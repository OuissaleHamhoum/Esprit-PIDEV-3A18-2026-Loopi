<!-- ═══ COLLECTION MODAL ═══ -->
<div class="modal-overlay" id="collModal" onclick="if(event.target===this)closeCollModal()">
  <div class="modal" style="width:540px">
    <div class="modal-title">
      <span id="collModalTitle">Nouvelle collection</span>
      <button class="modal-close" onclick="closeCollModal()">✕</button>
    </div>
    <form id="collForm" onsubmit="submitCollForm(event)" enctype="multipart/form-data">
      <input type="hidden" id="collEditId" value="">

      <div class="form-row2">
        <div class="fg" style="grid-column:1/-1">
          <label>Titre <span style="color:var(--danger)">*</span></label>
          <input id="cf_title" name="title" minlength="5" maxlength="255" placeholder="Minimum 5 caractères" required autocomplete="off">
          <div id="err_title" style="color:var(--danger);font-size:.7rem;margin-top:3px;display:none"></div>
        </div>
        <div class="fg">
          <label>Type de matériau <span style="color:var(--danger)">*</span></label>
          <select id="cf_material" name="materialType" required style="width:100%;padding:9px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:white;outline:none">
            <option value="">Choisir…</option>
            <option>Verre</option><option>Métal</option><option>Plastique</option><option>Bois</option><option>Papier</option><option>Autre</option>
          </select>
          <div id="err_material" style="color:var(--danger);font-size:.7rem;margin-top:3px;display:none"></div>
        </div>
        <div class="fg">
          <label>Statut</label>
          <select id="cf_status" name="status" style="width:100%;padding:9px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:white;outline:none">
            <option value="active">Actif</option>
            <option value="inactive">Inactif</option>
          </select>
        </div>
        <div class="fg">
          <label>Objectif <span style="color:var(--danger)">*</span></label>
          <input id="cf_goal" name="goalAmount" type="number" min="0.01" step="0.01" placeholder="ex: 150" required
            oninput="this.value=this.value.replace(/[^0-9.]/g,'')">
          <div id="err_goal" style="color:var(--danger);font-size:.7rem;margin-top:3px;display:none"></div>
        </div>
        <div class="fg">
          <label>Unité <span style="color:var(--danger)">*</span></label>
          <select id="cf_unit" name="unit" required style="width:100%;padding:9px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:white;outline:none">
            <option value="">Choisir…</option>
            <option>kg</option><option>litres</option><option>pièces</option>
          </select>
          <div id="err_unit" style="color:var(--danger);font-size:.7rem;margin-top:3px;display:none"></div>
        </div>
        <div class="fg" style="grid-column:1/-1">
          <label id="imgLabel">Image <span style="color:var(--danger)">*</span></label>
          <input id="cf_image" name="image" type="file" accept="image/*"
            style="width:100%;padding:9px 12px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:var(--muted);outline:none;cursor:pointer">
          <div id="imgPreviewBox" style="margin-top:8px;display:none">
            <img id="imgPreview" style="max-height:80px;border-radius:8px;border:1px solid var(--border)">
          </div>
          <div id="err_image" style="color:var(--danger);font-size:.7rem;margin-top:3px;display:none"></div>
        </div>
      </div>

      <div id="collFormError" style="color:var(--danger);font-size:.78rem;margin-top:8px;display:none"></div>

      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px">
        <button type="button" class="btn btn-ghost" onclick="closeCollModal()">Annuler</button>
        <button type="submit" class="btn btn-g" id="collSubmitBtn">Créer la collection</button>
      </div>
    </form>
  </div>
