    <div class="fg"><label>Description</label><textarea placeholder="Décrivez l'événement…"></textarea></div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:4px">
      <button class="btn btn-ghost" onclick="closeModal()">Annuler</button>
      <button class="btn btn-g" onclick="closeModal();showToast('Événement créé et envoyé pour validation ✓')">Créer & Soumettre</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ─── PAGE NAVIGATION ─────────────────────────────────────────────────────────
function showPage(name, navEl) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + name).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  if (name === 'collections') loadCollections();
}

// ─── TOAST ───────────────────────────────────────────────────────────────────
function showToast(msg, color) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.background = color || 'var(--accent)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

// ─── EVENT MODAL ─────────────────────────────────────────────────────────────
function openModal() { document.getElementById('eventModal').classList.add('active'); }
function closeModal() { document.getElementById('eventModal').classList.remove('active'); }

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { closeModal(); closeCollModal(); closeDeleteModal(); }
});

// ─── IMAGE PREVIEW ───────────────────────────────────────────────────────────
document.getElementById('cf_image').addEventListener('change', function() {
  const file = this.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('imgPreview').src = e.target.result;
      document.getElementById('imgPreviewBox').style.display = 'block';
    };
    reader.readAsDataURL(file);
  }
});

// ─── COLLECTION MODAL ────────────────────────────────────────────────────────
let _deleteCollId = null;

function openCollModal(collection) {
  const isEdit = !!collection;
  document.getElementById('collModalTitle').textContent = isEdit ? 'Modifier la collection' : 'Nouvelle collection';
  document.getElementById('collSubmitBtn').textContent  = isEdit ? 'Enregistrer' : 'Créer la collection';
  document.getElementById('collEditId').value   = isEdit ? collection.id : '';
  document.getElementById('cf_title').value     = isEdit ? collection.title : '';
  document.getElementById('cf_material').value  = isEdit ? collection.materialType : '';
  document.getElementById('cf_goal').value      = isEdit ? collection.goalAmount : '';
  document.getElementById('cf_unit').value      = isEdit ? collection.unit : '';
  document.getElementById('cf_status').value    = isEdit ? collection.status : 'active';
  document.getElementById('cf_image').value     = '';
  document.getElementById('imgPreviewBox').style.display = 'none';
  const imgLbl = document.getElementById('imgLabel');
  imgLbl.innerHTML = isEdit
    ? 'Image <span style="color:var(--muted);font-size:.7rem">(laisser vide pour conserver l\'actuelle)</span>'
    : 'Image <span style="color:var(--danger)">*</span>';
  // clear errors
  ['title','material','goal','unit','image'].forEach(f => {
    const el = document.getElementById('err_'+f);
    if (el) { el.style.display='none'; el.textContent=''; }
  });
  document.getElementById('collFormError').style.display = 'none';
  document.getElementById('collModal').classList.add('active');
}

function closeCollModal() {
  document.getElementById('collModal').classList.remove('active');
}

async function submitCollForm(e) {
  e.preventDefault();
  const editId = document.getElementById('collEditId').value;
  const isEdit = !!editId;
  const btn = document.getElementById('collSubmitBtn');
  btn.disabled = true;
  btn.textContent = isEdit ? 'Enregistrement…' : 'Création…';

  // clear errors
  ['title','material','goal','unit','image'].forEach(f => {
    const el = document.getElementById('err_'+f);
    if (el) { el.style.display='none'; el.textContent=''; }
  });
  document.getElementById('collFormError').style.display = 'none';

  const fd = new FormData();
  fd.append('title',        document.getElementById('cf_title').value.trim());
  fd.append('materialType', document.getElementById('cf_material').value);
  fd.append('goalAmount',   document.getElementById('cf_goal').value);
  fd.append('unit',         document.getElementById('cf_unit').value);
  fd.append('status',       document.getElementById('cf_status').value);
  const img = document.getElementById('cf_image').files[0];
  if (img) fd.append('image', img);
  if (isEdit) fd.append('_method', 'PUT');

  const url = isEdit ? '/api/organisateur/collections/' + editId : '/api/organisateur/collections';
  try {
    const res = await fetch(url, { method: 'POST', body: fd });
    const json = await res.json();
    if (json.success) {
      closeCollModal();
      showToast(isEdit ? '✅ Collection mise à jour!' : '✅ Collection créée!');
      loadCollections();
    } else {
      if (json.errors) {
        const map = { title:'title', materialType:'material', goalAmount:'goal', unit:'unit', image:'image' };
        Object.entries(json.errors).forEach(([k, msg]) => {
          const key = map[k] || k;
          const el = document.getElementById('err_'+key);
          if (el) { el.textContent = msg; el.style.display = 'block'; }
        });
      } else {
        document.getElementById('collFormError').textContent = json.message || 'Erreur inconnue.';
        document.getElementById('collFormError').style.display = 'block';
      }
    }
  } catch(err) {
    document.getElementById('collFormError').textContent = 'Erreur réseau. Veuillez réessayer.';
    document.getElementById('collFormError').style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = isEdit ? 'Enregistrer' : 'Créer la collection';
  }
}

// ─── DELETE ───────────────────────────────────────────────────────────────────
function askDeleteColl(id) {
  _deleteCollId = id;
  document.getElementById('confirmDeleteModal').classList.add('active');
}
function closeDeleteModal() {
  document.getElementById('confirmDeleteModal').classList.remove('active');
  _deleteCollId = null;
}
async function confirmDelete() {
  if (!_deleteCollId) return;
  const btn = document.getElementById('confirmDeleteBtn');
  btn.disabled = true; btn.textContent = 'Suppression…';
  try {
    const res = await fetch('/api/organisateur/collections/' + _deleteCollId, { method: 'DELETE' });
    const json = await res.json();
    if (json.success) {
      closeDeleteModal();
      showToast('🗑️ Collection supprimée.');
      loadCollections();
    } else {
      showToast(json.message || 'Erreur.', 'var(--danger)');
    }
  } catch { showToast('Erreur réseau.', 'var(--danger)'); }
  finally {
    btn.disabled = false; btn.textContent = 'Supprimer';
    _deleteCollId = null;
  }
}

// ─── LOAD & RENDER COLLECTIONS ───────────────────────────────────────────────
let _allCollections = [];

async function loadCollections() {
  const grid = document.getElementById('collGrid');
  document.getElementById('collLoading').style.display = 'block';
  document.getElementById('collLoading').textContent = 'Chargement…';
  // Remove old cards
  grid.querySelectorAll('.coll-dyn-card').forEach(c => c.remove());

  const search   = document.getElementById('collSearch')?.value || '';
  const material = document.getElementById('collMaterial')?.value || '';
  try {
    let url = '/api/organisateur/collections?1=1';
    if (search)   url += '&search=' + encodeURIComponent(search);
    if (material) url += '&material=' + encodeURIComponent(material);
    const res = await fetch(url);
    const json = await res.json();
    _allCollections = json.data || [];
    renderCollections(_allCollections);
  } catch(e) {
    document.getElementById('collLoading').textContent = '⚠️ Erreur de chargement.';
  }
}

function filterCollections() {
  const search   = (document.getElementById('collSearch')?.value || '').toLowerCase();
  const material = document.getElementById('collMaterial')?.value || '';
  const status   = document.getElementById('collStatus')?.value || '';
  const filtered = _allCollections.filter(c => {
    if (search   && !c.title.toLowerCase().includes(search) && !c.materialType.toLowerCase().includes(search)) return false;
    if (material && c.materialType !== material) return false;
    if (status   && c.status !== status) return false;
    return true;
  });
  renderCollections(filtered);
}

function renderCollections(list) {
  const grid = document.getElementById('collGrid');
  grid.querySelectorAll('.coll-dyn-card').forEach(c => c.remove());
  document.getElementById('collLoading').style.display = 'none';
  document.getElementById('collCount').textContent = list.length + ' collection(s)';

  if (list.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'coll-dyn-card';
    empty.style.cssText = 'grid-column:1/-1;text-align:center;padding:50px 0;color:var(--muted)';
    empty.innerHTML = '<div style="font-size:2.5rem;margin-bottom:12px">📭</div><div>Aucune collection trouvée.</div>';
    grid.appendChild(empty);
    return;
  }

  list.forEach(c => {
    const pct = Math.min(c.progress, 100);
    const imgHtml = c.imageUrl
      ? `<img src="${c.imageUrl}" style="width:100%;height:120px;object-fit:cover;border-radius:10px 10px 0 0">`
      : `<div style="height:80px;background:linear-gradient(135deg,var(--forest),var(--moss));border-radius:10px 10px 0 0;display:flex;align-items:center;justify-content:center;font-size:2.5rem">♻️</div>`;
    const statusBadge = c.status === 'active'
      ? '<span class="sbadge s-active">Actif</span>'
      : '<span class="sbadge s-full">Inactif</span>';

    const card = document.createElement('div');
    card.className = 'coll-dyn-card blk';
    card.style.padding = '0';
    card.style.overflow = 'hidden';
    card.innerHTML = `
      ${imgHtml}
      <div style="padding:16px">
        <div class="coll-header">
          <div class="coll-title">${escHtml(c.title)}</div>
          <div style="display:flex;gap:6px;align-items:center">
            <span class="coll-mat">${escHtml(c.materialType)}</span>
            ${statusBadge}
          </div>
        </div>
        <div class="prog-bar" style="height:8px;margin:10px 0 4px">
          <div class="prog-fill" style="width:${pct}%"></div>
        </div>
        <div class="prog-nums">
          <span style="color:var(--accent);font-weight:600">${c.currentAmount.toFixed(1)} ${escHtml(c.unit)}</span>
          <span>/ ${c.goalAmount} ${escHtml(c.unit)} · ${pct.toFixed(1)}%</span>
        </div>
        <div style="font-size:.72rem;color:var(--muted);margin-top:6px">${c.donationsCount} donation(s)</div>
        <div style="display:flex;gap:8px;margin-top:12px">
          <button class="btn btn-ghost" style="flex:1;font-size:.75rem" onclick='openCollModal(${JSON.stringify(c).replace(/'/g, "&apos;")})'>✏️ Modifier</button>
          <button class="btn btn-danger" style="flex:1;font-size:.75rem" onclick="askDeleteColl(${c.id})">🗑️ Supprimer</button>
        </div>
      </div>`;
    grid.appendChild(card);
  });
}

function escHtml(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
</body>
</html>
