<div class="toast" id="toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  // ===== GLOBAL VARIABLES =====
  let eventsData = [];
  let currentUserId = null;
  let editingEventId = null;
  let selectedImageFile = null;
  let generatedImageData = null;
  
  // Map variables
  let eventMap = null;
  let eventMarker = null;
  let currentLatitude = null;
  let currentLongitude = null;

  // Current filter for participants
  let currentParticipantEventId = null;

  // ===== UTILITIES =====
  function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.className = 'toast ' + type;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  function formatDate(dateString, withTime = false) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    if (withTime) {
      return date.toLocaleDateString('fr-FR') + ' ' + date.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    }
    return date.toLocaleDateString('fr-FR');
  }

  function formatDateTime(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString('fr-FR') + ' à ' + date.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  }

  function getStatusBadge(status) {
    const statusMap = {
      'valide': { class: 's-active', text: 'Validé' },
      'approuve': { class: 's-active', text: 'Validé' },
      'en_attente': { class: 's-pending', text: 'En attente' },
      'rejete': { class: 's-rejected', text: 'Rejeté' }
    };
    const s = statusMap[status] || statusMap['en_attente'];
    return `<span class="sbadge ${s.class}">${s.text}</span>`;
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // ===== LOAD EVENTS =====
  async function loadOrganisateurEvents() {
    try {
      const response = await fetch('/api/organisateur/events', {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      
      const data = await response.json();
      
      if (data.success && data.events) {
        eventsData = data.events;
        renderEventsGrid();
        updateDashboardStats();
        updateParticipantsList();
        updateDashboardCharts();
        return eventsData;
      }
      return [];
    } catch (error) {
      console.error('Erreur chargement événements:', error);
      showToast('Erreur lors du chargement des événements', 'error');
      return [];
    }
  }

  async function loadCurrentUser() {
    try {
      const response = await fetch('/api/health', {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json();
      if (data.user && data.user !== 'anonymous') {
        const name = data.user.split('@')[0];
        document.getElementById('userName').textContent = name || 'Organisateur';
        document.getElementById('userEmail').textContent = data.user;
        document.getElementById('userAvatar').textContent = (name?.charAt(0) || 'O').toUpperCase();
        document.getElementById('dashboardWelcome').innerHTML = `Bonjour, ${name || 'Organisateur'} 🌿`;
        
        document.getElementById('profileNom').value = '';
        document.getElementById('profilePrenom').value = '';
        document.getElementById('profileEmail').value = data.user;
      }
    } catch (error) {
      console.error('Erreur chargement user:', error);
    }
  }

  // ===== DASHBOARD STATS =====
  function filterDataByPeriod(data, period) {
    if (period === 'all') return data;
    const now = new Date();
    return data.filter(e => {
      if (!e.date_evenement) return true;
      const d = new Date(e.date_evenement);
      if (period === 'month') return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
      if (period === 'year') return d.getFullYear() === now.getFullYear();
      return true;
    });
  }

  function updateStat(statType, period) {
    const filtered = filterDataByPeriod(eventsData, period);
    if (statType === 'TotalEvents') {
      document.getElementById('statTotalEvents').textContent = filtered.length;
    } else if (statType === 'TotalParticipants') {
      document.getElementById('statTotalParticipants').textContent = filtered.reduce((sum, e) => sum + (e.participants_count || 0), 0);
    } else if (statType === 'ValidatedEvents') {
      const validated = filtered.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
      document.getElementById('statValidatedEvents').textContent = validated;
    } else if (statType === 'PendingEvents') {
      document.getElementById('statPendingEvents').textContent = filtered.filter(e => e.statut_validation === 'en_attente').length;
    }
  }

  let currentCalendarDate = new Date();

  function changeCalendarMonth(offset) {
    currentCalendarDate.setMonth(currentCalendarDate.getMonth() + offset);
    updateChart('FullCalendar', 'all');
  }

  function updateDashboardStats() {
    updateStat('TotalEvents', document.getElementById('filterTotalEvents')?.value || 'all');
    updateStat('TotalParticipants', document.getElementById('filterTotalParticipants')?.value || 'all');
    updateStat('ValidatedEvents', document.getElementById('filterValidatedEvents')?.value || 'all');
    updateStat('PendingEvents', document.getElementById('filterPendingEvents')?.value || 'all');
    
    const eventsStatTotal = document.getElementById('eventsStatTotal');
    if (eventsStatTotal) eventsStatTotal.textContent = eventsData.length;
    const eventsStatActive = document.getElementById('eventsStatActive');
    if (eventsStatActive) eventsStatActive.textContent = eventsData.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
    const eventsStatPending = document.getElementById('eventsStatPending');
    if (eventsStatPending) eventsStatPending.textContent = eventsData.filter(e => e.statut_validation === 'en_attente').length;
    const eventsStatParticipants = document.getElementById('eventsStatParticipants');
    if (eventsStatParticipants) eventsStatParticipants.textContent = eventsData.reduce((sum, e) => sum + (e.participants_count || 0), 0);
    
    const profileStatsEvents = document.getElementById('profileStatsEvents');
    if (profileStatsEvents) profileStatsEvents.textContent = eventsData.length;
    const profileStatsParticipants = document.getElementById('profileStatsParticipants');
    if (profileStatsParticipants) profileStatsParticipants.textContent = eventsData.reduce((sum, e) => sum + (e.participants_count || 0), 0);
  }

  function updateDashboardCharts() {
    updateChart('Popularity', document.getElementById('filterPopularity')?.value || 'all');
    updateChart('Status', document.getElementById('filterStatus')?.value || 'all');
    updateChart('FullCalendar', 'all');
  }

  function updateChart(chartType, period) {
    const filtered = filterDataByPeriod(eventsData, period);
    
    if (chartType === 'Popularity') {
      const monthlyData = {};
      filtered.forEach(event => {
        if (event.date_evenement) {
          const month = new Date(event.date_evenement).toLocaleString('fr-FR', { month: 'short' });
          monthlyData[month] = (monthlyData[month] || 0) + (event.participants_count || 0);
        }
      });
      const months = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];
      const maxValue = Math.max(...Object.values(monthlyData), 1);
      const chartContainer = document.getElementById('popularityChart');
      if (chartContainer) {
        chartContainer.innerHTML = months.map(month => {
          const value = monthlyData[month] || 0;
          const height = (value / maxValue) * 150;
          return `<div class="bar-item"><div class="bar-value" style="color:var(--text);">${value}</div><div class="bar" style="height: ${height}px;"></div><div class="bar-label" style="color:var(--text);">${month}</div></div>`;
        }).join('');
      }
    } else if (chartType === 'Status') {
      const validated = filtered.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
      const pending = filtered.filter(e => e.statut_validation === 'en_attente').length;
      const rejected = filtered.filter(e => e.statut_validation === 'rejete').length;
      const totalStatus = validated + pending + rejected;
      const donutContainer = document.getElementById('statusDonut');
      if (donutContainer) {
        if (totalStatus > 0) {
          const vP = (validated / totalStatus) * 100;
          const pP = (pending / totalStatus) * 100;
          const rP = (rejected / totalStatus) * 100;
          donutContainer.innerHTML = `<div class="donut" style="background: conic-gradient(var(--accent) 0% ${vP}%, var(--sand) ${vP}% ${vP + pP}%, var(--danger) ${vP + pP}% 100%)"><div class="donut-inner" style="color:var(--text);">${totalStatus}</div></div>
            <div class="donut-labels">
              <div class="donut-label-item"><div class="donut-color" style="background: var(--accent);"></div><span class="donut-text" style="color:var(--text);">Validés</span><span class="donut-percent" style="color:var(--text);">${vP.toFixed(0)}%</span></div>
              <div class="donut-label-item"><div class="donut-color" style="background: var(--sand);"></div><span class="donut-text" style="color:var(--text);">En attente</span><span class="donut-percent" style="color:var(--text);">${pP.toFixed(0)}%</span></div>
              <div class="donut-label-item"><div class="donut-color" style="background: var(--danger);"></div><span class="donut-text" style="color:var(--text);">Rejetés</span><span class="donut-percent" style="color:var(--text);">${rP.toFixed(0)}%</span></div>
            </div>`;
        } else {
          donutContainer.innerHTML = '<div style="text-align:center; padding:20px; color:var(--muted);">Aucune donnée disponible</div>';
        }
      }
    } else if (chartType === 'FullCalendar') {
      const year = currentCalendarDate.getFullYear();
      const month = currentCalendarDate.getMonth();
      
      const monthLabel = document.getElementById('calendarMonthLabel');
      if (monthLabel) monthLabel.textContent = currentCalendarDate.toLocaleString('fr-FR', { month: 'long', year: 'numeric' });
      
      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);
      const daysInMonth = lastDay.getDate();
      let startingDay = firstDay.getDay() - 1;
      if (startingDay === -1) startingDay = 6;
      
      const daysOfWeek = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
      let html = daysOfWeek.map(d => `<div style="font-size:0.8rem; font-weight:700; color:var(--muted); padding:10px 0; border-bottom:1px solid var(--border);">${d}</div>`).join('');
      
      for (let i = 0; i < startingDay; i++) {
        html += `<div style="background:rgba(255,255,255,0.01); border:1px solid rgba(255,255,255,0.03); border-radius:8px;"></div>`;
      }
      
      for (let i = 1; i <= daysInMonth; i++) {
        const loopDate = new Date(year, month, i, 12, 0, 0);
        const yStr = loopDate.getFullYear();
        const mStr = String(loopDate.getMonth() + 1).padStart(2, '0');
        const dStr = String(loopDate.getDate()).padStart(2, '0');
        const currentDateStr = `${yStr}-${mStr}-${dStr}`;
        
        const eventsOnDay = eventsData.filter(e => e.date_evenement && e.date_evenement.startsWith(currentDateStr));
        
        const isToday = new Date().toISOString().split('T')[0] === currentDateStr;
        
        let dayHtml = `<div style="min-height:80px; padding:6px; border:1px solid var(--border); border-radius:8px; background:rgba(255,255,255,0.02); display:flex; flex-direction:column; align-items:flex-start; transition:all 0.2s;">
          <span style="font-size:0.85rem; font-weight:600; color:var(--text); align-self:flex-end; margin-bottom:4px; ${isToday ? 'background:var(--accent); color:#fff; border-radius:50%; width:24px; height:24px; display:flex; align-items:center; justify-content:center;' : ''}">${i}</span>
          <div style="display:flex; flex-direction:column; gap:4px; width:100%; text-align:left;">
            ${eventsOnDay.map(e => `<div style="font-size:0.65rem; background:${e.statut_validation === 'valide' ? 'var(--accent)' : 'var(--card2)'}; color:white; padding:3px 6px; border-radius:4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; font-weight:500;" onclick="viewEventDetail(${e.id})" title="${escapeHtml(e.titre)}">${escapeHtml(e.heure_evenement || '')} ${escapeHtml(e.titre)}</div>`).join('')}
          </div>
        </div>`;
        html += dayHtml;
      }
      
      const calContainer = document.getElementById('fullCalendarGrid');
      if (calContainer) calContainer.innerHTML = html;
    }
  }

  // ===== RENDER EVENTS =====
  function renderEventsGrid() {
    const container = document.getElementById('eventsContainer');
    const emptyState = document.getElementById('eventsEmpty');
    
    if (!eventsData || eventsData.length === 0) {
      if (emptyState) emptyState.style.display = 'block';
      if (container) container.innerHTML = '';
      return;
    }
    
    const searchTerm = document.getElementById('eventSearch')?.value.toLowerCase() || '';
    const statusFilter = document.getElementById('eventStatusFilter')?.value || '';
    const periodFilter = document.getElementById('eventPeriodFilter')?.value || '';
    const now = new Date();
    
    let filteredEvents = eventsData.filter(event => {
      if (searchTerm) {
        const title = (event.titre || '').toLowerCase();
        const location = (event.lieu || '').toLowerCase();
        if (!title.includes(searchTerm) && !location.includes(searchTerm)) {
          return false;
        }
      }
      
      if (statusFilter) {
        const status = event.statut_validation || event.statut || 'en_attente';
        if (statusFilter === 'valide' && status !== 'valide' && status !== 'approuve') return false;
        if (statusFilter === 'en_attente' && status !== 'en_attente') return false;
        if (statusFilter === 'rejete' && status !== 'rejete') return false;
      }
      
      if (periodFilter && event.date_evenement) {
        const eventDate = new Date(event.date_evenement);
        if (periodFilter === 'upcoming' && eventDate < now) return false;
        if (periodFilter === 'past' && eventDate >= now) return false;
      }
      
      return true;
    });

    if (filteredEvents.length === 0) {
      if (emptyState) emptyState.style.display = 'none';
      if (container) {
        container.style.display = 'block';
        container.innerHTML = `<div style="text-align:center; padding:40px; color:var(--muted); grid-column:1/-1;">Aucun événement ne correspond à vos critères de recherche.</div>`;
      }
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (container) container.style.display = 'grid';
    
    container.innerHTML = filteredEvents.map(event => {
      const eventDate = new Date(event.date_evenement);
      const day = eventDate.getDate();
      const month = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'][eventDate.getMonth()];
      const participantsCount = event.participants_count || 0;
      const capacityFill = event.capacite_max > 0 ? (participantsCount / event.capacite_max) * 100 : 0;
      
      const imageUrl = event.image_evenement ? `/uploads/events/${event.image_evenement}` : null;
      
      return `
        <div class="event-card" onclick="viewEventDetail(${event.id})">
          <div class="event-image">
            ${imageUrl ? `<img src="${imageUrl}?t=${Date.now()}" alt="${escapeHtml(event.titre)}">` : `
              <div class="event-image-placeholder">📅</div>
            `}
            <div class="event-status-badge">${getStatusBadge(event.statut_validation)}</div>
            <div class="event-date-badge">
              <div class="event-date-day">${day}</div>
              <div class="event-date-month">${month}</div>
            </div>
          </div>
          <div class="event-body">
            <div class="event-title">${escapeHtml(event.titre)}</div>
            <div class="event-lieu">📍 ${escapeHtml(event.lieu)}</div>
            <div class="event-progress">
              <div class="progress-bar">
                <div class="progress-fill" style="width: ${Math.min(capacityFill, 100)}%"></div>
              </div>
              <div class="progress-stats">
                <span>👥 ${participantsCount} inscrits</span>
                <span>🎯 ${event.capacite_max} places</span>
              </div>
            </div>
            <div class="event-actions">
              <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation(); viewEventDetail(${event.id})">👁️ Voir</button>
              <button class="btn btn-warning btn-sm" onclick="event.stopPropagation(); editEvent(${event.id})">✏️ Modifier</button>
              <button class="btn btn-danger btn-sm" onclick="event.stopPropagation(); openDeleteModal(${event.id}, '${escapeHtml(event.titre).replace(/'/g, "\\'")}')">🗑️ Suppr.</button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // ===== VIEW EVENT DETAILS WITH PARTICIPANTS =====
  async function viewEventDetail(eventId) {
    const event = eventsData.find(e => e.id === eventId);
    if (!event) return;
    
    let participants = [];
    try {
      const response = await fetch(`/api/admin/events/${eventId}`, {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json();
      if (data.success && data.participants) {
        participants = data.participants;
      }
    } catch (error) {
      console.error('Erreur chargement participants:', error);
    }
    
    const eventDate = new Date(event.date_evenement);
    const formattedDate = eventDate.toLocaleDateString('fr-FR', {
      weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
    });
    const formattedTime = event.heure_evenement || eventDate.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    const imageUrl = event.image_evenement ? `/uploads/events/${event.image_evenement}` : null;
    
    const modalBody = document.getElementById('detailModalBody');
    modalBody.innerHTML = `
      <div class="detail-grid">
        <div class="detail-section">
          <h4>📋 Informations générales</h4>
          <div class="detail-info"><span class="detail-info-label">Titre:</span><span class="detail-info-value">${escapeHtml(event.titre)}</span></div>
          <div class="detail-info"><span class="detail-info-label">Statut:</span><span class="detail-info-value">${getStatusBadge(event.statut_validation)}</span></div>
          <div class="detail-info"><span class="detail-info-label">Date:</span><span class="detail-info-value">${formattedDate}</span></div>
          <div class="detail-info"><span class="detail-info-label">Heure:</span><span class="detail-info-value">${formattedTime}</span></div>
          <div class="detail-info"><span class="detail-info-label">Lieu:</span><span class="detail-info-value">${escapeHtml(event.lieu)}</span></div>
          <div class="detail-info"><span class="detail-info-label">Capacité:</span><span class="detail-info-value">${event.capacite_max} places</span></div>
          <div class="detail-info"><span class="detail-info-label">Inscrits:</span><span class="detail-info-value">${event.participants_count || 0}</span></div>
          ${event.latitude && event.longitude ? `<div class="detail-info"><span class="detail-info-label">Coordonnées:</span><span class="detail-info-value">${event.latitude}, ${event.longitude}</span></div>` : ''}
        </div>
        <div class="detail-section">
          <h4>🖼️ Image</h4>
          ${imageUrl ? `<img src="${imageUrl}?t=${Date.now()}" alt="${escapeHtml(event.titre)}" style="width:100%; border-radius:8px; max-height:150px; object-fit:cover;">` : '<div style="text-align:center; padding:20px;">📷 Pas d\'image</div>'}
        </div>
      </div>
      <div class="detail-section">
        <h4>📝 Description</h4>
        <p style="font-size:.85rem; line-height:1.5;">${escapeHtml(event.description || 'Aucune description').replace(/\n/g, '<br>')}</p>
      </div>
      <div class="detail-section">
        <h4>👥 Participants (${participants.length})</h4>
        <div class="participants-list">
          ${participants.length === 0 ? '<div style="text-align:center; padding:20px; color:var(--muted);">Aucun participant inscrit</div>' : 
            participants.map(p => `
              <div class="participant-item">
                <div>
                  <div class="participant-name">${escapeHtml(p.prenom || '')} ${escapeHtml(p.nom || '')}</div>
                  <div class="participant-email">${escapeHtml(p.email || '')}</div>
                </div>
                <div>
                  <div>${p.contact ? `📞 ${escapeHtml(p.contact)}` : ''}</div>
                  <div>${p.age ? `🎂 ${p.age} ans` : ''}</div>
                </div>
                <div class="participant-status"><span class="sbadge s-active">${p.statut === 'present' ? 'Présent' : (p.statut === 'absent' ? 'Absent' : 'Inscrit')}</span></div>
              </div>
            `).join('')
          }
        </div>
      </div>
    `;
    
    window.currentDetailEventId = event.id;
    document.getElementById('detailModal').classList.add('active');
