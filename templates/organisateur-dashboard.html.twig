<div class="toast" id="toast"></div>

<script>
function showPage(name, navEl) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + name).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');

  // Load events when switching to events page
  if (name === 'evenements') {
    loadOrganisateurEvents();
  }
}
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2600);
}

let organiserEventsCache = {};
let editingEventId = null;

function openModal() {
  document.getElementById('eventModal').classList.add('active');
}

function openEventModal() {
  openModal();
}

function closeModal() {
  document.getElementById('eventModal').classList.remove('active');
  editingEventId = null;
  resetEventForm();
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

function resetEventForm() {
  const modal = document.getElementById('eventModal');
  const inputs = modal.querySelectorAll('input, textarea');
  inputs[0].value = '';
  inputs[1].value = '';
  inputs[2].value = '';
  inputs[3].value = '';
  inputs[4].value = '09:00';
  inputs[5].value = '';
  const title = modal.querySelector('.modal-title');
  if (title) title.firstChild.textContent = 'Créer un événement ';
  const createBtn = modal.querySelector('.btn-g');
  if (createBtn) createBtn.textContent = 'Créer & Soumettre';
}

function populateEventForm(eventData) {
  const modal = document.getElementById('eventModal');
  const inputs = modal.querySelectorAll('input, textarea');
  inputs[0].value = eventData.titre || '';
  inputs[1].value = eventData.date_evenement || '';
  inputs[2].value = eventData.lieu || '';
  inputs[3].value = eventData.capacite_max || '';
  inputs[4].value = eventData.heure_evenement || '09:00';
  inputs[5].value = eventData.description || '';
  const title = modal.querySelector('.modal-title');
  if (title) title.firstChild.textContent = 'Modifier l\'événement ';
  const createBtn = modal.querySelector('.btn-g');
  if (createBtn) createBtn.textContent = 'Mettre à jour';
}

// Load events for organizer
function viewEvent(eventId) {
  const event = organiserEventsCache[eventId];
  if (!event) {
    showToast('Événement introuvable');
    return;
  }

  // Create a simple modal to show event details
  const modal = document.createElement('div');
  modal.style.cssText = `
    position:fixed;top:0;left:0;width:100%;height:100%;
    background:rgba(0,0,0,.7);z-index:1000;display:flex;
    align-items:center;justify-content:center;
  `;
  modal.onclick = () => modal.remove();

  const content = document.createElement('div');
  content.style.cssText = `
    background:white;border-radius:16px;max-width:500px;width:90%;
    max-height:80vh;overflow-y:auto;margin:20px;
  `;
  content.onclick = (e) => e.stopPropagation();

  const eventDate = new Date(event.date_evenement + 'T' + (event.heure_evenement || '00:00'));
  const formattedDate = eventDate.toLocaleDateString('fr-FR', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });

  let statusBadge = 's-pending';
  let statusText = 'En attente';
  switch (event.statut_validation) {
    case 'valide':
      statusBadge = 's-active';
      statusText = 'Validé';
      break;
    case 'rejete':
      statusBadge = 's-rejected';
      statusText = 'Rejeté';
      break;
  }

  content.innerHTML = `
    <div style="padding:24px">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
        <h2 style="margin:0;font-size:1.5rem;font-weight:700;color:var(--forest)">${event.titre}</h2>
        <span class="sbadge ${statusBadge}">${statusText}</span>
      </div>

      <div style="margin-bottom:20px">
        <div style="display:flex;gap:16px;margin-bottom:16px">
          <div style="background:var(--bg);border-radius:12px;padding:12px;text-align:center;min-width:60px">
            <div style="font-size:1.5rem;font-weight:700;color:var(--forest)">${eventDate.getDate()}</div>
            <div style="font-size:.8rem;color:var(--muted);text-transform:uppercase">
              ${['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'][eventDate.getDay()]}
            </div>
          </div>
          <div style="flex:1">
            <div style="font-weight:600;margin-bottom:4px">${formattedDate}</div>
            <div style="color:var(--muted)">${event.heure_evenement || '00:00'} • ${event.lieu}</div>
          </div>
        </div>

        <div style="margin-bottom:16px">
          <div style="font-weight:600;margin-bottom:8px">Description</div>
          <div style="color:var(--muted);line-height:1.5">${event.description || 'Aucune description'}</div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
          <div>
            <div style="font-weight:600;margin-bottom:4px">Capacité</div>
            <div style="color:var(--muted)">${event.capacite_max} places</div>
          </div>
          <div>
            <div style="font-weight:600;margin-bottom:4px">Participants</div>
            <div style="color:var(--muted)">${event.participants_count || 0} inscrits</div>
          </div>
        </div>

        <div style="display:flex;gap:8px">
          <button class="btn btn-ghost" style="flex:1" onclick="modal.remove();editEvent(${event.id})">
            ✏️ Modifier
          </button>
          <button class="btn btn-danger" style="flex:1" onclick="modal.remove();deleteEvent(${event.id})">
            🗑️ Supprimer
          </button>
        </div>
      </div>
    </div>
  `;

  modal.appendChild(content);
  document.body.appendChild(modal);
}

async function loadOrganisateurEvents() {
  const container = document.getElementById('events-container');
  const emptyState = document.getElementById('events-empty');

  if (!container) return;

  try {
    console.log('Loading events...');
    const response = await fetch('/api/organisateur/events');

    if (!response.ok) {
      console.error('HTTP error:', response.status, response.statusText);
      showToast('Erreur HTTP: ' + response.status);
      return;
    }

    let data;
    try {
      data = await response.json();
      console.log('Received data:', data);
    } catch (e) {
      console.error('JSON parse error:', e);
      showToast('Erreur: Réponse JSON invalide');
      return;
    }

    if (!data.success) {
      console.error('API returned success=false:', data);
      showToast('Erreur API: ' + (data.message || 'Erreur inconnue'));
      return;
    }

    const events = data.events;
    organiserEventsCache = {};
    console.log('Processing', events.length, 'events');

    if (!Array.isArray(events) || events.length === 0) {
      container.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    container.style.display = 'grid';
    emptyState.style.display = 'none';
    container.innerHTML = '';

    events.forEach(event => {
      organiserEventsCache[event.id] = event;
      const eventDate = new Date(event.date_evenement + 'T' + (event.heure_evenement || '00:00'));
      const day = eventDate.getDate();
      const month = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'][eventDate.getMonth()];

      let statusBadge = 's-pending';
      let statusText = 'En attente';
      switch (event.statut_validation) {
        case 'valide':
          statusBadge = 's-active';
          statusText = 'Validé';
          break;
        case 'rejete':
          statusBadge = 's-rejected';
          statusText = 'Rejeté';
          break;
        default:
          statusBadge = 's-pending';
          statusText = 'En attente';
      }

      const capacityFill = Math.round(((event.capacite_max - event.places_left) / event.capacite_max) * 100);
      const participantsCount = event.participants_count || 0;

      const card = document.createElement('div');
      card.className = 'event-card';
      card.style.cssText = `
        background:white;
        border-radius:16px;
        overflow:hidden;
        box-shadow:0 4px 20px rgba(0,0,0,.08);
        transition:transform .2s,box-shadow .2s;
        cursor:pointer;
      `;
      card.onmouseover = () => {
        card.style.transform = 'translateY(-4px)';
        card.style.boxShadow = '0 8px 30px rgba(0,0,0,.12)';
      };
      card.onmouseout = () => {
        card.style.transform = 'translateY(0)';
        card.style.boxShadow = '0 4px 20px rgba(0,0,0,.08)';
      };

      card.innerHTML = `
        <div style="position:relative">
          <div style="height:160px;background:linear-gradient(135deg,var(--forest),var(--moss));display:flex;align-items:center;justify-content:center;color:white;font-size:3rem">
            ${event.image_evenement ? `<img src="${event.image_evenement}" style="width:100%;height:100%;object-fit:cover" alt="${event.titre}">` : '📅'}
          </div>
          <div style="position:absolute;top:12px;left:12px">
            <span class="sbadge ${statusBadge}">${statusText}</span>
          </div>
          <div style="position:absolute;top:12px;right:12px">
            <div style="background:white;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:.8rem">📍</div>
          </div>
        </div>

        <div style="padding:20px">
          <div style="display:flex;gap:14px;margin-bottom:16px">
            <div class="ev-date" style="background:var(--bg);border:2px solid var(--border);border-radius:12px;padding:8px;text-align:center;min-width:50px">
              <div class="ev-day" style="font-size:1.2rem;font-weight:700;color:var(--forest)">${day}</div>
              <div class="ev-mon" style="font-size:.7rem;color:var(--muted);text-transform:uppercase">${month}</div>
            </div>
            <div style="flex:1">
              <div style="font-weight:700;font-size:1.1rem;color:var(--text);margin-bottom:4px">${event.titre}</div>
              <div style="font-size:.85rem;color:var(--muted)">${event.lieu}</div>
              <div style="font-size:.75rem;color:var(--muted);margin-top:2px">${event.heure_evenement || '00:00'} • ${event.capacite_max} places</div>
            </div>
          </div>

          <div style="margin-bottom:16px">
            <div style="display:flex;justify-content:space-between;margin-bottom:6px">
              <span style="font-size:.8rem;color:var(--muted)">Participants</span>
              <span style="font-size:.8rem;color:var(--forest);font-weight:600">${participantsCount}/${event.capacite_max}</span>
            </div>
            <div class="prog-bar" style="height:6px;border-radius:3px;background:var(--bg);overflow:hidden">
              <div class="prog-fill" style="height:100%;background:linear-gradient(90deg,var(--forest),var(--moss));width:${capacityFill}%"></div>
            </div>
          </div>

          <div style="display:flex;gap:8px">
            <button class="btn btn-ghost" style="flex:1;font-size:.8rem;padding:8px" onclick="event.stopPropagation();viewEvent(${event.id})">
              👁️ Voir
            </button>
            <button class="btn btn-ghost" style="flex:1;font-size:.8rem;padding:8px" onclick="event.stopPropagation();editEvent(${event.id})">
              ✏️ Modifier
            </button>
            <button class="btn btn-danger" style="flex:1;font-size:.8rem;padding:8px" onclick="event.stopPropagation();deleteEvent(${event.id})">
              🗑️ Supprimer
            </button>
          </div>
        </div>
      `;

      // Add click handler for the whole card
      card.onclick = () => viewEvent(event.id);

      container.appendChild(card);
    });

    // Update locations
    updateLocations(events);

  } catch (error) {
    console.error('Error loading events:', error);
    showToast('Erreur lors du chargement des événements');
  }
}

// Update location list
function updateLocations(events) {
  const locationList = document.getElementById('location-list');
  locationList.innerHTML = '';

  const locations = [...new Set(events.map(e => e.lieu))];

  locations.forEach((location, index) => {
    const div = document.createElement('div');
    div.style.cssText = 'display:flex;justify-content:space-between;padding:6px 0;';
    if (index < locations.length - 1) {
      div.style.borderBottom = '1px solid var(--border)';
    }
    div.innerHTML = `
      <span style="color:var(--muted)">${location}</span>
      <span style="color:var(--accent)">📍 Localisation</span>
    `;
    locationList.appendChild(div);
  });
}

// Create new event
async function createEvent() {
  const modal = document.getElementById('eventModal');
  const inputs = modal.querySelectorAll('input, textarea');
  const data = {
    titre: inputs[0].value,
    date_evenement: inputs[1].value,
    lieu: inputs[2].value,
    capacite_max: parseInt(inputs[3].value),
    heure_evenement: inputs[4].value,
    description: inputs[5].value
  };

  // Add coordinates if available
  if (currentLatitude && currentLongitude) {
    data.latitude = currentLatitude;
    data.longitude = currentLongitude;
  }

  const url = editingEventId ? `/api/organisateur/events/${editingEventId}` : '/api/organisateur/events';
  const method = editingEventId ? 'PUT' : 'POST';

  try {
    const response = await fetch(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data)
    });

    let result;
    try {
      result = await response.json();
    } catch (e) {
      console.error('Failed to parse JSON response:', e);
      showToast('Erreur: Réponse invalide du serveur');
      return;
    }

    if (response.ok && result.success) {
      closeModal();
      showToast('Événement créé et envoyé pour validation ✓');
      loadOrganisateurEvents(); // Reload events
    } else {
      const errorMsg = result.errors ?
        Object.values(result.errors).join(', ') :
        (result.message || 'Erreur lors de la création');
      console.error('API error:', result);
      showToast('Erreur: ' + errorMsg);
    }
  } catch (error) {
    console.error('Network error:', error);
    showToast('Erreur de connexion lors de la création');
  }
}

function editEvent(eventId) {
  const eventData = organiserEventsCache[eventId];
  if (!eventData) {
    showToast('Événement introuvable pour modification');
    return;
  }
  editingEventId = eventId;
  populateEventForm(eventData);
  openModal();
}

// Delete event
async function deleteEvent(eventId) {
  if (!confirm('Êtes-vous sûr de vouloir supprimer cet événement ?')) {
    return;
  }

  try {
    const response = await fetch(`/api/organisateur/events/${eventId}`, {
      method: 'DELETE'
    });

    if (response.ok) {
      showToast('Événement supprimé');
      loadOrganisateurEvents(); // Reload events
    } else {
      showToast('Erreur lors de la suppression');
    }
  } catch (error) {
    console.error('Error deleting event:', error);
    showToast('Erreur lors de la suppression');
  }
}

// Update modal submit button to call createEvent
document.addEventListener('DOMContentLoaded', function() {
  const createBtn = document.querySelector('.modal .btn-g');
  if (createBtn) {
    createBtn.onclick = createEvent;
  }
});
</script>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
// ===== GEOCODING AND MAP FUNCTIONS =====
let eventMap = null;
let eventMarker = null;
let currentLatitude = null;
let currentLongitude = null;

// Initialize map when modal opens
function initEventMap() {
  if (eventMap) {
    eventMap.remove();
  }

  const mapContainer = document.getElementById('eventMap');
  if (!mapContainer) return;

  // Default to Tunisia center
  const defaultLat = 36.8065;
  const defaultLng = 10.1815;

  eventMap = L.map('eventMap').setView([defaultLat, defaultLng], 7);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors',
    maxZoom: 19
  }).addTo(eventMap);

  // Add click handler to place marker
  eventMap.on('click', function(e) {
    placeMarker(e.latlng.lat, e.latlng.lng);
  });

  mapContainer.style.display = 'block';
}

// Place marker on map
function placeMarker(lat, lng) {
  if (eventMarker) {
    eventMap.removeLayer(eventMarker);
  }

  eventMarker = L.marker([lat, lng]).addTo(eventMap);
  currentLatitude = lat;
  currentLongitude = lng;

  updateCoordinatesDisplay();
  reverseGeocode(lat, lng);
}

// Update coordinates display
function updateCoordinatesDisplay() {
  const display = document.getElementById('coordinatesDisplay');
  const displayText = document.getElementById('latLngDisplay');

  if (currentLatitude && currentLongitude) {
    displayText.textContent = `${currentLatitude.toFixed(6)}, ${currentLongitude.toFixed(6)}`;
    display.style.display = 'block';
  } else {
    displayText.textContent = 'Non définies';
    display.style.display = 'none';
  }
}

// Reverse geocoding (coordinates to address)
async function reverseGeocode(lat, lng) {
  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
    const data = await response.json();

    if (data && data.display_name) {
      document.getElementById('eventLieu').value = data.display_name;
    }
  } catch (error) {
    console.error('Erreur de géocodage inverse:', error);
  }
}

// Forward geocoding (address to coordinates)
async function geocodeLocation() {
  const address = document.getElementById('eventLieu').value.trim();
  if (!address) {
    showToast('Veuillez saisir une adresse');
    return;
  }

  const btn = document.getElementById('btnGeocode');
  const originalHtml = btn.innerHTML;
  btn.classList.add('loading');
  btn.disabled = true;

  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=5&countrycodes=TN`);
    const results = await response.json();

    if (results && results.length > 0) {
      const result = results[0];
      const lat = parseFloat(result.lat);
      const lng = parseFloat(result.lon);

      // Initialize map if not already done
      if (!eventMap) {
        initEventMap();
      }

      // Center map and place marker
      eventMap.setView([lat, lng], 15);
      placeMarker(lat, lng);

      // Show suggestions if multiple results
      if (results.length > 1) {
        showLocationSuggestions(results);
      }

      showToast('Adresse localisée avec succès');
    } else {
      showToast('Adresse non trouvée. Essayez une adresse plus précise.');
    }
  } catch (error) {
    console.error('Erreur de géocodage:', error);
    showToast('Erreur lors de la recherche d\'adresse');
  } finally {
    btn.classList.remove('loading');
    btn.disabled = false;
  }
}

// Show location suggestions
function showLocationSuggestions(results) {
  const suggestionsList = document.getElementById('locationSuggestions');
  suggestionsList.innerHTML = '';

  results.forEach((result, index) => {
    const item = document.createElement('div');
    item.className = 'suggestion-item';
    item.textContent = result.display_name;
    item.onclick = () => {
      const lat = parseFloat(result.lat);
      const lng = parseFloat(result.lon);

      if (eventMap) {
        eventMap.setView([lat, lng], 15);
      }
      placeMarker(lat, lng);
      document.getElementById('eventLieu').value = result.display_name;
      suggestionsList.style.display = 'none';
    };
    suggestionsList.appendChild(item);
  });

  suggestionsList.style.display = 'block';
}

// Hide suggestions when clicking outside
document.addEventListener('click', function(e) {
  const suggestions = document.getElementById('locationSuggestions');
  const input = document.getElementById('eventLieu');

  if (suggestions && !suggestions.contains(e.target) && e.target !== input) {
    suggestions.style.display = 'none';
  }
});

// Update form submission to include coordinates
function updateEventFormSubmission() {
  const originalCreateEvent = window.createEvent;
  window.createEvent = async function() {
    const formData = new FormData();
    // ... existing form data collection ...

    // Add coordinates if available
    if (currentLatitude && currentLongitude) {
      formData.append('latitude', currentLatitude);
      formData.append('longitude', currentLongitude);
    }

    // Continue with original function
    return originalCreateEvent ? originalCreateEvent() : true;
  };
}

// Initialize geocoding when modal opens
function setupGeocodingForModal() {
  const modal = document.getElementById('eventModal');
  if (modal) {
    // Simple check for modal visibility changes
    let isModalOpen = false;
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
          const display = modal.style.display;
          if (display === 'flex' && !isModalOpen) {
            isModalOpen = true;
            // Modal opened, initialize map after a short delay
            setTimeout(() => {
              initEventMap();
              updateEventFormSubmission();
            }, 100);
          } else if (display === 'none' && isModalOpen) {
            isModalOpen = false;
            // Modal closed, reset coordinates
            currentLatitude = null;
            currentLongitude = null;
            updateCoordinatesDisplay();
            if (eventMap) {
              eventMap.remove();
              eventMap = null;
              eventMarker = null;
            }
          }
        }
      });
    });
    observer.observe(modal, { attributes: true, attributeFilter: ['style'] });
  }
}

// Initialize geocoding setup
if (document.readyState !== 'loading') {
  setupGeocodingForModal();
} else {
  document.addEventListener('DOMContentLoaded', setupGeocodingForModal);
}
</script>
</body>
