  // ===== EVENT CRUD =====
  function openEventModal(eventId = null) {
    resetEventForm();
    
    if (eventId) {
      const event = eventsData.find(e => e.id === eventId);
      if (event) {
        editingEventId = event.id;
        document.getElementById('eventModalTitle').textContent = 'Modifier l\'événement';
        document.getElementById('eventId').value = event.id;
        document.getElementById('eventTitre').value = event.titre;
        document.getElementById('eventDescription').value = event.description || '';
        document.getElementById('eventLieu').value = event.lieu;
        document.getElementById('eventCapacite').value = event.capacite_max;
        
        if (event.date_evenement) {
          const datePart = event.date_evenement;
          const timePart = event.heure_evenement || '09:00';
          document.getElementById('eventDate').value = `${datePart}T${timePart}`;
        }
        
        if (event.image_evenement) {
          const preview = document.getElementById('eventImagePreview');
          preview.innerHTML = `<img src="/uploads/events/${event.image_evenement}?t=${Date.now()}" alt="Aperçu" style="width:100%;height:100%;object-fit:cover;">`;
          preview.classList.remove('empty');
        }
        
        if (event.latitude && event.longitude) {
          currentLatitude = parseFloat(event.latitude);
          currentLongitude = parseFloat(event.longitude);
          updateCoordinatesDisplay();
        }
      }
    } else {
      editingEventId = null;
      document.getElementById('eventModalTitle').textContent = 'Créer un événement';
    }
    
    document.getElementById('eventModal').classList.add('active');
    setTimeout(() => initEventMap(), 100);
  }
  
  function closeEventModal() {
    document.getElementById('eventModal').classList.remove('active');
    editingEventId = null;
    resetEventForm();
    if (eventMap) {
      eventMap.remove();
      eventMap = null;
      eventMarker = null;
    }
    currentLatitude = null;
    currentLongitude = null;
    selectedImageFile = null;
    generatedImageData = null;
  }
  
  function resetEventForm() {
    document.getElementById('eventId').value = '';
    document.getElementById('eventTitre').value = '';
    document.getElementById('eventDescription').value = '';
    document.getElementById('eventLieu').value = '';
    document.getElementById('eventCapacite').value = '';
    document.getElementById('eventDate').value = '';
    document.getElementById('eventImageFile').value = '';
    
    const preview = document.getElementById('eventImagePreview');
    preview.innerHTML = '<div class="preview-icon">📷</div><div>Aperçu de l\'image</div>';
    preview.classList.add('empty');
    
    document.querySelectorAll('.error-message').forEach(el => {
      el.style.display = 'none';
      el.textContent = '';
    });
  }
  
  function previewImage(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('eventImagePreview');
        preview.innerHTML = `<img src="${e.target.result}" alt="Aperçu" style="width:100%;height:100%;object-fit:cover;">`;
        preview.classList.remove('empty');
        selectedImageFile = input.files[0];
        generatedImageData = null;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
  
  async function generateImageWithAI() {
    const titre = document.getElementById('eventTitre').value.trim();
    const description = document.getElementById('eventDescription').value.trim();
    
    if (!titre) {
      showToast('Veuillez saisir un titre pour générer une image', 'warning');
      return;
    }
    
    const btn = document.getElementById('btnGenerateImage');
    const statusDiv = document.getElementById('generationStatus');
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '⏳ Génération...';
    statusDiv.style.display = 'block';
    
    try {
      const response = await fetch('/api/admin/events/generate-image', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titre, description: description.substring(0, 200) })
      });
      
      const result = await response.json();
      
      if (result.success && result.imageData) {
        const preview = document.getElementById('eventImagePreview');
        const imgSrc = result.imageData.startsWith('data:') ? result.imageData : `data:${result.mimeType || 'image/png'};base64,${result.imageData}`;
        preview.innerHTML = `<img src="${imgSrc}" alt="Image générée" style="width:100%;height:100%;object-fit:cover;">`;
        preview.classList.remove('empty');
        generatedImageData = result.imageData;
        selectedImageFile = null;
        showToast('Image générée avec succès', 'success');
      } else {
        showToast(result.message || 'Erreur de génération', 'error');
      }
    } catch (error) {
      console.error('Erreur:', error);
      showToast('Erreur de connexion', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
      statusDiv.style.display = 'none';
    }
  }
  
  function validateEventForm() {
    let isValid = true;
    const titre = document.getElementById('eventTitre').value.trim();
    const description = document.getElementById('eventDescription').value.trim();
    const lieu = document.getElementById('eventLieu').value.trim();
    const date = document.getElementById('eventDate').value;
    const capacite = parseInt(document.getElementById('eventCapacite').value);
    
    document.querySelectorAll('.error-message').forEach(el => {
      el.style.display = 'none';
      el.textContent = '';
    });
    
    if (!titre || titre.length < 3) {
      showFieldError('titre', 'Le titre doit contenir au moins 3 caractères');
      isValid = false;
    }
    if (!description || description.length < 10) {
      showFieldError('description', 'La description doit contenir au moins 10 caractères');
      isValid = false;
    }
    if (!lieu) {
      showFieldError('lieu', 'Le lieu est requis');
      isValid = false;
    }
    if (!date) {
      showFieldError('date', 'La date est requise');
      isValid = false;
    }
    if (!capacite || capacite <= 0) {
      showFieldError('capacite', 'La capacité doit être supérieure à 0');
      isValid = false;
    } else if (capacite > 10000) {
      showFieldError('capacite', 'La capacité ne peut pas dépasser 10000');
      isValid = false;
    }
    
    return isValid;
  }
  
  function showFieldError(field, message) {
    const errorEl = document.getElementById(`error-${field}`);
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.style.display = 'block';
    }
  }
  
  async function saveEvent() {
    if (!validateEventForm()) return;
    
    const formData = new FormData();
    const eventId = document.getElementById('eventId').value;
    
    formData.append('titre', document.getElementById('eventTitre').value.trim());
    formData.append('description', document.getElementById('eventDescription').value.trim());
    formData.append('lieu', document.getElementById('eventLieu').value.trim());
    formData.append('capacite_max', document.getElementById('eventCapacite').value);
    
    const dateValue = document.getElementById('eventDate').value;
    formData.append('date_evenement', dateValue);
    
    if (dateValue) {
      const timePart = dateValue.split('T')[1] || '09:00';
      formData.append('heure_evenement', timePart);
    }
    
    if (currentLatitude && currentLongitude) {
      formData.append('latitude', currentLatitude);
      formData.append('longitude', currentLongitude);
    }
    
    if (selectedImageFile) {
      formData.append('image_evenement', selectedImageFile);
    } else if (generatedImageData) {
      formData.append('generatedImage', generatedImageData);
    }
    
    const url = eventId ? `/api/organisateur/events/${eventId}` : '/api/organisateur/events';
    const method = 'POST';
    
    const submitBtn = document.querySelector('#eventModal .btn-g');
    const originalHtml = submitBtn ? submitBtn.innerHTML : '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '⏳ Enregistrement...';
    }
    
    try {
      const response = await fetch(url, {
        method: method,
        credentials: 'include',
        headers: { 'Accept': 'application/json' },
        body: formData
      });
      
      const result = await response.json();
      
      if (result.success) {
        showToast(result.message, 'success');
        closeEventModal();
        await loadOrganisateurEvents();
      } else {
        if (result.errors) {
          Object.keys(result.errors).forEach(field => showFieldError(field, result.errors[field]));
        } else {
          showToast(result.message || 'Erreur lors de la sauvegarde', 'error');
        }
      }
    } catch (error) {
      console.error('Erreur:', error);
      showToast('Erreur de connexion', 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalHtml;
      }
    }
  }
  
  function editEvent(eventId) {
    openEventModal(eventId);
  }
  
  function openDeleteModal(eventId, eventTitle) {
    window.eventToDelete = eventId;
    document.getElementById('deleteEventTitle').textContent = eventTitle;
    document.getElementById('deleteModal').classList.add('active');
  }
  
  function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('active');
    window.eventToDelete = null;
  }
  
  async function confirmDeleteEvent() {
    if (!window.eventToDelete) return;
    
    try {
      const response = await fetch(`/api/organisateur/events/${window.eventToDelete}`, {
        method: 'DELETE',
        credentials: 'include'
      });
      
      if (response.ok) {
        showToast('Événement supprimé avec succès', 'success');
        closeDeleteModal();
        await loadOrganisateurEvents();
      } else {
        const result = await response.json();
        showToast(result.message || 'Erreur lors de la suppression', 'error');
      }
    } catch (error) {
      console.error('Erreur:', error);
      showToast('Erreur de connexion', 'error');
    }
  }

  // ===== MAP FUNCTIONS =====
  function initEventMap() {
    if (eventMap) {
      eventMap.remove();
    }
    const mapContainer = document.getElementById('eventMap');
    if (!mapContainer) return;
    
    const defaultLat = currentLatitude || 36.8065;
    const defaultLng = currentLongitude || 10.1815;
    
    eventMap = L.map('eventMap').setView([defaultLat, defaultLng], currentLatitude ? 13 : 7);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(eventMap);
    
    eventMap.on('click', function(e) {
      placeMarker(e.latlng.lat, e.latlng.lng);
    });
    
    if (currentLatitude && currentLongitude) {
      placeMarker(currentLatitude, currentLongitude);
    }
    
    mapContainer.style.display = 'block';
    setTimeout(() => eventMap.invalidateSize(), 100);
  }
  
  function placeMarker(lat, lng) {
    if (eventMarker) {
      eventMap.removeLayer(eventMarker);
    }
    eventMarker = L.marker([lat, lng]).addTo(eventMap);
    currentLatitude = lat;
    currentLongitude = lng;
    updateCoordinatesDisplay();
    reverseGeocode(lat, lng);
  }
  
  function updateCoordinatesDisplay() {
    const display = document.getElementById('coordinatesDisplay');
    const span = document.getElementById('latLngDisplay');
    if (currentLatitude && currentLongitude) {
      span.textContent = `${currentLatitude.toFixed(6)}, ${currentLongitude.toFixed(6)}`;
      display.style.display = 'block';
    } else {
      span.textContent = 'Non définies';
      display.style.display = 'none';
    }
  }
  
  async function reverseGeocode(lat, lng) {
    const addressInput = document.getElementById('eventLieu');
    if (addressInput.value.trim()) return;
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
      const data = await response.json();
      if (data && data.display_name) {
        addressInput.value = data.display_name;
      }
    } catch (error) {
      console.error('Erreur reverse geocode:', error);
    }
  }
  
  async function geocodeLocation() {
    const address = document.getElementById('eventLieu').value.trim();
    if (!address) {
      showToast('Veuillez saisir une adresse', 'warning');
      return;
    }
    
    const btn = document.getElementById('btnGeocode');
    btn.classList.add('loading');
    btn.disabled = true;
    
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=5`);
      const results = await response.json();
      
      if (results && results.length > 0) {
        const result = results[0];
        const lat = parseFloat(result.lat);
        const lng = parseFloat(result.lon);
        
        if (!eventMap) initEventMap();
        eventMap.setView([lat, lng], 15);
        placeMarker(lat, lng);
        showToast('Adresse localisée', 'success');
      } else {
        showToast('Adresse non trouvée', 'warning');
      }
    } catch (error) {
      console.error('Erreur geocode:', error);
      showToast('Erreur de géocodage', 'error');
    } finally {
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  }

  // ===== PARTICIPANTS =====
  async function updateParticipantsList() {
    const container = document.getElementById('participantsContainer');
    if (!container) return;
    
    const searchTerm = document.getElementById('participantSearch')?.value.toLowerCase() || '';
    const eventFilter = document.getElementById('participantEventFilter')?.value || '';
    
    // Update filter dropdown
    const filterSelect = document.getElementById('participantEventFilter');
    if (filterSelect && filterSelect.options.length <= 1 && eventsData.length > 0) {
      filterSelect.innerHTML = '<option value="">Tous les événements</option>';
      eventsData.forEach(e => {
        const option = document.createElement('option');
        option.value = e.id;
        option.textContent = e.titre;
        filterSelect.appendChild(option);
      });
    }

    let allParticipants = [];
    
    for (const event of eventsData) {
      if (eventFilter && event.id.toString() !== eventFilter) continue;
      
      try {
        const response = await fetch(`/api/admin/events/${event.id}`, {
          credentials: 'include',
          headers: { 'Accept': 'application/json' }
        });
        const data = await response.json();
        if (data.success && data.participants && data.participants.length) {
          data.participants.forEach(p => {
            allParticipants.push({ ...p, eventTitle: event.titre, eventId: event.id, eventDate: event.date_evenement });
          });
        }
      } catch (error) {
        console.error('Erreur chargement participants pour event', event.id, error);
      }
    }
    
    if (searchTerm) {
      allParticipants = allParticipants.filter(p => 
        (p.nom && p.nom.toLowerCase().includes(searchTerm)) ||
        (p.prenom && p.prenom.toLowerCase().includes(searchTerm)) ||
        (p.email && p.email.toLowerCase().includes(searchTerm)) ||
        (p.contact && p.contact.toLowerCase().includes(searchTerm))
      );
    }
    
    if (allParticipants.length === 0) {
      container.innerHTML = `
        <table class="participants-table">
          <thead>
            <tr><th>Participant</th><th>Contact</th><th>Âge</th><th>Événement</th><th>Date événement</th><th>Inscription</th><th>Statut</th></tr>
          </thead>
          <tbody>
            <tr><td colspan="7" style="text-align:center; padding:40px; color:var(--muted);">Aucun participant trouvé pour cette sélection</td></tr>
          </tbody>
        </table>
      `;
      return;
    }
    
    container.innerHTML = `
      <table class="participants-table">
        <thead>
          <tr><th>Participant</th><th>Contact</th><th>Âge</th><th>Événement</th><th>Date événement</th><th>Inscription</th><th>Statut</th></tr>
        </thead>
        <tbody>
          ${allParticipants.map(p => `
            <tr>
              <td><strong>${escapeHtml(p.prenom || '')} ${escapeHtml(p.nom || '')}</strong><br><small style="color:var(--muted)">${escapeHtml(p.email || '')}</small></td>
              <td>${escapeHtml(p.contact || '-')}</td>
              <td>${p.age || '-'}</td>
              <td><a class="event-link" onclick="viewEventDetail(${p.eventId})">${escapeHtml(p.eventTitle)}</a></td>
              <td>${formatDate(p.eventDate, true)}</td>
              <td>${formatDate(p.date_inscription, true)}</td>
              <td><span class="sbadge s-active">Inscrit</span></td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  }
  
  function exportParticipantsCSV() {
    let allParticipants = [];
    const fetchPromises = eventsData.map(async event => {
      try {
        const response = await fetch(`/api/admin/events/${event.id}`, {
          credentials: 'include'
        });
        const data = await response.json();
        if (data.success && data.participants && data.participants.length) {
          data.participants.forEach(p => {
            allParticipants.push({ ...p, eventTitle: event.titre, eventDate: event.date_evenement });
          });
        }
      } catch (error) {
        console.error('Erreur:', error);
      }
    });
    
    Promise.all(fetchPromises).then(() => {
      if (allParticipants.length === 0) {
        showToast('Aucun participant à exporter', 'warning');
        return;
      }
      
      const headers = ['Nom', 'Prénom', 'Email', 'Contact', 'Âge', 'Événement', 'Date événement', "Date d'inscription"];
      const rows = allParticipants.map(p => [
        p.nom || '', p.prenom || '', p.email || '', p.contact || '', p.age || '', p.eventTitle, formatDate(p.eventDate, true), formatDate(p.date_inscription, true)
      ]);
      
      const csvContent = [headers, ...rows].map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `participants_${new Date().toISOString().split('T')[0]}.csv`;
      link.click();
      URL.revokeObjectURL(link.href);
      showToast('Export CSV réussi', 'success');
    });
  }

  // ===== PROFILE =====
  function saveProfile() {
    showToast('Fonctionnalité à venir dans la prochaine version', 'warning');
  }

  // ===== COLLECTIONS =====
  async function loadCollections() {
    const container = document.getElementById('collectionsContainer');
    if (!container) return;
    container.innerHTML = `<div class="blk"><div style="text-align:center; padding:40px; color:var(--muted);">⏳ Chargement des collections...</div></div>`;
    try {
      const response = await fetch('/api/organisateur/collections', {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      if (response.ok) {
        const data = await response.json();
        if (data.success && data.collections && data.collections.length) {
          container.innerHTML = `
            <div class="form-row">
              ${data.collections.map(c => `
                <div class="blk">
                  <div class="blk-title">${escapeHtml(c.title)} — ${escapeHtml(c.materialType)}</div>
                  <div class="progress-bar" style="height:8px; margin:12px 0"><div class="progress-fill" style="width:${c.progress || 0}%"></div></div>
                  <div class="progress-stats"><span>${c.currentAmount || 0} ${c.unit} collectés</span><span>Objectif: ${c.goalAmount} ${c.unit}</span></div>
                  <div style="margin-top:12px; font-size:.75rem; color:var(--muted);">${c.donations_count || 0} donations · Statut: ${c.status === 'active' ? 'Actif' : 'Fermé'}</div>
                  <button class="btn btn-ghost btn-sm" style="margin-top:12px; width:100%;" onclick="showToast('Partager le lien')">📋 Partager le lien de collecte</button>
                </div>
              `).join('')}
            </div>
          `;
        } else {
          container.innerHTML = `<div class="blk"><div style="text-align:center; padding:40px; color:var(--muted);">Aucune collection créée</div></div>`;
        }
      }
    } catch (error) {
      console.error('Erreur collections:', error);
      container.innerHTML = `<div class="blk"><div style="text-align:center; padding:40px; color:var(--muted);">Erreur de chargement</div></div>`;
    }
  }

  // ===== NAVIGATION =====
  function showPage(pageName, navElement) {
    document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
    document.getElementById(`page-${pageName}`).style.display = 'block';
    document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
    if (navElement) navElement.classList.add('active');
    
    if (pageName === 'evenements') {
      loadOrganisateurEvents();
    } else if (pageName === 'participants') {
      updateParticipantsList();
      const searchInput = document.getElementById('participantSearch');
      if (searchInput) {
        searchInput.oninput = () => updateParticipantsList();
      }
    } else if (pageName === 'collections') {
      loadCollections();
    } else if (pageName === 'dashboard') {
      loadOrganisateurEvents();
    }
  }

  // ===== INITIALISATION =====
  document.addEventListener('DOMContentLoaded', async () => {
    await loadCurrentUser();
    await loadOrganisateurEvents();
    
    const searchInput = document.getElementById('participantSearch');
    if (searchInput) searchInput.oninput = () => updateParticipantsList();
  });
</script>
</body>
