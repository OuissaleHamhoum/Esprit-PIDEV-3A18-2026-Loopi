        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Capacité max *</label>
            <input type="number" id="eventCapacite" placeholder="Nombre de places" min="1" max="10000" required>
            <div class="error-message" id="error-capacite"></div>
          </div>
          <div class="form-group">
            <label>Lieu *</label>
            <div class="location-container">
              <div class="location-input-container">
                <input type="text" id="eventLieu" placeholder="Adresse complète" required>
                <button type="button" class="geocode-btn" id="btnGeocode" onclick="geocodeLocation()">📍 Localiser</button>
              </div>
              <div class="map-container" id="eventMap" style="display:none;"></div>
              <div class="coordinates-display" id="coordinatesDisplay">📍 Coordonnées: <span id="latLngDisplay">Non définies</span></div>
            </div>
