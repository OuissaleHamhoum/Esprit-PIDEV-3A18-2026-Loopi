<!-- ═══ MODAL SUPPRESSION COLLECTION ═══ -->
<div class="modal-overlay" id="confirmDeleteCollModal" onclick="if(event.target===this)closeDeleteCollModal()">
  <div class="modal" style="width:380px;text-align:center">
    <div class="modal-body" style="padding-top:28px">
      <div style="font-size:2.5rem;margin-bottom:12px">🗑️</div>
      <div style="font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:white;margin-bottom:8px">Supprimer la collection ?</div>
      <div style="font-size:.82rem;color:var(--muted);margin-bottom:22px">Cette action est irréversible. Tous les dons associés seront supprimés.</div>
      <div style="display:flex;gap:10px;justify-content:center">
        <button class="btn btn-ghost" onclick="closeDeleteCollModal()">Annuler</button>
        <button class="btn btn-danger" id="confirmDeleteCollBtn" onclick="confirmDeleteColl()">Supprimer</button>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
// ═══════════════════════════════════════════════════════
// VARIABLES GLOBALES
// ═══════════════════════════════════════════════════════
let eventsData = [];
let editingEventId = null;
let selectedImageFile = null;
let generatedImageData = null;
let eventMap = null;
let eventMarker = null;
let currentLatitude = null;
let currentLongitude = null;
let currentCalendarDate = new Date();
let _allCollections = [];
let _deleteCollId = null;

// ═══════════════════════════════════════════════════════
// UTILITAIRES
// ═══════════════════════════════════════════════════════
function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  toast.textContent = message;
  toast.className = 'toast ' + type;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function escHtml(s) { return escapeHtml(s); }

function formatDate(dateString, withTime = false) {
  if (!dateString) return '-';
  const date = new Date(dateString);
  if (withTime) return date.toLocaleDateString('fr-FR') + ' ' + date.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  return date.toLocaleDateString('fr-FR');
}

function getStatusBadge(status) {
  const statusMap = {
    'valide':    { class: 's-active',   text: 'Validé' },
    'approuve':  { class: 's-active',   text: 'Validé' },
    'en_attente':{ class: 's-pending',  text: 'En attente' },
    'rejete':    { class: 's-rejected', text: 'Rejeté' }
  };
  const s = statusMap[status] || statusMap['en_attente'];
  return `<span class="sbadge ${s.class}">${s.text}</span>`;
}

// ═══════════════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════════════
function showPage(pageName, navElement) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + pageName).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navElement) navElement.classList.add('active');

  if (pageName === 'evenements') {
    loadOrganisateurEvents();
  } else if (pageName === 'participants') {
    updateParticipantsList();
  } else if (pageName === 'collections') {
    loadCollections();
  } else if (pageName === 'dashboard') {
    loadOrganisateurEvents();
  }
}

// ═══════════════════════════════════════════════════════
// CHARGEMENT UTILISATEUR
// ═══════════════════════════════════════════════════════
async function loadCurrentUser() {
  try {
    const response = await fetch('/api/health', { credentials: 'include', headers: { 'Accept': 'application/json' } });
    const data = await response.json();
    if (data.user && data.user !== 'anonymous') {
      const name = data.user.split('@')[0];
      document.getElementById('userName').textContent = name || 'Organisateur';
      document.getElementById('userEmail').textContent = data.user;
      document.getElementById('userAvatar').textContent = (name?.charAt(0) || 'O').toUpperCase();
      document.getElementById('dashboardWelcome').innerHTML = `Bonjour, ${name || 'Organisateur'} 🌿`;
      const emailEl = document.getElementById('profileEmail');
      if (emailEl) emailEl.value = data.user;
    }
  } catch (error) {
    console.error('Erreur chargement user:', error);
  }
}

// ═══════════════════════════════════════════════════════
// CHARGEMENT ÉVÉNEMENTS
// ═══════════════════════════════════════════════════════
async function loadOrganisateurEvents() {
  try {
    const response = await fetch('/api/organisateur/events', {
      credentials: 'include',
      headers: { 'Accept': 'application/json' }
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    if (data.success && data.events) {
      eventsData = data.events;
      renderEventsGrid();
      updateDashboardStats();
      updateDashboardCharts();
      updateParticipantsList();
      renderDashboardEventsList();
    }
    return eventsData;
  } catch (error) {
    console.error('Erreur chargement événements:', error);
    showToast('Erreur lors du chargement des événements', 'error');
    return [];
  }
}

// ═══════════════════════════════════════════════════════
// DASHBOARD — STATS
// ═══════════════════════════════════════════════════════
function filterDataByPeriod(data, period) {
  if (period === 'all') return data;
  const now = new Date();
  return data.filter(e => {
    if (!e.date_evenement) return true;
    const d = new Date(e.date_evenement);
    if (period === 'month') return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
    if (period === 'year')  return d.getFullYear() === now.getFullYear();
    return true;
  });
}

function updateStat(statType, period) {
  const filtered = filterDataByPeriod(eventsData, period);
  if (statType === 'TotalEvents')       document.getElementById('statTotalEvents').textContent = filtered.length;
  else if (statType === 'TotalParticipants') document.getElementById('statTotalParticipants').textContent = filtered.reduce((s, e) => s + (e.participants_count || 0), 0);
  else if (statType === 'ValidatedEvents') {
    const v = filtered.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
    document.getElementById('statValidatedEvents').textContent = v;
  } else if (statType === 'PendingEvents') {
    document.getElementById('statPendingEvents').textContent = filtered.filter(e => e.statut_validation === 'en_attente').length;
  }
}

function updateDashboardStats() {
  updateStat('TotalEvents',        document.getElementById('filterTotalEvents')?.value || 'all');
  updateStat('TotalParticipants',  document.getElementById('filterTotalParticipants')?.value || 'all');
  updateStat('ValidatedEvents',    document.getElementById('filterValidatedEvents')?.value || 'all');
  updateStat('PendingEvents',      document.getElementById('filterPendingEvents')?.value || 'all');

  const total = document.getElementById('eventsStatTotal');
  if (total) total.textContent = eventsData.length;
  const active = document.getElementById('eventsStatActive');
  if (active) active.textContent = eventsData.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
  const pending = document.getElementById('eventsStatPending');
  if (pending) pending.textContent = eventsData.filter(e => e.statut_validation === 'en_attente').length;
  const participants = document.getElementById('eventsStatParticipants');
  if (participants) participants.textContent = eventsData.reduce((s, e) => s + (e.participants_count || 0), 0);

  const pEl = document.getElementById('profileStatsEvents');
  if (pEl) pEl.textContent = eventsData.length;
  const pPEl = document.getElementById('profileStatsParticipants');
  if (pPEl) pPEl.textContent = eventsData.reduce((s, e) => s + (e.participants_count || 0), 0);
}

function renderDashboardEventsList() {
  const container = document.getElementById('dashEventsList');
  if (!container) return;
  const recent = eventsData.slice(0, 4);
  if (!recent.length) {
    container.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Aucun événement</div>';
    return;
  }
  container.innerHTML = `<table class="tbl">
    <thead><tr><th>Événement</th><th>Date</th><th>Participants</th><th>Statut</th></tr></thead>
    <tbody>
    ${recent.map(e => `<tr>
      <td style="color:white;font-weight:600">${escHtml(e.titre)}</td>
      <td style="color:var(--muted);font-size:.75rem">${formatDate(e.date_evenement)}</td>
      <td><span style="color:var(--accent);font-weight:700">${e.participants_count || 0}</span><span style="color:var(--muted);font-size:.7rem"> / ${e.capacite_max}</span></td>
      <td>${getStatusBadge(e.statut_validation)}</td>
    </tr>`).join('')}
    </tbody>
  </table>`;
}

// ═══════════════════════════════════════════════════════
// DASHBOARD — GRAPHIQUES
// ═══════════════════════════════════════════════════════
function updateDashboardCharts() {
  updateChart('Popularity', document.getElementById('filterPopularity')?.value || 'all');
  updateChart('Status',     document.getElementById('filterStatus')?.value || 'all');
  updateChart('FullCalendar', 'all');
}

function changeCalendarMonth(offset) {
  currentCalendarDate.setMonth(currentCalendarDate.getMonth() + offset);
  updateChart('FullCalendar', 'all');
}

function updateChart(chartType, period) {
  const filtered = filterDataByPeriod(eventsData, period);

  if (chartType === 'Popularity') {
    const monthlyData = {};
    filtered.forEach(event => {
      if (event.date_evenement) {
        const month = new Date(event.date_evenement).toLocaleString('fr-FR', { month: 'short' });
        monthlyData[month] = (monthlyData[month] || 0) + (event.participants_count || 0);
      }
    });
    const months = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];
    const maxValue = Math.max(...Object.values(monthlyData), 1);
    const chartContainer = document.getElementById('popularityChart');
    if (chartContainer) {
      chartContainer.innerHTML = months.map(month => {
        const value = monthlyData[month] || 0;
        const height = (value / maxValue) * 150;
        return `<div class="bar-item"><div class="bar-value">${value}</div><div class="bar" style="height:${height}px;"></div><div class="bar-label">${month}</div></div>`;
      }).join('');
    }
  } else if (chartType === 'Status') {
    const validated = filtered.filter(e => e.statut_validation === 'valide' || e.statut_validation === 'approuve').length;
    const pending   = filtered.filter(e => e.statut_validation === 'en_attente').length;
    const rejected  = filtered.filter(e => e.statut_validation === 'rejete').length;
    const total = validated + pending + rejected;
    const donutContainer = document.getElementById('statusDonut');
    if (donutContainer) {
      if (total > 0) {
        const vP = (validated / total) * 100;
        const pP = (pending / total) * 100;
        const rP = (rejected / total) * 100;
        donutContainer.innerHTML = `
          <div class="donut" style="background:conic-gradient(var(--accent) 0% ${vP}%, var(--sand) ${vP}% ${vP + pP}%, var(--danger) ${vP + pP}% 100%)">
            <div class="donut-inner">${total}</div>
          </div>
          <div class="donut-labels">
            <div class="donut-label-item"><div class="donut-color" style="background:var(--accent)"></div><span class="donut-text">Validés</span><span class="donut-percent">${vP.toFixed(0)}%</span></div>
            <div class="donut-label-item"><div class="donut-color" style="background:var(--sand)"></div><span class="donut-text">En attente</span><span class="donut-percent">${pP.toFixed(0)}%</span></div>
            <div class="donut-label-item"><div class="donut-color" style="background:var(--danger)"></div><span class="donut-text">Rejetés</span><span class="donut-percent">${rP.toFixed(0)}%</span></div>
          </div>`;
      } else {
        donutContainer.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Aucune donnée</div>';
      }
    }
  } else if (chartType === 'FullCalendar') {
    const year = currentCalendarDate.getFullYear();
    const month = currentCalendarDate.getMonth();
    const monthLabel = document.getElementById('calendarMonthLabel');
    if (monthLabel) monthLabel.textContent = currentCalendarDate.toLocaleString('fr-FR', { month: 'long', year: 'numeric' });
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const daysInMonth = lastDay.getDate();
    let startingDay = firstDay.getDay() - 1;
    if (startingDay === -1) startingDay = 6;
    const daysOfWeek = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
    let html = daysOfWeek.map(d => `<div style="font-size:.8rem;font-weight:700;color:var(--muted);padding:10px 0;border-bottom:1px solid var(--border);">${d}</div>`).join('');
    for (let i = 0; i < startingDay; i++) html += `<div style="background:rgba(255,255,255,0.01);border:1px solid rgba(255,255,255,0.03);border-radius:8px;"></div>`;
    for (let i = 1; i <= daysInMonth; i++) {
      const loopDate = new Date(year, month, i, 12, 0, 0);
      const yStr = loopDate.getFullYear();
      const mStr = String(loopDate.getMonth() + 1).padStart(2, '0');
      const dStr = String(loopDate.getDate()).padStart(2, '0');
      const currentDateStr = `${yStr}-${mStr}-${dStr}`;
      const eventsOnDay = eventsData.filter(e => e.date_evenement && e.date_evenement.startsWith(currentDateStr));
      const isToday = new Date().toISOString().split('T')[0] === currentDateStr;
      html += `<div style="min-height:80px;padding:6px;border:1px solid var(--border);border-radius:8px;background:rgba(255,255,255,0.02);display:flex;flex-direction:column;align-items:flex-start;">
        <span style="font-size:.85rem;font-weight:600;align-self:flex-end;margin-bottom:4px;${isToday ? 'background:var(--accent);color:#fff;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;' : 'color:var(--text);'}">${i}</span>
        <div style="display:flex;flex-direction:column;gap:4px;width:100%;">
          ${eventsOnDay.map(e => `<div style="font-size:.65rem;background:${e.statut_validation === 'valide' ? 'var(--accent)' : 'var(--card2)'};color:white;padding:3px 6px;border-radius:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;font-weight:500;" onclick="viewEventDetail(${e.id})" title="${escHtml(e.titre)}">${escHtml(e.titre)}</div>`).join('')}
        </div>
      </div>`;
    }
    const calContainer = document.getElementById('fullCalendarGrid');
    if (calContainer) calContainer.innerHTML = html;
  }
}

// ═══════════════════════════════════════════════════════
// RENDER EVENTS GRID
// ═══════════════════════════════════════════════════════
function renderEventsGrid() {
  const container = document.getElementById('eventsContainer');
  const emptyState = document.getElementById('eventsEmpty');
  if (!eventsData || eventsData.length === 0) {
    if (emptyState) emptyState.style.display = 'block';
    if (container) container.innerHTML = '';
    return;
  }
  const searchTerm    = document.getElementById('eventSearch')?.value.toLowerCase() || '';
  const statusFilter  = document.getElementById('eventStatusFilter')?.value || '';
  const periodFilter  = document.getElementById('eventPeriodFilter')?.value || '';
  const now = new Date();
  let filteredEvents = eventsData.filter(event => {
    if (searchTerm) {
      const title = (event.titre || '').toLowerCase();
      const location = (event.lieu || '').toLowerCase();
      if (!title.includes(searchTerm) && !location.includes(searchTerm)) return false;
    }
    if (statusFilter) {
      const status = event.statut_validation || 'en_attente';
      if (statusFilter === 'valide'     && status !== 'valide' && status !== 'approuve') return false;
      if (statusFilter === 'en_attente' && status !== 'en_attente') return false;
      if (statusFilter === 'rejete'     && status !== 'rejete') return false;
    }
    if (periodFilter && event.date_evenement) {
      const eventDate = new Date(event.date_evenement);
      if (periodFilter === 'upcoming' && eventDate < now) return false;
      if (periodFilter === 'past' && eventDate >= now) return false;
    }
    return true;
  });

  if (filteredEvents.length === 0) {
    if (emptyState) emptyState.style.display = 'none';
    if (container) {
      container.style.display = 'block';
      container.innerHTML = `<div style="text-align:center;padding:40px;color:var(--muted);grid-column:1/-1;">Aucun événement ne correspond à vos critères.</div>`;
    }
    return;
  }
  if (emptyState) emptyState.style.display = 'none';
  if (container) container.style.display = 'grid';

  container.innerHTML = filteredEvents.map(event => {
    const eventDate = event.date_evenement ? new Date(event.date_evenement) : new Date();
    const day = eventDate.getDate();
    const month = ['Jan','Fév','Mar','Avr','Mai','Juin','Juil','Aoû','Sep','Oct','Nov','Déc'][eventDate.getMonth()];
    const participantsCount = event.participants_count || 0;
    const capacityFill = event.capacite_max > 0 ? (participantsCount / event.capacite_max) * 100 : 0;
    const imageUrl = event.image_evenement ? `/uploads/events/${event.image_evenement}` : null;
    return `
      <div class="event-card" onclick="viewEventDetail(${event.id})">
        <div class="event-image">
          ${imageUrl ? `<img src="${imageUrl}?t=${Date.now()}" alt="${escHtml(event.titre)}">` : `<div class="event-image-placeholder">📅</div>`}
          <div class="event-status-badge">${getStatusBadge(event.statut_validation)}</div>
          <div class="event-date-badge"><div class="event-date-day">${day}</div><div class="event-date-month">${month}</div></div>
        </div>
        <div class="event-body">
          <div class="event-title">${escHtml(event.titre)}</div>
          <div class="event-lieu">📍 ${escHtml(event.lieu)}</div>
          <div>
            <div class="progress-bar"><div class="progress-fill" style="width:${Math.min(capacityFill, 100)}%"></div></div>
            <div class="progress-stats"><span>👥 ${participantsCount} inscrits</span><span>🎯 ${event.capacite_max} places</span></div>
          </div>
          <div class="event-actions">
            <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();viewEventDetail(${event.id})">👁️ Voir</button>
            <button class="btn btn-warning btn-sm" onclick="event.stopPropagation();editEvent(${event.id})">✏️ Modifier</button>
            <button class="btn btn-danger btn-sm" onclick="event.stopPropagation();openDeleteEventModal(${event.id},'${escHtml(event.titre).replace(/'/g,"\\'")}')">🗑️ Suppr.</button>
          </div>
        </div>
      </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════
// DETAIL ÉVÉNEMENT
// ═══════════════════════════════════════════════════════
async function viewEventDetail(eventId) {
  const event = eventsData.find(e => e.id === eventId);
  if (!event) return;
  let participants = [];
  try {
    const response = await fetch(`/api/admin/events/${eventId}`, { credentials: 'include', headers: { 'Accept': 'application/json' } });
    const data = await response.json();
    if (data.success && data.participants) participants = data.participants;
  } catch (error) { console.error('Erreur participants:', error); }

  const eventDate = new Date(event.date_evenement);
  const formattedDate = eventDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const formattedTime = event.heure_evenement || eventDate.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  const imageUrl = event.image_evenement ? `/uploads/events/${event.image_evenement}` : null;

  document.getElementById('detailModalBody').innerHTML = `
    <div class="detail-grid">
      <div class="detail-section">
        <h4>📋 Informations générales</h4>
        <div class="detail-info"><span class="detail-info-label">Titre:</span><span class="detail-info-value">${escHtml(event.titre)}</span></div>
        <div class="detail-info"><span class="detail-info-label">Statut:</span><span class="detail-info-value">${getStatusBadge(event.statut_validation)}</span></div>
        <div class="detail-info"><span class="detail-info-label">Date:</span><span class="detail-info-value">${formattedDate}</span></div>
        <div class="detail-info"><span class="detail-info-label">Heure:</span><span class="detail-info-value">${formattedTime}</span></div>
        <div class="detail-info"><span class="detail-info-label">Lieu:</span><span class="detail-info-value">${escHtml(event.lieu)}</span></div>
        <div class="detail-info"><span class="detail-info-label">Capacité:</span><span class="detail-info-value">${event.capacite_max} places</span></div>
        <div class="detail-info"><span class="detail-info-label">Inscrits:</span><span class="detail-info-value">${event.participants_count || 0}</span></div>
        ${event.latitude && event.longitude ? `<div class="detail-info"><span class="detail-info-label">Coordonnées:</span><span class="detail-info-value">${event.latitude}, ${event.longitude}</span></div>` : ''}
      </div>
      <div class="detail-section">
        <h4>🖼️ Image</h4>
        ${imageUrl ? `<img src="${imageUrl}?t=${Date.now()}" alt="${escHtml(event.titre)}" style="width:100%;border-radius:8px;max-height:150px;object-fit:cover;">` : '<div style="text-align:center;padding:20px;color:var(--muted);">📷 Pas d\'image</div>'}
      </div>
    </div>
    <div class="detail-section">
      <h4>📝 Description</h4>
      <p style="font-size:.85rem;line-height:1.5;">${escHtml(event.description || 'Aucune description').replace(/\n/g,'<br>')}</p>
    </div>
    <div class="detail-section">
      <h4>👥 Participants (${participants.length})</h4>
      <div class="participants-list">
        ${participants.length === 0 
          ? '<div style="text-align:center;padding:20px;color:var(--muted);">Aucun participant inscrit</div>'
          : participants.map(p => `
            <div class="participant-item">
              <div><div class="participant-name">${escHtml(p.prenom || '')} ${escHtml(p.nom || '')}</div><div class="participant-email">${escHtml(p.email || '')}</div></div>
              <div><div>${p.contact ? `📞 ${escHtml(p.contact)}` : ''}</div><div>${p.age ? `🎂 ${p.age} ans` : ''}</div></div>
              <div><span class="sbadge s-active">Inscrit</span></div>
            </div>`).join('')}
      </div>
    </div>`;

  window.currentDetailEventId = event.id;
  document.getElementById('detailModal').classList.add('active');
}

function closeDetailModal() {
  document.getElementById('detailModal').classList.remove('active');
  window.currentDetailEventId = null;
}

function editFromDetail() {
  if (window.currentDetailEventId) { closeDetailModal(); editEvent(window.currentDetailEventId); }
}

// ═══════════════════════════════════════════════════════
// CRUD ÉVÉNEMENTS
// ═══════════════════════════════════════════════════════
function openEventModal(eventId = null) {
  resetEventForm();
  if (eventId) {
    const event = eventsData.find(e => e.id === eventId);
    if (event) {
      editingEventId = event.id;
      document.getElementById('eventModalTitle').textContent = 'Modifier l\'événement';
      document.getElementById('eventId').value = event.id;
      document.getElementById('eventTitre').value = event.titre;
      document.getElementById('eventDescription').value = event.description || '';
      document.getElementById('eventLieu').value = event.lieu;
      document.getElementById('eventCapacite').value = event.capacite_max;
      if (event.date_evenement) {
        document.getElementById('eventDate').value = `${event.date_evenement}T${event.heure_evenement || '09:00'}`;
      }
      if (event.image_evenement) {
        const preview = document.getElementById('eventImagePreview');
        preview.innerHTML = `<img src="/uploads/events/${event.image_evenement}?t=${Date.now()}" alt="Aperçu" style="width:100%;height:100%;object-fit:cover;">`;
        preview.classList.remove('empty');
      }
      if (event.latitude && event.longitude) {
        currentLatitude = parseFloat(event.latitude);
        currentLongitude = parseFloat(event.longitude);
        updateCoordinatesDisplay();
      }
    }
  } else {
    editingEventId = null;
    document.getElementById('eventModalTitle').textContent = 'Créer un événement';
  }
  document.getElementById('eventModal').classList.add('active');
  setTimeout(() => initEventMap(), 100);
}

function closeEventModal() {
  document.getElementById('eventModal').classList.remove('active');
  editingEventId = null;
  resetEventForm();
  if (eventMap) { eventMap.remove(); eventMap = null; eventMarker = null; }
  currentLatitude = null; currentLongitude = null;
  selectedImageFile = null; generatedImageData = null;
}

function resetEventForm() {
  ['eventId','eventTitre','eventDescription','eventLieu','eventCapacite','eventDate'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });
  const fi = document.getElementById('eventImageFile');
  if (fi) fi.value = '';
  const preview = document.getElementById('eventImagePreview');
  if (preview) {
    preview.innerHTML = '<div class="preview-icon">📷</div><div>Aperçu de l\'image</div>';
    preview.classList.add('empty');
  }
  document.querySelectorAll('.error-message').forEach(el => { el.style.display = 'none'; el.textContent = ''; });
}

function editEvent(eventId) { openEventModal(eventId); }

function openDeleteEventModal(eventId, eventTitle) {
  window.eventToDelete = eventId;
  document.getElementById('deleteEventTitle').textContent = eventTitle;
  document.getElementById('deleteModal').classList.add('active');
}

function closeDeleteEventModal() {
  document.getElementById('deleteModal').classList.remove('active');
  window.eventToDelete = null;
}

async function confirmDeleteEvent() {
  if (!window.eventToDelete) return;
  try {
    const response = await fetch(`/api/organisateur/events/${window.eventToDelete}`, { method: 'DELETE', credentials: 'include' });
    if (response.ok) {
      showToast('Événement supprimé avec succès', 'success');
      closeDeleteEventModal();
      await loadOrganisateurEvents();
    } else {
      const result = await response.json();
      showToast(result.message || 'Erreur lors de la suppression', 'error');
    }
  } catch (error) { showToast('Erreur de connexion', 'error'); }
}

function previewImage(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('eventImagePreview');
      preview.innerHTML = `<img src="${e.target.result}" alt="Aperçu" style="width:100%;height:100%;object-fit:cover;">`;
      preview.classList.remove('empty');
      selectedImageFile = input.files[0];
      generatedImageData = null;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

async function generateImageWithAI() {
  const titre = document.getElementById('eventTitre').value.trim();
  const description = document.getElementById('eventDescription').value.trim();
  if (!titre) { showToast('Veuillez saisir un titre pour générer une image', 'warning'); return; }
  const btn = document.getElementById('btnGenerateImage');
  const statusDiv = document.getElementById('generationStatus');
  const originalHtml = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '⏳ Génération…'; statusDiv.style.display = 'block';
  try {
    const response = await fetch('/api/admin/events/generate-image', {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ titre, description: description.substring(0, 200) })
    });
    const result = await response.json();
    if (result.success && result.imageData) {
      const preview = document.getElementById('eventImagePreview');
      const imgSrc = result.imageData.startsWith('data:') ? result.imageData : `data:${result.mimeType || 'image/png'};base64,${result.imageData}`;
      preview.innerHTML = `<img src="${imgSrc}" alt="Image générée" style="width:100%;height:100%;object-fit:cover;">`;
      preview.classList.remove('empty');
      generatedImageData = result.imageData;
      selectedImageFile = null;
      showToast('Image générée avec succès', 'success');
    } else { showToast(result.message || 'Erreur de génération', 'error'); }
  } catch { showToast('Erreur de connexion', 'error'); }
  finally { btn.disabled = false; btn.innerHTML = originalHtml; statusDiv.style.display = 'none'; }
}

function validateEventForm() {
  let isValid = true;
  document.querySelectorAll('.error-message').forEach(el => { el.style.display = 'none'; el.textContent = ''; });
  const titre = document.getElementById('eventTitre').value.trim();
  const description = document.getElementById('eventDescription').value.trim();
  const lieu = document.getElementById('eventLieu').value.trim();
  const date = document.getElementById('eventDate').value;
  const capacite = parseInt(document.getElementById('eventCapacite').value);
  if (!titre || titre.length < 3)      { showFieldError('titre', 'Le titre doit contenir au moins 3 caractères'); isValid = false; }
  if (!description || description.length < 10) { showFieldError('description', 'La description doit contenir au moins 10 caractères'); isValid = false; }
  if (!lieu)    { showFieldError('lieu', 'Le lieu est requis'); isValid = false; }
  if (!date)    { showFieldError('date', 'La date est requise'); isValid = false; }
  if (!capacite || capacite <= 0) { showFieldError('capacite', 'La capacité doit être supérieure à 0'); isValid = false; }
  else if (capacite > 10000) { showFieldError('capacite', 'La capacité ne peut pas dépasser 10000'); isValid = false; }
  return isValid;
}

function showFieldError(field, message) {
  const el = document.getElementById(`error-${field}`);
  if (el) { el.textContent = message; el.style.display = 'block'; }
}

async function saveEvent() {
  if (!validateEventForm()) return;
  const formData = new FormData();
  const eventId = document.getElementById('eventId').value;
  formData.append('titre', document.getElementById('eventTitre').value.trim());
  formData.append('description', document.getElementById('eventDescription').value.trim());
  formData.append('lieu', document.getElementById('eventLieu').value.trim());
  formData.append('capacite_max', document.getElementById('eventCapacite').value);
  const dateValue = document.getElementById('eventDate').value;
  formData.append('date_evenement', dateValue);
  if (dateValue) formData.append('heure_evenement', dateValue.split('T')[1] || '09:00');
  if (currentLatitude && currentLongitude) {
    formData.append('latitude', currentLatitude);
    formData.append('longitude', currentLongitude);
  }
  if (selectedImageFile) formData.append('image_evenement', selectedImageFile);
  else if (generatedImageData) formData.append('generatedImage', generatedImageData);

  const url = eventId ? `/api/organisateur/events/${eventId}` : '/api/organisateur/events';
  const submitBtn = document.querySelector('#eventModal .btn-g');
  const originalHtml = submitBtn ? submitBtn.innerHTML : '';
  if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '⏳ Enregistrement…'; }
  try {
    const response = await fetch(url, { method: 'POST', credentials: 'include', headers: { 'Accept': 'application/json' }, body: formData });
    const result = await response.json();
    if (result.success) {
      showToast(result.message, 'success');
      closeEventModal();
      await loadOrganisateurEvents();
    } else {
      if (result.errors) Object.keys(result.errors).forEach(f => showFieldError(f, result.errors[f]));
      else showToast(result.message || 'Erreur lors de la sauvegarde', 'error');
    }
  } catch { showToast('Erreur de connexion', 'error'); }
  finally { if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalHtml; } }
}

// ═══════════════════════════════════════════════════════
// MAP LEAFLET
// ═══════════════════════════════════════════════════════
function initEventMap() {
  if (eventMap) { eventMap.remove(); }
  const mapContainer = document.getElementById('eventMap');
  if (!mapContainer) return;
  const defaultLat = currentLatitude || 36.8065;
  const defaultLng = currentLongitude || 10.1815;
  eventMap = L.map('eventMap').setView([defaultLat, defaultLng], currentLatitude ? 13 : 7);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors', maxZoom: 19
  }).addTo(eventMap);
  eventMap.on('click', function(e) { placeMarker(e.latlng.lat, e.latlng.lng); });
  if (currentLatitude && currentLongitude) placeMarker(currentLatitude, currentLongitude);
  mapContainer.style.display = 'block';
  setTimeout(() => eventMap.invalidateSize(), 100);
}

function placeMarker(lat, lng) {
  if (eventMarker) eventMap.removeLayer(eventMarker);
  eventMarker = L.marker([lat, lng]).addTo(eventMap);
  currentLatitude = lat; currentLongitude = lng;
  updateCoordinatesDisplay();
  reverseGeocode(lat, lng);
}

function updateCoordinatesDisplay() {
  const display = document.getElementById('coordinatesDisplay');
  const span = document.getElementById('latLngDisplay');
  if (currentLatitude && currentLongitude) {
    span.textContent = `${currentLatitude.toFixed(6)}, ${currentLongitude.toFixed(6)}`;
    display.style.display = 'block';
  } else {
    span.textContent = 'Non définies';
    display.style.display = 'none';
  }
}

async function reverseGeocode(lat, lng) {
  const addressInput = document.getElementById('eventLieu');
  if (addressInput.value.trim()) return;
  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
    const data = await response.json();
    if (data && data.display_name) addressInput.value = data.display_name;
  } catch { console.error('Erreur reverse geocode'); }
}

async function geocodeLocation() {
  const address = document.getElementById('eventLieu').value.trim();
  if (!address) { showToast('Veuillez saisir une adresse', 'warning'); return; }
  const btn = document.getElementById('btnGeocode');
  btn.classList.add('loading'); btn.disabled = true;
  try {
    const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=5`);
    const results = await response.json();
    if (results && results.length > 0) {
      const lat = parseFloat(results[0].lat);
      const lng = parseFloat(results[0].lon);
      if (!eventMap) initEventMap();
      eventMap.setView([lat, lng], 15);
      placeMarker(lat, lng);
      showToast('Adresse localisée', 'success');
    } else { showToast('Adresse non trouvée', 'warning'); }
  } catch { showToast('Erreur de géocodage', 'error'); }
  finally { btn.classList.remove('loading'); btn.disabled = false; }
}

// ═══════════════════════════════════════════════════════
// PARTICIPANTS
// ═══════════════════════════════════════════════════════
async function updateParticipantsList() {
  const container = document.getElementById('participantsContainer');
  if (!container) return;
  const searchTerm  = document.getElementById('participantSearch')?.value.toLowerCase() || '';
  const eventFilter = document.getElementById('participantEventFilter')?.value || '';

  const filterSelect = document.getElementById('participantEventFilter');
  if (filterSelect && filterSelect.options.length <= 1 && eventsData.length > 0) {
    filterSelect.innerHTML = '<option value="">Tous les événements</option>';
    eventsData.forEach(e => {
      const option = document.createElement('option');
      option.value = e.id; option.textContent = e.titre;
      filterSelect.appendChild(option);
    });
  }

  let allParticipants = [];
  for (const event of eventsData) {
    if (eventFilter && event.id.toString() !== eventFilter) continue;
    try {
      const response = await fetch(`/api/admin/events/${event.id}`, { credentials: 'include', headers: { 'Accept': 'application/json' } });
      const data = await response.json();
      if (data.success && data.participants && data.participants.length) {
        data.participants.forEach(p => {
          allParticipants.push({ ...p, eventTitle: event.titre, eventId: event.id, eventDate: event.date_evenement });
        });
      }
    } catch { console.error('Erreur participants event', event.id); }
  }

  if (searchTerm) {
    allParticipants = allParticipants.filter(p =>
      (p.nom && p.nom.toLowerCase().includes(searchTerm)) ||
      (p.prenom && p.prenom.toLowerCase().includes(searchTerm)) ||
      (p.email && p.email.toLowerCase().includes(searchTerm))
    );
  }

  if (allParticipants.length === 0) {
    container.innerHTML = `<table class="participants-table"><thead><tr><th>Participant</th><th>Contact</th><th>Âge</th><th>Événement</th><th>Date événement</th><th>Inscription</th><th>Statut</th></tr></thead><tbody><tr><td colspan="7" style="text-align:center;padding:40px;color:var(--muted);">Aucun participant trouvé</td></tr></tbody></table>`;
    return;
  }

  container.innerHTML = `
    <table class="participants-table">
      <thead><tr><th>Participant</th><th>Contact</th><th>Âge</th><th>Événement</th><th>Date événement</th><th>Inscription</th><th>Statut</th></tr></thead>
      <tbody>
        ${allParticipants.map(p => `
          <tr>
            <td><strong>${escHtml(p.prenom || '')} ${escHtml(p.nom || '')}</strong><br><small style="color:var(--muted)">${escHtml(p.email || '')}</small></td>
            <td>${escHtml(p.contact || '-')}</td>
            <td>${p.age || '-'}</td>
            <td><a class="event-link" onclick="viewEventDetail(${p.eventId})">${escHtml(p.eventTitle)}</a></td>
            <td>${formatDate(p.eventDate, true)}</td>
            <td>${formatDate(p.date_inscription, true)}</td>
            <td><span class="sbadge s-active">Inscrit</span></td>
          </tr>`).join('')}
      </tbody>
    </table>`;
}

function exportParticipantsCSV() {
  let allParticipants = [];
  const fetchPromises = eventsData.map(async event => {
    try {
      const response = await fetch(`/api/admin/events/${event.id}`, { credentials: 'include' });
      const data = await response.json();
      if (data.success && data.participants) {
        data.participants.forEach(p => allParticipants.push({ ...p, eventTitle: event.titre, eventDate: event.date_evenement }));
      }
    } catch {}
  });
  Promise.all(fetchPromises).then(() => {
    if (allParticipants.length === 0) { showToast('Aucun participant à exporter', 'warning'); return; }
    const headers = ['Nom', 'Prénom', 'Email', 'Contact', 'Âge', 'Événement', 'Date événement', "Date d'inscription"];
    const rows = allParticipants.map(p => [p.nom||'', p.prenom||'', p.email||'', p.contact||'', p.age||'', p.eventTitle, formatDate(p.eventDate, true), formatDate(p.date_inscription, true)]);
    const csvContent = [headers, ...rows].map(row => row.map(cell => `"${String(cell).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob(["\uFEFF" + csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `participants_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
    showToast('Export CSV réussi', 'success');
  });
}

// ═══════════════════════════════════════════════════════
// COLLECTIONS
// ═══════════════════════════════════════════════════════
async function loadCollections() {
  const grid = document.getElementById('collGrid');
  const loadingEl = document.getElementById('collLoading');
  if (loadingEl) { loadingEl.style.display = 'block'; loadingEl.textContent = 'Chargement…'; }
  grid.querySelectorAll('.coll-dyn-card').forEach(c => c.remove());

  try {
    const search   = document.getElementById('collSearch')?.value || '';
    const material = document.getElementById('collMaterial')?.value || '';
    let url = '/api/organisateur/collections?1=1';
    if (search)   url += '&search='   + encodeURIComponent(search);
    if (material) url += '&material=' + encodeURIComponent(material);

    const res = await fetch(url, { credentials: 'include', headers: { 'Accept': 'application/json' } });
    const json = await res.json();
    _allCollections = json.data || json.collections || [];
    renderCollections(_allCollections);

    const totalCollected = json.totalCollected ?? _allCollections.reduce((s, c) => s + (parseFloat(c.currentAmount) || 0), 0);
    updatePlantGamification(totalCollected);
    renderDashboardCollPreview(_allCollections);
  } catch (e) {
    console.error('Erreur collections:', e);
    if (loadingEl) loadingEl.textContent = '⚠️ Erreur de chargement.';
  }
}

function renderDashboardCollPreview(list) {
  const container = document.getElementById('dashCollPreview');
  if (!container) return;
  const preview = list.slice(0, 3);
  if (!preview.length) { container.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted)">Aucune collection</div>'; return; }
  container.innerHTML = preview.map(c => {
    const pct = Math.min(c.progress || (c.currentAmount / c.goalAmount * 100), 100);
    return `<div class="coll-card">
      <div class="coll-header"><div class="coll-title">${escHtml(c.title)}</div><span class="coll-mat">${escHtml(c.materialType)}</span></div>
      <div class="prog-bar"><div class="prog-fill" style="width:${pct}%"></div></div>
      <div class="prog-nums"><span style="color:var(--accent)">${parseFloat(c.currentAmount).toFixed(1)} ${escHtml(c.unit)}</span><span>/ ${c.goalAmount} ${escHtml(c.unit)}</span></div>
    </div>`;
  }).join('');
}

function filterCollections() {
  const search   = (document.getElementById('collSearch')?.value || '').toLowerCase();
  const material = document.getElementById('collMaterial')?.value || '';
  const status   = document.getElementById('collStatus')?.value || '';
  const filtered = _allCollections.filter(c => {
    if (search   && !c.title.toLowerCase().includes(search) && !c.materialType.toLowerCase().includes(search)) return false;
    if (material && c.materialType !== material) return false;
    if (status   && c.status !== status) return false;
    return true;
  });
  renderCollections(filtered);
}

function renderCollections(list) {
  const grid = document.getElementById('collGrid');
  grid.querySelectorAll('.coll-dyn-card').forEach(c => c.remove());
  const loadingEl = document.getElementById('collLoading');
  if (loadingEl) loadingEl.style.display = 'none';
  const countEl = document.getElementById('collCount');
  if (countEl) countEl.textContent = list.length + ' collection(s)';

  if (list.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'coll-dyn-card';
    empty.style.cssText = 'grid-column:1/-1;text-align:center;padding:50px 0;color:var(--muted)';
    empty.innerHTML = '<div style="font-size:2.5rem;margin-bottom:12px">📭</div><div>Aucune collection trouvée.</div>';
    grid.appendChild(empty); return;
  }

  const sortedList = [...list].sort((a, b) => {
    const aFin = a.currentAmount >= a.goalAmount;
    const bFin = b.currentAmount >= b.goalAmount;
    if (aFin !== bFin) return aFin ? 1 : -1;
    return b.currentAmount - a.currentAmount;
  });

  sortedList.forEach(c => {
    const pct = Math.min(c.progress || (c.currentAmount / c.goalAmount * 100), 100);
    const isFinished = c.currentAmount >= c.goalAmount;
    const imgHtml = c.imageUrl
      ? `<img src="${c.imageUrl}" style="width:100%;height:120px;object-fit:cover;border-radius:10px 10px 0 0">`
      : `<div style="height:80px;background:linear-gradient(135deg,var(--forest),var(--moss));border-radius:10px 10px 0 0;display:flex;align-items:center;justify-content:center;font-size:2.5rem">♻️</div>`;
    const statusBadge = c.status === 'active'
      ? '<span class="sbadge s-active">Actif</span>'
      : '<span class="sbadge s-full">Inactif</span>';

    const card = document.createElement('div');
    card.className = 'coll-dyn-card blk';
    card.style.cssText = 'padding:0;overflow:hidden;opacity:0;transform:translateY(10px);transition:all 0.4s ease;';
    if (isFinished) card.style.filter = 'grayscale(80%) opacity(0.85)';

    card.innerHTML = `
      ${imgHtml}
      <div style="padding:16px">
        <div class="coll-header">
          <div class="coll-title">${escHtml(c.title)}</div>
          <div style="display:flex;gap:6px;align-items:center">${escHtml(c.materialType) ? `<span class="coll-mat">${escHtml(c.materialType)}</span>` : ''}${statusBadge}</div>
        </div>
        <div class="prog-bar" style="height:8px;margin:10px 0 4px;background:rgba(255,255,255,0.05)">
          <div class="prog-fill" id="pb-${c.id}" style="width:0%;transition:width 2s cubic-bezier(0.2,0.8,0.2,1)"></div>
        </div>
        <div class="prog-nums">
          <span style="color:var(--accent);font-weight:600">${parseFloat(c.currentAmount).toFixed(1)} ${escHtml(c.unit)}</span>
          <span>/ ${c.goalAmount} ${escHtml(c.unit)} · ${pct.toFixed(1)}%</span>
        </div>
        <div style="font-size:.72rem;color:var(--muted);margin-top:6px">${c.donationsCount || c.donations_count || 0} donation(s)</div>
        <div style="display:flex;gap:8px;margin-top:12px">
          <button class="btn btn-ghost" style="flex:1;font-size:.75rem" onclick='openCollModal(${JSON.stringify(c).replace(/'/g,"&apos;")})'>✏️ Modifier</button>
          <button class="btn btn-danger" style="flex:1;font-size:.75rem" onclick="askDeleteColl(${c.id})">🗑️ Supprimer</button>
        </div>
      </div>`;

    grid.appendChild(card);
    setTimeout(() => {
      card.style.opacity = '1'; card.style.transform = 'translateY(0)';
      const fill = document.getElementById(`pb-${c.id}`);
      if (fill) fill.style.width = pct + '%';
    }, 100);
  });
}

// ── Gamification ──
function updatePlantGamification(total) {
  let totFinal = parseFloat(total) || 0;
  if (totFinal < 0) totFinal = 0;
  const progressBar = document.getElementById('plantProgressBar');
  const totalBadge  = document.getElementById('plantTotalBadge');
  const imgEl       = document.getElementById('plantImage');
  const goalMsg     = document.getElementById('plantNextGoal');
  if (!progressBar || !totalBadge || !imgEl || !goalMsg) return;

  const stages = [
    { limit: 0,    img: 'tree_stage1_sapling.png' },
    { limit: 100,  img: 'tree_stage2_small.png' },
    { limit: 1000, img: 'tree_stage3_large.png' },
    { limit: 5000, img: 'tree_stage4_glowing.png' }
  ];

  let targetIdx = 0;
  for (let i = 0; i < stages.length; i++) {
    if (totFinal >= stages[i].limit) targetIdx = i;
  }

  const duration = 2500;
  const startTime = performance.now();

  function animate(now) {
    const elapsed = now - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const currentKg = totFinal * progress;
    totalBadge.textContent = 'Total : ' + currentKg.toFixed(1) + ' kg';

    let currentStageIdx = 0;
    if (targetIdx > 0) {
      currentStageIdx = Math.floor(progress * (targetIdx + 1));
      if (currentStageIdx > targetIdx) currentStageIdx = targetIdx;
    }
    const activeStage = stages[currentStageIdx];
    const newSrc = '/images/' + activeStage.img;
    if (!imgEl.src.endsWith(activeStage.img)) {
      imgEl.src = newSrc;
      imgEl.style.transform = 'scale(1.15)';
      setTimeout(() => imgEl.style.transform = 'scale(1)', 300);
    }

    let progPct = 0, msg = '';
    if (currentKg < 100)       { progPct = (currentKg / 100) * 100; msg = `Niveau 1 🌱 ➔ Encore ${(100 - currentKg).toFixed(1)} kg pour éclore !`; }
    else if (currentKg < 1000) { progPct = ((currentKg - 100) / 900) * 100; msg = `Niveau 2 🌿 ➔ ${(1000 - currentKg).toFixed(1)} kg restants !`; }
    else if (currentKg < 5000) { progPct = ((currentKg - 1000) / 4000) * 100; msg = `Niveau 3 🌳 ➔ ${(5000 - currentKg).toFixed(1)} kg avant la forêt dense !`; }
    else { progPct = 100; msg = `Niveau MAX 🌎 ➔ Impact Exceptionnel !`; progressBar.style.background = 'linear-gradient(90deg, #d4af37, #f3e5ab)'; }

    progressBar.style.width = Math.max(0, Math.min(progPct, 100)) + '%';
    goalMsg.textContent = msg;
    if (progress < 1) requestAnimationFrame(animate);
  }
  requestAnimationFrame(animate);
}

// ── CRUD collections ──
function openCollModal(collection) {
  const isEdit = !!collection;
  document.getElementById('collModalTitle').textContent = isEdit ? 'Modifier la collection' : 'Nouvelle collection';
  document.getElementById('collSubmitBtn').textContent  = isEdit ? 'Enregistrer' : 'Créer la collection';
  document.getElementById('collEditId').value   = isEdit ? collection.id : '';
  document.getElementById('cf_title').value     = isEdit ? collection.title : '';
  document.getElementById('cf_material').value  = isEdit ? collection.materialType : '';
  document.getElementById('cf_goal').value      = isEdit ? collection.goalAmount : '';
  document.getElementById('cf_unit').value      = isEdit ? collection.unit : '';
  document.getElementById('cf_status').value    = isEdit ? collection.status : 'active';
  document.getElementById('cf_image').value     = '';
  document.getElementById('imgPreviewBox').style.display = 'none';
  document.getElementById('imgLabel').innerHTML = isEdit
    ? 'Image <span style="color:var(--muted);font-size:.7rem">(laisser vide pour conserver l\'actuelle)</span>'
    : 'Image <span style="color:var(--danger)">*</span>';
  ['title','material','goal','unit','image'].forEach(f => {
    const el = document.getElementById('err_'+f);
    if (el) { el.style.display='none'; el.textContent=''; }
  });
  document.getElementById('collFormError').style.display = 'none';
  document.getElementById('collModal').classList.add('active');
}

function closeCollModal() { document.getElementById('collModal').classList.remove('active'); }

document.addEventListener('DOMContentLoaded', () => {
  const cfImage = document.getElementById('cf_image');
  if (cfImage) cfImage.addEventListener('change', function() {
    const file = this.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = e => {
        document.getElementById('imgPreview').src = e.target.result;
        document.getElementById('imgPreviewBox').style.display = 'block';
      };
      reader.readAsDataURL(file);
    }
  });
});

async function submitCollForm(e) {
  e.preventDefault();
  const editId = document.getElementById('collEditId').value;
  const isEdit = !!editId;
  const btn = document.getElementById('collSubmitBtn');
  btn.disabled = true; btn.textContent = isEdit ? 'Enregistrement…' : 'Création…';

  ['title','material','goal','unit','image'].forEach(f => {
    const el = document.getElementById('err_'+f);
    if (el) { el.style.display='none'; el.textContent=''; }
  });
  document.getElementById('collFormError').style.display = 'none';

  const fd = new FormData();
  fd.append('title',        document.getElementById('cf_title').value.trim());
  fd.append('materialType', document.getElementById('cf_material').value);
  fd.append('goalAmount',   document.getElementById('cf_goal').value);
  fd.append('unit',         document.getElementById('cf_unit').value);
  fd.append('status',       document.getElementById('cf_status').value);
  const img = document.getElementById('cf_image').files[0];
  if (img) fd.append('image', img);
  if (isEdit) fd.append('_method', 'PUT');

  const url = isEdit ? '/api/organisateur/collections/' + editId : '/api/organisateur/collections';
  try {
    const res = await fetch(url, { method: 'POST', credentials: 'include', body: fd });
    const json = await res.json();
    if (json.success) {
      closeCollModal();
      showToast(isEdit ? '✅ Collection mise à jour!' : '✅ Collection créée!');
      loadCollections();
    } else {
      if (json.errors) {
        const map = { title:'title', materialType:'material', goalAmount:'goal', unit:'unit', image:'image' };
        Object.entries(json.errors).forEach(([k, msg]) => {
          const key = map[k] || k;
          const el = document.getElementById('err_'+key);
          if (el) { el.textContent = msg; el.style.display = 'block'; }
        });
      } else {
        document.getElementById('collFormError').textContent = json.message || 'Erreur inconnue.';
        document.getElementById('collFormError').style.display = 'block';
      }
    }
  } catch {
    document.getElementById('collFormError').textContent = 'Erreur réseau. Veuillez réessayer.';
    document.getElementById('collFormError').style.display = 'block';
  } finally {
    btn.disabled = false; btn.textContent = isEdit ? 'Enregistrer' : 'Créer la collection';
  }
}

function askDeleteColl(id) {
  _deleteCollId = id;
  document.getElementById('confirmDeleteCollModal').classList.add('active');
}

function closeDeleteCollModal() {
  document.getElementById('confirmDeleteCollModal').classList.remove('active');
  _deleteCollId = null;
}

async function confirmDeleteColl() {
  if (!_deleteCollId) return;
  const btn = document.getElementById('confirmDeleteCollBtn');
  btn.disabled = true; btn.textContent = 'Suppression…';
  try {
    const res = await fetch('/api/organisateur/collections/' + _deleteCollId, { method: 'DELETE', credentials: 'include' });
    const json = await res.json();
    if (json.success) { closeDeleteCollModal(); showToast('🗑️ Collection supprimée.'); loadCollections(); }
    else showToast(json.message || 'Erreur.', 'error');
  } catch { showToast('Erreur réseau.', 'error'); }
  finally { btn.disabled = false; btn.textContent = 'Supprimer'; _deleteCollId = null; }
}

