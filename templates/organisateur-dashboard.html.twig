<script>
function showPage(name, navEl) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + name).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  
  if (name === 'produits') {
    refreshProducts();
  }
}

async function generateAIDescription() {
  const name = document.getElementById('productName').value;
  const description = document.getElementById('productDescription').value;
  const btn = document.getElementById('aiGenBtn');
  
  if (!name || name.length < 3) {
    showToast('Veuillez d\'abord saisir un nom de produit (min. 3 caractères)');
    return;
  }
  
  const originalText = btn.innerHTML;
  btn.innerHTML = '⌛ Génération...';
  btn.disabled = true;
  
  try {
    const response = await fetch('/api/generate-description', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, description })
    });
    
    const data = await response.json();
    if (data.success) {
      document.getElementById('productDescription').value = data.description;
      showToast('Description améliorée avec succès ! ✨');
    } else {
      showToast('Erreur : ' + (data.message || 'L\'IA n\'a pas pu répondre'));
    }
  } catch (error) {
    console.error('AI Error:', error);
    showToast('Erreur lors de la communication avec l\'IA');
  } finally {
    btn.innerHTML = originalText;
    btn.disabled = false;
  }
}

async function refreshProducts() {
  const search = document.getElementById('prodSearch') ? document.getElementById('prodSearch').value : '';
  const cat = document.getElementById('prodCat') ? document.getElementById('prodCat').value : '';
  const sort = document.getElementById('prodSort') ? document.getElementById('prodSort').value : 'date_desc';
  const grid = document.getElementById('productsGrid');
  if (!grid) return;

  grid.style.opacity = '0.6';
  try {
    const res = await fetch(`/api/organisateur/products?search=${encodeURIComponent(search)}&category=${encodeURIComponent(cat)}&sort=${sort}`);
    const result = await res.json();
    grid.style.opacity = '1';
    
    if (!result.success) throw new Error(result.message);

    if (result.data.length === 0) {
      grid.innerHTML = `
        <div class="blk" style="grid-column:1/-1;text-align:center;padding:40px 20px">
          <div style="font-size:3rem;margin-bottom:12px">📦</div>
          <div style="font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:white;margin-bottom:6px">Aucun produit trouvé</div>
          <div style="font-size:.82rem;color:var(--muted)">Essayez de modifier vos filtres ou d'ajouter une œuvre</div>
        </div>
      `;
      return;
    }

    grid.innerHTML = result.data.map(p => `
      <div class="blk" style="display:flex;flex-direction:column">
        <div style="display:flex;gap:16px;flex:1">
          <div style="width:140px;height:140px;border-radius:12px;background:linear-gradient(135deg,var(--card2),var(--forest));display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden">
            ${p.imageProduit ? `<img src="/uploads/${p.imageProduit}" style="width:100%;height:100%;object-fit:cover" alt="${p.nomProduit}" onerror="this.parentElement.innerHTML='<span style=\'font-size:3rem\'>🎨</span>'">` : `<span style="font-size:3rem">🎨</span>`}
          </div>
          <div style="flex:1;display:flex;flex-direction:column">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <h3 style="font-family:'Playfair Display',serif;font-size:.95rem;font-weight:700;color:white;margin-bottom:6px">${p.nomProduit}</h3>
              <span class="sbadge ${p.status === 'publié' ? 's-active' : 's-archived'}">${p.status === 'publié' ? 'Publié' : 'Archivé'}</span>
            </div>
            ${p.category ? `<span class="sbadge s-active" style="width:fit-content;margin-bottom:8px">${p.category}</span>` : ''}
            <p style="font-size:.78rem;color:var(--muted);line-height:1.4;margin-bottom:10px;flex:1">${p.description ? p.description.substring(0, 100) + (p.description.length > 100 ? '...' : '') : 'Pas de description'}</p>
            <div style="font-size:.7rem;color:var(--muted)">Créé le ${p.date}</div>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
          <button class="btn btn-ghost" style="flex:1;font-size:.75rem" onclick="openEditModal(${p.id})">✏️ Modifier</button>
          <form method="POST" action="/organisateur/produit/toggle-status/${p.id}" style="flex:1">
            <button type="submit" class="btn btn-ghost" style="width:100%;font-size:.75rem">${p.status === 'publié' ? '📁 Archiver' : '🌍 Publier'}</button>
          </form>
          <form method="POST" action="/produit/delete/${p.id}" style="flex:1" onsubmit="return confirm('Êtes-vous sûr ?')">
            <button type="submit" class="btn btn-danger" style="width:100%;font-size:.75rem">🗑️ Supprimer</button>
          </form>
        </div>
      </div>
    `).join('');

  } catch (e) {
    grid.style.opacity = '1';
    console.error(e);
    showToast('Erreur lors du chargement des produits');
  }
}
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2600);
}
function openModal() { document.getElementById('eventModal').classList.add('active'); }
function closeModal() { document.getElementById('eventModal').classList.remove('active'); }
function openProductModal() { document.getElementById('productModal').classList.add('active'); }
function closeProductModal() { document.getElementById('productModal').classList.remove('active'); }
function openEditModal(productId) {
  // For now, redirect to edit page. In a more advanced implementation, we could load the edit form via AJAX
  window.location.href = '/organisateur/produit/edit/' + productId;
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeProductModal(); } });

function showFormError(message) {
  const errorBox = document.getElementById('formErrorMessage');
  if (!errorBox) return;
  errorBox.textContent = message;
  errorBox.style.display = 'block';
}

function clearFormError() {
  const errorBox = document.getElementById('formErrorMessage');
  if (!errorBox) return;
  errorBox.textContent = '';
  errorBox.style.display = 'none';
}

// Show edit modal if editProduit exists
document.addEventListener('DOMContentLoaded', function() {
  // Show the active page
  {% if activePage is defined and activePage %}
  showPage('{{ activePage }}');
  {% else %}
  showPage('dashboard');
  {% endif %}
  
  {% if editProduit is defined and editProduit %}
  openProductModal();
  {% else %}
  closeProductModal();
  {% endif %}

  const productForm = document.getElementById('productForm');
  const currentImageName = '{{ editProduit is defined and editProduit and editProduit.imageProduit ? editProduit.imageProduit : '' }}';
  const existingImageNames = [
    {% for produit in produits %}
      {% if produit.imageProduit %}
        '{{ produit.imageProduit }}'{% if not loop.last %}, {% endif %}
      {% endif %}
    {% endfor %}
  ];

  const imageInput = productForm ? productForm.querySelector('input[name="imageProduit"]') : null;
  if (imageInput) {
    imageInput.addEventListener('change', function() {
      clearFormError();
      if (!this.files || this.files.length === 0) {
        return;
      }
      const fileName = this.files[0].name;
      if (currentImageName && fileName === currentImageName) {
        showFormError('Vous avez sélectionné la même image que l\'actuelle. Choisissez-en une autre pour modifier.');
        return;
      }
      if (existingImageNames.includes(fileName) && fileName !== currentImageName) {
        showFormError('Cette image est déjà utilisée par un autre produit. Choisissez une autre image.');
      }
    });
  }

  if (productForm) {
    productForm.addEventListener('submit', function(e) {
      clearFormError();
      const nomProduit = productForm.nomProduit.value.trim();
      const description = productForm.description.value.trim();
      const pattern = /^[A-Za-z0-9]+$/;

      if (nomProduit.length < 3 || !pattern.test(nomProduit)) {
        showFormError('Le nom doit contenir au moins 3 caractères et seulement des lettres ou des chiffres.');
        e.preventDefault();
        return;
      }

      if (description === '') {
        showFormError('La description est obligatoire.');
        e.preventDefault();
        return;
      }

      const isEditMode = {{ editProduit is defined and editProduit ? 'true' : 'false' }};
      if (!isEditMode && imageInput && imageInput.files.length === 0) {
        showFormError('L\'image est requise.');
        e.preventDefault();
      }
    });
  }
});

// Image upload handling - removed for simple file input
</script>
</body>
</html>
