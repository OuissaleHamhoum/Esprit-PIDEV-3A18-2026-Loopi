<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — Espace Organisateur</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
:root {
  --bg: #0F1C15; --surface: #162318; --card: #1E3228; --card2: #243B2D;
  --border: rgba(255,255,255,0.07); --forest: #1E3A2F; --moss: #3D6B4F;
  --sage: #7A9E7E; --sand: #C9A96E; --rust: #B05A2F; --light: #E8F0E4;
  --muted: rgba(255,255,255,.45); --text: rgba(255,255,255,.9);
  --accent: #5DA87A; --danger: #E05A3A; --success: #10B981; --warning: #F59E0B;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }

/* ── SIDEBAR ── */
.sidebar { width: 260px; background: var(--surface); min-height: 100vh; display: flex; flex-direction: column; position: fixed; left: 0; top: 0; bottom: 0; z-index: 100; border-right: 1px solid var(--border); }
.sidebar-logo { padding: 26px 22px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.logo-text { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 900; color: var(--text); }
.logo-badge { background: linear-gradient(135deg, var(--moss), var(--accent)); border-radius: 8px; padding: 2px 8px; font-size: .62rem; font-weight: 700; color: white; letter-spacing: .04em; }
.sidebar-user { padding: 16px 22px 14px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
.user-av { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--moss)); display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: .95rem; font-weight: 700; color: white; flex-shrink: 0; }
.user-info .u-name { font-size: .82rem; font-weight: 600; color: var(--text); }
.user-info .u-role { font-size: .65rem; color: var(--muted); }
nav.snav { padding: 14px 10px; flex: 1; overflow-y: auto; }
.nsec { font-size: .6rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.2); padding: 14px 12px 5px; }
.ni { display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: 9px; cursor: pointer; transition: all .18s; margin-bottom: 2px; text-decoration: none; color: var(--muted); font-size: .82rem; font-weight: 500; }
.ni:hover { background: rgba(255,255,255,.06); color: var(--text); }
.ni.active { background: linear-gradient(135deg, rgba(93,168,122,.18), rgba(61,107,79,.12)); color: var(--accent); }
.ni .ic { width: 17px; text-align: center; font-size: .9rem; }
.ni .badge { margin-left: auto; background: var(--accent); color: white; border-radius: 50px; padding: 1px 6px; font-size: .6rem; font-weight: 700; }
.sbot { padding: 14px 10px; border-top: 1px solid var(--border); }

/* ── MAIN ── */
.main { margin-left: 260px; flex: 1; padding: 28px; min-height: 100vh; background: var(--bg); }
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
.page-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--text); }
.page-sub { font-size: .78rem; color: var(--muted); margin-top: 2px; }
.ta { display: flex; gap: 10px; align-items: center; }

/* ── BUTTONS ── */
.btn { padding: 8px 18px; border-radius: 8px; font-size: .8rem; font-weight: 600; cursor: pointer; transition: all .2s; border: none; font-family: 'DM Sans', sans-serif; }
.btn-g { background: linear-gradient(135deg, var(--accent), var(--moss)); color: white; }
.btn-g:hover { opacity: .88; transform: translateY(-1px); }
.btn-ghost { background: rgba(255,255,255,.06); color: var(--text); border: 1px solid var(--border); }
.btn-ghost:hover { background: rgba(255,255,255,.1); }
.btn-danger { background: rgba(224,90,58,.15); color: var(--danger); border: 1px solid rgba(224,90,58,.2); }
.btn-danger:hover { background: rgba(224,90,58,.25); }
.btn-warning { background: rgba(245,158,11,.15); color: var(--warning); border: 1px solid rgba(245,158,11,.2); }
.btn-warning:hover { background: rgba(245,158,11,.25); }
.btn-sm { padding: 6px 12px; font-size: .7rem; }

/* ── STAT CARDS ── */
.cards-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
.sc { background: var(--card); border-radius: 16px; padding: 20px; border: 1px solid var(--border); transition: transform .2s; }
.sc:hover { transform: translateY(-3px); }
.sc-icon { width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; margin-bottom: 12px; }
.sc-val { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 700; color: var(--text); line-height: 1; }
.sc-lbl { font-size: .72rem; color: var(--muted); margin-top: 3px; }
.sc-trend { font-size: .7rem; margin-top: 6px; font-weight: 600; color: var(--accent); }
.sc-trend.down { color: var(--danger); }

/* ── CHARTS ── */
.chart-container { background: var(--card); border-radius: 16px; padding: 20px; border: 1px solid var(--border); margin-bottom: 24px; }
.chart-title { font-family: 'Playfair Display', serif; font-size: .9rem; font-weight: 700; margin-bottom: 16px; color: var(--text); }
.bars-chart { display: flex; align-items: flex-end; gap: 12px; height: 200px; padding: 10px 0; }
.bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.bar { width: 100%; background: linear-gradient(180deg, var(--accent), var(--moss)); border-radius: 8px 8px 4px 4px; transition: height .5s ease; min-height: 5px; }
.bar-label { font-size: .65rem; color: var(--muted); text-align: center; }
.bar-value { font-size: .7rem; font-weight: 600; color: var(--accent); }
.donut-container { display: flex; align-items: center; gap: 30px; flex-wrap: wrap; }
.donut { width: 120px; height: 120px; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; }
.donut-inner { position: absolute; width: 70px; height: 70px; background: var(--card); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; color: var(--accent); }
.donut-labels { flex: 1; }
.donut-label-item { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-size: .75rem; }
.donut-color { width: 12px; height: 12px; border-radius: 3px; }
.donut-text { color: var(--muted); }
.donut-percent { margin-left: auto; font-weight: 600; color: var(--text); }

/* ── EVENTS GRID ── */
.events-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
.events-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
.event-stat { background: var(--card); border-radius: 12px; padding: 16px; text-align: center; border: 1px solid var(--border); }
.event-stat-value { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: var(--accent); }
.event-stat-label { font-size: .7rem; color: var(--muted); margin-top: 4px; }
.events-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; }
.event-card { background: var(--card); border-radius: 16px; overflow: hidden; border: 1px solid var(--border); transition: transform .2s, box-shadow .2s; cursor: pointer; }
.event-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,.3); }
.event-image { height: 180px; background: linear-gradient(135deg, var(--forest), var(--moss)); position: relative; overflow: hidden; }
.event-image img { width: 100%; height: 100%; object-fit: cover; }
.event-image-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; font-size: 4rem; }
.event-status-badge { position: absolute; top: 12px; right: 12px; }
.event-date-badge { position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); border-radius: 8px; padding: 6px 12px; text-align: center; min-width: 60px; }
.event-date-day { font-size: 1.1rem; font-weight: 700; line-height: 1; }
.event-date-month { font-size: .65rem; text-transform: uppercase; opacity: 0.7; }
.event-body { padding: 16px; }
.event-title { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
.event-lieu { font-size: .75rem; color: var(--muted); margin-bottom: 12px; display: flex; align-items: center; gap: 4px; }
.event-actions { display: flex; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
.event-actions button { flex: 1; }
.events-empty { text-align: center; padding: 60px 20px; background: var(--card); border-radius: 16px; border: 1px solid var(--border); }
.events-empty-icon { font-size: 4rem; margin-bottom: 16px; }
.events-empty-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; }
.events-empty-text { font-size: .85rem; color: var(--muted); margin-bottom: 20px; }

/* ── PROGRESS ── */
.progress-bar { height: 6px; background: rgba(255,255,255,.1); border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent), var(--moss)); border-radius: 3px; transition: width .3s ease; }
.progress-stats { display: flex; justify-content: space-between; font-size: .7rem; color: var(--muted); }

/* ── MODAL ── */
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.8); backdrop-filter: blur(6px); z-index: 2000; align-items: center; justify-content: center; }
.modal-overlay.active { display: flex; }
.modal { background: var(--card); border-radius: 20px; width: 520px; max-width: 92vw; max-height: 90vh; overflow-y: auto; border: 1px solid var(--border); animation: slideUp .25s ease; }
.modal-large { width: 700px; }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.modal-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: var(--text); padding: 18px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.modal-close { background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer; transition: color .2s; }
.modal-close:hover { color: var(--text); }
.modal-body { padding: 24px; }
.modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; gap: 12px; justify-content: flex-end; }

/* ── FORMS ── */
.form-group { margin-bottom: 16px; }
.form-group label, .fg label { display: block; font-size: .73rem; font-weight: 600; color: rgba(255,255,255,.7); margin-bottom: 5px; }
.form-group input, .form-group textarea, .form-group select,
.fg input, .fg textarea, .fg select {
  width: 100%; padding: 10px 14px; background: rgba(255,255,255,.08); border: 1px solid var(--border);
  border-radius: 10px; font-family: 'DM Sans', sans-serif; font-size: .85rem; color: var(--text); outline: none; transition: all .2s;
}
.form-group input:focus, .form-group textarea:focus, .form-group select:focus,
.fg input:focus, .fg textarea:focus, .fg select:focus { border-color: var(--accent); background: rgba(255,255,255,.12); }
.form-group textarea, .fg textarea { resize: vertical; min-height: 80px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.fg { margin-bottom: 12px; }
select option { background: var(--surface); color: white; }
.error-message { color: var(--danger); font-size: .65rem; margin-top: 4px; display: none; }

/* ── IMAGE PREVIEW ── */
.image-preview { width: 100%; height: 200px; background: rgba(255,255,255,.05); border: 2px dashed var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; overflow: hidden; position: relative; }
.image-preview img { width: 100%; height: 100%; object-fit: cover; }
.image-preview.empty { flex-direction: column; gap: 8px; color: var(--muted); }
.image-preview.empty .preview-icon { font-size: 2.5rem; }
.image-buttons { display: flex; gap: 10px; }
.image-buttons button { flex: 1; }

/* ── MAP ── */
.location-container { position: relative; }
.location-input-container { display: flex; gap: 8px; }
.location-input-container input { flex: 1; }
.geocode-btn { padding: 10px 16px; background: rgba(93,168,122,0.1); color: var(--accent); border: 1px solid var(--accent); border-radius: 10px; cursor: pointer; font-size: .8rem; transition: all .2s; white-space: nowrap; }
.geocode-btn:hover { background: var(--accent); color: white; }
.geocode-btn.loading { opacity: 0.6; cursor: wait; }
.map-container { margin-top: 12px; height: 250px; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); }
.coordinates-display { margin-top: 8px; font-size: .7rem; color: var(--muted); padding: 8px; background: rgba(255,255,255,.05); border-radius: 6px; display: none; }

/* ── DETAIL MODAL ── */
.detail-section { background: rgba(255,255,255,.03); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
.detail-section h4 { font-size: .85rem; font-weight: 700; margin-bottom: 12px; color: var(--accent); }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.detail-info { display: flex; margin-bottom: 8px; font-size: .8rem; }
.detail-info-label { width: 100px; color: var(--muted); }
.detail-info-value { flex: 1; color: var(--text); }
.participants-list { max-height: 300px; overflow-y: auto; }
.participant-item { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid var(--border); }
.participant-item:last-child { border-bottom: none; }
.participant-name { font-weight: 600; }
.participant-email { font-size: .7rem; color: var(--muted); }

/* ── PARTICIPANTS TABLE ── */
.participants-table-container { background: var(--card); border-radius: 16px; border: 1px solid var(--border); overflow-x: auto; }
.participants-table { width: 100%; border-collapse: collapse; }
.participants-table th, .participants-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); font-size: .82rem; }
.participants-table th { font-size: .7rem; font-weight: 700; text-transform: uppercase; color: var(--muted); background: rgba(255,255,255,.02); }
.participants-table tr:hover td { background: rgba(255,255,255,.02); }
.event-link { color: var(--accent); text-decoration: none; cursor: pointer; }
.event-link:hover { text-decoration: underline; }

/* ── COLLECTIONS ── */
.coll-card { background: var(--card2); border-radius: 13px; padding: 16px; border: 1px solid var(--border); margin-bottom: 10px; }
.coll-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
.coll-title { font-weight: 700; color: white; font-size: .88rem; }
.coll-mat { background: rgba(93,168,122,.12); color: var(--accent); border-radius: 8px; padding: 2px 8px; font-size: .65rem; font-weight: 600; }
.prog-bar { height: 5px; background: rgba(255,255,255,.08); border-radius: 3px; overflow: hidden; margin: 8px 0 4px; }
.prog-fill { height: 100%; border-radius: 3px; background: linear-gradient(to right, var(--accent), var(--sage)); }
.prog-nums { display: flex; justify-content: space-between; font-size: .68rem; color: var(--muted); }

/* ── BADGES ── */
.sbadge { padding: 3px 9px; border-radius: 50px; font-size: .62rem; font-weight: 700; white-space: nowrap; }
.s-active { background: rgba(93,168,122,.15); color: var(--accent); }
.s-pending { background: rgba(201,169,110,.15); color: var(--sand); }
.s-rejected { background: rgba(224,90,58,.12); color: var(--danger); }
.s-full { background: rgba(255,255,255,.08); color: var(--muted); }

/* ── BLOCKS ── */
.blk { background: var(--card); border-radius: 16px; padding: 20px; border: 1px solid var(--border); }
.blk-title { font-family: 'Playfair Display', serif; font-size: .95rem; font-weight: 700; color: white; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; }
.blk-title span { font-family: 'DM Sans', sans-serif; font-size: .72rem; color: var(--accent); cursor: pointer; }

/* ── TABLES ── */
.tbl { width: 100%; border-collapse: collapse; font-size: .8rem; }
.tbl th { text-align: left; padding: 8px 10px; font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); }
.tbl td { padding: 10px; border-bottom: 1px solid rgba(255,255,255,.04); vertical-align: middle; }
.tbl tr:last-child td { border-bottom: none; }
.tbl tr:hover td { background: rgba(255,255,255,.02); }

/* ── PRODUITS ── */
.prod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.prod-card { background: var(--card2); border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform .18s; border: 1px solid var(--border); }
.prod-card:hover { transform: translateY(-3px); }
.prod-img { height: 120px; display: flex; align-items: center; justify-content: center; font-size: 3rem; }
.prod-body { padding: 10px 12px; }
.prod-name { font-size: .8rem; font-weight: 700; color: white; }
.prod-cat { font-size: .65rem; color: var(--muted); margin-top: 2px; }
.prod-actions { display: flex; gap: 6px; margin-top: 8px; }

/* ── NOTIFS ── */
.notif-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.05); font-size: .79rem; }
.notif-item:last-child { border-bottom: none; }
.notif-icon { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; background: rgba(93,168,122,.12); }
.notif-body { flex: 1; }
.notif-text { color: white; font-weight: 500; }
.notif-time { font-size: .68rem; color: var(--muted); margin-top: 2px; }

/* ── PROFILE STATS ── */
.stats-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.stat-mini-card { background: rgba(255,255,255,.03); border-radius: 12px; padding: 16px; text-align: center; }
.stat-mini-value { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--accent); }
.stat-mini-label { font-size: .7rem; color: var(--muted); margin-top: 4px; }

/* ── TOAST ── */
.toast { position: fixed; bottom: 22px; right: 22px; background: var(--accent); color: white; padding: 12px 20px; border-radius: 12px; font-size: .85rem; font-weight: 600; z-index: 9999; transform: translateY(70px); opacity: 0; transition: all .3s; }
.toast.show { transform: translateY(0); opacity: 1; }
.toast.error { background: var(--danger); }
.toast.warning { background: var(--warning); color: #1a1a1a; }

/* ── ANIMATIONS ── */
@keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
.main > * { animation: fadeUp .35s ease both; }
</style>
</head>
<body>

<!-- ═══ SIDEBAR ═══ -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div style="width:28px;height:28px;background:linear-gradient(135deg,var(--accent),var(--moss));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem">🌿</div>
    <div class="logo-text">Loopi</div>
    <div class="logo-badge" style="margin-left:auto">ORG</div>
  </div>
  <div class="sidebar-user">
    <div class="user-av" id="userAvatar">{{ app.user.nom|default('E')[:1]|upper }}</div>
    <div class="user-info">
      <div class="u-name" id="userName">{{ app.user.nom|default('Chargement...') }}</div>
      <div class="u-role" id="userEmail">{{ app.user.email|default('organisateur@loopi.tn') }}</div>
    </div>
  </div>
  <nav class="snav">
    <div class="nsec">Principal</div>
    <a href="#" class="ni active" onclick="showPage('dashboard',this)"><span class="ic">📊</span> Tableau de bord</a>
    <a href="#" class="ni" onclick="showPage('evenements',this)"><span class="ic">📅</span> Mes événements</a>
    <a href="#" class="ni" onclick="showPage('participants',this)"><span class="ic">👥</span> Participants</a>
    <div class="nsec">Contenu</div>
    <a href="#" class="ni" onclick="showPage('produits',this)"><span class="ic">🎨</span> Mes produits</a>
    <a href="#" class="ni" onclick="showPage('collections',this)"><span class="ic">♻️</span> Collections</a>
    <a href="#" class="ni" onclick="showPage('galerie',this)"><span class="ic">🖼️</span> Galerie analytique</a>
    <div class="nsec">Compte</div>
    <a href="#" class="ni" onclick="showPage('notifs',this)"><span class="ic">🔔</span> Notifications</a>
    <a href="#" class="ni" onclick="showPage('profil',this)"><span class="ic">👤</span> Profil</a>
  </nav>
  <div class="sbot">
    <a href="/logout" class="ni"><span class="ic">🚪</span> Déconnexion</a>
  </div>
</aside>

<!-- ═══ MAIN ═══ -->
<main class="main" id="mainContent">

  <!-- ── DASHBOARD ── -->
  <div id="page-dashboard">
    <div class="topbar">
      <div>
        <div class="page-title" id="dashboardWelcome">Tableau de bord</div>
        <div class="page-sub">Vue d'ensemble de votre activité</div>
      </div>
      <div class="ta">
        <button class="btn btn-ghost" onclick="showPage('produits',document.querySelector('[onclick*=produits]'))">+ Ajouter produit</button>
        <button class="btn btn-g" onclick="openEventModal()">+ Nouvel événement</button>
      </div>
    </div>

    <!-- Stat cards with filter -->
    <div class="cards-row">
      <div class="sc">
