{% extends 'base.html.twig' %}

{% block title %}Inscription — Loopi{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}
{% block main_class %}py-0 flex-grow-1 d-flex flex-column{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="row g-0 min-vh-100 auth-split">
        <div class="col-lg-5 d-none d-lg-flex flex-column text-white p-5 auth-split-left rounded-end-0">
            <div class="mb-4">
                <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img loopi-logo-img--auth mb-3">
                <h1 class="display-6 fw-bold mb-3">Rejoindre Loopi</h1>
                <p class="lead text-white-50 mb-0">Économie circulaire &amp; solidarité — création de compte avec photo et choix du rôle.</p>
            </div>
            <div class="loopi-auth-logos mt-auto">
                <img src="{{ asset('images/branding/esprit.png') }}" alt="Esprit" class="loopi-logo-img" style="height:32px;width:auto;opacity:.88;">
                <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img loopi-logo-img--auth" style="height:36px;">
            </div>
            <p class="small text-white-50 mb-0 mt-3 pt-2 border-top border-white border-opacity-10">Déjà inscrit ?
                <a href="{{ path('app_login') }}" class="text-white fw-semibold text-decoration-underline">Se connecter</a>
            </p>
        </div>
        <div class="col-lg-7 bg-white p-4 p-lg-5 d-flex align-items-center">
            <div class="w-100" style="max-width: 520px; margin: 0 auto;">
                <h2 class="h4 fw-bold mb-1">Créer un compte</h2>
                <p class="text-muted small mb-4">Renseignez vos informations, choisissez votre rôle et ajoutez une photo (fichier ou caméra).</p>

                {{ form_start(registrationForm, {'attr': {'enctype': 'multipart/form-data', 'id': 'register-form'}}) }}
                {% include '_form_errors_banner.html.twig' with { form: registrationForm } only %}

                <div class="mb-4 text-center">
                    <div id="photo-preview" class="rounded-circle bg-light border mx-auto mb-2 d-flex align-items-center justify-content-center overflow-hidden" style="width:112px;height:112px;">
                        <i class="bi bi-person-fill text-muted fs-1"></i>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <label class="btn btn-success btn-sm mb-0">
                            Choisir un fichier
                            {{ form_widget(registrationForm.photoFile) }}
                        </label>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#camModal">Prendre une photo</button>
                    </div>
                    {{ form_errors(registrationForm.photoFile) }}
                </div>

                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(registrationForm.prenom) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.nom) }}</div>
                    <div class="col-12">{{ form_row(registrationForm.email) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.genre) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.role) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.plainPassword.first) }}</div>
                    <div class="col-md-6">{{ form_row(registrationForm.plainPassword.second) }}</div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-loopi btn-lg w-100 rounded-3">S’inscrire</button>
                </div>
                {{ form_end(registrationForm) }}

                <p class="text-center text-muted small mt-4 mb-0 d-lg-none">
                    Déjà inscrit ? <a href="{{ path('app_login') }}" class="fw-semibold text-loopi">Connexion</a>
                </p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="camModal" tabindex="-1" aria-labelledby="camModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header border-0">
                <h2 class="modal-title h6" id="camModalLabel">Photo depuis la caméra</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body text-center">
                <video id="cam-video" class="w-100 rounded-3 bg-dark" style="max-height:320px;" playsinline autoplay muted></video>
                <canvas id="cam-canvas" class="d-none"></canvas>
                <p class="small text-muted mt-2 mb-0">Autorisez l’accès à la caméra si demandé.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary rounded-3" id="cam-capture">Capturer</button>
            </div>
        </div>
    </div>
</div>

<style>
@media (max-width: 991.98px) {
    .auth-split .col-lg-7 { min-height: auto; }
}
</style>
{% endblock %}

{% block body_scripts %}
{{ parent() }}
<script>
(function () {
    const input = document.querySelector('#register-form input[type=file].js-register-photo');
    const preview = document.getElementById('photo-preview');
    const video = document.getElementById('cam-video');
    const canvas = document.getElementById('cam-canvas');
    const modal = document.getElementById('camModal');
    let stream = null;

    function showPreview(file) {
        if (!file || !file.type.startsWith('image/')) return;
        const url = URL.createObjectURL(file);
        preview.innerHTML = '<img src="' + url + '" alt="" class="w-100 h-100 object-fit-cover">';
    }

    if (input) {
        input.addEventListener('change', function () {
            if (input.files && input.files[0]) showPreview(input.files[0]);
        });
    }

    if (modal) {
        modal.addEventListener('shown.bs.modal', async function () {
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                video.srcObject = stream;
            } catch (e) {
                alert('Caméra indisponible : ' + (e.message || 'erreur'));
            }
        });
        modal.addEventListener('hidden.bs.modal', function () {
            if (stream) {
                stream.getTracks().forEach(function (t) { t.stop(); });
                stream = null;
            }
            video.srcObject = null;
        });
    }

    document.getElementById('cam-capture')?.addEventListener('click', function () {
        if (!video.videoWidth) return;
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0);
        canvas.toBlob(function (blob) {
            if (!blob || !input) return;
            const file = new File([blob], 'camera-photo.jpg', { type: 'image/jpeg' });
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            showPreview(file);
            bootstrap.Modal.getInstance(modal)?.hide();
        }, 'image/jpeg', 0.92);
    });
})();
</script>
{% endblock %}
