<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Loopi{% endblock %}</title>
    <style>
        body { font-family: 'DM Sans', Arial, sans-serif; background: #f7f6f2; color: #1a1a1a; margin: 0; padding: 0; }
        .page { max-width: 920px; margin: 0 auto; padding: 32px; }
        .card { background: white; border-radius: 18px; padding: 28px; box-shadow: 0 20px 48px rgba(16, 28, 24, 0.08); }
        .form-grid { display: grid; gap: 18px; }
        label { display: block; font-weight: 700; margin-bottom: 8px; }
        input, select { width: 100%; padding: 14px 16px; border: 1px solid #d7d3c8; border-radius: 12px; }
        button { padding: 14px 20px; border: none; border-radius: 12px; background: #1e3a2f; color: white; cursor: pointer; }
        button:hover { opacity: 0.95; }
        .error { color: #b02a37; margin-bottom: 18px; }
        .navigation { margin-bottom: 24px; display: flex; flex-wrap: wrap; gap: 14px; }
        .navigation a { color: #3d6b4f; text-decoration: none; font-weight: 600; }
        .link-row { margin-top: 20px; }
    </style>
</head>
<body>
<div class="page">
    <div class="navigation">
        <a href="{{ path('app_home') }}">Accueil</a>
        <a href="{{ path('app_login') }}">Se connecter</a>
        <a href="{{ path('app_register') }}">Créer un compte</a>
    </div>
    <div class="card">
        {% block body %}{% endblock %}
    </div>
</div>
</body>
</html>
