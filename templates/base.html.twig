<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Loopi{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/loopi-design-system.css') }}" rel="stylesheet">
    <link rel="icon" type="image/png" href="{{ asset('images/branding/logo.png') }}">
    <style>
        /* Variables & shell dashboard : public/css/loopi-design-system.css */
        * { box-sizing: border-box; }
        body {
            font-family: 'DM Sans', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(165deg, var(--loopi-cream) 0%, #e8f4f2 45%, #dfeff0 100%);
            background-attachment: fixed;
            color: var(--loopi-text);
        }
        h1, h2, h3, h4, .navbar-brand { font-family: 'Outfit', sans-serif; }
        .navbar-loopi {
            background: linear-gradient(110deg, var(--loopi-deep) 0%, var(--loopi-forest) 55%, var(--loopi-leaf) 100%);
            padding: 0.65rem 0;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .navbar-loopi .navbar-brand {
            color: #fff !important;
            font-weight: 700;
            font-size: 1.45rem;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }
        .navbar-loopi .brand-mark {
            width: 38px; height: 38px;
            border-radius: 12px;
            background: rgba(255,255,255,0.18);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
        }
        .navbar-loopi .nav-link {
            color: rgba(255,255,255,0.92) !important;
            font-weight: 500;
            padding: 0.5rem 0.9rem !important;
            border-radius: 10px;
            transition: background .2s, transform .15s;
        }
        .navbar-loopi .nav-link:hover { background: rgba(255,255,255,0.12); }
        .navbar-loopi .nav-link.active { background: rgba(255,255,255,0.2); }
        .navbar-loopi .dropdown-menu {
            border: none;
            border-radius: 14px;
            box-shadow: var(--shadow);
            padding: 0.4rem;
        }
        .navbar-loopi .dropdown-item { border-radius: 10px; padding: 0.5rem 0.85rem; }
        .navbar-loopi .dropdown-item:hover { background: #e8f4f2; color: var(--loopi-deep); }
        .user-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--loopi-mint), #fff);
            color: var(--loopi-deep);
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255,255,255,0.35);
        }
        .btn-loopi {
            background: linear-gradient(135deg, var(--loopi-leaf), var(--loopi-forest));
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.55rem 1.15rem;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(26, 95, 95, 0.35);
        }
        .btn-loopi:hover { color: #fff; filter: brightness(1.06); transform: translateY(-1px); }
        .btn-loopi-outline {
            border: 2px solid rgba(255,255,255,0.55);
            color: #fff;
            background: transparent;
            font-weight: 600;
            border-radius: 12px;
            padding: 0.48rem 1rem;
        }
        .btn-loopi-outline:hover { background: rgba(255,255,255,0.15); color: #fff; }
        .card-loopi {
            border: none;
            border-radius: 18px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }
        .card-loopi .card-header {
            background: linear-gradient(90deg, var(--loopi-forest), var(--loopi-leaf));
            color: #fff;
            border: none;
            font-weight: 600;
        }
        main { flex: 1; }
        footer {
            background: linear-gradient(180deg, var(--loopi-deep) 0%, #062a2b 100%);
            color: rgba(255,255,255,0.88);
            padding: 2.5rem 0 1.25rem;
            margin-top: auto;
        }
        footer a { color: rgba(255,255,255,0.75); text-decoration: none; }
        footer a:hover { color: var(--loopi-mint); }
        .alert { border: none; border-radius: 12px; }
        .form-control, .form-select {
            border-radius: 0.75rem;
            border-color: #cbd5e1;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--loopi-leaf);
            box-shadow: 0 0 0 0.2rem rgba(20, 184, 166, 0.2);
        }
        .form-label { font-weight: 600; color: var(--loopi-text); font-size: 0.9rem; }
        .form-text, .invalid-feedback { font-size: 0.85rem; }
        .invalid-feedback { color: #b91c1c; }
        .was-validated .form-control:invalid, .form-control.is-invalid,
        .was-validated .form-select:invalid, .form-select.is-invalid {
            border-color: #f87171;
        }
        a.text-loopi { color: var(--loopi-forest) !important; }
        a.text-loopi:hover { color: var(--loopi-deep) !important; }
        .loopi-form-alert { border-left: 4px solid #dc2626 !important; }
        .loopi-surface {
            background: rgba(255,255,255,0.72);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.5);
        }
        .loopi-card-elevated {
            border: none;
            border-radius: 1.15rem;
            box-shadow: var(--shadow-lg);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .loopi-card-elevated:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 48px rgba(6, 78, 74, 0.14);
        }
        ul li .invalid-feedback.d-block { margin-top: 0.25rem; }
        {% block extra_styles %}{% endblock %}
    </style>
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block navbar %}
    <nav class="navbar navbar-expand-lg navbar-loopi">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img loopi-logo-img--nav" width="120" height="38">
                <span class="d-none d-sm-inline fw-bold">Loopi</span>
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Menu">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mt-2 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1"></i>Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_catalog') }}"><i class="bi bi-grid-3x3-gap me-1"></i>Galerie</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_events') }}"><i class="bi bi-calendar-event me-1"></i>Événements</a>
                    </li>
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link text-warning" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-1"></i>Administration</a>
                            </li>
                        {% elseif is_granted('ROLE_ORGANISATEUR') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_organisateur_dashboard') }}"><i class="bi bi-building me-1"></i>Espace organisateur</a>
                            </li>
                        {% elseif is_granted('ROLE_PARTICIPANT') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_participant_dashboard') }}"><i class="bi bi-person-hearts me-1"></i>Espace participant</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_dashboard') }}"><i class="bi bi-person-workspace me-1"></i>Mon espace</a>
                            </li>
                        {% endif %}
                    {% endif %}
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-avatar">{{ app.user.prenom|slice(0, 1)|upper }}</span>
                                <span class="d-none d-lg-inline">{{ app.user.prenom }}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="px-3 py-2 border-bottom small">
                                    <div class="fw-semibold">{{ app.user.prenom }} {{ app.user.nom }}</div>
                                    <div class="text-muted">{{ app.user.userIdentifier }}</div>
                                    <span class="badge rounded-pill mt-1" style="background:#e8f4f2;color:var(--loopi-deep);">
                                        {{ app.user.role.value }}
                                    </span>
                                </li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Administration</a></li>
                                {% elseif is_granted('ROLE_ORGANISATEUR') %}
                                    <li><a class="dropdown-item" href="{{ path('app_organisateur_dashboard') }}"><i class="bi bi-building me-2"></i>Espace organisateur</a></li>
                                {% elseif is_granted('ROLE_PARTICIPANT') %}
                                    <li><a class="dropdown-item" href="{{ path('app_participant_dashboard') }}"><i class="bi bi-person-hearts me-2"></i>Espace participant</a></li>
                                {% else %}
                                    <li><a class="dropdown-item" href="{{ path('app_dashboard') }}"><i class="bi bi-layout-text-sidebar me-2"></i>Mon espace</a></li>
                                {% endif %}
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right me-1"></i>Connexion</a></li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-loopi btn-sm" href="{{ path('app_register') }}"><i class="bi bi-person-plus me-1"></i>Inscription</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
    {% endblock %}

    {% block flash_messages %}
    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    {% endblock %}

    <main class="{% block main_class %}py-3{% endblock %}">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img" style="height:40px;width:auto;filter:brightness(0) invert(1);opacity:.92;">
                        <span class="fw-bold fs-5 text-white">Loopi</span>
                    </div>
                    <p class="small text-white-50 mb-0">Art recyclé, événements éco-responsables et communauté engagée — la même plateforme, des rôles adaptés à chaque profil.</p>
                    <div class="loopi-footer-logos border-secondary border-opacity-25">
                        <img src="{{ asset('images/branding/esprit.png') }}" alt="Esprit" class="loopi-logo-img loopi-logo-img--partner" loading="lazy">
                        <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img loopi-logo-img--partner-sm" style="filter:brightness(0) invert(1);" loading="lazy">
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="text-white mb-2">Navigation</h6>
                    <ul class="list-unstyled small">
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="{{ path('app_catalog') }}">Galerie</a></li>
                        <li><a href="{{ path('app_events') }}">Événements</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h6 class="text-white mb-2">Compte</h6>
                    <ul class="list-unstyled small">
                        {% if app.user %}
                            <li>
                                {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_dashboard') }}">Administration</a>
                                {% elseif is_granted('ROLE_ORGANISATEUR') %}<a href="{{ path('app_organisateur_dashboard') }}">Espace organisateur</a>
                                {% elseif is_granted('ROLE_PARTICIPANT') %}<a href="{{ path('app_participant_dashboard') }}">Espace participant</a>
                                {% else %}<a href="{{ path('app_dashboard') }}">Mon espace</a>{% endif %}
                            </li>
                        {% else %}
                            <li><a href="{{ path('app_login') }}">Connexion</a></li>
                            <li><a href="{{ path('app_register') }}">Inscription</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-3">
            <p class="small text-white-50 mb-0 text-center">&copy; {{ 'now'|date('Y') }} Loopi — Projet PIDEV · Base <code class="text-white-50">loopi_db</code></p>
        </div>
    </footer>
    {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block body_scripts %}{% endblock %}
</body>
</html>
