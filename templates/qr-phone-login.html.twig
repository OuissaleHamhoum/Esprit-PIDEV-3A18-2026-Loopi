<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion QR — Loopi</title>
  <style>
    :root{--bg:#F7F5F0;--card:#fff;--forest:#1E3A2F;--moss:#3D6B4F;--muted:#6B7468;--border:rgba(30,58,47,0.12);--danger:#DC3545}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#111}
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .card{width:min(520px,92vw);background:var(--card);border:1px solid var(--border);border-radius:18px;box-shadow:0 16px 40px rgba(17,21,16,.08);padding:18px}
    h1{margin:0 0 6px;font-size:1.1rem;color:var(--forest)}
    p{margin:0 0 14px;color:var(--muted);font-size:.92rem;line-height:1.45}
    label{display:block;font-size:.8rem;color:var(--forest);font-weight:700;margin:10px 0 6px}
    input{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--border);font-size:1rem;outline:none}
    input:focus{border-color:rgba(61,107,79,.6);box-shadow:0 0 0 3px rgba(61,107,79,.12)}
    .btn{width:100%;margin-top:14px;padding:12px 14px;border:none;border-radius:12px;background:linear-gradient(135deg,var(--forest),var(--moss));color:#fff;font-weight:800;font-size:1rem;cursor:pointer}
    .btn:disabled{opacity:.65;cursor:not-allowed}
    .err{display:none;margin-top:10px;padding:10px 12px;border-radius:12px;border:1px solid rgba(220,53,69,.25);background:rgba(220,53,69,.08);color:var(--danger);font-weight:700;font-size:.9rem}
    .ok{display:none;margin-top:10px;padding:10px 12px;border-radius:12px;border:1px solid rgba(16,185,129,.25);background:rgba(16,185,129,.08);color:#0f766e;font-weight:800;font-size:.9rem}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Connexion via QR Code</h1>
      <p>Entrez votre email et mot de passe sur votre téléphone. Si c’est correct, la session sur l’ordinateur sera connectée automatiquement.</p>

      <div id="err" class="err"></div>
      <div id="ok" class="ok"></div>

      <form id="f">
        <label for="email">Email</label>
        <input id="email" type="email" autocomplete="username" required placeholder="vous@email.com">

        <label for="password">Mot de passe</label>
        <input id="password" type="password" autocomplete="current-password" required placeholder="••••••••">

        <button id="btn" class="btn" type="submit">Se connecter</button>
      </form>
    </div>
  </div>

  <script>
    const token = {{ token|json_encode|raw }};
    const err = document.getElementById('err');
    const ok = document.getElementById('ok');
    const btn = document.getElementById('btn');

    function showErr(msg){ err.textContent = msg; err.style.display='block'; ok.style.display='none'; }
    function showOk(msg){ ok.textContent = msg; ok.style.display='block'; err.style.display='none'; }

    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      err.style.display = 'none';
      ok.style.display = 'none';

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      if (!email || !password) return;

      btn.disabled = true;
      btn.textContent = 'Connexion...';
      try{
        const res = await fetch(`/api/qr-login/approve/${encodeURIComponent(token)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success){
          showErr(data.message || 'Impossible de se connecter.');
          return;
        }
        showOk('Connexion approuvée. Vous pouvez retourner sur l’ordinateur.');
      }catch(e){
        showErr('Erreur réseau.');
      }finally{
        btn.disabled = false;
        btn.textContent = 'Se connecter';
      }
    });
  </script>
</body>
</html>

