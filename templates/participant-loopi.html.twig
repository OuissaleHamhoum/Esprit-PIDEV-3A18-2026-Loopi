async function loadUserStats() {
  try {
    const response = await fetch('/api/my-events', { credentials: 'include', headers: { 'Accept': 'application/json' } });
    if (response.ok) {
      const data = await response.json();
      const myEvents = data.events || data || [];
      const registeredCount = Array.isArray(myEvents) ? myEvents.length : 0;
      const kgEstimate = registeredCount * 15;
      const couponsCount = Math.floor(registeredCount / 2) + 1;
      document.getElementById('heroEventsCount').textContent = registeredCount;
      document.getElementById('heroKgCount').textContent = kgEstimate;
      document.getElementById('dashboardEventsCount').textContent = registeredCount;
      document.getElementById('dashboardKgCount').textContent = kgEstimate;
      document.getElementById('dashboardCouponsCount').textContent = couponsCount;
      document.getElementById('event-coupons-count').textContent = couponsCount;
      document.getElementById('heroCouponsCount').textContent = couponsCount;
    }
  } catch (error) { console.error('Erreur chargement stats:', error); }
}

