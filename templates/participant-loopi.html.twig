<div id="badgeModal" style="display:none;position:fixed;inset:0;background:rgba(15,28,21,0.85);backdrop-filter:blur(10px);z-index:4000;align-items:center;justify-content:center" onclick="if(event.target===this)closeBadgeModal()">
  <div style="background:var(--forest);border-radius:30px;width:480px;max-width:92vw;padding:40px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.4);animation:popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);position:relative;overflow:hidden">
