        {% endfor %}
      </div>
      <div>
        <select id="sortSelect" onchange="applyFilters()" style="padding:8px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:'DM Sans',sans-serif;font-size:.83rem;outline:none;background:var(--bg);color:var(--forest);font-weight:600;cursor:pointer;">
