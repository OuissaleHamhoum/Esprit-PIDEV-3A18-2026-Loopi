<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — Espace Participant</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #F4F1EB;
  --cream: #FAF8F3;
  --forest: #1E3A2F;
  --moss: #3D6B4F;
  --sage: #7A9E7E;
  --sand: #C9A96E;
  --rust: #B05A2F;
  --light: #FDFCF9;
  --dark: #111510;
  --muted: #6B7468;
  --card: #FFFFFF;
  --border: rgba(30,58,47,0.09);
  --shadow: 0 4px 24px rgba(30,58,47,0.08);
  --shadow-lg: 0 12px 48px rgba(30,58,47,0.14);
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--dark);
  min-height: 100vh;
}

/* ── NAVBAR ── */
.navbar {
  position: sticky;
  top: 0;
  z-index: 200;
  background: rgba(30,58,47,0.97);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64px;
}

.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-weight: 900;
  color: white;
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.leaf {
  width: 20px; height: 20px;
  background: var(--sage);
  border-radius: 60% 10% 60% 10%;
  transform: rotate(-20deg);
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  list-style: none;
}

.nav-links a {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 8px;
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  font-size: .83rem;
  font-weight: 500;
  transition: all .2s;
}

.nav-links a:hover { background: rgba(255,255,255,.08); color: white; }
.nav-links a.active { background: rgba(255,255,255,.12); color: white; }

.nav-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.notif-btn {
  position: relative;
  width: 36px; height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.1);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  font-size: .95rem;
  transition: background .2s;
}
.notif-btn:hover { background: rgba(255,255,255,.15); }
.notif-dot {
  position: absolute; top: 6px; right: 6px;
  width: 8px; height: 8px;
  background: var(--rust);
  border-radius: 50%;
  border: 2px solid var(--forest);
}

.nav-avatar {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--sage), var(--moss));
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: .95rem;
  font-weight: 700;
  color: white;
  cursor: pointer;
  border: 2px solid rgba(255,255,255,.2);
}

.btn-donate {
  padding: 8px 18px;
  border-radius: 9px;
  background: var(--sand);
  color: var(--forest);
  font-size: .82rem;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: all .2s;
  font-family: 'DM Sans', sans-serif;
}
.btn-donate:hover { background: #d4b070; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(201,169,110,.35); }

/* ── HERO / WELCOME STRIP ── */
.hero-strip {
  background: linear-gradient(135deg, var(--forest) 0%, var(--moss) 100%);
  padding: 48px 40px 52px;
  position: relative;
  overflow: hidden;
}

.hero-strip::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 280px; height: 280px;
  border-radius: 50%;
  background: rgba(122,158,126,.15);
}

.hero-strip::after {
  content: '';
  position: absolute;
  bottom: -80px; left: 30%;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: rgba(201,169,110,.08);
}

.hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  z-index: 1;
}

.hero-greeting {
  font-family: 'Playfair Display', serif;
  font-size: 2.2rem;
  font-weight: 700;
  color: white;
  line-height: 1.2;
}

.hero-sub {
  font-size: .9rem;
  color: rgba(255,255,255,.55);
  margin-top: 6px;
}

.hero-stats {
  display: flex;
  gap: 32px;
}

.hero-stat {
  text-align: center;
  padding: 16px 24px;
  background: rgba(255,255,255,.07);
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.1);
  backdrop-filter: blur(8px);
}

.hero-stat-val {
  font-family: 'Playfair Display', serif;
  font-size: 1.7rem;
  font-weight: 700;
  color: white;
  line-height: 1;
}

.hero-stat-lbl {
  font-size: .72rem;
  color: rgba(255,255,255,.5);
  margin-top: 4px;
  font-weight: 500;
}

/* ── TABS NAV ── */
.section-tabs {
  background: white;
  border-bottom: 1px solid var(--border);
  padding: 0 40px;
  display: flex;
  gap: 0;
  position: sticky;
  top: 64px;
  z-index: 100;
}

.stab {
  padding: 16px 22px;
  border-bottom: 3px solid transparent;
  cursor: pointer;
  font-size: .83rem;
  font-weight: 600;
  color: var(--muted);
  transition: all .2s;
  display: flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
  border-left: none; border-right: none; border-top: none;
  background: transparent;
  font-family: 'DM Sans', sans-serif;
}

.stab:hover { color: var(--forest); }
.stab.active { color: var(--forest); border-bottom-color: var(--moss); }

/* ── CONTENT ── */
.page-section {
  display: none;
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 40px 80px;
  animation: fadeUp .35s ease both;
}

.page-section.active { display: block; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── GRID LAYOUTS ── */
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 32px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 24px; }
.grid-3-2 { display: grid; grid-template-columns: 2fr 1fr; gap: 22px; margin-bottom: 24px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

/* ── CARD ── */
.card {
  background: white;
  border-radius: 18px;
  border: 1px solid var(--border);
  padding: 24px;
  transition: transform .2s, box-shadow .2s;
}

.card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }

.card-title {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--forest);
  margin-bottom: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title a {
  font-family: 'DM Sans', sans-serif;
  font-size: .75rem;
  font-weight: 600;
  color: var(--moss);
  text-decoration: none;
}

.card-title a:hover { text-decoration: underline; }

/* ── STAT CARD ── */
.stat-card {
  background: white;
  border-radius: 18px;
  border: 1px solid var(--border);
  padding: 22px;
  transition: transform .2s, box-shadow .2s;
}

.stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }

.stat-icon {
  width: 44px; height: 44px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem;
  margin-bottom: 14px;
}

.stat-val {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem;
  font-weight: 700;
  color: var(--forest);
  line-height: 1;
}

.stat-lbl { font-size: .75rem; color: var(--muted); margin-top: 5px; font-weight: 500; }
.stat-trend { font-size: .72rem; margin-top: 8px; font-weight: 600; }
.trend-up { color: #3D9B5A; }
.trend-neu { color: var(--muted); }

/* ── GALLERY GRID ── */
.gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.gal-item { border-radius: 14px; overflow: hidden; cursor: pointer; transition: transform .2s, box-shadow .2s; border: 1px solid var(--border); background: white; }
.gal-item:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.gal-img { height: 120px; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; position: relative; }
.gal-heart { position: absolute; top: 8px; right: 8px; background: rgba(255,255,255,.9); border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: .8rem; cursor: pointer; border: none; transition: transform .2s; box-shadow: 0 2px 8px rgba(0,0,0,.1); }
.gal-heart:hover { transform: scale(1.2); }
.gal-info { padding: 10px 12px 12px; }
.gal-name { font-size: .82rem; font-weight: 700; color: var(--forest); }
.gal-cat { font-size: .68rem; color: var(--muted); margin-top: 2px; }

/* ── EVENTS ── */
.event-item { display: flex; align-items: flex-start; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border); }
.event-item:last-child { border-bottom: none; padding-bottom: 0; }
.ev-date { background: var(--forest); color: white; border-radius: 10px; width: 46px; height: 50px; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; }
.ev-day { font-size: 1.15rem; font-weight: 700; line-height: 1; }
.ev-mon { font-size: .58rem; text-transform: uppercase; letter-spacing: .06em; opacity: .7; }
.ev-info .ev-title { font-size: .87rem; font-weight: 700; color: var(--forest); margin-bottom: 3px; }
.ev-info .ev-loc { font-size: .73rem; color: var(--muted); }
.ev-badge { margin-left: auto; padding: 4px 10px; border-radius: 50px; font-size: .67rem; font-weight: 700; flex-shrink: 0; }
.badge-inscrit { background: rgba(61,107,79,.1); color: var(--moss); }
.badge-dispo { background: rgba(201,169,110,.15); color: #9a7040; }

/* ── DONATIONS ── */
.don-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: .82rem; }
.don-row:last-child { border-bottom: none; }
.don-av { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .82rem; font-weight: 700; color: white; flex-shrink: 0; }
.don-coll { font-weight: 600; color: var(--forest); flex: 1; }
.don-amount { font-weight: 700; color: var(--moss); }
.don-status { padding: 3px 9px; border-radius: 50px; font-size: .64rem; font-weight: 700; }
.status-conf { background: rgba(61,155,90,.1); color: #3D9B5A; }
.status-pend { background: rgba(201,169,110,.15); color: #9a7040; }

/* ── COUPONS ── */
.coupon-card {
  background: linear-gradient(135deg, var(--forest), var(--moss));
  border-radius: 16px;
  padding: 18px 22px;
  color: white;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.coupon-code { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; }
.coupon-disc { font-size: .75rem; opacity: .65; margin-top: 3px; }
.coupon-pct { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; color: var(--sand); }

/* ── PROGRESS ── */
.prog-bar { height: 7px; background: rgba(30,58,47,.08); border-radius: 4px; overflow: hidden; margin: 6px 0; }
.prog-fill { height: 100%; border-radius: 4px; background: linear-gradient(to right, var(--moss), var(--sage)); }

/* ── PROFILE SECTION ── */
.profile-hero {
  background: linear-gradient(135deg, var(--forest), var(--moss));
  border-radius: 22px;
  padding: 36px;
  color: white;
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 24px;
}

.profile-avatar-lg {
  width: 90px; height: 90px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--sage), rgba(255,255,255,.3));
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 2.4rem;
  font-weight: 700;
  color: white;
  border: 3px solid rgba(255,255,255,.3);
  flex-shrink: 0;
}

.profile-info .profile-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.7rem;
  font-weight: 700;
}

.profile-info .profile-email { font-size: .85rem; opacity: .6; margin-top: 4px; }
.profile-info .profile-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 10px;
  padding: 4px 12px;
  background: rgba(255,255,255,.12);
  border-radius: 50px;
  font-size: .75rem;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,.15);
}

.profile-stats-strip {
  margin-left: auto;
  display: flex;
  gap: 20px;
}

.pstrip-stat {
  text-align: center;
  padding: 14px 18px;
  background: rgba(255,255,255,.09);
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.1);
}

.pstrip-val {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 700;
}

.pstrip-lbl { font-size: .68rem; opacity: .55; margin-top: 3px; }

/* ── FORM FIELDS ── */
.field-group { display: flex; flex-direction: column; gap: 5px; }
.field-group label { font-size: .76rem; font-weight: 600; color: var(--forest); }
.field-group input, .field-group select {
  padding: 11px 14px;
  border: 1.5px solid var(--border);
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: .86rem;
  outline: none;
  background: var(--bg);
  color: var(--dark);
  transition: border-color .2s;
}
.field-group input:focus, .field-group select:focus { border-color: var(--moss); }

/* ── BTNS ── */
.btn { padding: 9px 20px; border-radius: 10px; font-size: .82rem; font-weight: 600; cursor: pointer; transition: all .2s; border: none; font-family: 'DM Sans', sans-serif; }
.btn-primary { background: var(--forest); color: white; }
.btn-primary:hover { background: var(--moss); }
.btn-outline { background: transparent; color: var(--forest); border: 1.5px solid var(--border); }
.btn-outline:hover { border-color: var(--forest); }
.btn-sm { padding: 7px 16px; border-radius: 8px; font-size: .78rem; }

/* ── SECTION HEADING ── */
.section-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--forest);
  margin-bottom: 6px;
}

.section-sub { font-size: .84rem; color: var(--muted); margin-bottom: 28px; }

/* ── TOAST ── */
.toast {
  position: fixed;
  bottom: 28px; right: 28px;
  background: var(--forest);
  color: white;
  padding: 13px 22px;
  border-radius: 13px;
  font-size: .84rem;
  font-weight: 600;
  z-index: 9999;
  transform: translateY(80px);
  opacity: 0;
  transition: all .3s cubic-bezier(.34,1.56,.64,1);
  pointer-events: none;
  box-shadow: var(--shadow-lg);
}
.toast.show { transform: translateY(0); opacity: 1; }

/* ── EMPTY STATE ── */
.empty-state { text-align: center; padding: 56px 0; color: var(--muted); }
.empty-state .e-icon { font-size: 3.2rem; margin-bottom: 14px; }
.empty-state p { font-size: .86rem; line-height: 1.6; }

/* ── FOOTER ── */
footer {
  background: var(--forest);
  color: rgba(255,255,255,.5);
  text-align: center;
  padding: 28px 40px;
  font-size: .78rem;
}

footer span { color: var(--sage); font-weight: 600; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .navbar { padding: 0 20px; }
  .section-tabs { padding: 0 20px; overflow-x: auto; }
  .page-section { padding: 28px 20px 60px; }
  .hero-strip { padding: 36px 20px 40px; }
  .hero-inner { flex-direction: column; gap: 24px; align-items: flex-start; }
  .hero-stats { flex-wrap: wrap; gap: 12px; }
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-2 { grid-template-columns: 1fr; }
  .grid-3-2 { grid-template-columns: 1fr; }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .profile-hero { flex-direction: column; gap: 20px; }
  .profile-stats-strip { margin-left: 0; }
  .nav-links { display: none; }
}
</style>
</head>
<body>

<!-- ══ NAVBAR ══ -->
<nav class="navbar">
  <a href="#" class="nav-logo"><span class="leaf"></span> Loopi</a>

  <ul class="nav-links">
    <li><a href="#" class="active" onclick="showSection('accueil',this)">🏠 Accueil</a></li>
    <li><a href="#" onclick="showSection('galerie',this)">🎨 Galerie</a></li>
    <li><a href="#" onclick="showSection('evenements',this)">📅 Événements</a></li>
    <li><a href="#" onclick="showSection('collections',this)">♻️ Collections</a></li>
    <li><a href="#" onclick="showSection('dons',this)">🤝 Mes dons</a></li>
    <li><a href="#" onclick="showSection('coupons',this)">🎟️ Coupons</a></li>
    <li><a href="#" onclick="showSection('profil',this)">👤 Profil</a></li>
  </ul>

  <div class="nav-right">
    <div class="notif-btn" onclick="showToast('2 nouvelles notifications')">🔔<span class="notif-dot"></span></div>
    <div class="nav-avatar" onclick="showSection('profil', document.querySelector('[onclick*=profil]'))">T</div>
    <button class="btn-donate" onclick="showSection('collections', document.querySelector('[onclick*=collections]'))">♻️ Faire un don</button>
  </div>
</nav>

<!-- ══ HERO STRIP ══ -->
<div class="hero-strip">
  <div class="hero-inner">
    <div>
      <div class="hero-greeting">Bonjour, Test 👋</div>
      <div class="hero-sub">Voici un aperçu de votre activité sur Loopi · Avril 2026</div>
    </div>
    <div class="hero-stats">
      <div class="hero-stat" style="cursor:pointer" onclick="showSection('galerie',null)">
        <div class="hero-stat-val">8</div>
        <div class="hero-stat-lbl">Favoris</div>
      </div>
      <div class="hero-stat" style="cursor:pointer" onclick="showSection('dons',null)">
        <div class="hero-stat-val">32.8 kg</div>
        <div class="hero-stat-lbl">Donnés</div>
      </div>
      <div class="hero-stat" style="cursor:pointer" onclick="showSection('evenements',null)">
        <div class="hero-stat-val">2</div>
        <div class="hero-stat-lbl">Événements</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-val">2</div>
        <div class="hero-stat-lbl">Coupons</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ SECTION TABS (mobile-friendly) ══ -->
<div class="section-tabs">
  <button class="stab active" onclick="showSection('accueil',this)">🏠 Tableau de bord</button>
  <button class="stab" onclick="showSection('galerie',this)">🎨 Galerie</button>
  <button class="stab" onclick="showSection('evenements',this)">📅 Événements</button>
  <button class="stab" onclick="showSection('collections',this)">♻️ Collections</button>
  <button class="stab" onclick="showSection('dons',this)">🤝 Dons</button>
  <button class="stab" onclick="showSection('coupons',this)">🎟️ Coupons</button>
  <button class="stab" onclick="showSection('profil',this)">👤 Profil</button>
</div>

<!-- ══════════════════════════════ -->
<!-- ACCUEIL -->
<!-- ══════════════════════════════ -->
<section id="sec-accueil" class="page-section active">
  <div class="section-heading">Vue d'ensemble</div>
  <div class="section-sub">Vos statistiques, galerie récente et prochains événements</div>

  <!-- Stats row -->
  <div class="grid-4">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(61,107,79,.1)">❤️</div>
      <div class="stat-val">8</div>
      <div class="stat-lbl">Œuvres en favoris</div>
      <div class="stat-trend trend-up">↑ 2 cette semaine</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(201,169,110,.12)">🤝</div>
      <div class="stat-val">32,8</div>
      <div class="stat-lbl">kg donnés au total</div>
      <div class="stat-trend trend-up">↑ 24.6 kg ce mois</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(176,90,47,.1)">📅</div>
      <div class="stat-val">2</div>
      <div class="stat-lbl">Événements rejoints</div>
      <div class="stat-trend trend-neu">→ Prochain: 15 juin</div>
