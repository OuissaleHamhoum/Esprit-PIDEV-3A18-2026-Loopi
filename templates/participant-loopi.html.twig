  document.getElementById('profileNameLarge').innerHTML = userName;
  ['profileAvatar','profileAvatarLarge','profileAvatarEdit','navAvatar'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = userName.charAt(0);
  });
  initGallery();
  loadParticipantEvents();
  loadUserStats();
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
    closeMobileNavDirect();
  }
});

// ─────────────────────────────────────────────────────────────────
// ── DYNAMIC COLLECTIONS + DONATE + LEADERBOARD + HISTORY ──
// ─────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────
// ── PARTICIPANT COLLECTIONS ──
// ─────────────────────────────────────────────────────────────────
let _partAllColl = [];

async function loadParticipantCollections() {
  const grid = document.getElementById('partCollGrid');
  const loader = document.getElementById('partCollLoading');
  loader.style.display = 'block';
  grid.querySelectorAll('.part-coll-card').forEach(c => c.remove());

  try {
    const res  = await fetch('/api/participant/collections?status=active');
    const json = await res.json();
    _partAllColl = json.data || [];
    
    if (json.weather) {
        const wDiv = document.getElementById('weatherDisplay');
        if (wDiv) {
            wDiv.style.display = 'block';
            wDiv.innerHTML = '⛅ <strong>' + json.weather + '</strong> — Sortez recycler en toute sérénité !';
        }
    }
    
    renderPartCollections(_partAllColl);
  } catch {
    loader.innerHTML = '<div style="font-size:1.5rem">⚠️</div><div>Erreur de chargement.</div>';
  }
}

function filterPartCollections() {
  const s = (document.getElementById('partCollSearch')?.value || '').toLowerCase();
  const m = document.getElementById('partCollMaterial')?.value || '';
  const filtered = _partAllColl.filter(c => {
    if (s && !c.title.toLowerCase().includes(s) && !c.materialType.toLowerCase().includes(s)) return false;
    if (m && c.materialType !== m) return false;
    return true;
  });
  renderPartCollections(filtered);
}

function renderPartCollections(list) {
  const grid   = document.getElementById('partCollGrid');
  const loader = document.getElementById('partCollLoading');
  grid.querySelectorAll('.part-coll-card').forEach(c => c.remove());
  loader.style.display = 'none';
  document.getElementById('partCollCount').textContent = list.length + ' collection(s)';

  if (list.length === 0) {
    const el = document.createElement('div');
    el.className = 'part-coll-card';
    el.style.cssText = 'grid-column:1/-1;text-align:center;padding:60px 0;color:var(--muted)';
    el.innerHTML = '<div style="font-size:3rem;margin-bottom:12px">📭</div><p>Aucune collection active pour le moment.</p>';
    grid.appendChild(el);
    return;
  }

  const sortedList = [...list].sort((a, b) => {
    const aFin = a.currentAmount >= a.goalAmount;
    const bFin = b.currentAmount >= b.goalAmount;
    if (aFin !== bFin) return aFin ? 1 : -1;
    return b.currentAmount - a.currentAmount;
  });

  sortedList.forEach(c => {
    const pct = Math.min(c.progress || (c.currentAmount/c.goalAmount*100), 100);
    const isFinished = c.currentAmount >= c.goalAmount;
    const card = document.createElement('div');
    card.className = 'part-coll-card card';
    card.style.padding = '0';
    card.style.overflow = 'hidden';
    if (isFinished) {
      card.style.filter = 'grayscale(80%) opacity(0.85)';
    }

    const imgHtml = c.imageUrl
      ? `<div style="height:160px;overflow:hidden"><img src="${c.imageUrl}" style="width:100%;height:100%;object-fit:cover"></div>`
      : `<div style="height:100px;background:linear-gradient(135deg,var(--forest),var(--moss));display:flex;align-items:center;justify-content:center;font-size:3rem">♻️</div>`;

    card.innerHTML = `
      ${imgHtml}
      <div style="padding:18px">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
          <div style="font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:var(--forest)">${escH(c.title)}</div>
          <span style="padding:3px 10px;border-radius:50px;font-size:.65rem;font-weight:700;background:rgba(61,107,79,.1);color:var(--moss)">${escH(c.materialType)}</span>
        </div>
        <div style="font-size:.75rem;color:var(--muted);margin-bottom:10px">👤 ${escH(c.organisateur || 'Organisateur')}</div>
        <div style="background:rgba(30,58,47,.07);border-radius:5px;height:7px;overflow:hidden;margin-bottom:5px">
          <div style="height:100%;width:${pct}%;background:linear-gradient(to right,var(--moss),var(--sage));border-radius:5px;transition:width .5s ease"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);margin-bottom:14px">
          <span style="font-weight:600;color:var(--moss)">${c.currentAmount.toFixed(1)} ${escH(c.unit)}</span>
          <span>${pct.toFixed(1)}% — Objectif: ${c.goalAmount} ${escH(c.unit)}</span>
        </div>
        ${isFinished 
          ? `<button disabled style="width:100%;padding:10px;border-radius:10px;border:none;background:var(--muted);color:white;font-family:'DM Sans',sans-serif;font-size:.84rem;font-weight:600;cursor:not-allowed">Objectif atteint 🎉</button>`
          : `<button onclick='openDonateModal(${JSON.stringify(c).replace(/'/g, "&apos;")})' style="width:100%;padding:10px;border-radius:10px;border:none;background:var(--forest);color:white;font-family:'DM Sans',sans-serif;font-size:.84rem;font-weight:600;cursor:pointer;transition:background .2s" onmouseover="this.style.background='var(--moss)'" onmouseout="this.style.background='var(--forest)'">♻️ Faire un don</button>`
        }
      </div>`;
    grid.appendChild(card);
  });
}

// ─────────────────────────────────────────────────────────────────
// ── DONATE MODAL ──
// ─────────────────────────────────────────────────────────────────
let _donateCollId = null;

function openDonateModal(c) {
  _donateCollId = c.id;
  const pct = Math.min(c.progress, 100);
  document.getElementById('donateCollName').textContent = c.title;
  document.getElementById('donateCollMat').textContent  = c.materialType + ' · ' + c.donationsCount + ' donation(s)';
  document.getElementById('donateProgBar').style.width  = pct + '%';
  document.getElementById('donateProgNums').innerHTML   =
    `<span style="font-weight:600;color:var(--moss)">${c.currentAmount.toFixed(1)} ${escH(c.unit)}</span><span>Objectif: ${c.goalAmount} ${escH(c.unit)}</span>`;
  document.getElementById('donateUnit').textContent  = c.unit;
  document.getElementById('donateAmount').value      = '';
  document.getElementById('donateError').style.display = 'none';
  document.getElementById('donateModal').style.display = 'flex';
  setTimeout(() => document.getElementById('donateAmount').focus(), 80);
}

function closeDonateModal() {
  document.getElementById('donateModal').style.display = 'none';
  _donateCollId = null;
}

async function submitDonate() {
  const amountVal = document.getElementById('donateAmount').value.trim();
  const errEl = document.getElementById('donateError');
  errEl.style.display = 'none';

  if (!amountVal || isNaN(amountVal) || parseFloat(amountVal) <= 0) {
    errEl.textContent = 'Veuillez entrer un montant valide et positif.';
    errEl.style.display = 'block';
    return;
  }

  const btn = document.getElementById('donateSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Envoi en cours…';

  try {
    const res = await fetch('/api/participant/donate/' + _donateCollId, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount: parseFloat(amountVal) })
    });
    const json = await res.json();

    if (json.success) {
      closeDonateModal();
      
      if (json.ai_message) {
          // Show AI message ABOVE the other toasts (bottom:100px to not overlap)
          setTimeout(() => {
              const toast = document.createElement('div');
              toast.style.cssText = 'position:fixed;bottom:90px;right:24px;background:#1E3A2F;color:white;padding:14px 18px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.2);z-index:9999;font-size:0.85rem;max-width:300px;text-align:left;line-height:1.5;';
              toast.innerHTML = '<div style="font-size:0.7rem;color:rgba(255,255,255,0.55);margin-bottom:5px;">🤖 IA Gemini</div>' + json.ai_message;
              document.body.appendChild(toast);
              setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.5s'; setTimeout(() => toast.remove(), 500); }, 6000);
          }, 1500);
      }

      if (json.badges && json.badges.length > 0) {
          setTimeout(() => { triggerBadgeCelebration(json.badges); }, 300);
      } else {
          showToast('✅ Don de ' + amountVal + ' enregistré avec succès!');
      }
      if (json.xp_awarded && json.multiplier) {
          let multiplierHtml = json.multiplier > 1 ? ` (+ Bonus x${json.multiplier})` : '';
          setTimeout(() => showToast(`⚡ ${json.xp_awarded} XP gagnés${multiplierHtml} !`), 3000);
      }
      
      // Update the card in-place
      const updated = json.collection;
      const idx = _partAllColl.findIndex(c => c.id === updated.id);
      if (idx !== -1) _partAllColl[idx] = updated;
      renderPartCollections(_partAllColl.filter(c => {
        const s = (document.getElementById('partCollSearch')?.value || '').toLowerCase();
        const m = document.getElementById('partCollMaterial')?.value || '';
        if (s && !c.title.toLowerCase().includes(s) && !c.materialType.toLowerCase().includes(s)) return false;
        if (m && c.materialType !== m) return false;
        return true;
      }));
    } else {
      const msg = json.errors?.amount || json.message || 'Erreur inconnue.';
      errEl.textContent = msg;
      errEl.style.display = 'block';
    }
  } catch(err) {
    errEl.textContent = 'Erreur réseau: ' + err.message;
    errEl.style.display = 'block';
    console.error('Donation error:', err);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Confirmer le don';
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeDonateModal();
});

// ─────────────────────────────────────────────────────────────────
// ── LEADERBOARD ──
// ─────────────────────────────────────────────────────────────────
async function loadLeaderboard() {
  const cont = document.getElementById('leaderboardContainer');
  cont.innerHTML = '<div style="text-align:center;padding:30px;color:var(--muted)">Chargement...</div>';

  try {
    const res = await fetch('/api/participant/leaderboard');
    const json = await res.json();
    if (!json.success) {
      cont.innerHTML = `<div style="color:var(--rust)">⚠️ ${json.message}</div>`;
      return;
    }

    // Update global stat
    document.getElementById('heroMyRank').textContent = json.myRank ? `#${json.myRank}` : '--';
    
    // Update Personal Section
    document.getElementById('myCurrentXp').textContent = `${json.myXp} XP`;
    let myTitle = 'Eco-Novice';
    if (json.myXp >= 5000) myTitle = 'Gardien de la Terre';
    else if (json.myXp >= 2000) myTitle = 'Héros de la Planète';
    else if (json.myXp >= 500) myTitle = 'Recycleur Actif';
    document.getElementById('myCurrentRankTitle').textContent = myTitle;

    // Render list
    cont.innerHTML = '';
    if (json.data.length === 0) {
      cont.innerHTML = '<div style="text-align:center;color:var(--muted)">Aucun participant classé.</div>';
    }
    
    json.data.forEach(u => {
      let medal = `<div style="width:30px;font-weight:bold;color:var(--muted)">#${u.rank}</div>`;
      if (u.rank === 1) medal = `<div style="width:30px;font-size:1.3rem">🥇</div>`;
      if (u.rank === 2) medal = `<div style="width:30px;font-size:1.3rem">🥈</div>`;
      if (u.rank === 3) medal = `<div style="width:30px;font-size:1.3rem">🥉</div>`;

      let bgColor = u.isMe ? 'rgba(93,168,122,0.15)' : 'var(--card)';
      let border = u.isMe ? '1px solid var(--moss)' : '1px solid var(--border)';
      
      let titleBadge = '';
      if (u.title === 'Gardien de la Terre') titleBadge = 'background:linear-gradient(135deg,#c9a030,#8B6914);color:white;';
      else if (u.title === 'Héros de la Planète') titleBadge = 'background:rgba(93,168,122,0.2);color:var(--forest);';
      else if (u.title === 'Recycleur Actif') titleBadge = 'background:var(--bg);color:var(--moss);font-weight:600;';
      else titleBadge = 'background:var(--bg);color:var(--muted);';

      cont.innerHTML += `
        <div style="display:flex;align-items:center;padding:12px 18px;background:${bgColor};border:${border};border-radius:12px">
          ${medal}
          <div style="width:40px;height:40px;border-radius:50%;background:rgba(30,58,47,0.1);color:var(--forest);display:flex;align-items:center;justify-content:center;font-weight:bold;margin:0 15px 0 5px">${u.name.charAt(0).toUpperCase()}</div>
          <div style="flex:1">
            <div style="font-weight:bold;color:${u.isMe ? 'var(--forest)' : 'var(--dark)'}">${u.name} ${u.isMe ? '(Moi)' : ''}</div>
            <div style="font-size:0.75rem;padding:2px 8px;border-radius:4px;display:inline-block;margin-top:4px;${titleBadge}">${u.title}</div>
          </div>
          <div style="font-family:'Playfair Display',serif;font-weight:bold;font-size:1.2rem;color:var(--forest)">${u.xp} XP</div>
        </div>
      `;
    });

  } catch(e) {
    cont.innerHTML = '<div style="color:var(--rust)">Erreur de chargement.</div>';
  }
}

// ─────────────────────────────────────────────────────────────────
// ── DONATION HISTORY ──
// ─────────────────────────────────────────────────────────────────
async function loadDonationHistory() {
  const cont = document.getElementById('donsContainer');
  cont.innerHTML = '<div style="text-align:center;padding:60px 0;color:var(--muted)"><div style="font-size:2rem">⏳</div><div>Chargement…</div></div>';

  try {
    const res  = await fetch('/api/participant/donations');
    const json = await res.json();
    if (!json.success) {
      cont.innerHTML = '<div class="card" style="text-align:center;padding:40px;color:red">⚠️ ' + (json.message || 'Erreur inconnue') + '</div>';
      return;
    }
    const donations = json.data || [];

    if (donations.length === 0) {
      cont.innerHTML = `
        <div class="card" style="text-align:center;padding:50px">
          <div style="font-size:3rem;margin-bottom:14px">🤍</div>
          <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--forest);margin-bottom:8px">Pas encore de dons</div>
          <div style="font-size:.85rem;color:var(--muted);margin-bottom:20px">Visitez les collections actives et faites votre première contribution!</div>
          <button class="btn btn-primary" onclick="showSection('collections', document.querySelector('[onclick*=collections]'))">♻️ Voir les collections</button>
        </div>`;
      return;
    }

    // Group by collection for summaries
    const totals = {};
    donations.forEach(d => {
      if (d.collectionId) {
        totals[d.collectionId] = totals[d.collectionId] || { title: d.collection, unit: d.unit, total: 0 };
        totals[d.collectionId].total += parseFloat(d.amount);
      }
    });

    const statusColors = { 'confirmé': '#3D9B5A', 'en_attente': '#9a7040', 'annulé': '#B05A2F' };
    const statusLabels = { 'confirmé': '✓ Confirmé', 'en_attente': '⏳ En attente', 'annulé': '✗ Annulé' };
    const colours = ['linear-gradient(135deg,var(--moss),var(--forest))','linear-gradient(135deg,var(--sand),#a08040)','linear-gradient(135deg,#7a6a5a,#5a4a3d)','linear-gradient(135deg,var(--sage),var(--moss))'];

    let badgesHtml = '';
    if (json.badges && json.badges.length > 0) {
      badgesHtml = '<div class="card" style="margin-bottom:20px"><div class="card-title">🏆 Mes Badges Débloqués</div><div style="display:flex;gap:15px;flex-wrap:wrap;padding:10px 0">';
      json.badges.forEach(b => {
        // Use lowercase filenames matching those uploaded by user
        let safeBadgeName = b.replace(/\s+/g,'_').toLowerCase();
        badgesHtml += `<div style="text-align:center;padding:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;width:120px;transition:transform .2s" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
          <div style="font-size:2.5rem;margin-bottom:10px;height:50px;display:flex;align-items:center;justify-content:center"><img src="/images/${safeBadgeName}.png" alt="${b}" style="max-height:100%;max-width:100%" onerror="this.outerHTML='🎖️'"></div>
          <div style="font-size:0.75rem;font-weight:bold;color:var(--forest)">${escH(b)}</div>
        </div>`;
      });
      badgesHtml += '</div></div>';
    }

    cont.innerHTML = badgesHtml + `
      <div class="grid-2">
        <div class="card">
          <div class="card-title">Historique complet</div>
          <div id="donsList"></div>
        </div>
        <div class="card">
          <div class="card-title">Résumé par collection</div>
          <div id="donsSummary"></div>
        </div>
      </div>`;

    const listEl = document.getElementById('donsList');
    donations.forEach((d, i) => {
      const col = colours[i % colours.length];
      const statusC = statusColors[d.status] || '#888';
      const statusL = statusLabels[d.status] || d.status;
      const initial = (d.collection || 'D')[0].toUpperCase();
      listEl.innerHTML += `
        <div class="don-row">
          <div class="don-av" style="background:${col}">${initial}</div>
          <div style="flex:1">
            <div class="don-coll">${escH(d.collection || 'Collection supprimée')}</div>
            <div style="font-size:.7rem;color:var(--muted)">${escH(d.materialType || '')} · ${escH(d.date || '')}</div>
          </div>
          <span class="don-amount">${parseFloat(d.amount).toFixed(1)} ${escH(d.unit || '')}</span>
          <span class="don-status" style="background:${statusC}20;color:${statusC}">${statusL}</span>
        </div>`;
    });

    const sumEl = document.getElementById('donsSummary');
    Object.values(totals).forEach(t => {
      sumEl.innerHTML += `
        <div style="padding:12px 0;border-bottom:1px solid var(--border)";>
          <div style="font-weight:600;color:var(--forest);font-size:.87rem;margin-bottom:4px">${escH(t.title)}</div>
          <div style="font-size:.8rem;color:var(--moss);font-weight:700">${t.total.toFixed(2)} ${escH(t.unit || '')}</div>
        </div>`;
    });

  } catch {
    cont.innerHTML = '<div class="card" style="text-align:center;padding:40px">⚠️ Erreur de chargement de l\'historique.</div>';
  }
}

// ── HTML escape ──
function escH(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
</body>
</html>