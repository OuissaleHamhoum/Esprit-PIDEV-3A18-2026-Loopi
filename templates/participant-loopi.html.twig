// ===== MANAGE PARTICIPATIONS =====
let currentEditingParticipationId = null;
let allMyParticipations = []; // cache des données brutes
let partFilters = { status: 'all', sort: 'asc' };

function openManageParticipationsModal() {
  document.getElementById('manageParticipationsModal').classList.add('active');
  loadMyParticipations();
}

function closeManageParticipationsModal() {
  document.getElementById('manageParticipationsModal').classList.remove('active');
}

function setPartFilter(type, value, btn) {
  partFilters[type] = value;
  // Mettre à jour les boutons actifs du même groupe
  document.querySelectorAll(`.part-filter-btn[data-filter="${type}"]`).forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  filterParticipations();
}

function resetPartFilters() {
  partFilters = { status: 'all', sort: 'asc' };
  document.querySelectorAll('.part-filter-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.part-filter-btn[data-value="all"], .part-filter-btn[data-value="asc"]').forEach(b => b.classList.add('active'));
  const searchInput = document.getElementById('partSearch');
  if (searchInput) searchInput.value = '';
  filterParticipations();
}

function filterParticipations() {
  const search = (document.getElementById('partSearch')?.value || '').toLowerCase().trim();
  const now = new Date();

  let filtered = allMyParticipations.filter(event => {
    // Filtre recherche
    const matchSearch = !search
      || (event.titre || '').toLowerCase().includes(search)
      || (event.lieu || '').toLowerCase().includes(search)
      || (event.contact || '').toLowerCase().includes(search);

    // Filtre statut
    const d = event.date_evenement ? new Date(event.date_evenement) : null;
    let matchStatus = true;
    if (partFilters.status === 'upcoming') matchStatus = d ? d >= now : false;
    if (partFilters.status === 'past')     matchStatus = d ? d < now  : false;

    return matchSearch && matchStatus;
  });

  // Tri par date
  filtered.sort((a, b) => {
    const da = a.date_evenement ? new Date(a.date_evenement) : new Date(0);
    const db = b.date_evenement ? new Date(b.date_evenement) : new Date(0);
    return partFilters.sort === 'asc' ? da - db : db - da;
  });

  renderParticipations(filtered, allMyParticipations.length);
}

function renderParticipations(events, total) {
  const container = document.getElementById('participationsListContainer');
  const countEl   = document.getElementById('partCount');
  const now = new Date();

  if (countEl) {
    const txt = events.length === total
      ? `${total} participation${total > 1 ? 's' : ''}`
      : `${events.length} résultat${events.length > 1 ? 's' : ''} sur ${total}`;
    countEl.textContent = txt;
  }

  if (events.length === 0) {
    container.innerHTML = `
      <div class="part-empty">
        <div class="part-empty-icon"><i class="fas fa-search"></i></div>
        <h4>Aucun résultat</h4>
        <p>Aucune participation ne correspond à vos critères de recherche.<br>Essayez de modifier vos filtres.</p>
      </div>`;
    return;
  }

  container.innerHTML = events.map(event => {
    const d       = event.date_evenement ? new Date(event.date_evenement) : null;
    const isPast  = d ? d < now : false;
    const day     = d ? d.getDate() : '—';
    const mon     = d ? ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'][d.getMonth()] : '';
    const dateStr = d ? d.toLocaleDateString('fr-FR', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) : '-';

    const safeTitle     = escapeHtml(event.titre);
    const safeLieu      = escapeHtml(event.lieu || '-');
    const safeContact   = escapeHtml(event.contact || '-');
    const safeAge       = event.age || '-';
    const safeTitleJs   = safeTitle.replace(/'/g, "\\'");
    const safeContactJs = escapeHtml(event.contact || '').replace(/'/g, "\\'");

    const statusBadge = isPast
      ? `<span class="sbadge" style="background:rgba(107,116,104,0.12);color:var(--muted);font-size:0.63rem;padding:3px 10px;"><i class="fas fa-check-double" style="margin-right:4px"></i>Terminé</span>`
      : `<span class="sbadge sbadge-registered" style="font-size:0.63rem;padding:3px 10px;"><i class="fas fa-clock" style="margin-right:4px"></i>À venir</span>`;

    const dateBoxStyle = isPast
      ? `background:linear-gradient(135deg,var(--muted),var(--muted-light));`
      : `background:linear-gradient(135deg,var(--forest),var(--moss));`;

    return `
      <div class="part-card" style="${isPast ? 'opacity:0.82' : ''}">
        <div class="part-date-box" style="${dateBoxStyle}">
          <div class="part-date-day">${day}</div>
          <div class="part-date-mon">${mon}</div>
        </div>
        <div class="part-info">
          <div class="part-title">${safeTitle}</div>
          <div class="part-meta">
            <span><i class="fas fa-calendar-alt"></i> ${dateStr}</span>
            <span><i class="fas fa-map-marker-alt"></i> ${safeLieu}</span>
          </div>
          <div class="part-details-row">
            <span class="part-detail-chip"><i class="fas fa-phone"></i> ${safeContact}</span>
            ${safeAge !== '-' ? `<span class="part-detail-chip"><i class="fas fa-birthday-cake"></i> ${safeAge} ans</span>` : ''}
            ${statusBadge}
          </div>
        </div>
        <div class="part-actions">
          ${!isPast ? `<button class="btn btn-primary btn-sm" onclick="openEditParticipationModal(${event.id},'${safeTitleJs}','${safeContactJs}','${safeAge}')">
            <i class="fas fa-edit"></i> Modifier
          </button>` : `<button class="btn btn-outline btn-sm" disabled style="opacity:0.45;cursor:not-allowed;">
            <i class="fas fa-edit"></i> Modifier
          </button>`}
          <button class="btn btn-outline btn-sm" style="color:var(--danger);border-color:var(--danger);" onclick="cancelParticipation(${event.id})">
            <i class="fas fa-trash-alt"></i> Annuler
          </button>
        </div>
      </div>`;
  }).join('');
}

async function loadMyParticipations() {
  const container = document.getElementById('participationsListContainer');
  const countEl   = document.getElementById('partCount');
  container.innerHTML = '<div class="loading-spinner"><div class="spinner"></div>Chargement…</div>';
  if (countEl) countEl.textContent = '';

  try {
    const response = await fetch('/api/my-events', { credentials: 'include', headers: { 'Accept': 'application/json' } });
    if (!response.ok) throw new Error('Erreur réseau');
    const data = await response.json();
    allMyParticipations = data.events || [];

    if (allMyParticipations.length === 0) {
      if (countEl) countEl.textContent = 'Aucune participation';
      container.innerHTML = `
        <div class="part-empty">
          <div class="part-empty-icon"><i class="fas fa-calendar-times"></i></div>
          <h4>Aucune participation</h4>
          <p>Vous n'êtes inscrit à aucun événement pour le moment.<br>Explorez les événements disponibles et rejoignez-en un !</p>
        </div>`;
      return;
    }

    // Réinitialiser les filtres visuels
    resetPartFilters();

  } catch (error) {
    console.error('Erreur:', error);
    if (countEl) countEl.textContent = '';
    container.innerHTML = `
      <div style="text-align:center;padding:40px;color:var(--danger);">
        <i class="fas fa-exclamation-triangle" style="font-size:2rem;margin-bottom:12px;display:block;opacity:.7"></i>
        Erreur lors du chargement de vos participations.
      </div>`;
  }
}

function openEditParticipationModal(eventId, eventName, contact, age) {
  currentEditingParticipationId = eventId;
  document.getElementById('editPartEventName').textContent = eventName;
  document.getElementById('editPartContact').value = contact !== '-' ? contact : '';
  document.getElementById('editPartAge').value = age !== '-' ? age : '';
