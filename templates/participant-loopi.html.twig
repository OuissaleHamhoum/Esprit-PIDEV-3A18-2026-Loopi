<script>
// ── Section switching ──
function showSection(name, triggerEl) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.getElementById('sec-' + name).classList.add('active');

  // sync both nav-links and stabs
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  document.querySelectorAll('.stab').forEach(b => b.classList.remove('active'));

  const navLink = document.querySelector(`.nav-links a[onclick*="${name}"]`);
  const stab = document.querySelector(`.stab[onclick*="${name}"]`);
  if (navLink) navLink.classList.add('active');
  if (stab) stab.classList.add('active');

  if (name === 'recommandations') {
    loadRecommendations();
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── Recommendations loading ──
async function loadRecommendations() {
  const containerForYou = document.getElementById('recom-foryou');
  const containerTopRated = document.getElementById('recom-toprated');
  if (!containerForYou || !containerTopRated) return;

  try {
    const res = await fetch('/api/participant/recommendations');
    const data = await res.json();
    if (!data.success) return;

    // Render "Pour vous"
    containerForYou.innerHTML = data.forYou.length > 0 
      ? data.forYou.map(p => renderRecomCard(p)).join('')
      : '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--muted);">Ajoutez des produits à vos favoris pour obtenir des recommandations personnalisées !</div>';

    // Render "Les mieux notées"
    containerTopRated.innerHTML = data.topRated.length > 0 
      ? data.topRated.map(p => renderRecomCard(p, true)).join('')
      : '<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--muted);">Aucun produit noté pour le moment.</div>';

  } catch (error) {
    console.error('Error loading recommendations:', error);
  }
}

function renderRecomCard(p, showRating = false) {
  return `
    <div class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);">
      <div style="height: 150px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
        ${p.imageProduit 
          ? `<img src="/uploads/${p.imageProduit}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;">`
          : '<span style="font-size: 3rem; filter: grayscale(1); opacity: 0.3;">🖼️</span>'
        }
        <div style="position: absolute; top: 12px; right: 12px; padding: 4px 10px; background: rgba(255,255,255,0.95); border-radius: 50px; font-size: 0.65rem; font-weight: 700; color: var(--forest); box-shadow: 0 2px 8px rgba(0,0,0,0.1); backdrop-filter: blur(4px);">
          ${p.category}
        </div>
      </div>
      <div style="padding: 18px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--forest); margin-bottom: 6px; line-height: 1.3;">${p.nomProduit}</div>
          ${showRating 
            ? `<div style="display: flex; align-items: center; gap: 4px; color: #ffc107; font-size: 0.85rem;">
                <span style="letter-spacing: 1px;">${'★'.repeat(Math.round(p.avgRating))}${'☆'.repeat(5 - Math.round(p.avgRating))}</span>
                <span style="color: var(--muted); font-size: 0.72rem; font-weight: 500;">(${p.avgRating.toFixed(1)})</span>
               </div>`
            : ''
          }
        </div>
        <button class="btn btn-outline btn-sm" style="width: 100%; margin-top: 16px; font-size: 0.75rem; border-radius: 8px;" onclick="window.location.href='/produit/detaile/${p.id}'">Découvrir l'œuvre</button>
      </div>
    </div>
  `;
}

// ── Product Modal ──
function openProductModal(card) {
  const name = card.dataset.name;
  const description = card.dataset.description;
  const category = card.dataset.category;
  const image = card.dataset.image;

  document.getElementById('modalName').textContent = name;
  document.getElementById('modalDescription').textContent = description;
  document.getElementById('modalCategory').textContent = category;

  const imgDiv = document.getElementById('modalImage');
  if (image) {
    imgDiv.innerHTML = `<img src="/uploads/${image}" alt="${name}" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">`;
  } else {
    imgDiv.innerHTML = '🎨';
  }

  document.getElementById('productModal').style.display = 'flex';
}

function closeProductModal() {
  document.getElementById('productModal').style.display = 'none';
}

// Close modal when clicking outside
document.getElementById('productModal').addEventListener('click', function(event) {
  if (event.target === this) {
    closeProductModal();
  }
});

// ── Toast ──
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2600);
}

// ── Heart toggle ──
function toggleHeart(btn) {
  btn.textContent = btn.textContent === '🤍' ? '❤️' : '🤍';
}

// ── Gallery filter, search & sort ──
let currentCat = 'Tous';

function filterCat(btn, cat) {
  document.querySelectorAll('.cat-btn').forEach(b => {
    b.className = 'btn btn-outline btn-sm cat-btn';
  });
  btn.className = 'btn btn-primary btn-sm cat-btn';
  currentCat = cat;
  applyFilters();
}

function applyFilters() {
  const searchInput = document.getElementById('searchInput');
  const searchQuery = searchInput ? searchInput.value.toLowerCase() : '';
  const sortSelect = document.getElementById('sortSelect');
  const sortOption = sortSelect ? sortSelect.value : 'newest';
  
  const grid = document.getElementById('galleryGrid');
  if (!grid) return;
  
  const cards = Array.from(grid.querySelectorAll('.gallery-item'));

  cards.forEach(card => {
    const name = card.dataset.name || '';
    const cat = card.dataset.cat || '';
    
    const matchesSearch = name.includes(searchQuery);
    const matchesCat = (currentCat === 'Tous' || cat === currentCat);
    
    if (matchesSearch && matchesCat) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });

  // Sorting
  const visibleCards = cards.filter(card => card.style.display !== 'none');
  
  visibleCards.sort((a, b) => {
    if (sortOption === 'az') {
      return (a.dataset.name || '').localeCompare(b.dataset.name || '');
    } else if (sortOption === 'za') {
      return (b.dataset.name || '').localeCompare(a.dataset.name || '');
    } else {
      // newest (by id desc)
      return parseInt(b.dataset.id || 0) - parseInt(a.dataset.id || 0);
    }
  });

  // Re-append to DOM to apply sort visually
  visibleCards.forEach(card => grid.appendChild(card));
}

// Init filtering on load just in case
document.addEventListener('DOMContentLoaded', () => {
  applyFilters();
});
</script>

