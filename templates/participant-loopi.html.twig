<script>
// ===== GLOBAL VARIABLES =====
let eventsList = [];
let currentSubscribingEvent = null;
let currentDetailEvent = null;
let galleryItems = [];

// ===== MOBILE NAV =====
function openMobileNav() { document.getElementById('mobileNav').classList.add('open'); }
function closeMobileNavDirect() { document.getElementById('mobileNav').classList.remove('open'); }
function closeMobileNav(e) { if (e.target === e.currentTarget) closeMobileNavDirect(); }

// ===== UTILITY FUNCTIONS =====
function showToast(message, type = 'success') {
  const toast = document.getElementById('toast');
  let icon = '';
  switch(type) {
    case 'success': icon = '<i class="fas fa-check-circle"></i> '; break;
    case 'error': icon = '<i class="fas fa-exclamation-circle"></i> '; break;
    case 'warning': icon = '<i class="fas fa-exclamation-triangle"></i> '; break;
    default: icon = '<i class="fas fa-info-circle"></i> ';
  }
  toast.innerHTML = icon + message;
  toast.className = 'toast ' + (type === 'error' ? 'error' : type === 'warning' ? 'warning' : type === 'info' ? 'info' : '');
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3200);
}

function formatDate(dateString) {
  if (!dateString) return '-';
  return new Date(dateString).toLocaleDateString('fr-FR');
}

function getMonthName(month) {
  return ['Jan','Fév','Mar','Avr','Mai','Juin','Juil','Aoû','Sep','Oct','Nov','Déc'][month];
}

function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function copyCouponCode(code) {
  navigator.clipboard.writeText(code).catch(() => {});
  showToast(`Code <strong>${code}</strong> copié dans le presse-papier !`, 'success');
}

// ===== SECTION SWITCHING =====
function showSection(name, triggerEl) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.getElementById('sec-' + name).classList.add('active');
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  document.querySelectorAll('.stab').forEach(b => b.classList.remove('active'));
  const navLink = document.querySelector(`.nav-links a[onclick*="${name}"]`);
  const stab = document.querySelector(`.stab[onclick*="${name}"]`);
  if (navLink) navLink.classList.add('active');
  if (stab) stab.classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
  if (name === 'evenements') loadParticipantEvents();
  else if (name === 'galerie') renderGallery();
  else if (name === 'collections') loadParticipantCollections();
  else if (name === 'dons') loadDonationHistory();
  else if (name === 'leaderboard') loadLeaderboard();
}

// ===== LOAD PARTICIPANT EVENTS =====
async function loadParticipantEvents() {
  const container = document.getElementById('eventsContainer');
  const emptyDiv = document.getElementById('eventsEmpty');
  if (!container) return;
  try {
    container.innerHTML = '<div class="loading-spinner"><div class="spinner"></div>Chargement des événements…</div>';
    const response = await fetch('/api/events', { credentials: 'include', headers: { 'Accept': 'application/json' } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    const events = data.events || data || [];
    eventsList = events;
    if (!Array.isArray(events) || events.length === 0) {
      container.style.display = 'none';
      if (emptyDiv) emptyDiv.style.display = 'block';
      return;
    }
    container.style.display = 'grid';
    if (emptyDiv) emptyDiv.style.display = 'none';
    const totalEvents = events.length;
    const registeredEvents = events.filter(e => e.is_registered === true).length;
    const fullEvents = events.filter(e => {
      const cap = e.capacite_max || 0;
      return cap > 0 && (e.participants_count || 0) >= cap;
    }).length;
    const kgEstimate = registeredEvents * 15;
    document.getElementById('event-count-total').textContent = totalEvents;
    document.getElementById('event-joined-count').textContent = registeredEvents;
    document.getElementById('event-kg-total').textContent = kgEstimate;
    document.getElementById('event-coupons-count').textContent = Math.floor(registeredEvents / 2) + (registeredEvents > 0 ? 1 : 0);
    // Affichage via filtre
    filterEventsUI();
    updateUpcomingEventsPreview(events.filter(e => !e.is_registered && e.date_evenement >= new Date().toISOString().split('T')[0]).slice(0, 3));
  } catch (error) {
    console.error('Erreur:', error);
    container.innerHTML = '<div class="empty-state"><div class="e-icon"><i class="fas fa-exclamation-triangle"></i></div><h4>Erreur de chargement</h4><p>Impossible de charger les événements.</p></div>';
  }
}

function renderEventCard(event) {
  const eventDate = new Date(event.date_evenement + 'T' + (event.heure_evenement || '00:00'));
  const day = eventDate.getDate();
  const month = getMonthName(eventDate.getMonth());
  const participantsCount = event.participants_count || 0;
  const capacity = event.capacite_max || 0;
  const fillPercent = capacity > 0 ? (participantsCount / capacity) * 100 : 0;
  const placesLeft = capacity - participantsCount;
  const isFull = placesLeft <= 0;
  const isUrgent = !isFull && placesLeft <= 5 && placesLeft > 0;

  let statusClass = 'sbadge-available';
  let statusText = 'Disponible';
  if (event.is_registered) { statusClass = 'sbadge-registered'; statusText = '✓ Inscrit'; }
  else if (isFull)          { statusClass = 'sbadge-pending';    statusText = '⛔ Complet'; }
  else if (isUrgent)        { statusClass = 'sbadge-pending';    statusText = `⚡ ${placesLeft} place${placesLeft > 1 ? 's' : ''}`; }

  const progressColor = isFull
    ? 'background:linear-gradient(90deg,var(--danger),#f87171)'
    : isUrgent
      ? 'background:linear-gradient(90deg,var(--warning),#fcd34d)'
      : 'background:linear-gradient(90deg,var(--moss),var(--sage-light))';

  const imageUrl = event.image_evenement ? `/uploads/events/${event.image_evenement}` : null;

  const actionBtn = event.is_registered
    ? `<button class="btn-subscribe" style="background:linear-gradient(135deg,#1a5c1a,var(--moss));cursor:default" disabled>
         <i class="fas fa-check-circle"></i> Inscrit
       </button>
       <button class="btn-details" style="color:var(--danger);border-color:var(--danger)" onclick="event.stopPropagation();cancelParticipationFromCard(${event.id})">
         <i class="fas fa-times"></i> Désinscrire
       </button>`
    : isFull
      ? `<button class="btn-subscribe" disabled style="opacity:.45;cursor:not-allowed;background:var(--muted)">
           <i class="fas fa-ban"></i> Complet
         </button>
         <button class="btn-details" onclick="event.stopPropagation();viewEventDetail(${event.id})">
           <i class="fas fa-info-circle"></i> Détails
         </button>`
      : `<button class="btn-subscribe" onclick="event.stopPropagation();openSubscribeModal(${event.id},'${escapeHtml(event.titre).replace(/'/g,"\\'")}')">
           <i class="fas fa-calendar-plus"></i> S'inscrire
         </button>
         <button class="btn-details" onclick="event.stopPropagation();viewEventDetail(${event.id})">
           <i class="fas fa-info-circle"></i> Détails
         </button>`;

  return `
    <div class="event-card" onclick="viewEventDetail(${event.id})">
      <div class="event-image">
        ${imageUrl ? `<img src="${imageUrl}" alt="${escapeHtml(event.titre)}">` : `<div class="event-image-placeholder"><i class="fas fa-calendar-alt"></i></div>`}
        <div class="event-status-badge"><span class="sbadge ${statusClass}">${statusText}</span></div>
        <div class="event-date-badge">
          <div class="event-date-day">${day}</div>
          <div class="event-date-month">${month}</div>
        </div>
      </div>
      <div class="event-body">
        <div class="event-title">${escapeHtml(event.titre)}</div>
        <div class="event-lieu"><i class="fas fa-map-marker-alt"></i> ${escapeHtml(event.lieu)}</div>
        <div class="event-progress">
          <div class="progress-bar"><div class="progress-fill" style="width:${Math.min(fillPercent, 100)}%;${progressColor}"></div></div>
          <div class="progress-stats">
            <span><i class="fas fa-users"></i> ${participantsCount} inscrits</span>
            <span style="color:${isFull ? 'var(--danger)' : isUrgent ? 'var(--warning)' : 'inherit'}">
              <i class="fas fa-chair"></i> ${isFull ? 'Complet' : `${placesLeft} / ${capacity} places`}
            </span>
          </div>
        </div>
        <div class="event-details-mini">
          <span><i class="fas fa-calendar-day"></i> ${eventDate.toLocaleDateString('fr-FR')}</span>
          <span><i class="fas fa-clock"></i> ${event.heure_evenement || '–'}</span>
        </div>
        <div class="event-actions">${actionBtn}</div>
      </div>
    </div>
  `;
}

function updateUpcomingEventsPreview(events) {
  const container = document.getElementById('upcomingEventsPreview');
  if (!container) return;
  if (!events || events.length === 0) {
    container.innerHTML = '<div style="text-align:center;padding:24px;color:var(--muted);font-size:0.82rem"><i class="fas fa-calendar-check" style="font-size:2rem;opacity:.3;display:block;margin-bottom:10px"></i>Aucun événement à venir</div>';
    return;
  }
  container.innerHTML = events.map(event => {
    const d = new Date(event.date_evenement + 'T00:00');
    return `
      <div class="upcoming-item">
        <div class="upcoming-date-box">
          <div class="upcoming-day">${d.getDate()}</div>
          <div class="upcoming-mon">${getMonthName(d.getMonth())}</div>
        </div>
        <div class="upcoming-info">
          <div class="upcoming-title">${escapeHtml(event.titre)}</div>
          <div class="upcoming-lieu"><i class="fas fa-map-marker-alt" style="margin-right:4px"></i>${escapeHtml(event.lieu)}</div>
        </div>
      </div>`;
  }).join('');
}

async function viewEventDetail(eventId) {
  const event = eventsList.find(e => e.id === eventId);
  if (!event) return;
  currentDetailEvent = event;
  const capacity = event.capacite_max || 0;
  const participantsCount = event.participants_count || 0;
  const fillPercent = capacity > 0 ? Math.round((participantsCount / capacity) * 100) : 0;
  const placesLeft = capacity - participantsCount;
  const isFull = placesLeft <= 0;
  const eventDate = new Date(event.date_evenement + 'T' + (event.heure_evenement || '00:00'));
  document.getElementById('eventDetailBody').innerHTML = `
    <div style="background:linear-gradient(135deg,var(--forest),var(--moss));border-radius:var(--radius-lg);padding:20px;color:white;margin-bottom:20px">
      <div style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;margin-bottom:6px">${escapeHtml(event.titre)}</div>
      <div style="font-size:0.8rem;opacity:.65"><i class="fas fa-map-marker-alt" style="margin-right:5px"></i>${escapeHtml(event.lieu)}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px">
      <div style="padding:14px;background:var(--bg);border-radius:var(--radius-md)">
        <div style="font-size:0.7rem;color:var(--muted);font-weight:600;margin-bottom:4px"><i class="fas fa-calendar-day" style="margin-right:4px"></i>DATE</div>
        <div style="font-weight:700;color:var(--forest)">${eventDate.toLocaleDateString('fr-FR')}</div>
      </div>
      <div style="padding:14px;background:var(--bg);border-radius:var(--radius-md)">
        <div style="font-size:0.7rem;color:var(--muted);font-weight:600;margin-bottom:4px"><i class="fas fa-clock" style="margin-right:4px"></i>HEURE</div>
        <div style="font-weight:700;color:var(--forest)">${event.heure_evenement || '–'}</div>
      </div>
    </div>
    <div style="margin-bottom:18px">
      <div style="font-size:0.75rem;font-weight:600;color:var(--forest);margin-bottom:8px"><i class="fas fa-users" style="margin-right:5px;color:var(--moss)"></i>Capacité</div>
      <div class="progress-bar"><div class="progress-fill" style="width:${Math.min(fillPercent,100)}%"></div></div>
      <div style="display:flex;justify-content:space-between;font-size:0.72rem;color:var(--muted);margin-top:6px">
        <span>${participantsCount} inscrits</span>
        <span>${isFull ? '<span style="color:var(--danger)">Complet</span>' : `${placesLeft} places restantes`}</span>
      </div>
    </div>
    ${event.description ? `<div style="font-size:0.85rem;color:var(--muted);line-height:1.65;padding:14px;background:var(--bg);border-radius:var(--radius-md)">${escapeHtml(event.description)}</div>` : ''}
  `;
  const subscribeBtn = document.getElementById('detailSubscribeBtn');
  const unsubBtn = document.getElementById('detailUnsubBtn');
  if (event.is_registered) {
    subscribeBtn.disabled = true;
    subscribeBtn.innerHTML = '<i class="fas fa-check-circle"></i> Déjà inscrit';
    subscribeBtn.style.opacity = '0.5';
    if (unsubBtn) { unsubBtn.style.display = 'flex'; }
  } else if (isFull) {
    subscribeBtn.disabled = true;
    subscribeBtn.innerHTML = '<i class="fas fa-ban"></i> Complet';
    subscribeBtn.style.opacity = '0.5';
    if (unsubBtn) unsubBtn.style.display = 'none';
  } else {
    subscribeBtn.disabled = false;
    subscribeBtn.innerHTML = '<i class="fas fa-calendar-plus"></i> S\'inscrire';
    subscribeBtn.style.opacity = '1';
    if (unsubBtn) unsubBtn.style.display = 'none';
  }
  document.getElementById('eventDetailModal').classList.add('active');
}

function closeEventDetailModal() { document.getElementById('eventDetailModal').classList.remove('active'); currentDetailEvent = null; }

function subscribeFromDetail() {
  if (currentDetailEvent && !currentDetailEvent.is_registered) {
    closeEventDetailModal();
    openSubscribeModal(currentDetailEvent.id, currentDetailEvent.titre);
  }
}

// Désinscription directe depuis la carte (sans modal intermédiaire)
async function cancelParticipationFromCard(eventId) {
  const ev = eventsList.find(e => e.id === eventId);
  const titre = ev ? ev.titre : 'cet événement';
  if (!confirm(`Annuler votre inscription à « ${titre} » ?`)) return;
  try {
    const response = await fetch(`/api/events/${eventId}/subscribe`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    });
    const result = await response.json();
    if (result.success) {
      showToast('Inscription annulée avec succès', 'success');
      await loadParticipantEvents();
      loadUserStats();
    } else {
      showToast(result.message || 'Erreur lors de l\'annulation', 'error');
    }
  } catch (err) {
    showToast('Erreur serveur', 'error');
  }
}

function openSubscribeModal(eventId, eventTitle) {
  currentSubscribingEvent = { id: eventId, title: eventTitle };
  document.getElementById('modalEventTitle').innerHTML = `<i class="fas fa-calendar-alt" style="color:var(--moss);margin-right:6px"></i>${eventTitle}`;
  document.getElementById('subscribeContact').value = '';
  document.getElementById('subscribeAge').value = '';
  document.getElementById('subscribeModal').classList.add('active');
}

function closeSubscribeModal() { document.getElementById('subscribeModal').classList.remove('active'); currentSubscribingEvent = null; }

async function confirmSubscription() {
  if (!currentSubscribingEvent) return;
  const contact = document.getElementById('subscribeContact').value.trim();
  const age = parseInt(document.getElementById('subscribeAge').value);
  if (!contact) { showToast('Veuillez entrer un numéro de contact', 'warning'); return; }
  try {
    const response = await fetch(`/api/events/${currentSubscribingEvent.id}/subscribe`, {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ contact, age: age || null })
    });
    const result = await response.json();
    if (response.ok && result.success) {
      showToast(`Inscription confirmée pour ${currentSubscribingEvent.title}! 🎉`);
      closeSubscribeModal();
      await loadParticipantEvents();
      loadUserStats();
    } else {
      showToast(result.message || 'Erreur lors de l\'inscription', 'error');
    }
  } catch (error) {
    showToast('Erreur de connexion', 'error');
  }
}

