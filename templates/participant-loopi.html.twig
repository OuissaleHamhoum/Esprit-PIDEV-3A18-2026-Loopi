      <button class="modal-close" onclick="closeManageParticipationsModal()" style="background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.15)"><i class="fas fa-times"></i></button>
    </div>

    <!-- Barre recherche + filtres -->
    <div style="padding:16px 24px;background:var(--bg-secondary);border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:12px;">

      <!-- Recherche -->
      <div style="position:relative;">
        <i class="fas fa-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:0.85rem;pointer-events:none"></i>
        <input type="text" id="partSearch" placeholder="Rechercher un événement, un lieu…"
          oninput="filterParticipations()"
          style="width:100%;padding:10px 14px 10px 40px;border:1.5px solid var(--border);border-radius:var(--radius-full);font-family:'DM Sans',sans-serif;font-size:0.84rem;outline:none;background:white;transition:all .2s;color:var(--dark-soft)"
          onfocus="this.style.borderColor='var(--moss)';this.style.boxShadow='0 0 0 3px rgba(58,99,71,0.1)'"
          onblur="this.style.borderColor='';this.style.boxShadow=''">
      </div>

      <!-- Filtres -->
      <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
        <!-- Statut -->
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="part-filter-btn active" data-filter="status" data-value="all" onclick="setPartFilter('status','all',this)">
            <i class="fas fa-th-large"></i> Tous
          </button>
          <button class="part-filter-btn" data-filter="status" data-value="upcoming" onclick="setPartFilter('status','upcoming',this)">
            <i class="fas fa-clock"></i> À venir
          </button>
          <button class="part-filter-btn" data-filter="status" data-value="past" onclick="setPartFilter('status','past',this)">
            <i class="fas fa-history"></i> Passés
          </button>
        </div>
        <div style="width:1px;height:24px;background:var(--border);margin:0 4px;"></div>
        <!-- Tri date -->
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="part-filter-btn active" data-filter="sort" data-value="asc" onclick="setPartFilter('sort','asc',this)">
            <i class="fas fa-sort-amount-up"></i> Date ↑
          </button>
          <button class="part-filter-btn" data-filter="sort" data-value="desc" onclick="setPartFilter('sort','desc',this)">
            <i class="fas fa-sort-amount-down"></i> Date ↓
          </button>
        </div>
        <div style="width:1px;height:24px;background:var(--border);margin:0 4px;"></div>
        <!-- Reset -->
        <button class="part-filter-btn" style="color:var(--rust);border-color:var(--rust);" onclick="resetPartFilters()">
          <i class="fas fa-times-circle"></i> Réinitialiser
        </button>
      </div>
    </div>

    <!-- Compteur résultats -->
    <div style="padding:10px 24px 0;background:white;display:flex;justify-content:space-between;align-items:center;">
      <span id="partCount" style="font-size:0.78rem;color:var(--muted);font-weight:500;"></span>
      <span style="font-size:0.7rem;color:var(--muted);"><i class="fas fa-info-circle" style="margin-right:4px;color:var(--sage)"></i>Cliquer sur Modifier pour mettre à jour</span>
    </div>

    <!-- Liste -->
    <div class="modal-body" style="max-height:55vh;overflow-y:auto;padding:14px 24px 10px;">
      <div id="participationsListContainer">
        <div class="loading-spinner"><div class="spinner"></div>Chargement de vos participations…</div>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn btn-outline" onclick="closeManageParticipationsModal()"><i class="fas fa-times"></i> Fermer</button>
    </div>
  </div>
</div>

