}

function closeEditParticipationModal() {
  document.getElementById('editParticipationModal').classList.remove('active');
  currentEditingParticipationId = null;
}

async function confirmEditParticipation() {
  const contact = document.getElementById('editPartContact').value.trim();
  const age = document.getElementById('editPartAge').value.trim();
  if (!contact) {
    showToast('Le contact est requis', 'error');
    return;
  }
  
  try {
    const response = await fetch(`/api/events/${currentEditingParticipationId}/subscribe`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ contact, age })
    });
    const result = await response.json();
    if (result.success) {
      showToast('Participation mise à jour avec succès', 'success');
      closeEditParticipationModal();
      loadMyParticipations(); // Reload the list
      loadParticipantEvents(); // Reload the main grid if needed
    } else {
      showToast(result.message || 'Erreur lors de la mise à jour', 'error');
    }
  } catch (error) {
    console.error('Erreur:', error);
    showToast('Erreur serveur', 'error');
  }
}

async function cancelParticipation(eventId) {
  if (!confirm('Êtes-vous sûr de vouloir annuler votre participation à cet événement ?')) return;
  
  try {
    const response = await fetch(`/api/events/${eventId}/subscribe`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    });
    const result = await response.json();
    if (result.success) {
      showToast('Participation annulée avec succès', 'success');
      loadMyParticipations();
      loadParticipantEvents(); // Reload main grid to update buttons
      loadUserStats(); // Update counters
    } else {
      showToast(result.message || 'Erreur lors de l\'annulation', 'error');
    }
  } catch (error) {
    console.error('Erreur:', error);
    showToast('Erreur serveur', 'error');
  }
}

