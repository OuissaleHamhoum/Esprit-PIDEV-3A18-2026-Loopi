<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>Loopi — Espace Participant</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ================================================
   ROOT VARIABLES - DESIGN SYSTEM
   ================================================ */
:root {
  --bg: #F4F2ED;
  --bg-secondary: #FDFCF9;
  --cream: #FAF8F2;
  --forest: #1A3528;
  --forest-light: #264A39;
  --moss: #3A6347;
  --moss-light: #4D8060;
  --sage: #7A9E7E;
  --sage-light: #9DBBA1;
  --sand: #C9A455;
  --sand-light: #DFC07A;
  --rust: #B05A2F;
  --light: #FDFCF9;
  --dark: #111510;
  --dark-soft: #1A2218;
  --muted: #6B7468;
  --muted-light: #9AA39E;
  --card: #FFFFFF;
  --border: rgba(26,53,40,0.09);
  --border-dark: rgba(26,53,40,0.15);
  --shadow-sm: 0 1px 4px rgba(26,53,40,0.06), 0 2px 8px rgba(26,53,40,0.04);
  --shadow-md: 0 4px 16px rgba(26,53,40,0.08), 0 2px 6px rgba(26,53,40,0.04);
  --shadow-lg: 0 12px 36px rgba(26,53,40,0.12), 0 4px 12px rgba(26,53,40,0.06);
  --shadow-xl: 0 24px 56px rgba(26,53,40,0.14), 0 8px 20px rgba(26,53,40,0.08);
  --success: #10B981;
  --success-light: #D1FAE5;
  --danger: #EF4444;
  --danger-light: #FEE2E2;
  --warning: #F59E0B;
  --warning-light: #FEF3C7;
  --info: #3B82F6;
  --info-light: #DBEAFE;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 28px;
  --radius-full: 9999px;
  --nav-h: 68px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--dark-soft);
  min-height: 100vh;
  line-height: 1.6;
  /* Subtle noise texture */
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
}

h1, h2, h3, h4, .font-serif { font-family: 'Playfair Display', serif; }

/* ================================================
   NAVBAR
   ================================================ */
.navbar {
  position: sticky;
  top: 0;
  z-index: 200;
  background: rgba(26,53,40,0.97);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.05);
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-h);
}

.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-weight: 800;
  color: white;
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  letter-spacing: -0.02em;
}

.logo-icon {
  width: 34px;
  height: 34px;
  background: linear-gradient(135deg, var(--sage), var(--moss));
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2px;
  list-style: none;
}

.nav-links a {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px;
  border-radius: var(--radius-lg);
  color: rgba(255,255,255,0.58);
  text-decoration: none;
  font-size: 0.82rem;
  font-weight: 500;
  transition: all 0.2s ease;
  position: relative;
}

.nav-links a:hover {
  background: rgba(255,255,255,0.09);
  color: white;
}

.nav-links a.active {
  background: rgba(255,255,255,0.11);
  color: white;
}

.nav-links a.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 2px;
  background: var(--sand);
  border-radius: 2px;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.notif-btn {
  position: relative;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 0.95rem;
  transition: all 0.2s ease;
  color: rgba(255,255,255,0.65);
}

.notif-btn:hover { background: rgba(255,255,255,0.14); color: white; }

.notif-dot {
  position: absolute;
  top: 7px;
  right: 7px;
  width: 8px;
  height: 8px;
  background: var(--rust);
  border-radius: 50%;
  border: 2px solid var(--forest);
  animation: pulse-dot 2s ease infinite;
}

@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.25); opacity: 0.8; }
}

.nav-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--sage), var(--moss));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: white;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 2px solid rgba(255,255,255,0.15);
}

.nav-avatar:hover { transform: scale(1.08); border-color: var(--sand); }

.btn-donate {
  padding: 8px 18px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--sand), #c4993e);
  color: var(--forest);
  font-size: 0.8rem;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: all 0.25s ease;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  box-shadow: 0 2px 8px rgba(201,164,85,0.25);
  letter-spacing: 0.01em;
}

.btn-donate:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(201,164,85,0.35);
  background: linear-gradient(135deg, var(--sand-light), var(--sand));
}

/* Hamburger mobile */
.nav-hamburger {
  display: none;
  background: none;
  border: none;
  color: rgba(255,255,255,0.7);
  font-size: 1.3rem;
  cursor: pointer;
  padding: 4px;
}

/* ================================================
   HERO STRIP (AMÉLIORÉ)
   ================================================ */
.hero-strip {
  background: linear-gradient(135deg, var(--forest) 0%, #2A5240 50%, var(--moss) 100%);
  padding: 60px 32px 80px;
  position: relative;
  overflow: hidden;
}

/* Orbs flottants */
.hero-strip::before {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(122,158,126,0.18) 0%, transparent 70%);
  animation: float-orb 8s ease-in-out infinite;
}

.hero-strip::after {
  content: '';
  position: absolute;
  bottom: 20px;
  left: 15%;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,164,85,0.12) 0%, transparent 70%);
  animation: float-orb 12s ease-in-out infinite reverse;
}

@keyframes float-orb {
  0%, 100% { transform: translate(0, 0); }
  33% { transform: translate(-12px, -20px); }
  66% { transform: translate(8px, 10px); }
}

.hero-bg-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 20% 80%, rgba(122,158,126,0.08) 0%, transparent 40%),
                    radial-gradient(circle at 80% 20%, rgba(201,164,85,0.06) 0%, transparent 40%);
}

.hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
  gap: 32px;
}

.hero-left { flex: 1; }

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 4px 14px;
  background: rgba(255,255,255,0.09);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 600;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.hero-tag i { color: var(--sand); font-size: 0.65rem; }

.hero-greeting {
  font-family: 'Playfair Display', serif;
  font-size: 2.4rem;
  font-weight: 800;
  color: white;
  line-height: 1.15;
  margin-bottom: 10px;
  letter-spacing: -0.02em;
}

.hero-greeting em {
  font-style: normal;
  color: var(--sand-light);
}

.hero-sub {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.48);
  font-weight: 400;
}

.hero-stats {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.hero-stat {
  text-align: center;
  padding: 18px 22px;
  background: rgba(255,255,255,0.07);
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255,255,255,0.09);
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  min-width: 90px;
  position: relative;
  overflow: hidden;
}

.hero-stat::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 100%);
}

.hero-stat:hover {
  background: rgba(255,255,255,0.12);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}

.hero-stat-val {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem;
  font-weight: 700;
  color: white;
  line-height: 1;
  letter-spacing: -0.02em;
}

.hero-stat-lbl {
  font-size: 0.68rem;
  color: rgba(255,255,255,0.48);
  margin-top: 7px;
  font-weight: 500;
  letter-spacing: 0.3px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

/* Wave SVG divider */
.hero-wave {
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  line-height: 0;
}

.hero-wave svg {
  display: block;
  width: 100%;
  height: 48px;
}

/* ================================================
   SECTION TABS
   ================================================ */
.section-tabs-wrap {
  background: white;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: var(--nav-h);
  z-index: 99;
  box-shadow: 0 2px 12px rgba(26,53,40,0.06);
}

.section-tabs {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  gap: 0;
  overflow-x: auto;
  scrollbar-width: none;
  position: relative;
}

.section-tabs::-webkit-scrollbar { display: none; }

.stab {
  padding: 0 22px;
  height: 52px;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--muted);
  transition: color 0.2s ease, border-color 0.2s ease;
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  background: transparent;
  border-top: none;
  border-left: none;
  border-right: none;
  font-family: 'DM Sans', sans-serif;
  position: relative;
}

.stab i { font-size: 0.9rem; opacity: 0.7; transition: opacity 0.2s; }

.stab:hover { color: var(--forest); }
.stab:hover i { opacity: 1; }

.stab.active {
  color: var(--forest);
  border-bottom-color: var(--moss);
  font-weight: 700;
}

.stab.active i { opacity: 1; color: var(--moss); }

.stab-badge {
  font-size: 0.65rem;
  background: var(--moss);
  color: white;
  padding: 2px 7px;
  border-radius: var(--radius-full);
  font-weight: 700;
  line-height: 1.4;
}

/* ================================================
   PAGE SECTIONS
   ================================================ */
.page-section {
  display: none;
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 32px 100px;
  animation: fadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.page-section.active { display: block; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

.section-header {
  margin-bottom: 36px;
}

.section-heading {
  font-family: 'Playfair Display', serif;
  font-size: 1.65rem;
  font-weight: 700;
  color: var(--forest);
  letter-spacing: -0.02em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.section-heading i { color: var(--moss); font-size: 1.3rem; }

.section-sub {
  font-size: 0.85rem;
  color: var(--muted);
}

/* ================================================
   GRID LAYOUTS
   ================================================ */
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 24px; }
.grid-3-2 { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

/* ================================================
   STAT CARDS (AMÉLIORÉES)
   ================================================ */
.stat-card {
  background: white;
  border-radius: var(--radius-xl);
  border: 1px solid var(--border);
  padding: 24px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  border-radius: 4px 0 0 4px;
}

.stat-card:nth-child(1)::before { background: linear-gradient(180deg, var(--rust), #d97b4a); }
.stat-card:nth-child(2)::before { background: linear-gradient(180deg, var(--sand), var(--sand-light)); }
.stat-card:nth-child(3)::before { background: linear-gradient(180deg, var(--moss), var(--sage)); }
.stat-card:nth-child(4)::before { background: linear-gradient(180deg, var(--info), #60a5fa); }

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.stat-card-inner { padding-left: 4px; }

.stat-icon {
  width: 46px;
  height: 46px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  margin-bottom: 18px;
}

.stat-val {
  font-family: 'Playfair Display', serif;
  font-size: 2.1rem;
  font-weight: 700;
  color: var(--forest);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.stat-lbl {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 5px;
  font-weight: 500;
}

.stat-trend {
  font-size: 0.7rem;
  margin-top: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
}

.trend-up { color: var(--success); }
.trend-neutral { color: var(--muted); }

/* ================================================
   GENERIC CARD
   ================================================ */
.card {
  background: white;
  border-radius: var(--radius-xl);
  border: 1px solid var(--border);
  padding: 24px;
  transition: all 0.3s ease;
  box-shadow: var(--shadow-sm);
}

.card:hover { box-shadow: var(--shadow-md); }

.card-title {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--forest);
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.card-title a {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--moss);
  text-decoration: none;
  transition: color 0.2s;
  display: flex;
  align-items: center;
  gap: 4px;
}

.card-title a:hover { color: var(--forest); }

/* ================================================
   EVENTS SECTION
   ================================================ */
.events-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}

.event-stat {
  background: white;
  border-radius: var(--radius-lg);
  padding: 20px 16px;
  text-align: center;
  border: 1px solid var(--border);
  transition: all 0.3s ease;
  box-shadow: var(--shadow-sm);
}

.event-stat:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

.event-stat-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  font-size: 0.95rem;
}

.event-stat-value {
  font-family: 'Playfair Display', serif;
  font-size: 1.9rem;
  font-weight: 700;
  color: var(--forest);
  line-height: 1;
  letter-spacing: -0.02em;
}

.event-stat-label {
  font-size: 0.7rem;
  color: var(--muted);
  margin-top: 7px;
  font-weight: 500;
}

/* ================================================
   EVENT CARDS
   ================================================ */
.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 24px;
}

.event-card {
  background: white;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--border);
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  box-shadow: var(--shadow-sm);
}

.event-card:hover {
  transform: translateY(-7px);
  box-shadow: var(--shadow-xl);
  border-color: rgba(58,99,71,0.2);
}

.event-image {
  height: 175px;
  background: linear-gradient(135deg, var(--forest), var(--moss));
  position: relative;
  overflow: hidden;
}

.event-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.event-card:hover .event-image img { transform: scale(1.07); }

.event-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 3.5rem;
  background: linear-gradient(135deg, var(--forest), var(--moss));
  color: rgba(255,255,255,0.3);
}

.event-status-badge {
  position: absolute;
  top: 12px;
  right: 12px;
}

.sbadge {
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.63rem;
  font-weight: 700;
  backdrop-filter: blur(6px);
  letter-spacing: 0.03em;
}

.sbadge-registered { background: rgba(16,185,129,0.92); color: white; }
.sbadge-pending { background: rgba(245,158,11,0.92); color: var(--forest); }
.sbadge-available { background: rgba(59,130,246,0.92); color: white; }

.event-date-badge {
  position: absolute;
  bottom: 12px;
  left: 12px;
  background: rgba(0,0,0,0.72);
  backdrop-filter: blur(10px);
  border-radius: var(--radius-md);
  padding: 7px 14px;
  text-align: center;
  min-width: 60px;
  border: 1px solid rgba(255,255,255,0.08);
}

.event-date-day { font-size: 1.15rem; font-weight: 700; line-height: 1; color: white; }
.event-date-month { font-size: 0.6rem; text-transform: uppercase; opacity: 0.75; color: white; letter-spacing: 0.04em; }

.event-body { padding: 20px; }

.event-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--forest);
  margin-bottom: 7px;
  line-height: 1.3;
}

.event-lieu {
  font-size: 0.74rem;
  color: var(--muted);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.event-progress { margin-bottom: 14px; }

.progress-bar {
  height: 5px;
  background: rgba(26,53,40,0.07);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 8px;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--moss), var(--sage-light));
  border-radius: var(--radius-full);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-stats {
  display: flex;
  justify-content: space-between;
  font-size: 0.68rem;
  color: var(--muted);
}

.event-details-mini {
  display: flex;
  gap: 16px;
  padding: 10px 0;
  font-size: 0.7rem;
  color: var(--muted);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  margin-bottom: 14px;
}

.event-details-mini span { display: flex; align-items: center; gap: 5px; }

.event-actions { display: flex; gap: 10px; }
.event-actions button { flex: 1; }

.btn-subscribe {
  background: linear-gradient(135deg, var(--forest), var(--moss));
  color: white;
  border: none;
  padding: 9px 16px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: 'DM Sans', sans-serif;
}

.btn-subscribe:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(26,53,40,0.25);
}

.btn-subscribe:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-details {
  background: transparent;
  color: var(--forest);
  border: 1.5px solid var(--border-dark);
  padding: 9px 14px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: 'DM Sans', sans-serif;
}

.btn-details:hover { background: rgba(26,53,40,0.04); border-color: var(--moss); }

/* ================================================
   GALLERY
   ================================================ */
.gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.gal-item {
  border-radius: var(--radius-lg);
  overflow: hidden;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid var(--border);
  background: white;
  box-shadow: var(--shadow-sm);
}

.gal-item:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }

.gal-img {
  height: 138px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.8rem;
  position: relative;
  transition: transform 0.4s ease;
  overflow: hidden;
}

.gal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(26,53,40,0);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: all 0.3s ease;
  opacity: 0;
}

.gal-item:hover .gal-overlay { background: rgba(26,53,40,0.45); opacity: 1; }

.gal-overlay-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  color: var(--forest);
  transition: transform 0.2s;
  transform: translateY(8px);
}

.gal-item:hover .gal-overlay-btn { transform: translateY(0); }

.gal-heart {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
  color: var(--danger);
  z-index: 1;
}

.gal-heart:hover { transform: scale(1.2); }

.gal-info { padding: 14px; }
.gal-name { font-size: 0.85rem; font-weight: 700; color: var(--forest); }
.gal-cat {
  font-size: 0.68rem;
  color: var(--muted);
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 5px;
}

.gal-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

/* ================================================
   DONATIONS
   ================================================ */
.don-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.don-row:last-child { border-bottom: none; }

.don-av {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.don-coll { font-weight: 600; color: var(--forest); flex: 1; font-size: 0.88rem; }
.don-date { font-size: 0.7rem; color: var(--muted); }
.don-amount { font-weight: 700; color: var(--moss); font-size: 0.9rem; }

.don-status {
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 0.63rem;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.status-confirmed { background: var(--success-light); color: var(--success); }
.status-pending { background: var(--warning-light); color: #b45309; }

/* ================================================
   COUPONS (STYLE TICKET)
   ================================================ */
.coupon-card {
  border-radius: var(--radius-lg);
  padding: 0;
  color: white;
  margin-bottom: 14px;
  display: flex;
  overflow: hidden;
  transition: all 0.3s ease;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  position: relative;
}

.coupon-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-xl); }

.coupon-left {
  flex: 1;
  padding: 22px 24px;
  background: linear-gradient(135deg, var(--forest), var(--moss));
  position: relative;
}

.coupon-left::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -14px;
  transform: translateY(-50%);
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--bg);
  z-index: 2;
}

.coupon-code {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 6px;
}

.coupon-desc { font-size: 0.72rem; opacity: 0.6; }

.coupon-dashed {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 1px;
  border-right: 2px dashed rgba(255,255,255,0.2);
}

.coupon-right {
  width: 90px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--moss), var(--sage));
  padding: 16px 12px;
}

.coupon-pct {
  font-family: 'Playfair Display', serif;
  font-size: 2.2rem;
  font-weight: 900;
  color: var(--sand-light);
  line-height: 1;
}

.coupon-off { font-size: 0.65rem; opacity: 0.7; margin-top: 4px; font-weight: 600; }

.coupon-copy-hint {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.45);
  margin-top: 8px;
  display: flex;
  align-items: center;
  gap: 4px;
}

/* ================================================
   PROGRESS BAR (COLLECTIONS)
   ================================================ */
.prog-bar {
  height: 8px;
  background: rgba(26,53,40,0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin: 10px 0;
  position: relative;
}

.prog-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, var(--moss), var(--sage-light));
  position: relative;
}

.prog-fill::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 6px;
  background: rgba(255,255,255,0.5);
  border-radius: 50%;
  animation: prog-shimmer 2s ease infinite;
}

@keyframes prog-shimmer {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ================================================
   PROFILE
   ================================================ */
.profile-hero {
  background: linear-gradient(135deg, var(--forest) 0%, #2A5240 60%, var(--moss) 100%);
  border-radius: var(--radius-2xl);
  padding: 40px;
  color: white;
  display: flex;
  align-items: center;
  gap: 32px;
  margin-bottom: 28px;
  position: relative;
  overflow: hidden;
}

.profile-hero::before {
  content: '';
  position: absolute;
  right: -80px;
  top: -80px;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  background: rgba(122,158,126,0.12);
}

.profile-avatar-lg {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--sage), rgba(255,255,255,0.25));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem;
  font-weight: 700;
  color: white;
  border: 3px solid rgba(255,255,255,0.25);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.profile-info { position: relative; z-index: 1; }

.profile-info .profile-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  font-weight: 700;
  line-height: 1.2;
}

.profile-info .profile-email {
  font-size: 0.85rem;
  opacity: 0.55;
  margin-top: 6px;
}

.profile-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  padding: 5px 14px;
  background: rgba(255,255,255,0.1);
  border-radius: var(--radius-full);
  font-size: 0.73rem;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,0.13);
}

.profile-badge i { color: var(--sand); }

.profile-stats-strip {
  margin-left: auto;
  display: flex;
  gap: 14px;
  position: relative;
  z-index: 1;
}

.pstrip-stat {
  text-align: center;
  padding: 14px 18px;
  background: rgba(255,255,255,0.08);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255,255,255,0.1);
}

.pstrip-val { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; }
.pstrip-lbl { font-size: 0.63rem; opacity: 0.55; margin-top: 4px; }

/* ================================================
   BUTTONS
   ================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 22px;
  border-radius: var(--radius-lg);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border: none;
  font-family: 'DM Sans', sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, var(--forest), var(--moss));
  color: white;
  box-shadow: 0 2px 8px rgba(26,53,40,0.18);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(26,53,40,0.24);
}

.btn-secondary {
  background: linear-gradient(135deg, var(--sand), #c4993e);
  color: var(--forest);
  box-shadow: 0 2px 8px rgba(201,164,85,0.2);
}

.btn-secondary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(201,164,85,0.3);
}

.btn-outline {
  background: transparent;
  color: var(--forest);
  border: 1.5px solid var(--border-dark);
}

.btn-outline:hover {
  border-color: var(--moss);
  background: rgba(58,99,71,0.05);
  transform: translateY(-1px);
}

.btn-sm { padding: 6px 14px; font-size: 0.75rem; gap: 6px; border-radius: var(--radius-md); }
.btn-lg { padding: 13px 28px; font-size: 0.92rem; }
.btn-full { width: 100%; justify-content: center; }

/* ================================================
   FORM FIELDS
   ================================================ */
.field-group { display: flex; flex-direction: column; gap: 6px; }

.field-group label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--forest);
  display: flex;
  align-items: center;
  gap: 6px;
}

.field-group input,
.field-group select,
.field-group textarea {
  padding: 12px 16px;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.85rem;
  outline: none;
  background: var(--bg);
  color: var(--dark-soft);
  transition: all 0.2s ease;
}

.field-group input:focus,
.field-group select:focus,
.field-group textarea:focus {
  border-color: var(--moss);
  background: white;
  box-shadow: 0 0 0 3px rgba(58,99,71,0.1);
}

/* ================================================
   MODALS
   ================================================ */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  backdrop-filter: blur(10px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.active { display: flex; opacity: 1; visibility: visible; }

.modal-content {
  background: white;
  border-radius: var(--radius-2xl);
  width: 90%;
  max-width: 500px;
  max-height: 88vh;
  overflow-y: auto;
  animation: modalIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--shadow-xl);
}

@keyframes modalIn {
  from { opacity: 0; transform: translateY(-32px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-header {
  padding: 24px 28px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(26,53,40,0.03), transparent);
}

.modal-header h3 {
  font-family: 'Playfair Display', serif;
  color: var(--forest);
  font-size: 1.15rem;
  display: flex;
  align-items: center;
  gap: 10px;
}

.modal-header h3 i { color: var(--moss); }

.modal-close {
  background: rgba(26,53,40,0.06);
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 0.9rem;
  cursor: pointer;
  color: var(--muted);
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close:hover { background: rgba(239,68,68,0.1); color: var(--danger); }

.modal-body { padding: 28px; }
.modal-footer {
  padding: 20px 28px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

/* ================================================
   TOAST
   ================================================ */
.toast {
  position: fixed;
  bottom: 30px;
  right: 30px;
  background: var(--forest);
  color: white;
  padding: 13px 22px;
  border-radius: var(--radius-lg);
  font-size: 0.85rem;
  font-weight: 600;
  z-index: 9999;
  transform: translateY(80px);
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: var(--shadow-xl);
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 340px;
  border-left: 3px solid var(--sage);
}

.toast.show { transform: translateY(0); opacity: 1; }
.toast.error { background: var(--danger); border-left-color: #f87171; }
.toast.warning { background: var(--warning); color: var(--dark); border-left-color: #fcd34d; }
.toast.info { background: var(--info); border-left-color: #93c5fd; }

/* ================================================
   EMPTY STATE & LOADING
   ================================================ */
.empty-state {
  text-align: center;
  padding: 70px 20px;
  color: var(--muted);
}

.empty-state .e-icon {
  font-size: 3.5rem;
  margin-bottom: 18px;
  opacity: 0.35;
}

.empty-state h4 {
  font-family: 'Playfair Display', serif;
  color: var(--forest);
  font-size: 1.15rem;
  margin-bottom: 8px;
}

.empty-state p { font-size: 0.85rem; line-height: 1.7; max-width: 340px; margin: 0 auto; }

.loading-spinner { text-align: center; padding: 60px; color: var(--muted); }

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--border);
  border-top-color: var(--moss);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin: 0 auto 14px;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ================================================
   HOW IT WORKS
   ================================================ */
.how-step {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.how-step-icon {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  flex-shrink: 0;
}

.how-step-text strong {
  display: block;
  font-weight: 700;
  color: var(--forest);
  font-size: 0.9rem;
  margin-bottom: 3px;
}

.how-step-text span { font-size: 0.8rem; color: var(--muted); line-height: 1.55; }

/* ================================================
   FOOTER
   ================================================ */
footer {
  background: linear-gradient(135deg, var(--forest), #1A3230);
  color: rgba(255,255,255,0.4);
  padding: 40px;
  margin-top: 0;
  text-align: center;
}

.footer-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  font-weight: 800;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 10px;
}

.footer-logo i { color: var(--sage); }

.footer-sub { font-size: 0.75rem; color: rgba(255,255,255,0.38); }

.footer-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
  flex-wrap: wrap;
}

.footer-links a {
  font-size: 0.73rem;
  color: rgba(255,255,255,0.35);
  text-decoration: none;
  transition: color 0.2s;
}

.footer-links a:hover { color: var(--sage); }

.footer-divider {
  width: 40px;
  height: 1px;
  background: rgba(255,255,255,0.1);
  margin: 20px auto;
}

/* ================================================
   RESPONSIVE
   ================================================ */
@media (max-width: 1024px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .events-stats { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .navbar { padding: 0 20px; }
  .nav-links { display: none; }
  .nav-hamburger { display: flex; }

  .hero-strip { padding: 44px 20px 70px; }
  .hero-inner { flex-direction: column; align-items: flex-start; gap: 28px; }
  .hero-greeting { font-size: 1.8rem; }
  .hero-stats { flex-wrap: wrap; gap: 10px; width: 100%; }
  .hero-stat { flex: 1; min-width: calc(50% - 5px); }

  .section-tabs { padding: 0 20px; }
  .page-section { padding: 36px 20px 80px; }

  .grid-4, .grid-3 { grid-template-columns: 1fr; }
  .grid-2 { grid-template-columns: 1fr; }
  .grid-3-2 { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: 1fr; }
  .events-grid { grid-template-columns: 1fr; }
  .events-stats { grid-template-columns: repeat(2, 1fr); }

  .profile-hero { flex-direction: column; text-align: center; padding: 28px; }
  .profile-stats-strip { margin-left: 0; justify-content: center; flex-wrap: wrap; }

  .toast { bottom: 18px; right: 18px; left: 18px; max-width: none; justify-content: center; }
}

@media (max-width: 480px) {
  .hero-greeting { font-size: 1.5rem; }
  .events-stats { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .hero-stat { padding: 12px 14px; }
}

/* ================================================
   MOBILE MENU
   ================================================ */
.mobile-nav {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(4px);
}

.mobile-nav.open { display: block; }

.mobile-nav-panel {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 280px;
  background: white;
  padding: 24px 0;
  overflow-y: auto;
  animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

.mobile-nav-close {
  position: absolute;
  top: 18px;
  right: 18px;
  background: none;
  border: none;
  font-size: 1.2rem;
  cursor: pointer;
  color: var(--muted);
}

.mobile-nav-logo {
  padding: 0 24px 20px;
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--forest);
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
}

.mobile-nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 24px;
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.mobile-nav-item:hover { color: var(--forest); background: rgba(26,53,40,0.04); }
.mobile-nav-item.active { color: var(--moss); font-weight: 700; background: rgba(58,99,71,0.06); }
.mobile-nav-item i { width: 20px; text-align: center; font-size: 1rem; }

/* ================================================
   EVENT FILTER BUTTONS (barre filtre principale)
   ================================================ */
.ev-filter-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 13px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  border: 1.5px solid var(--border-dark);
  background: white;
  color: var(--muted);
  font-family: 'DM Sans', sans-serif;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.ev-filter-btn:hover { border-color: var(--moss); color: var(--forest); background: rgba(58,99,71,.05); }
.ev-filter-btn.active { background: var(--forest); color: white; border-color: var(--forest); box-shadow: 0 2px 8px rgba(26,53,40,.2); }

/* ================================================
   UPCOMING EVENTS PREVIEW
   ================================================ */
.upcoming-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.upcoming-item:last-child { border-bottom: none; }

.upcoming-date-box {
  width: 46px;
  height: 46px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--forest), var(--moss));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: white;
}

.upcoming-day { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; line-height: 1; }
.upcoming-mon { font-size: 0.55rem; text-transform: uppercase; opacity: 0.7; letter-spacing: 0.04em; }

.upcoming-info { flex: 1; min-width: 0; }
.upcoming-title { font-weight: 700; font-size: 0.85rem; color: var(--forest); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.upcoming-lieu { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }

/* ================================================
   PARTICIPATION CARDS (modal)
   ================================================ */
.part-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 18px 20px;
  margin-bottom: 14px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.part-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
  background: linear-gradient(180deg, var(--moss), var(--sage));
  border-radius: 4px 0 0 4px;
}

.part-card:hover {
  box-shadow: var(--shadow-md);
  border-color: rgba(58,99,71,0.2);
  background: white;
}

.part-date-box {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--forest), var(--moss));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
}

.part-date-day {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  font-weight: 700;
  line-height: 1;
}

.part-date-mon {
  font-size: 0.55rem;
  text-transform: uppercase;
  opacity: 0.75;
  letter-spacing: 0.04em;
  margin-top: 2px;
}

.part-info {
  flex: 1;
  min-width: 0;
}

.part-title {
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--forest);
  margin-bottom: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.part-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 0.75rem;
  color: var(--muted);
  margin-bottom: 10px;
}

.part-meta span {
  display: flex;
  align-items: center;
  gap: 5px;
}

.part-meta i { color: var(--moss); }

.part-details-row {
  display: flex;
  gap: 16px;
  font-size: 0.78rem;
}

.part-detail-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: rgba(58,99,71,0.08);
  color: var(--moss);
  font-weight: 600;
}

.part-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
}

.part-empty {
  text-align: center;
  padding: 50px 20px;
  color: var(--muted);
}

.part-empty-icon {
  font-size: 3rem;
  margin-bottom: 14px;
  opacity: 0.3;
}

.part-empty h4 {
  font-family: 'Playfair Display', serif;
  color: var(--forest);
  font-size: 1.05rem;
  margin-bottom: 6px;
}

.part-empty p {
  font-size: 0.82rem;
  line-height: 1.65;
}

/* Filtres participations */
.part-filter-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 13px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  border: 1.5px solid var(--border-dark);
  background: white;
  color: var(--muted);
  font-family: 'DM Sans', sans-serif;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.part-filter-btn:hover {
  border-color: var(--moss);
  color: var(--forest);
  background: rgba(58,99,71,0.05);
}
.part-filter-btn.active {
  background: var(--forest);
  color: white;
  border-color: var(--forest);
  box-shadow: 0 2px 8px rgba(26,53,40,0.2);
}

/* ================================================
   SECTION INTRO PILL
   ================================================ */
.section-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  background: rgba(58,99,71,0.08);
  border: 1px solid rgba(58,99,71,0.15);
  border-radius: var(--radius-full);
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--moss);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

/* Animation stagger for cards */
.stat-card:nth-child(1) { animation-delay: 0.05s; }
.stat-card:nth-child(2) { animation-delay: 0.1s; }
.stat-card:nth-child(3) { animation-delay: 0.15s; }
.stat-card:nth-child(4) { animation-delay: 0.2s; }

@keyframes cardIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-in { animation: cardIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) both; }
</style>
</head>
