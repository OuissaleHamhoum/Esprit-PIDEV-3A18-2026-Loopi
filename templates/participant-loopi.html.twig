      <div class="hero-stat">
        <div class="hero-stat-val">2</div>
        <div class="hero-stat-lbl">Coupons</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ SECTION TABS (mobile-friendly) ══ -->
<div class="section-tabs">
  <button class="stab active" onclick="showSection('accueil',this)">🏠 Tableau de bord</button>
  <button class="stab" onclick="showSection('galerie',this)">🎨 Galerie</button>
  <button class="stab" onclick="window.location.href='{{ path('app_favoris') }}'">❤️ Favoris</button>
  <button class="stab" onclick="showSection('recommandations',this)">✨ Recommandations</button>
  <button class="stab" onclick="showSection('evenements',this)">📅 Événements</button>
  <button class="stab" onclick="showSection('collections',this)">♻️ Collections</button>
  <button class="stab" onclick="showSection('dons',this)">🤝 Dons</button>
  <button class="stab" onclick="showSection('coupons',this)">🎟️ Coupons</button>
  <button class="stab" onclick="showSection('profil',this)">👤 Profil</button>
</div>

<!-- ══════════════════════════════ -->
<!-- ACCUEIL -->
<!-- ══════════════════════════════ -->
<section id="sec-accueil" class="page-section active">
  <div class="section-heading">Vue d'ensemble</div>
  <div class="section-sub">Vos statistiques, galerie récente et prochains événements</div>

  <!-- Stats row -->
  <div class="grid-4">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(61,107,79,.1)">❤️</div>
      <div class="stat-val">8</div>
      <div class="stat-lbl">Œuvres en favoris</div>
      <div class="stat-trend trend-up">↑ 2 cette semaine</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(201,169,110,.12)">🤝</div>
      <div class="stat-val">32,8</div>
      <div class="stat-lbl">kg donnés au total</div>
      <div class="stat-trend trend-up">↑ 24.6 kg ce mois</div>
