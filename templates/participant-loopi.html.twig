    <div style="font-size:1.05rem;color:rgba(255,255,255,0.85);margin-bottom:30px">
      Vous avez débloqué <span id="badgeCountText" style="font-weight:700;color:var(--sand)">un nouveau badge</span> !
    </div>
    
    <div id="badgesContainer" style="display:flex;justify-content:center;gap:25px;margin-bottom:35px;flex-wrap:wrap">
      <!-- Badges will be injected here -->
      <!-- AI MESSAGE INJECTION -->
  <div id="celebrationAiContainer" style="margin-top:15px; padding:12px; background:rgba(30,58,47,0.05); border-radius:10px; font-style:italic; color:var(--forest); font-size:0.9rem; display:none;"></div>
  
</div>

    <button class="btn btn-g" style="padding:14px 35px;font-size:1.1rem;border-radius:50px;box-shadow:0 10px 20px rgba(93,168,122,0.3)" onclick="closeBadgeModal()">Génial ! 🎉</button>
  </div>
