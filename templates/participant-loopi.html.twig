let _currentEvFilter = 'all';

function setEvFilter(filter, btn) {
  _currentEvFilter = filter;
  document.querySelectorAll('.ev-filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  filterEventsUI();
}

function resetEvFilters() {
  _currentEvFilter = 'all';
  document.querySelectorAll('.ev-filter-btn').forEach(b => b.classList.remove('active'));
  const allBtn = document.querySelector('.ev-filter-btn[data-evfilter="all"]');
  if (allBtn) allBtn.classList.add('active');
  const search = document.getElementById('eventsSearch');
  if (search) search.value = '';
  const sort = document.getElementById('eventsSort');
  if (sort) sort.value = 'date-asc';
  filterEventsUI();
}

function filterEventsUI() {
  const search = (document.getElementById('eventsSearch')?.value || '').toLowerCase().trim();
  const sortVal = document.getElementById('eventsSort')?.value || 'date-asc';
  const container = document.getElementById('eventsContainer');
  const emptyDiv  = document.getElementById('eventsEmpty');
  const countEl   = document.getElementById('eventsCount');

  let filtered = eventsList.filter(ev => {
    // Filtre recherche
    const matchSearch = !search
      || (ev.titre || '').toLowerCase().includes(search)
      || (ev.lieu  || '').toLowerCase().includes(search);

    // Filtre statut
    const capacity     = ev.capacite_max || 0;
    const participants = ev.participants_count || 0;
    const isFull       = capacity > 0 && participants >= capacity;
    let matchStatus = true;
    if (_currentEvFilter === 'available')  matchStatus = !ev.is_registered && !isFull;
    if (_currentEvFilter === 'registered') matchStatus = ev.is_registered === true;
    if (_currentEvFilter === 'full')       matchStatus = isFull;

    return matchSearch && matchStatus;
  });

  // Tri
  filtered.sort((a, b) => {
    if (sortVal === 'date-asc')  return new Date(a.date_evenement) - new Date(b.date_evenement);
    if (sortVal === 'date-desc') return new Date(b.date_evenement) - new Date(a.date_evenement);
    if (sortVal === 'places') {
      const placesA = (a.capacite_max || 0) - (a.participants_count || 0);
      const placesB = (b.capacite_max || 0) - (b.participants_count || 0);
      return placesB - placesA;
    }
    return 0;
  });

  // Mise à jour compteur
  if (countEl) {
    const total = eventsList.length;
    countEl.textContent = filtered.length === total
      ? `${total} événement${total > 1 ? 's' : ''}`
      : `${filtered.length} / ${total} événement${total > 1 ? 's' : ''}`;
  }

  if (filtered.length === 0) {
    container.style.display  = 'none';
    if (emptyDiv) emptyDiv.style.display = 'flex';
  } else {
    container.style.display  = 'grid';
    if (emptyDiv) emptyDiv.style.display = 'none';
    container.innerHTML = filtered.map(ev => renderEventCard(ev)).join('');
  }
}
