<!-- ─── PAGE: USERS ─── -->
  <div id="page-users" style="display:none">
    <div class="blk" style="margin-bottom:16px">
      <div class="blk-title">Gestion des utilisateurs <span class="sub" id="usersSummary">0 comptes enregistrés</span></div>
      <div class="search-bar">
        <input id="userSearch" class="search-input" placeholder="🔍 Rechercher par nom, email…">
        <select id="userRoleFilter" class="filter">
          <option value="">Tous les rôles</option>
          <option value="admin">Admin</option>
          <option value="organisateur">Organisateur</option>
          <option value="participant">Participant</option>
        </select>
        <button class="btn btn-ghost btn-sm" onclick="exportUsersCsv()">📥 Exporter CSV</button>
        <button class="btn btn-ghost btn-sm" onclick="document.getElementById('csvImportInput').click()">📤 Importer CSV</button>
        <button class="btn btn-ghost btn-sm" onclick="refreshUserTable()">🔄 Actualiser</button>
        <button class="btn btn-primary btn-sm" style="margin-left:auto" onclick="openUserModal('create')">+ Ajouter</button>
        <input type="file" id="csvImportInput" accept=".csv" style="display:none" onchange="handleCsvImport(event)">
      </div>
      <table class="tbl">
        <thead><tr><th>Utilisateur</th><th>Email</th><th>Rôle</th><th>Genre</th><th>Inscription</th><th>Dernière MAJ</th><th>Actions</th></tr></thead>
        <tbody id="usersTableBody"></tbody>
      </table>
      <div id="usersEmptyState" style="display:none;padding:18px;color:var(--muted)">Aucun utilisateur trouvé. Essayez de réinitialiser ou de modifier le filtre.</div>
    </div>
  </div>
