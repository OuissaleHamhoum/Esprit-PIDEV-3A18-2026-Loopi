<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
let eventsMap = null;
let eventMarkers = [];
let allEvents = [];
let currentSelectedEvent = null;

// Fonction pour obtenir l'URL complète de l'image
function getEventImageUrl(imageName) {
  if (!imageName) return null;
  // Si l'URL commence déjà par http ou /uploads, la retourner telle quelle
  if (imageName.startsWith('http') || imageName.startsWith('/uploads')) {
    return imageName;
  }
  // Sinon, construire le chemin /uploads/events/
  return '/uploads/events/' + imageName;
}

// Fonction pour créer l'en-tête avec image ou placeholder
function createEventHeader(imageUrl, title) {
  if (imageUrl) {
    // Tester si l'image existe (optionnel, mais on l'affiche quand même)
    return `<div class="event-info-header" style="background-image: url('${imageUrl}'); background-size: cover; background-position: center;"></div>`;
  } else {
    return `<div class="event-info-header" style="background: linear-gradient(135deg, var(--forest), var(--moss)); display: flex; align-items: center; justify-content: center;">
      <div class="event-image-placeholder">📅</div>
    </div>`;
  }
}

// Initialize map
function initEventsMap() {
  if (eventsMap) {
    eventsMap.remove();
  }

  // Default to Tunisia center
  const defaultLat = 36.8065;
  const defaultLng = 10.1815;

  eventsMap = L.map('eventsMap').setView([defaultLat, defaultLng], 7);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors',
    maxZoom: 19
  }).addTo(eventsMap);

  loadEventsForMap();
}

// Load events data
async function loadEventsForMap() {
  const loading = document.getElementById('mapLoading');
  loading.style.display = 'flex';

  try {
    const response = await fetch('/api/admin/events', {
      credentials: 'include',
      headers: { 'Accept': 'application/json' }
    });

    const data = await response.json();
    if (data.success && data.events) {
      allEvents = data.events;
      displayEventsOnMap(allEvents);
    } else {
      console.error('Erreur lors du chargement des événements:', data);
      showToast('Erreur lors du chargement des événements', 'error');
    }
  } catch (error) {
    console.error('Erreur:', error);
    showToast('Erreur de connexion', 'error');
  } finally {
    loading.style.display = 'none';
  }
}

// Create custom marker icon
function createCustomMarker(event) {
  let color;
  let icon;
  switch (event.statut) {
    case 'valide':
    case 'approuve':
      color = '#10B981';
      icon = '✓';
      break;
    case 'rejete':
      color = '#DC3545';
      icon = '✗';
      break;
    default:
      color = '#F59E0B';
      icon = '⏳';
  }
  
  return L.divIcon({
    className: 'custom-marker',
    html: `<div class="custom-marker ${event.statut === 'valide' || event.statut === 'approuve' ? 'valide' : event.statut === 'rejete' ? 'rejete' : 'en_attente'}" style="background: ${color};">${icon}</div>`,
    iconSize: [36, 36],
    iconAnchor: [18, 36],
    popupAnchor: [0, -36]
  });
}

// Create info window content (popup)
function createInfoWindowContent(event) {
  const eventDate = new Date(event.date_evenement);
  const formattedDate = eventDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const formattedTime = event.heure_evenement || eventDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  
  const statusText = event.statut === 'valide' ? 'Validé' : event.statut === 'rejete' ? 'Rejeté' : 'En attente';
  const statusClass = event.statut === 'valide' ? 'valide' : event.statut === 'rejete' ? 'rejete' : 'en_attente';
  const statusColor = statusClass === 'valide' ? '#10B981' : statusClass === 'rejete' ? '#DC3545' : '#F59E0B';
  
  const imageUrl = getEventImageUrl(event.image_evenement);
  
  const headerHtml = imageUrl 
    ? `<div class="event-info-header" style="background-image: url('${imageUrl}'); background-size: cover; background-position: center;"></div>`
    : `<div class="event-info-header" style="background: linear-gradient(135deg, var(--forest), var(--moss)); display: flex; align-items: center; justify-content: center;"><div class="event-image-placeholder" style="font-size: 3rem;">📅</div></div>`;
  
  return `
    <div class="event-info-window">
      ${headerHtml}
      <div class="event-info-content">
        <div class="event-info-title">${escapeHtml(event.titre)}</div>
        <div class="event-info-meta">
          <span>📅 ${formattedDate}</span>
          <span>⏰ ${formattedTime}</span>
          <span>📍 ${escapeHtml(event.lieu || 'Non spécifié')}</span>
        </div>
        <div class="event-info-desc">
          ${escapeHtml(event.description ? event.description.substring(0, 100) + (event.description.length > 100 ? '...' : '') : 'Aucune description')}
        </div>
        <div class="event-info-stats">
          <div class="event-stat-item">
            <div class="event-stat-value">${event.participants_count || 0}</div>
            <div class="event-stat-label">Participants</div>
          </div>
          <div class="event-stat-item">
            <div class="event-stat-value">${event.capacite_max || 0}</div>
            <div class="event-stat-label">Places max</div>
          </div>
          <div class="event-stat-item">
            <div class="event-stat-value">${(event.capacite_max || 0) - (event.participants_count || 0)}</div>
            <div class="event-stat-label">Places rest.</div>
          </div>
        </div>
        <div class="event-info-actions">
          <button class="btn-view-details" onclick="viewEventDetails(${event.id})">👁️ Voir détails</button>
          <button class="btn-edit" onclick="editEventFromMap(${event.id})">✏️ Modifier</button>
        </div>
      </div>
    </div>
  `;
}

// Display events on map
function displayEventsOnMap(events) {
  // Clear existing markers
  eventMarkers.forEach(marker => eventsMap.removeLayer(marker));
  eventMarkers = [];

  // Ensure all events are visible on the map.
  // If coordinates are missing, place them around Tunis with a small offset.
  const baseLat = 36.8065;
  const baseLng = 10.1815;

  // Create markers for each event
  events.forEach((event, index) => {
    const lat = event.latitude && !Number.isNaN(parseFloat(event.latitude))
      ? parseFloat(event.latitude)
      : baseLat + ((index % 10) * 0.01);
    const lng = event.longitude && !Number.isNaN(parseFloat(event.longitude))
      ? parseFloat(event.longitude)
      : baseLng + ((Math.floor(index / 10) % 10) * 0.01);
    
    if (isNaN(lat) || isNaN(lng)) return;
    
    const marker = L.marker([lat, lng], {
      icon: createCustomMarker(event)
    });
    
    const popupContent = createInfoWindowContent(event);
    marker.bindPopup(popupContent, {
      maxWidth: 340,
      minWidth: 280,
      className: 'custom-popup'
    });
    
    marker.addTo(eventsMap);
    eventMarkers.push(marker);
  });

  // Fit map to show all markers
  if (eventMarkers.length > 0) {
    const group = new L.featureGroup(eventMarkers);
    eventsMap.fitBounds(group.getBounds().pad(0.1));
  }
}

// View event details in modal (comme la capture)
async function viewEventDetails(eventId) {
  currentSelectedEvent = allEvents.find(e => e.id === eventId);
  
  if (!currentSelectedEvent) {
    // Fetch event details if not in cache
    try {
      const response = await fetch(`/api/admin/events/${eventId}`, {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json();
      if (data.success) {
        currentSelectedEvent = data.event;
        currentSelectedEvent.participants = data.participants || [];
      } else {
        showToast('Erreur lors du chargement des détails', 'error');
        return;
      }
    } catch (error) {
      console.error('Erreur:', error);
      showToast('Erreur de connexion', 'error');
      return;
    }
  } else {
    // Fetch participants separately if needed
    try {
      const response = await fetch(`/api/admin/events/${eventId}`, {
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
      });
      const data = await response.json();
      if (data.success) {
        currentSelectedEvent.participants = data.participants || [];
      }
    } catch (error) {
      console.error('Erreur chargement participants:', error);
      currentSelectedEvent.participants = [];
    }
  }
  
  displayEventDetailsModal(currentSelectedEvent);
}

// Display modal with event details
function displayEventDetailsModal(event) {
  const modal = document.getElementById('eventDetailModal');
  const eventDate = new Date(event.date_evenement);
  const formattedDate = eventDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const formattedTime = event.heure_evenement || eventDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  
  const statusText = event.statut === 'valide' ? 'Validé' : event.statut === 'rejete' ? 'Rejeté' : 'En attente';
  const statusClass = event.statut === 'valide' ? '#10B981' : event.statut === 'rejete' ? '#DC3545' : '#F59E0B';
  
  const imageUrl = getEventImageUrl(event.image_evenement);
  
  // Set header background or placeholder
  const header = document.getElementById('eventDetailHeader');
  if (imageUrl) {
    header.style.backgroundImage = `url('${imageUrl}')`;
    header.style.backgroundSize = 'cover';
    header.style.backgroundPosition = 'center';
    header.style.backgroundColor = 'transparent';
    header.innerHTML = '<span id="eventDetailStatus" class="event-status-badge"></span>';
  } else {
    header.style.backgroundImage = 'none';
    header.style.background = 'linear-gradient(135deg, var(--forest), var(--moss))';
    header.innerHTML = `
      <div class="event-image-placeholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem;">📅</div>
      <span id="eventDetailStatus" class="event-status-badge"></span>
    `;
  }
  
  // Re-add status badge reference
  const statusBadge = document.getElementById('eventDetailStatus');
  if (statusBadge) {
    statusBadge.textContent = statusText;
    statusBadge.style.backgroundColor = statusClass;
    statusBadge.style.color = 'white';
  }
  
  // Set title
  document.getElementById('eventDetailTitle').textContent = event.titre;
  
  // Set organizer
  document.getElementById('eventDetailOrganizer').innerHTML = `👤 Organisé par <strong>${escapeHtml(event.organisateur || 'Administrateur')}</strong>`;
  
  // Set description
  document.getElementById('eventDetailDescription').textContent = event.description || 'Aucune description disponible.';
  
  // Set info grid
  document.getElementById('eventDetailDate').textContent = formattedDate;
  document.getElementById('eventDetailTime').textContent = formattedTime;
  document.getElementById('eventDetailLocation').textContent = event.lieu || 'Non spécifié';
  document.getElementById('eventDetailCapacity').textContent = `${event.participants_count || 0}/${event.capacite_max || 0} participants`;
  
  // Set participants list
  const participantsContainer = document.getElementById('eventDetailParticipants');
  const participants = event.participants || [];
  
  if (participants.length === 0) {
    participantsContainer.innerHTML = '<div style="text-align: center; color: var(--muted); padding: 20px;">Aucun participant inscrit pour le moment.</div>';
  } else {
    participantsContainer.innerHTML = `
      <div style="max-height: 200px; overflow-y: auto;">
        ${participants.map(p => `
          <div class="participant-item">
            <span><strong>${escapeHtml(p.prenom || '')} ${escapeHtml(p.nom || '')}</strong> - ${escapeHtml(p.email || '')}</span>
            <span style="font-size: 0.65rem; padding: 2px 8px; border-radius: 50px; background: ${p.statut === 'present' ? '#10B98120' : '#F59E0B20'}; color: ${p.statut === 'present' ? '#10B981' : '#F59E0B'};">${p.statut === 'present' ? 'Présent' : p.statut === 'absent' ? 'Absent' : 'Inscrit'}</span>
          </div>
        `).join('')}
      </div>
    `;
  }
  
  // Set edit button
  const editBtn = document.getElementById('eventDetailEditBtn');
  editBtn.onclick = () => editEventFromMap(event.id);
  
  // Open modal
  modal.classList.add('open');
  document.body.style.overflow = 'hidden';
}

// Close modal
function closeEventDetailModal() {
  const modal = document.getElementById('eventDetailModal');
  modal.classList.remove('open');
  document.body.style.overflow = '';
  currentSelectedEvent = null;
}

// Edit current event
function editCurrentEvent() {
  if (currentSelectedEvent) {
    editEventFromMap(currentSelectedEvent.id);
  }
}

// Edit event from map
function editEventFromMap(eventId) {
  closeEventDetailModal();
  
  // Switch to events page and edit event
  if (typeof goPage === 'function') {
    // Find the events nav element and switch page
    const eventsNav = document.querySelector('.ni[onclick*="events"]');
    if (eventsNav) {
      goPage('events', eventsNav);
      // Wait for page to load then edit
      setTimeout(() => {
        if (typeof editEvent === 'function') {
          editEvent(eventId);
        } else {
          showToast('Fonction d\'édition non disponible', 'error');
        }
      }, 500);
    } else {
      window.location.href = '/admin?page=events&edit=' + eventId;
    }
  } else {
    window.location.href = '/admin?page=events&edit=' + eventId;
  }
}

// Filter events based on search and filters
function filterEvents() {
  const searchTerm = document.getElementById('mapSearch').value.toLowerCase();
  const statusFilter = document.getElementById('statusFilter').value;
  const dateFilter = document.getElementById('dateFilter').value;

  let filteredEvents = allEvents.filter(event => {
    // Search filter
    if (searchTerm) {
      const searchableText = `${event.titre} ${event.lieu} ${event.organisateur} ${event.description}`.toLowerCase();
      if (!searchableText.includes(searchTerm)) {
        return false;
      }
    }

    // Status filter
    if (statusFilter && event.statut !== statusFilter) {
      return false;
    }

    // Date filter
    if (dateFilter) {
      const eventDate = new Date(event.date_evenement);
      const now = new Date();

      switch (dateFilter) {
        case 'today':
          if (eventDate.toDateString() !== now.toDateString()) return false;
          break;
        case 'week':
          const weekEnd = new Date(now);
          weekEnd.setDate(now.getDate() + 7);
          if (eventDate < now || eventDate > weekEnd) return false;
          break;
        case 'month':
          if (eventDate.getMonth() !== now.getMonth() || eventDate.getFullYear() !== now.getFullYear()) return false;
          break;
        case 'upcoming':
          if (eventDate < now) return false;
          break;
      }
    }

    return true;
  });

  displayEventsOnMap(filteredEvents);
}

// Show toast notification
function showToast(message, type = 'info') {
  const toast = document.getElementById('toast');
  if (toast) {
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  } else {
    console.log(message);
  }
}

// Escape HTML
function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Initialize when page becomes active
function initEventsMapPage() {
  setTimeout(() => {
    if (document.getElementById('page-events-map').style.display !== 'none') {
      initEventsMap();
    }
  }, 100);
}

// Clean up when leaving page
function cleanupEventsMapPage() {
  if (eventsMap) {
    eventsMap.remove();
    eventsMap = null;
  }
  eventMarkers = [];
}

// Close modal on escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeEventDetailModal();
  }
});

// Close modal on click outside
document.getElementById('eventDetailModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeEventDetailModal();
  }
});
</script>