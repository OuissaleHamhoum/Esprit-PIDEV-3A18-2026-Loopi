{% extends 'admin/layout.html.twig' %}

{% block title %}Collections — Admin{% endblock %}

{% block admin_body %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h4 fw-bold mb-0">Gestion des collections</h1>
    <a class="btn btn-primary btn-sm" href="{{ path('admin_collections_new') }}"><i class="bi bi-plus-lg me-1"></i>Nouvelle</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card loopi-panel"><div class="card-body py-3">
            <div class="text-muted small">Total collections</div>
            <div class="fs-3 fw-bold">{{ collections|length }}</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card loopi-panel"><div class="card-body py-3">
            <div class="text-muted small">Objectif cumulé</div>
            <div class="fs-3 fw-bold">{{ totalGoal|number_format(0, ',', ' ') }}</div>
        </div></div>
    </div>
</div>
<div class="card loopi-panel">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle small">
            <thead class="table-light">
                <tr><th>Titre</th><th>Matériau</th><th>Collecté</th><th>Objectif</th><th>Statut</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                {% for c in collections %}
                    <tr>
                        <td>{{ c.title }}</td>
                        <td>{{ c.materialType }}</td>
                        <td>{{ c.currentAmount ?? 0 }} {{ c.unit }}</td>
                        <td>{{ c.goalAmount }} {{ c.unit }}</td>
                        <td><span class="badge bg-success">{{ c.status }}</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_collections_edit', {id: c.id}) }}">Modifier</a>
                            <form class="d-inline" method="post" action="{{ path('admin_collections_delete', {id: c.id}) }}" onsubmit="return confirm('Supprimer ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
