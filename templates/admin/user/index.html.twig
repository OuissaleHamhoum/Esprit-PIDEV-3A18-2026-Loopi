{% extends 'admin/layout.html.twig' %}

{% block title %}Utilisateurs — Admin{% endblock %}

{% block admin_body %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h4 fw-bold mb-0">Gestion des utilisateurs</h1>
    <a class="btn btn-primary btn-sm" href="{{ path('admin_users_new') }}"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>

<div class="card loopi-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.id }}</td>
                        <td>{{ u.prenom }} {{ u.nom }}</td>
                        <td>{{ u.email }}</td>
                        <td>
                            {% set rv = u.role.value %}
                            <span class="badge {% if rv == 'admin' %}bg-primary{% elseif rv == 'organisateur' %}bg-success{% else %}bg-warning text-dark{% endif %}">{{ rv }}</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_users_edit', {id: u.id}) }}"><i class="bi bi-pencil"></i></a>
                            <form class="d-inline" method="post" action="{{ path('admin_users_delete', {id: u.id}) }}" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
