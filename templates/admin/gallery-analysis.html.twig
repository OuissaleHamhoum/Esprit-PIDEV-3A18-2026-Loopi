<!-- ─── PAGE: GALLERY ANALYSIS ─── -->
<div id="page-gallery-analysis" style="display:none">
  <div class="blk-title" style="margin-bottom:24px">
    <div>Analyse approfondie de la Galerie <span class="sub">Données en temps réel sur les produits, organisateurs et avis</span></div>
    <button class="btn btn-primary btn-sm" onclick="refreshGalleryAnalysis()">🔄 Actualiser l'analyse</button>
  </div>

  <!-- Row 1: Products and Organizers -->
  <div class="g2">
    <div class="blk">
      <div class="blk-title">📦 Répartition des Produits par Catégorie</div>
      <div style="height:300px; position:relative">
        <canvas id="chartProductsByCategory"></canvas>
      </div>
    </div>
    <div class="blk">
      <div class="blk-title">👤 Genre des Organisateurs</div>
      <div style="height:300px; position:relative">
        <canvas id="chartOrganizersByGender"></canvas>
      </div>
    </div>
  </div>

  <!-- Row 2: Feedbacks -->
  <div class="g2">
    <div class="blk">
      <div class="blk-title">📈 Activité des Participants (Nombre d'avis)</div>
      <div style="height:300px; position:relative">
        <canvas id="chartParticipantActivity"></canvas>
      </div>
    </div>
    <div class="blk">
      <div class="blk-title">⭐ Qualité des Avis (Normaux vs Signalés)</div>
      <div style="height:300px; position:relative">
        <canvas id="chartFeedbackQuality"></canvas>
      </div>
    </div>
  </div>

  <div class="blk" style="margin-top:20px">
    <div class="blk-title">💡 Résumé Analytique</div>
    <div id="analysisSummaryText" style="color:var(--muted); line-height:1.6; font-size:0.9rem">
      Chargement de l'analyse en cours...
    </div>
  </div>
</div>

<script>
let charts = {};

async function refreshGalleryAnalysis() {
    const btn = document.querySelector('[onclick="refreshGalleryAnalysis()"]');
    if (btn) btn.textContent = '⌛ Chargement...';
    
    try {
        const res = await fetch('/api/admin/analysis/gallery', { credentials: 'include' });
        const json = await res.json();
        
        if (json.success) {
            const data = json.data;
            renderGalleryCharts(data);
            document.getElementById('analysisSummaryText').textContent = data.summary;
        } else {
            showToast(json.message || "Erreur lors du chargement de l'analyse", 'error');
        }
    } catch (error) {
        console.error('Analysis error:', error);
        showToast("Erreur réseau lors de l'analyse", 'error');
    } finally {
        if (btn) btn.textContent = '🔄 Actualiser l\'analyse';
    }
}

function renderGalleryCharts(data) {
    // Destroy existing charts if they exist
    Object.values(charts).forEach(chart => chart.destroy());

    // 1. Products By Category (Doughnut)
    charts.products = new Chart(document.getElementById('chartProductsByCategory'), {
        type: 'doughnut',
        data: {
            labels: data.productsByCategory.map(x => x.label),
            datasets: [{
                data: data.productsByCategory.map(x => x.count),
                backgroundColor: ['#1E3A2F', '#3D6B4F', '#7A9E7E', '#C9A96E', '#B05A2F', '#DC3545', '#F59E0B']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });

    // 2. Organizers By Gender (Pie)
    charts.organizers = new Chart(document.getElementById('chartOrganizersByGender'), {
        type: 'pie',
        data: {
            labels: data.organizersByGender.map(x => x.label),
            datasets: [{
                data: data.organizersByGender.map(x => x.count),
                backgroundColor: ['#3B82F6', '#EC4899', '#94A3B8']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });

    // 3. Participant Activity (Bar)
    charts.activity = new Chart(document.getElementById('chartParticipantActivity'), {
        type: 'bar',
        data: {
            labels: data.participantActivity.map(x => x.label),
            datasets: [{
                label: 'Nombre d\'avis',
                data: data.participantActivity.map(x => x.count),
                backgroundColor: '#1E3A2F',
                borderRadius: 6
            }]
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: false, 
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // 4. Feedback Quality (Polar Area)
    charts.quality = new Chart(document.getElementById('chartFeedbackQuality'), {
        type: 'polarArea',
        data: {
            labels: data.feedbackQuality.map(x => x.label),
            datasets: [{
                data: data.feedbackQuality.map(x => x.count),
                backgroundColor: ['rgba(16, 185, 129, 0.7)', 'rgba(220, 53, 69, 0.7)']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });
}
</script>
