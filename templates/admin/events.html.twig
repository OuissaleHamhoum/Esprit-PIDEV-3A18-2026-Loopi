<!-- ─── PAGE: EVENTS ─── -->
<style>
  .action-buttons { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .btn-small { display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; font-size: 0.8rem; border-radius: 10px; cursor: pointer; border: 1px solid transparent; transition: all 0.2s ease; min-width: 92px; font-weight: 700; text-align: center; }
  .btn-small:hover { transform: translateY(-1px); }
  .btn-small.info { background: rgba(93, 168, 122, 0.12); color: var(--forest); border-color: rgba(93, 168, 122, 0.25); }
  .btn-small.warning { background: rgba(201, 169, 110, 0.12); color: var(--sand); border-color: rgba(201, 169, 110, 0.25); }
  .btn-small.success { background: rgba(93, 168, 122, 0.12); color: var(--forest); border-color: rgba(93, 168, 122, 0.25); }
  .btn-small.danger { background: rgba(224, 90, 58, 0.12); color: var(--danger); border-color: rgba(224, 90, 58, 0.25); }
  .badge { padding: 4px 10px; border-radius: 50px; font-size: 0.65rem; font-weight: 700; white-space: nowrap; }
  .badge.pending { background: rgba(201, 169, 110, 0.15); color: #C9A96E; }
  .badge.valide { background: rgba(93, 168, 122, 0.15); color: #5DA87A; }
  .badge.rejete { background: rgba(224, 90, 58, 0.15); color: #E05A3A; }
  .events-modal { display: none !important; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: 3000; align-items: center; justify-content: center; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity .2s ease, visibility .2s ease; }
  .events-modal.open { display: flex !important; pointer-events: auto; opacity: 1; visibility: visible; }
  .events-modal-content { background: var(--card); border-radius: 16px; width: 90%; max-width: 700px; max-height: 90vh; overflow-y: auto; border: 1px solid var(--border); }
  .events-modal-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .events-modal-header h3 { color: var(--text); font-size: 1.1rem; margin: 0; }
  .events-modal-body { padding: 24px; }
  .events-modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; gap: 10px; justify-content: flex-end; }
  .filter-section { background: var(--bg); padding: 16px; border-radius: 12px; margin-bottom: 16px; }
  .filter-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; align-items: flex-end; }
  .filter-row > div { display: flex; flex-direction: column; }
  .filter-row label { font-size: 0.7rem; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .filter-row input, .filter-row select { padding: 8px 12px; background: rgba(255, 255, 255, 0.9); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.8rem; }
  .filter-row input:focus, .filter-row select:focus { border-color: var(--accent); outline: none; background: white; }
  .event-row { display: grid; grid-template-columns: 0.8fr 2fr 1.5fr 1.5fr 1.5fr 1fr 1fr 1.2fr 1.8fr; gap: 12px; padding: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.04); align-items: center; }
  .event-row:hover { background: rgba(255, 255, 255, 0.02); }
</style>

  <div id="page-events" style="display:none">
    <div class="blk" style="margin-bottom:16px">
      <div class="blk-title" style="margin-bottom: 20px;">
        <div>
          Gestion des événements
          <span class="sub" style="font-family: 'DM Sans',sans-serif; font-size: 0.7rem; color: var(--muted); margin-left: 8px;">Validation & Modération</span>
        </div>
        <div style="display:flex;gap:10px">
          <button id="btnRefreshEvents" class="btn btn-outline" style="background: rgba(255,255,255,0.08); color: var(--accent); border: 1px solid var(--border); padding: 8px 16px;" title="Rafraîchir la liste">
            <i class="fas fa-sync-alt"></i> Rafraîchir
          </button>
          <button id="btnExportEvents" class="btn btn-outline" style="background: rgba(93,168,122,0.1); color: var(--accent); border: 1px solid var(--accent); padding: 8px 16px;" title="Exporter les événements">
            <i class="fas fa-download"></i> Exporter
          </button>
          <button id="btnCreateEvent" class="btn" style="background: linear-gradient(135deg, var(--accent), var(--moss)); color: var(--text); padding: 10px 20px; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: none; cursor: pointer; transition: all 0.2s ease;" onclick="openEventModal()">
            <i class="fas fa-plus"></i> Créer un événement
          </button>
        </div>
      </div>

      <!-- Barre de recherche et filtres -->
      <div class="filter-section">
        <div class="filter-row" style="grid-template-columns: 2fr 1fr 1fr 1fr auto;">
          <div>
            <label for="searchEvents">🔍 Rechercher</label>
            <input type="text" id="searchEvents" placeholder="Titre, organisateur, lieu..." style="width: 100%">
          </div>
          <div>
            <label for="filterStatus">Statut</label>
            <select id="filterStatus" style="width: 100%">
              <option value="">Tous</option>
              <option value="en_attente">En attente</option>
              <option value="valide">Validé</option>
              <option value="rejete">Rejeté</option>
            </select>
          </div>
          <div>
            <label for="filterOrganisateur">Organisateur</label>
            <select id="filterOrganisateur" style="width: 100%">
              <option value="">Tous</option>
            </select>
          </div>
          <div>
            <label for="filterDate">Période</label>
            <select id="filterDate" style="width: 100%">
              <option value="">Toutes</option>
              <option value="today">Aujourd'hui</option>
              <option value="week">Cette semaine</option>
              <option value="month">Ce mois</option>
              <option value="upcoming">À venir</option>
              <option value="past">Passés</option>
            </select>
