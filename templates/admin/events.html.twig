  // ===== CHARGEMENT DES DONNÉES =====
  async function loadEvents() {
    try {
      setEventsLoading();
      const response = await fetch('/api/admin/events', {
        credentials: 'include',
        headers: {
          'Accept': 'application/json'
        }
      });

      const data = await parseJsonResponse(response);
      if (!response.ok) {
        if (response.status === 401 || response.status === 403) {
          showAlert('Accès refusé. Veuillez vous connecter en tant qu\'administrateur.', 'error');
          document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Accès non autorisé.</div>`;
          return;
        }
        showAlert(data.message || `Erreur serveur (${response.status})`, 'error');
        document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Impossible de charger les événements.</div>`;
        return;
      }

      if (data.success) {
        eventsData = Array.isArray(data.events) ? data.events : [];
        renderEventsTable();
        updateEventsSummary();
      } else {
        showAlert(data.message || 'Erreur lors du chargement des événements', 'error');
      }
    } catch (error) {
      console.error('Erreur:', error);
      showAlert('Erreur de connexion', 'error');
      document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Erreur de connexion.</div>`;
    }
  }

