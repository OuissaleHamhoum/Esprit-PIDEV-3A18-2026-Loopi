        <div style="color: var(--accent); font-weight: 600; text-align: center; cursor: pointer;" onclick="viewEventDetails(${event.id})" title="Voir les participants">
          ${participantsCount}/${event.capacite_max}
        </div>
        <div><span class="badge ${statusClass}">${statusText}</span></div>
        <div class="action-buttons">
          <button class="btn-small info" onclick="viewEventDetails(${event.id})" title="Voir">Voir</button>
          <button class="btn-small warning" onclick="editEvent(${event.id})" title="Modifier">Modifier</button>
