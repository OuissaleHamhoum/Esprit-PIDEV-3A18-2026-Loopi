                  <th style="padding:8px;text-align:left">Inscription</th>
                </tr>
              </thead>
              <tbody>
        `;

        if (participants.length === 0) {
          content += '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">Aucun participant inscrit</td></tr>';
        } else {
          participants.forEach(participant => {
            const statusClass = participant.statut === 'present' ? 'valide' : (participant.statut === 'absent' ? 'rejete' : 'pending');
            const statusText = participant.statut === 'present' ? 'Présent' : (participant.statut === 'absent' ? 'Absent' : 'Inscrit');

            content += `
              <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:8px">${escapeHtml(participant.nom)} ${escapeHtml(participant.prenom)}</td>
                <td style="padding:8px">${escapeHtml(participant.email)}</td>
                <td style="padding:8px">${escapeHtml(participant.contact || '-')}</td>
                <td style="padding:8px">${participant.age || '-'}</td>
                <td style="padding:8px"><span class="badge ${statusClass}">${statusText}</span></td>
                <td style="padding:8px">${formatDate(participant.date_inscription)}</td>
              </tr>
            `;
          });
        }

        content += `
              </tbody>
            </table>
          </div>
        `;

        document.getElementById('eventDetailsContent').innerHTML = content;
        document.getElementById('eventDetailsModal').classList.add('open');
      } else {
        showAlert('Erreur lors du chargement des détails', 'error');
      }
    } catch (error) {
      console.error('Erreur:', error);
      showAlert('Erreur de connexion', 'error');
    }
  }

  // ===== GÉNÉRATION D'IMAGE IA =====
  async function generateImageWithAI() {
    const titre = document.getElementById('eventTitre')?.value.trim() || currentEditingEventData?.titre || '';
    const description = document.getElementById('eventDescription')?.value.trim() || currentEditingEventData?.description || '';

    if (!titre || !description) {
      showAlert('Le titre et la description de l\'événement sont nécessaires pour générer une image', 'error');
      return;
    }

    const btnGenerate = document.getElementById('btnGenerateEventImage');
    const originalHtml = btnGenerate ? btnGenerate.innerHTML : '';
    if (btnGenerate) {
      btnGenerate.disabled = true;
      btnGenerate.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';
    }

    try {
      const response = await fetch('/api/admin/events/generate-image', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          titre: titre,
          description: description.substring(0, 200)
        })
      });

      const result = await parseJsonResponse(response);

      if (result.success && result.imageData) {
        const mimeType = result.mimeType || 'image/png';
        const preview = document.getElementById('eventImagePreview');
        if (preview) {
          const imgSrc = result.imageData.startsWith('data:') ? result.imageData : `data:${mimeType};base64,${result.imageData}`;
          preview.innerHTML = `<img src="${imgSrc}" alt="Image générée" style="width: 100%; height: 100%; object-fit: cover;">`;
        }
        generatedImageData = result.imageData;
        selectedImageFile = null;
        document.getElementById('eventImage').value = '';
        showAlert('Image générée avec succès par IA', 'success');
      } else {
        showAlert(result.message || 'Erreur lors de la génération d\'image', 'error');
      }
    } catch (error) {
      console.error('Erreur:', error);
      showAlert('Erreur de génération d\'image', 'error');
    } finally {
      if (btnGenerate) {
        btnGenerate.disabled = false;
        btnGenerate.innerHTML = originalHtml;
      }
    }
  }

  // ===== FONCTIONS DE LA CARTE =====
  function initEventMap() {
    if (eventMap) {
      eventMap.remove();
    }

    const mapContainer = document.getElementById('eventMap');
    if (!mapContainer) return;

    const defaultLat = 36.8065;
    const defaultLng = 10.1815;

    eventMap = L.map('eventMap').setView([defaultLat, defaultLng], 7);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(eventMap);

    eventMap.on('click', function(e) {
      placeMarker(e.latlng.lat, e.latlng.lng);
    });

    mapContainer.style.display = 'block';
  }

  function placeMarker(lat, lng) {
    if (eventMarker) {
      eventMap.removeLayer(eventMarker);
    }

    eventMarker = L.marker([lat, lng]).addTo(eventMap);
    currentLatitude = lat;
    currentLongitude = lng;

    updateCoordinatesDisplay();
    reverseGeocode(lat, lng);
  }

  function updateCoordinatesDisplay() {
    const display = document.getElementById('coordinatesDisplay');
    const displayText = document.getElementById('latLngDisplay');

    if (currentLatitude && currentLongitude) {
      displayText.textContent = `${currentLatitude.toFixed(6)}, ${currentLongitude.toFixed(6)}`;
      display.style.display = 'block';
    } else {
      displayText.textContent = 'Non définies';
      display.style.display = 'none';
    }
  }

  async function reverseGeocode(lat, lng) {
    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
      const data = await response.json();

      if (data && data.display_name) {
        document.getElementById('eventLieu').value = data.display_name;
      }
    } catch (error) {
      console.error('Erreur de géocodage inverse:', error);
    }
  }

  async function geocodeLocation() {
    const address = document.getElementById('eventLieu').value.trim();
    if (!address) {
      showAlert('Veuillez saisir une adresse', 'error');
      return;
    }

    const btn = document.getElementById('btnGeocode');
    btn.classList.add('loading');
    btn.disabled = true;

    try {
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}&limit=5&countrycodes=TN`);
      const results = await response.json();

      if (results && results.length > 0) {
        const result = results[0];
        const lat = parseFloat(result.lat);
        const lng = parseFloat(result.lon);

        if (!eventMap) {
          initEventMap();
        }

        eventMap.setView([lat, lng], 15);
        placeMarker(lat, lng);
        showAlert('Adresse localisée avec succès', 'success');
      } else {
        showAlert('Adresse non trouvée. Essayez une adresse plus précise.', 'error');
      }
    } catch (error) {
      console.error('Erreur de géocodage:', error);
      showAlert('Erreur lors de la recherche d\'adresse', 'error');
    } finally {
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  }

  function setupGeocodingForModal() {
    const modal = document.getElementById('eventModal');
    if (modal) {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            if (modal.classList.contains('open')) {
              setTimeout(() => {
                initEventMap();
              }, 100);
            } else {
              currentLatitude = null;
              currentLongitude = null;
              updateCoordinatesDisplay();
              if (eventMap) {
                eventMap.remove();
                eventMap = null;
                eventMarker = null;
              }
              const mapContainer = document.getElementById('eventMap');
              if (mapContainer) {
                mapContainer.style.display = 'none';
              }
            }
          }
        });
      });
      observer.observe(modal, { attributes: true });
    }
  }

  // ===== INITIALISATION =====
  function setupEventListeners() {
    const searchInput = document.getElementById('searchEvents');
    const statusFilter = document.getElementById('filterStatus');
    const organisateurFilter = document.getElementById('filterOrganisateur');
    const dateFilter = document.getElementById('filterDate');
    const resetFiltersButton = document.getElementById('btnResetFilters');
    const exportButton = document.getElementById('btnExportEvents');
    const refreshButton = document.getElementById('btnRefreshEvents');
    const createButton = document.getElementById('btnCreateEvent');
    const saveButton = document.getElementById('btnSaveEvent');

    if (searchInput) searchInput.addEventListener('input', filterEvents);
    if (statusFilter) statusFilter.addEventListener('change', filterEvents);
    if (organisateurFilter) organisateurFilter.addEventListener('change', filterEvents);
    if (dateFilter) dateFilter.addEventListener('change', filterEvents);
    if (resetFiltersButton) resetFiltersButton.addEventListener('click', resetFilters);
    if (exportButton) exportButton.addEventListener('click', exportEvents);
    if (refreshButton) refreshButton.addEventListener('click', async () => { await loadEvents(); });
    if (createButton) createButton.addEventListener('click', openEventModalForCreate);
    if (saveButton) saveButton.addEventListener('click', saveEvent);

    checkAuthentication().then(isAuthenticated => {
      if (isAuthenticated) {
        setEventsLoading();
        loadOrganisateurs();
        loadEvents();
      } else {
        showAlert('Erreur de connexion au serveur. Veuillez rafraîchir la page.', 'error');
        setTimeout(() => window.location.reload(), 3000);
      }
    });

    setupGeocodingForModal();

    const eventImageInput = document.getElementById('eventImage');
    if (eventImageInput) {
      eventImageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          if (file.size > 5 * 1024 * 1024) {
            showAlert('Fichier trop volumineux (max 5MB)', 'error');
            e.target.value = '';
            return;
          }
          const reader = new FileReader();
          reader.onload = function(event) {
            const preview = document.getElementById('eventImagePreview');
            if (preview) {
              preview.innerHTML = `<img src="${event.target.result}" alt="Aperçu" style="width: 100%; height: 100%; object-fit: cover;">`;
            }
            selectedImageFile = file;
            generatedImageData = null;
          };
          reader.readAsDataURL(file);
        }
      });
    }
  }

  if (document.readyState !== 'loading') {
    setupEventListeners();
  } else {
    document.addEventListener('DOMContentLoaded', setupEventListeners);
  }
</script>