      const enAttente = events.filter(e => e.statut === 'en_attente').length;
      const rejete = events.filter(e => e.statut === 'rejete').length;

      document.getElementById('summary-total').textContent = total;
      document.getElementById('summary-valid').textContent = valide;
      document.getElementById('summary-pending').textContent = enAttente;
      document.getElementById('summary-rejected').textContent = rejete;
    }

