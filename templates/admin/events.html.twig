    function normalizeEventDateFields(data) {
      if (data.date_evenement && data.date_evenement.includes('T')) {
        const [date, time] = data.date_evenement.split('T');
        data.date_evenement = date;
        data.heure_evenement = time;
      } else {
        data.heure_evenement = data.heure_evenement || '09:00';
      }
      return data;
    }

    async function saveEvent() {
      const form = document.getElementById('eventForm');
      const formData = new FormData(form);
      if (!formData.get('image_evenement') && generatedImageData) {
        let base64String = generatedImageData;
        if (base64String.includes(',')) {
          base64String = base64String.split(',')[1];
        }
        const byteCharacters = atob(base64String);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
          byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        const mimeType = generatedImageData.startsWith('data:image/svg+xml') ? 'image/svg+xml' : 'image/png';
        const fileName = mimeType === 'image/svg+xml' ? 'generated-event-image.svg' : 'generated-event-image.png';
        formData.append('image_evenement', new Blob([byteArray], { type: mimeType }), fileName);
      }
      const data = normalizeEventDateFields(Object.fromEntries([...formData.entries()].filter(([key]) => key !== 'image_evenement')));

      // Validation côté client
      if (!validateEventForm(data)) {
        return;
      }

      const isUpdate = currentEventId !== null;
      const url = isUpdate ? `/api/admin/events/${currentEventId}` : '/api/admin/events';
      const method = 'POST';

      try {
        const response = await fetch(url, {
          method: method,
          credentials: 'include',
          headers: {
            'Accept': 'application/json'
          },
          body: formData
        });

        const result = await parseJsonResponse(response);

        if (result.success) {
          showAlert(result.message, 'success');
          closeEventModal();
          await loadEvents();
        } else if (result.errors) {
          displayFormErrors(result.errors);
        } else {
          showAlert(result.message || 'Erreur lors de la sauvegarde', 'error');
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion', 'error');
      }
    }

