  <script>
    let eventsData = [];
    let organisateursData = [];
    let currentEventId = null;

    async function parseJsonResponse(response) {
      const text = await response.text();
      try {
        const json = JSON.parse(text);
        if (typeof json === 'object' && json !== null) {
          return json;
        }
      } catch (error) {
        console.error('Invalid JSON response:', text);
      }
      return {
        success: false,
        message: response.status === 401
          ? 'Accès non autorisé. Veuillez vous reconnecter.'
          : response.status === 403
            ? 'Accès refusé.'
            : 'Réponse serveur invalide.',
        status: response.status,
        body: text,
      };
    }

    async function checkAuthentication() {
      // For admin page, we skip authentication check since routes are open
      return true;
    }

    function setEventsLoading() {
      const tbody = document.getElementById('eventsTableBody');
      if (tbody) {
        tbody.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⏳ Chargement des événements...</div>`;
      }
    }

    function setupEventListeners() {
      const searchInput = document.getElementById('searchEvents');
      const statusFilter = document.getElementById('filterStatus');
      const organisateurFilter = document.getElementById('filterOrganisateur');
      const dateFilter = document.getElementById('filterDate');
      const resetFiltersButton = document.getElementById('btnResetFilters');
      const exportButton = document.getElementById('btnExportEvents');
      const refreshButton = document.getElementById('btnRefreshEvents');

      if (searchInput) searchInput.addEventListener('input', filterEvents);
      if (statusFilter) statusFilter.addEventListener('change', filterEvents);
      if (organisateurFilter) organisateurFilter.addEventListener('change', filterEvents);
      if (dateFilter) dateFilter.addEventListener('change', filterEvents);
      if (resetFiltersButton) resetFiltersButton.addEventListener('click', resetFilters);
      if (exportButton) exportButton.addEventListener('click', exportEvents);
      if (refreshButton) refreshButton.addEventListener('click', async () => { await loadEvents(); });

      // Check authentication and load data
      checkAuthentication().then(isAuthenticated => {
        if (isAuthenticated) {
          setEventsLoading();
          loadOrganisateurs();
          loadEvents();
        } else {
          showAlert('Erreur de connexion au serveur. Veuillez rafraîchir la page.', 'error');
          setTimeout(() => window.location.reload(), 3000);
        }
      });
    }

    // Fonctions de chargement des données
    async function loadEvents() {
      try {
        setEventsLoading();
        const response = await fetch('/api/admin/events', {
          credentials: 'include',
          headers: {
            'Accept': 'application/json'
          }
        });

        const data = await parseJsonResponse(response);
        if (!response.ok) {
          if (response.status === 401 || response.status === 403) {
            showAlert('Accès refusé. Veuillez vous connecter en tant qu\'administrateur.', 'error');
            document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Accès non autorisé.</div>`;
            setTimeout(() => window.location.href = '/login', 2000);
            return;
          }
          const details = data.body ? ` (${escapeHtml(data.body.substring(0, 120))})` : '';
          showAlert(data.message || `Erreur serveur (${response.status})${details}`, 'error');
          document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Impossible de charger les événements.</div>`;
          return;
        }

        if (data.success) {
          eventsData = Array.isArray(data.events) ? data.events : [];
          renderEventsTable();
          updateEventsSummary();
        } else {
          showAlert(data.message || 'Erreur lors du chargement des événements', 'error');
          document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ ${escapeHtml(data.message || 'Erreur lors du chargement des événements')}</div>`;
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion', 'error');
        document.getElementById('eventsTableBody').innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⚠️ Erreur de connexion.</div>`;
      }
    }

    async function loadOrganisateurs() {
