    <!-- Modal de confirmation de suppression -->
    <div id="deleteEventModal" class="events-modal">
      <div class="events-modal-content" style="max-width: 400px;">
        <div class="events-modal-header">
          <h3>Confirmer la suppression</h3>
          <button style="background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;" onclick="closeDeleteModal()">✕</button>
        </div>
        <div class="events-modal-body">
          <p style="color: var(--text); margin-bottom: 8px;">Êtes-vous sûr de vouloir supprimer cet événement ?</p>
          <p style="color: var(--text); font-weight: 600; margin-bottom: 8px;"><i class="fas fa-calendar"></i> <span id="deleteEventTitle"></span></p>
          <p style="color: var(--danger); font-size: 0.8rem;"><i class="fas fa-exclamation-triangle"></i> Cette action est irréversible.</p>
        </div>
        <div class="events-modal-footer">
          <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--text); padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer;" onclick="closeDeleteModal()">Annuler</button>
          <button type="button" class="btn" style="background: rgba(224,90,58,0.15); color: var(--danger); padding: 8px 16px; border: 1px solid rgba(224,90,58,0.3); border-radius: 8px; cursor: pointer;" id="btnConfirmDelete" onclick="confirmDeleteEvent()">
            <i class="fas fa-trash"></i> Supprimer
          </button>
        </div>
      </div>
