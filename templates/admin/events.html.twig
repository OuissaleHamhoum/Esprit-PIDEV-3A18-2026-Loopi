          <div style="color: var(--text); text-align: center;">${event.capacite_max}</div>
          <div style="color: var(--accent); font-weight: 600; text-align: center; cursor: pointer;" onclick="viewEventParticipants(${event.id})" title="Voir les participants">
            ${participantsCount}/${event.capacite_max}
          </div>
          <div><span class="badge ${statusClass}">${statusText}</span></div>
          <div class="action-buttons">
            <button class="btn-small info" onclick="viewEventDetails(${event.id})" title="Voir">Voir</button>
            <button class="btn-small warning" onclick="editEvent(${event.id})" title="Modifier">Modifier</button>
            ${event.statut === 'en_attente' ? `
              <button class="btn-small success" onclick="validateEvent(${event.id})" title="Valider">Valider</button>
              <button class="btn-small danger" onclick="rejectEvent(${event.id})" title="Rejeter">Rejeter</button>
            ` : ''}
            <button class="btn-small danger" onclick="deleteEventById(${event.id})" title="Supprimer">Supprimer</button>
