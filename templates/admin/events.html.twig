                <input type="datetime-local" id="eventDate" name="date_evenement" required style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
                <div class="error-message" id="error-date_evenement" style="color: var(--danger); font-size: 0.65rem; display: none;"></div>
