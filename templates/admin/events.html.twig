          <button id="btnResetFilters" onclick="resetFilters()" style="background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); padding: 8px 12px; border-radius: 8px; cursor: pointer; align-self: flex-end;">
            <i class="fas fa-times"></i> Réinitialiser
          </button>
        </div>
      </div>

      <div id="eventsAlert" class="alert alert-warn" style="display:none; margin-bottom: 12px; padding: 12px 16px; border-radius: 8px; background: rgba(201,169,110,0.1); border-left: 3px solid var(--sand); color: var(--sand);"></div>
      <div id="eventsSummary" style="margin-bottom:12px;color:var(--muted);font-size:.8rem;display:flex;gap:16px">
        <span><i class="fas fa-list"></i> Total: <span id="summary-total">0</span></span>
        <span><i class="fas fa-check"></i> Validés: <span id="summary-valid">0</span></span>
        <span><i class="fas fa-clock"></i> En attente: <span id="summary-pending">0</span></span>
        <span><i class="fas fa-times"></i> Rejetés: <span id="summary-rejected">0</span></span>
      </div>

      <!-- Table des événements -->
      <div style="overflow-x: auto; background: var(--card); border-radius: 12px; border: 1px solid var(--border);">
        <div class="tbl" style="display: grid; grid-template-columns: 0.8fr 2fr 1.5fr 1.5fr 1.5fr 1fr 1fr 1.2fr 1.8fr; gap: 12px; padding: 12px; background: var(--bg); border-bottom: 1px solid var(--border); font-weight: 700; color: var(--muted); font-size: 0.65rem; text-transform: uppercase;">
          <div>Image</div>
          <div>Titre</div>
          <div>Organisateur</div>
          <div>Date</div>
          <div>Lieu</div>
          <div>Capacité</div>
          <div>Participants</div>
          <div>Statut</div>
          <div>Actions</div>
        </div>
        <div id="eventsTableBody">
          <div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">
            ⏳ Chargement des événements...
          </div>
        </div>
      </div>
    </div>
    </div>

    <!-- Modal de détails d'événement -->
    <div id="eventDetailsModal" class="events-modal">
      <div class="events-modal-content">
        <div class="events-modal-header">
          <h3>Détails de l'événement</h3>
          <button style="background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;" onclick="closeEventDetailsModal()">✕</button>
        </div>
        <div class="events-modal-body">
