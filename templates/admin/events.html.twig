  function renderOrganisateursSelect() {
    const filterSelect = document.getElementById('filterOrganisateur');
    const eventSelect = document.getElementById('eventOrganisateur');

    if (filterSelect) {
      filterSelect.innerHTML = '<option value="">Tous les organisateurs</option>';
    }
    if (eventSelect) {
      eventSelect.innerHTML = '<option value="">Sélectionner un organisateur</option>';
    }

    if (!Array.isArray(organisateursData) || !organisateursData.length) {
      return;
    }

    organisateursData.forEach(org => {
      const label = org.nom ? `${org.nom} ${org.prenom || ''}`.trim() : org.email || org.displayName || 'Organisateur';
