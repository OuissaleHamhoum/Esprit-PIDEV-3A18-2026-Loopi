        if (!response.ok) {
          if (response.status === 401 || response.status === 403) {
            console.warn('Impossible de charger les organisateurs: accès refusé');
            return;
          }
          console.warn('Impossible de charger les organisateurs:', data.message || response.status);
          return;
        }

        if (data.success) {
