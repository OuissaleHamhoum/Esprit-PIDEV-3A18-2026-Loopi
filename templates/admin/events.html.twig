        tbody.innerHTML = '<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">📭 Aucun événement trouvé</div>';
        updateEventsSummary(events);
        return;
      }

      events.forEach(event => {
        const statusClass = getStatusClass(event.statut);
