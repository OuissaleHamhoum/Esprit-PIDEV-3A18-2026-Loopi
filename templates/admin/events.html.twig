<!-- ─── PAGE: EVENTS ─── -->

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
  .action-buttons { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .btn-small { display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; font-size: 0.8rem; border-radius: 10px; cursor: pointer; border: 1px solid transparent; transition: all 0.2s ease; min-width: 92px; font-weight: 700; text-align: center; }
  .btn-small:hover { transform: translateY(-1px); }
  .btn-small.info { background: rgba(93, 168, 122, 0.12); color: var(--forest); border-color: rgba(93, 168, 122, 0.25); }
  .btn-small.warning { background: rgba(201, 169, 110, 0.12); color: var(--sand); border-color: rgba(201, 169, 110, 0.25); }
  .btn-small.success { background: rgba(93, 168, 122, 0.12); color: var(--forest); border-color: rgba(93, 168, 122, 0.25); }
  .btn-small.danger { background: rgba(224, 90, 58, 0.12); color: var(--danger); border-color: rgba(224, 90, 58, 0.25); }
  .badge { padding: 4px 10px; border-radius: 50px; font-size: 0.65rem; font-weight: 700; white-space: nowrap; }
  .badge.pending { background: rgba(201, 169, 110, 0.15); color: #C9A96E; }
  .badge.valide { background: rgba(93, 168, 122, 0.15); color: #5DA87A; }
  .badge.rejete { background: rgba(224, 90, 58, 0.15); color: #E05A3A; }
  
  .events-modal {
    display: none !important;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 3000;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity .2s ease, visibility .2s ease;
  }
  .events-modal.open {
    display: flex !important;
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }
  .events-modal-content {
    background: var(--card);
    border-radius: 16px;
    width: 90%;
    max-width: 700px;
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid var(--border);
  }
  .events-modal-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .events-modal-header h3 {
    color: var(--text);
    font-size: 1.1rem;
    margin: 0;
  }
  .events-modal-body {
    padding: 24px;
  }
  .events-modal-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }
  .filter-section {
    background: var(--bg);
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
    align-items: flex-end;
  }
  .filter-row > div {
    display: flex;
    flex-direction: column;
  }
  .filter-row label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .filter-row input, .filter-row select {
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.8rem;
  }
  .filter-row input:focus, .filter-row select:focus {
    border-color: var(--accent);
    outline: none;
    background: white;
  }
  .event-row {
    display: grid;
    grid-template-columns: 0.8fr 2fr 1.5fr 1.5fr 1.5fr 1fr 1fr 1.2fr 1.8fr;
    gap: 12px;
    padding: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    align-items: center;
  }
  .event-row:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Geocoding and Map Styles */
  .location-container { position: relative; }
  .location-input-container { display: flex; gap: 8px; align-items: flex-end; }
  .location-input-container input { flex: 1; }
  .geocode-btn { padding: 8px 12px; background: rgba(93,168,122,0.1); color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; cursor: pointer; font-size: 0.8rem; transition: all 0.2s; }
  .geocode-btn:hover { background: var(--accent); color: white; }
  .geocode-btn.loading { background: rgba(201,169,110,0.1); color: var(--sand); border-color: var(--sand); }
  .geocode-btn.loading::after { content: '⏳'; margin-left: 4px; }
  .map-container { margin-top: 12px; height: 300px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
  .coordinates-display { margin-top: 8px; font-size: 0.75rem; color: var(--muted); padding: 8px; background: rgba(255,255,255,0.05); border-radius: 6px; }
  .suggestions-list { position: absolute; top: 100%; left: 0; right: 0; background: var(--card); border: 1px solid var(--border); border-radius: 8px; max-height: 200px; overflow-y: auto; z-index: 1000; display: none; }
  .suggestion-item { padding: 8px 12px; cursor: pointer; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .suggestion-item:hover { background: rgba(255,255,255,0.05); }
  .suggestion-item:last-child { border-bottom: none; }
  
  .badge-success {
    background-color: #28a745;
    color: white;
  }
  .badge-danger {
    background-color: #dc3545;
    color: white;
  }
  .badge-warning {
    background-color: #ffc107;
    color: black;
  }
  .badge-secondary {
    background-color: #6c757d;
    color: white;
  }
  .error-message {
    color: var(--danger);
    font-size: 0.65rem;
    display: none;
  }
</style>

<div id="page-events" style="display:none">
  <div class="blk" style="margin-bottom:16px">
    <div class="blk-title" style="margin-bottom: 20px;">
      <div>
        Gestion des événements
        <span class="sub" style="font-family: 'DM Sans',sans-serif; font-size: 0.7rem; color: var(--muted); margin-left: 8px;">Validation & Modération</span>
      </div>
      <div style="display:flex;gap:10px">
        <button id="btnRefreshEvents" class="btn btn-outline" style="background: rgba(255,255,255,0.08); color: var(--accent); border: 1px solid var(--border); padding: 8px 16px;" title="Rafraîchir la liste">
          <i class="fas fa-sync-alt"></i> Rafraîchir
        </button>
        <button id="btnExportEvents" class="btn btn-outline" style="background: rgba(93,168,122,0.1); color: var(--accent); border: 1px solid var(--accent); padding: 8px 16px;" title="Exporter les événements">
          <i class="fas fa-download"></i> Exporter
        </button>
        <button id="btnCreateEvent" class="btn" style="background: linear-gradient(135deg, var(--accent), var(--moss)); color: var(--text); padding: 10px 20px; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: none; cursor: pointer; transition: all 0.2s ease;">
          <i class="fas fa-plus"></i> Créer un événement
        </button>
      </div>
    </div>

    <!-- Barre de recherche et filtres -->
    <div class="filter-section">
      <div class="filter-row" style="grid-template-columns: 2fr 1fr 1fr 1fr auto;">
        <div>
          <label for="searchEvents">🔍 Rechercher</label>
          <input type="text" id="searchEvents" placeholder="Titre, organisateur, lieu..." style="width: 100%">
        </div>
        <div>
          <label for="filterStatus">Statut</label>
          <select id="filterStatus" style="width: 100%">
            <option value="">Tous</option>
            <option value="en_attente">En attente</option>
            <option value="valide">Validé</option>
            <option value="rejete">Rejeté</option>
          </select>
        </div>
        <div>
          <label for="filterOrganisateur">Organisateur</label>
          <select id="filterOrganisateur" style="width: 100%">
            <option value="">Tous</option>
          </select>
        </div>
        <div>
          <label for="filterDate">Période</label>
          <select id="filterDate" style="width: 100%">
            <option value="">Toutes</option>
            <option value="today">Aujourd'hui</option>
            <option value="week">Cette semaine</option>
            <option value="month">Ce mois</option>
            <option value="upcoming">À venir</option>
            <option value="past">Passés</option>
          </select>
        </div>
        <button id="btnResetFilters" style="background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); padding: 8px 12px; border-radius: 8px; cursor: pointer; align-self: flex-end;">
          <i class="fas fa-times"></i> Réinitialiser
        </button>
      </div>
    </div>

    <div id="eventsAlert" class="alert alert-warn" style="display:none; margin-bottom: 12px; padding: 12px 16px; border-radius: 8px; background: rgba(201,169,110,0.1); border-left: 3px solid var(--sand); color: var(--sand);"></div>
    <div id="eventsSummary" style="margin-bottom:12px;color:var(--muted);font-size:.8rem;display:flex;gap:16px">
      <span><i class="fas fa-list"></i> Total: <span id="summary-total">0</span></span>
      <span><i class="fas fa-check"></i> Validés: <span id="summary-valid">0</span></span>
      <span><i class="fas fa-clock"></i> En attente: <span id="summary-pending">0</span></span>
      <span><i class="fas fa-times"></i> Rejetés: <span id="summary-rejected">0</span></span>
    </div>

    <!-- Table des événements -->
    <div style="overflow-x: auto; background: var(--card); border-radius: 12px; border: 1px solid var(--border);">
      <div class="tbl" style="display: grid; grid-template-columns: 0.8fr 2fr 1.5fr 1.5fr 1.5fr 1fr 1fr 1.2fr 1.8fr; gap: 12px; padding: 12px; background: var(--bg); border-bottom: 1px solid var(--border); font-weight: 700; color: var(--muted); font-size: 0.65rem; text-transform: uppercase;">
        <div>Image</div>
        <div>Titre</div>
        <div>Organisateur</div>
        <div>Date</div>
        <div>Lieu</div>
        <div>Capacité</div>
        <div>Participants</div>
        <div>Statut</div>
        <div>Actions</div>
      </div>
      <div id="eventsTableBody">
        <div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">
          ⏳ Chargement des événements...
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de détails d'événement -->
<div id="eventDetailsModal" class="events-modal">
  <div class="events-modal-content">
    <div class="events-modal-header">
      <h3>Détails de l'événement</h3>
      <button style="background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;" onclick="closeEventDetailsModal()">✕</button>
    </div>
    <div class="events-modal-body">
      <div id="eventDetailsContent" style="color: var(--text);"></div>
    </div>
    <div class="events-modal-footer">
      <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--text); padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer;" onclick="closeEventDetailsModal()">Fermer</button>
    </div>
  </div>
</div>

<!-- Modal de création/édition d'événement -->
<div id="eventModal" class="events-modal">
  <div class="events-modal-content">
    <div class="events-modal-header">
      <h3 id="eventModalTitle">Créer un événement</h3>
      <button style="background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;" onclick="closeEventModal()">✕</button>
    </div>
    <div class="events-modal-body">
      <form id="eventForm" style="display: grid; gap: 12px;" onsubmit="event.preventDefault();">
        <input type="hidden" id="eventId" name="id">

        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label for="eventTitre" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Titre *</label>
          <input type="text" id="eventTitre" name="titre" required maxlength="200" placeholder="Titre de l'événement" style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
          <div class="error-message" id="error-titre"></div>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label for="eventDescription" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Description *</label>
          <textarea id="eventDescription" name="description" required rows="3" placeholder="Description détaillée..." style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem; resize: vertical;"></textarea>
          <div class="error-message" id="error-description"></div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <label for="eventDate" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Date & Heure *</label>
            <input type="datetime-local" id="eventDate" name="date_evenement" required style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
            <div class="error-message" id="error-date_evenement"></div>
          </div>
          <div style="display: flex; flex-direction: column; gap: 4px;">
            <label for="eventCapacite" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Capacité max *</label>
            <input type="number" id="eventCapacite" name="capacite_max" required min="1" max="10000" placeholder="Nombre" style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
            <div class="error-message" id="error-capacite_max"></div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label for="eventLieu" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Lieu *</label>
          <div class="location-container">
            <div class="location-input-container">
              <input type="text" id="eventLieu" name="lieu" required maxlength="200" placeholder="Adresse ou description du lieu" style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
              <button type="button" class="geocode-btn" id="btnGeocode" onclick="geocodeLocation()" title="Rechercher et localiser l'adresse">
                <i class="fas fa-search-location"></i> Localiser
              </button>
            </div>
            <div class="suggestions-list" id="locationSuggestions"></div>
            <div class="map-container" id="eventMap" style="display: none;"></div>
            <div class="coordinates-display" id="coordinatesDisplay" style="display: none;">
              <i class="fas fa-map-marker-alt"></i> Coordonnées: <span id="latLngDisplay">Non définies</span>
            </div>
          </div>
          <div class="error-message" id="error-lieu"></div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label for="eventOrganisateur" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Organisateur *</label>
          <select id="eventOrganisateur" name="id_organisateur" required style="padding: 8px 12px; background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.85rem;">
            <option value="">-- Sélectionner --</option>
          </select>
          <div class="error-message" id="error-id_organisateur"></div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 4px;">
          <label for="eventImage" style="font-size: 0.75rem; font-weight: 600; color: var(--muted);">Image de l'événement</label>
          <input type="file" id="eventImage" name="image_evenement" accept="image/*" style="padding: 8px 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 8px; color: var(--muted); font-size: 0.8rem;">
          <div id="eventImagePreview" style="width: 100%; height: auto; min-height: 250px; max-height: 400px; background: var(--bg); border: 2px dashed var(--border); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.85rem; overflow: auto; position: relative;">
            <div style="text-align:center; padding: 20px;">
              <div style="font-size:3rem; margin-bottom:8px;">📷</div>
              <div>Aperçu de l'image</div>
              <div style="font-size: 0.7rem; margin-top: 8px; color: var(--muted);">Hauteur adaptable : voir l'image complète</div>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;">
            <button type="button" class="btn" onclick="document.getElementById('eventImage').click()" style="padding: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.06); color: var(--text); cursor: pointer; transition: all 0.2s;" title="Sélectionner une image depuis votre ordinateur">
              <i class="fas fa-upload"></i> Choisir image
            </button>
            <button type="button" class="btn" id="btnGenerateEventImage" onclick="generateImageWithAI()" style="padding: 10px; border: 1px solid var(--border); background: rgba(93,168,122,0.12); color: var(--forest); cursor: pointer; transition: all 0.2s;" title="Générer une image via IA basée sur le titre et la description">
              <i class="fas fa-wand-magic-sparkles"></i> Générer IA
            </button>
          </div>
          <small style="color: var(--muted); font-size: 0.7rem; line-height: 1.4;">
            💡 <strong>Générer IA:</strong> Utilise OpenAI DALL-E si configuré (clé API), sinon génère un visuel SVG local basé sur couleur du titre et texte.
          </small>
        </div>
      </form>
    </div>
    <div class="events-modal-footer">
      <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--text); padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer;" onclick="closeEventModal()">Annuler</button>
      <button type="button" class="btn" style="background: linear-gradient(135deg, var(--accent), var(--moss)); color: var(--text); padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.2s ease;" id="btnSaveEvent">
        <i class="fas fa-save"></i> Enregistrer
      </button>
    </div>
  </div>
</div>

<!-- Modal de confirmation de suppression -->
<div id="deleteEventModal" class="events-modal">
  <div class="events-modal-content" style="max-width: 400px;">
    <div class="events-modal-header">
      <h3>Confirmer la suppression</h3>
      <button style="background: none; border: none; color: var(--muted); font-size: 1.2rem; cursor: pointer;" onclick="closeDeleteModal()">✕</button>
    </div>
    <div class="events-modal-body">
      <p style="color: var(--text); margin-bottom: 8px;">Êtes-vous sûr de vouloir supprimer cet événement ?</p>
      <p style="color: var(--text); font-weight: 600; margin-bottom: 8px;"><i class="fas fa-calendar"></i> <span id="deleteEventTitle"></span></p>
      <p style="color: var(--danger); font-size: 0.8rem;"><i class="fas fa-exclamation-triangle"></i> Cette action est irréversible.</p>
    </div>
    <div class="events-modal-footer">
      <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--text); padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer;" onclick="closeDeleteModal()">Annuler</button>
      <button type="button" class="btn" style="background: rgba(224,90,58,0.15); color: var(--danger); padding: 8px 16px; border: 1px solid rgba(224,90,58,0.3); border-radius: 8px; cursor: pointer;" id="btnConfirmDelete" onclick="confirmDeleteEvent()">
        <i class="fas fa-trash"></i> Supprimer
      </button>
    </div>
  </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  // ===== VARIABLES GLOBALES =====
  let eventsData = [];
  let organisateursData = [];
  let currentEventId = null;
  let currentEditingEventData = null;
  let selectedImageFile = null;
  let generatedImageData = null;
  
  // Variables pour la carte
  let eventMap = null;
  let eventMarker = null;
  let currentLatitude = null;
  let currentLongitude = null;

  // ===== FONCTIONS UTILITAIRES =====
  async function parseJsonResponse(response) {
    const text = await response.text();
    try {
      const json = JSON.parse(text);
      if (typeof json === 'object' && json !== null) {
        return json;
      }
    } catch (error) {
      console.error('Invalid JSON response:', text);
    }
    return {
      success: false,
      message: response.status === 401
        ? 'Accès non autorisé. Veuillez vous reconnecter.'
        : response.status === 403
          ? 'Accès refusé.'
          : 'Réponse serveur invalide.',
      status: response.status,
      body: text,
    };
  }

  async function checkAuthentication() {
    return true;
  }

  function setEventsLoading() {
    const tbody = document.getElementById('eventsTableBody');
    if (tbody) {
      tbody.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 20px; color: var(--muted); font-size: 0.8rem;">⏳ Chargement des événements...</div>`;
    }
  }

  function showAlert(message, type = 'info') {
    const alertDiv = document.getElementById('eventsAlert');
    alertDiv.className = `alert alert-${type === 'error' ? 'danger' : type}`;
    alertDiv.textContent = message;
    alertDiv.style.display = 'block';

    setTimeout(() => {
      alertDiv.style.display = 'none';
    }, 5000);
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function getStatusClass(status) {
    switch (status) {
      case 'valide':
      case 'approuve':
        return 'valide';
      case 'rejete':
        return 'rejete';
      case 'en_attente':
        return 'pending';
      default:
        return 'secondary';
    }
  }

  function getStatusText(status) {
    switch (status) {
      case 'valide':
      case 'approuve':
        return 'Validé';
      case 'rejete':
        return 'Rejeté';
      case 'en_attente':
        return 'En attente';
      default:
        return status;
    }
  }

  function formatDate(dateString) {
    if (!dateString) return '-';
    const date = new Date(dateString);
    return date.toLocaleDateString('fr-FR') + ' ' + date.toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit'});
  }

  function showFieldError(field, message) {
    const errorElement = document.getElementById(`error-${field}`);
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.style.display = 'block';
    }
  }

  function clearFormErrors() {
    const errorElements = document.querySelectorAll('.error-message');
    errorElements.forEach(el => {
      el.textContent = '';
      el.style.display = 'none';
    });
  }

  function displayFormErrors(errors) {
    Object.keys(errors).forEach(field => {
      showFieldError(field, errors[field]);
    });
  }

  // ===== FONCTIONS DE FILTRAGE =====
  function checkDateFilter(eventDate, filter) {
    if (!eventDate) return false;

    const eventDateTime = new Date(eventDate);
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

    switch (filter) {
      case 'today':
        return eventDateTime.toDateString() === today.toDateString();
      case 'week':
        const weekStart = new Date(today);
        weekStart.setDate(today.getDate() - today.getDay());
        const weekEnd = new Date(weekStart);
        weekEnd.setDate(weekStart.getDate() + 6);
        return eventDateTime >= weekStart && eventDateTime <= weekEnd;
      case 'month':
        return eventDateTime.getMonth() === now.getMonth() && eventDateTime.getFullYear() === now.getFullYear();
      case 'upcoming':
        return eventDateTime >= now;
      case 'past':
        return eventDateTime < now;
      default:
        return true;
    }
  }

  function filterEvents() {
    const normalizeStr = str => String(str || '').normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const searchTerm = normalizeStr(document.getElementById('searchEvents').value);
    const statusFilter = document.getElementById('filterStatus').value;
    const organisateurFilter = document.getElementById('filterOrganisateur').value;
    const dateFilter = document.getElementById('filterDate').value;

    const filteredEvents = eventsData.filter(event => {
      const title = normalizeStr(event.titre);
      const organizer = normalizeStr(event.organisateur);
      const location = normalizeStr(event.lieu);
      const description = normalizeStr(event.description);

      const matchesSearch = !searchTerm ||
          title.includes(searchTerm) ||
          organizer.includes(searchTerm) ||
          location.includes(searchTerm) ||
          description.includes(searchTerm);

      let matchesStatus = true;
      if (statusFilter) {
        if (statusFilter === 'valide') {
          matchesStatus = (event.statut === 'valide' || event.statut === 'approuve');
        } else {
          matchesStatus = (event.statut === statusFilter);
        }
      }

      const matchesOrganisateur = !organisateurFilter || String(event.id_organisateur) === String(organisateurFilter);
      const matchesDate = !dateFilter || checkDateFilter(event.date_evenement, dateFilter);

      return matchesSearch && matchesStatus && matchesOrganisateur && matchesDate;
    });

    renderEventsTable(filteredEvents);
    updateEventsSummary(filteredEvents);
  }

  function resetFilters() {
    document.getElementById('searchEvents').value = '';
    document.getElementById('filterStatus').value = '';
    document.getElementById('filterOrganisateur').value = '';
    document.getElementById('filterDate').value = '';
    filterEvents();
  }

  function updateEventsSummary(events = null) {
    const eventsToShow = events || eventsData;
    const total = eventsToShow.length;
    const valide = eventsToShow.filter(e => e.statut === 'valide' || e.statut === 'approuve').length;
    const enAttente = eventsToShow.filter(e => e.statut === 'en_attente').length;
    const rejete = eventsToShow.filter(e => e.statut === 'rejete').length;

    document.getElementById('summary-total').textContent = total;
    document.getElementById('summary-valid').textContent = valide;
    document.getElementById('summary-pending').textContent = enAttente;
    document.getElementById('summary-rejected').textContent = rejete;
  }

