        <div class="events-modal-footer">
          <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--text); padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer;" onclick="closeEventModal()">Annuler</button>
          <button type="button" class="btn" style="background: linear-gradient(135deg, var(--accent), var(--moss)); color: var(--text); padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.2s ease;" id="btnSaveEvent" onclick="saveEvent()">
