    /**
     * ╔════════════════════════════════════════════════════════════════════════════╗
     * ║           SYSTÈME DE GÉNÉRATION D'IMAGE AVEC IA (3 NIVEAUX)               ║
     * ╚════════════════════════════════════════════════════════════════════════════╝
     * 
     * ARCHITECTURE MULTI-FALLBACK :
     * =============================
     * Cette fonction implémente un système de génération d'image intelligent avec
     * 3 niveaux de fallback pour garantir un résultat même sans API externe.
     * 
     * 🎨 NIVEAU 1 - OpenAI DALL-E (Production)
     * ──────────────────────────────────────────
     * ✓ Utilise l'API OpenAI DALL-E 3
     * ✓ Génère des images réalistes et uniques
     * ✓ Clé API stockée en variable d'environnement côté serveur (OPENAI_API_KEY)
     * ✓ Requête : POST https://api.openai.com/v1/images/generations
     * ✓ Format : PNG 512x512 pixels
     * ✓ Avantage : Très bonne qualité, images personnalisées
     * 
     * 🖼️ NIVEAU 2 - GD Library (Fallback Local)
     * ──────────────────────────────────────────
     * ✓ Utilise la bibliothèque GD PHP (imagecreatetruecolor, imagepng)
     * ✓ Génération 100% locale, pas d'appel externe
     * ✓ Gradient de couleur basé sur MD5 du titre
     * ✓ Ajoute le texte du titre et description en blanc
     * ✓ Format : PNG (compressé)
     * ✓ Avantage : Rapide, aucune dépendance API
     * 
     * 📊 NIVEAU 3 - SVG Fallback (Ultime Secours)
     * ──────────────────────────────────────────
     * ✓ Génère un fichier SVG vectoriel
     * ✓ Couleur basée sur le hash MD5 du titre
     * ✓ Affiche titre et description en texte SVG
     * ✓ Utilise un dégradé linéaire pour le fond
     * ✓ Format : SVG (très léger, ~1KB)
     * ✓ Avantage : Toujours fonctionnel, ultra-léger
     * 
     * FLUX DE FONCTIONNEMENT COMPLET :
     * ════════════════════════════════════════════════════════════════════════
     * 
     * [USER] Clique \"Générer IA\"\n     *   ↓\n     * [FRONTEND] Extrait titre et description du formulaire\n     *   ↓\n     * [FRONTEND] Envoie POST /api/admin/events/generate-image\n     *   avec JSON: {titre: \"...\", description: \"...\"}\n     *   ↓\n     * [BACKEND ApiController::generateEventImage()]\n     *   ├─ Essaie OpenAI DALL-E (si OPENAI_API_KEY configurée)\n     *   │   ├─ Appel CURL à OpenAI API\n     *   │   ├─ Prompt: \"Créer une image d'événement pour {titre}...\"\n     *   │   └─ Retourne PNG base64\n     *   │\n     *   ├─ Fallback 2 : generateImageWithGD()\n     *   │   ├─ Crée image PNG 800x450 avec gradient couleur\n     *   │   ├─ Couleur = MD5(titre) → hex RGB\n     *   │   ├─ Ajoute texte titre + description\n     *   │   └─ Retourne base64 PNG\n     *   │\n     *   └─ Fallback 3 : generateFallbackImage()\n     *       ├─ Crée SVG vectoriel\n     *       ├─ Gradient linéaire + texte SVG\n     *       └─ Retourne base64 SVG\n     *   ↓\n     * [BACKEND] Retourne JSON:\n     *   {\n     *     success: true,\n     *     message: \"Image générée...\",\n     *     imageData: \"iVBORw0KGgo...\",\n     *     mimeType: \"image/png\" ou \"image/svg+xml\"\n     *   }\n     *   ↓\n     * [FRONTEND] Reçoit et crée data-URI:\n     *   const src = \"data:image/png;base64,{imageData}\"\n     *   ↓\n     * [FRONTEND] Affiche dans preview avec CSS adaptable:\n     *   <img src=\"data:...\" style=\"width:100%; height:100%; object-fit:cover;\" />\n     *   ↓\n     * [USER] Valide et clique \"Modifier\"\n     *   ↓\n     * [FRONTEND saveEvent()]\n     *   ├─ Détecte generatedImageData en base64\n     *   ├─ Convertit base64 → Uint8Array\n     *   ├─ Crée Blob(byteArray, {type: \"image/png\"})\n     *   ├─ Ajoute au FormData : formData.append('image_evenement', blob)\n     *   └─ Envoie POST /api/admin/events/{id} multipart/form-data\n     *   ↓\n     * [BACKEND updateEvent()]\n     *   ├─ Valide format image (jpg, jpeg, png, webp, svg)\n     *   ├─ Valide taille (max 5MB)\n     *   ├─ Génère nom unique : uniqid('event_', true) . '.png'\n     *   ├─ Déplace vers /public/uploads/events/\n     *   └─ Mise à jour DB : event.image_evenement = \"event_123abc.png\"\n     *   ↓\n     * [DISPLAY] L'image est accessible via /uploads/events/event_123abc.png\n     * \n     * CONFIGURATION OPENAI DALL-E :\n     * ═════════════════════════════════\n     * 1. Créer compte sur https://platform.openai.com\n     * 2. Générer clé API et l'ajouter à .env.local :\n     *    OPENAI_API_KEY=\"sk-proj-...\"\n     * 3. Backend utilise generateImageWithOpenAI() automatiquement\n     * 4. Sans clé API : utilise GD ou SVG fallback\n     * \n     * COÛTS ACTUELS (2024) :\n     * ═════════════════════════\n     * - OpenAI DALL-E 3 : ~$0.04 par image 512x512\n     * - GD Library local : GRATUIT (CPU serveur)\n     * - SVG fallback : GRATUIT (CPU serveur)\n     */
    async function generateImageWithAI() {
      const titre = document.getElementById('eventTitre')?.value.trim() || currentEditingEventData?.titre || '';
      const description = document.getElementById('eventDescription')?.value.trim() || currentEditingEventData?.description || '';

      if (!titre || !description) {
        showAlert('Le titre et la description de l\'événement sont nécessaires pour générer une image', 'error');
        return;
      }

      const btnGenerate = document.getElementById('btnGenerateEventImage');
      const originalHtml = btnGenerate ? btnGenerate.innerHTML : '';
      if (btnGenerate) {
        btnGenerate.disabled = true;
        btnGenerate.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';
      }

      document.getElementById('generationStatus').style.display = 'block';

      try {
        const response = await fetch('/api/admin/events/generate-image', {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            titre: titre,
            description: description.substring(0, 200) // Limiter la description
          })
        });

        const result = await parseJsonResponse(response);

        if (result.success && result.imageData) {
          const mimeType = result.mimeType || 'image/png';
          const preview = document.getElementById('eventImagePreview');
          if (preview) {
            preview.innerHTML = `<img src="data:${mimeType};base64,${result.imageData}" alt="Image générée" style="width: 100%; height: 100%; object-fit: cover;">`;
          }
          generatedImageData = result.imageData;
          selectedImageFile = null;
          document.getElementById('eventImage').value = '';
          showAlert('Image générée avec succès par IA', 'success');
        } else {
          showAlert(result.message || 'Erreur lors de la génération d\'image', 'error');
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de génération d\'image', 'error');
      } finally {
        if (btnGenerate) {
          btnGenerate.disabled = false;
          btnGenerate.innerHTML = originalHtml;
        }
        document.getElementById('generationStatus').style.display = 'none';
      }
    }

    // Sauvegarde des modifications d'image
    async function saveImageChanges() {
      if (!currentEditingEventData || (!selectedImageFile && !generatedImageData)) {
        showAlert('Veuillez sélectionner ou générer une image', 'error');
        return;
      }

      const btnSave = document.getElementById('btnSaveImage');
      const originalHtml = btnSave.innerHTML;
      btnSave.disabled = true;
      btnSave.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';

      try {
        const formData = new FormData();
        
        if (selectedImageFile) {
          formData.append('image_evenement', selectedImageFile);
        } else if (generatedImageData) {
          // Convertir base64 en blob
          try {
            // Si le base64 commence par "data:", enlever le préfixe
            let base64String = generatedImageData;
            if (base64String.includes(',')) {
              base64String = base64String.split(',')[1];
            }
            
            const byteCharacters = atob(base64String);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
              byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            const byteArray = new Uint8Array(byteNumbers);
            
            // Déterminer le type MIME basé sur le début du contenu
            const mimeType = base64String.startsWith('PHN2ZyA') ? 'image/svg+xml' : 'image/png';
            const fileName = mimeType === 'image/svg+xml' ? 'generated-image.svg' : 'generated-image.png';
            
            const blob = new Blob([byteArray], { type: mimeType });
            formData.append('image_evenement', blob, fileName);
          } catch (e) {
            console.error('Erreur conversion base64:', e);
            showAlert('Erreur lors de la conversion de l\'image', 'error');
            btnSave.disabled = false;
            btnSave.innerHTML = originalHtml;
            return;
          }
        }

        const response = await fetch(`/api/admin/events/${currentEditingEventData.id}`, {
          method: 'POST',
          credentials: 'include',
          body: formData
        });

        const result = await parseJsonResponse(response);

        if (result.success) {
          showAlert('Image mise à jour avec succès', 'success');
          closeImageModal();
          await loadEvents();
        } else {
          showAlert(result.message || 'Erreur lors de la mise à jour', 'error');
          console.error('API Error:', result);
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion: ' + error.message, 'error');
      } finally {
        btnSave.disabled = false;
        btnSave.innerHTML = originalHtml;
      }
    }

    async function validateEvent(id) {
      if (!confirm('Êtes-vous sûr de vouloir valider cet événement ?')) return;

      try {
        const response = await fetch(`/api/admin/events/${id}/validate`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          }
        });

        const result = await parseJsonResponse(response);

        if (result.success) {
          showAlert(result.message, 'success');
          await loadEvents();
        } else {
          showAlert(result.message || 'Erreur lors de la validation', 'error');
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion', 'error');
      }
    }

    async function rejectEvent(id) {
      if (!confirm('Êtes-vous sûr de vouloir rejeter cet événement ?')) return;

      try {
        const response = await fetch(`/api/admin/events/${id}/reject`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          }
        });

        const result = await parseJsonResponse(response);

        if (result.success) {
          showAlert(result.message, 'success');
          await loadEvents();
        } else {
          showAlert(result.message || 'Erreur lors du rejet', 'error');
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion', 'error');
      }
    }

    async function exportEvents() {
      try {
        const response = await fetch('/api/admin/events/export', {
          method: 'GET',
          credentials: 'include',
          headers: {
            'Accept': 'text/csv'
          }
        });

        if (response.ok) {
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `evenements_${new Date().toISOString().split('T')[0]}.csv`;
          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);
          document.body.removeChild(a);
          showAlert('Export réussi', 'success');
        } else {
          showAlert('Erreur lors de l\'export', 'error');
        }
      } catch (error) {
        console.error('Erreur export:', error);
        showAlert('Erreur de connexion', 'error');
      }
    }

    async function viewEventDetails(id) {
      try {
        const response = await fetch(`/api/admin/events/${id}`, {
          credentials: 'include',
          headers: {
            'Accept': 'application/json'
          }
        });

        const data = await parseJsonResponse(response);
        if (data.success) {
          const event = data.event;
          const participants = data.participants || [];

          let content = `
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
              <div>
                <h4 style="margin-bottom:10px;color:var(--primary)">Informations générales</h4>
                <table class="tbl" style="margin-bottom:20px">
                  <tr><td style="font-weight:500">Titre:</td><td>${escapeHtml(event.titre)}</td></tr>
                  <tr><td style="font-weight:500">Organisateur:</td><td>${escapeHtml(event.organisateur)}</td></tr>
                  ${event.image_evenement ? `<tr><td style="font-weight:500">Image:</td><td><img src="/uploads/events/${encodeURI(event.image_evenement)}" style="max-width:120px;max-height:90px;border-radius:8px" alt="Image événement"></td></tr>` : ''}
                  <tr><td style="font-weight:500">Date:</td><td>${formatDate(event.date_evenement)}</td></tr>
                  <tr><td style="font-weight:500">Lieu:</td><td>${escapeHtml(event.lieu)}</td></tr>
                  <tr><td style="font-weight:500">Capacité:</td><td>${event.capacite_max}</td></tr>
                  <tr><td style="font-weight:500">Statut:</td><td><span class="badge ${getStatusClass(event.statut)}">${getStatusText(event.statut)}</span></td></tr>
                  <tr><td style="font-weight:500">Créé le:</td><td>${formatDate(event.created_at)}</td></tr>
                  ${event.updated_at ? `<tr><td style="font-weight:500">Modifié le:</td><td>${formatDate(event.updated_at)}</td></tr>` : ''}
                </table>
              </div>
              <div>
                <h4 style="margin-bottom:10px;color:var(--primary)">Description</h4>
                <div style="background:var(--bg-secondary);padding:15px;border-radius:8px;max-height:200px;overflow-y:auto">
                  ${escapeHtml(event.description).replace(/\n/g, '<br>')}
                </div>
              </div>
            </div>

            <h4 style="margin-bottom:10px;color:var(--primary)">Participants (${participants.length}/${event.capacite_max})</h4>
            <div style="max-height:300px;overflow-y:auto;border:1px solid var(--border);border-radius:8px">
              <table class="tbl" style="margin:0;border:none">
                <thead style="position:sticky;top:0;background:var(--bg)">
                  <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Contact</th>
                    <th>Âge</th>
                    <th>Statut</th>
                    <th>Inscription</th>
                  </tr>
                </thead>
                <tbody>
          `;

          if (participants.length === 0) {
            content += '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--muted)">Aucun participant inscrit</td></tr>';
          } else {
            participants.forEach(participant => {
              const statusClass = participant.statut === 'present' ? 'badge-success' :
                                participant.statut === 'absent' ? 'badge-danger' : 'badge-warning';
              const statusText = participant.statut === 'present' ? 'Présent' :
                               participant.statut === 'absent' ? 'Absent' : 'Inscrit';

              content += `
                <tr>
                  <td>${escapeHtml(participant.nom)} ${escapeHtml(participant.prenom)}</td>
                  <td>${escapeHtml(participant.email)}</td>
                  <td>${escapeHtml(participant.contact || '-')}</td>
                  <td>${participant.age || '-'}</td>
                  <td><span class="badge ${statusClass}">${statusText}</span></td>
                  <td>${formatDate(participant.date_inscription)}</td>
                </tr>
              `;
            });
          }

          content += `
                </tbody>
              </table>
            </div>
          `;

          document.getElementById('eventDetailsContent').innerHTML = content;
          document.getElementById('eventDetailsModal').classList.add('open');
        } else {
          showAlert('Erreur lors du chargement des détails', 'error');
        }
      } catch (error) {
        console.error('Erreur:', error);
        showAlert('Erreur de connexion', 'error');
      }
    }

    function viewEventParticipants(id) {
      viewEventDetails(id);
    }

    // Fonctions utilitaires
    function validateEventForm(data) {
      clearFormErrors();
      let isValid = true;

      if (!data.titre || data.titre.trim().length < 3) {
        showFieldError('titre', 'Le titre doit contenir au moins 3 caractères');
        isValid = false;
      }

      if (!data.description || data.description.trim().length < 10) {
        showFieldError('description', 'La description doit contenir au moins 10 caractères');
        isValid = false;
      }

      if (!data.date_evenement) {
        showFieldError('date_evenement', 'La date est requise');
        isValid = false;
      } else {
        const eventDate = new Date(data.date_evenement);
        const now = new Date();
        if (eventDate < now) {
          showFieldError('date_evenement', 'La date ne peut pas être dans le passé');
          isValid = false;
        }
      }

      if (!data.lieu || data.lieu.trim().length === 0) {
        showFieldError('lieu', 'Le lieu est requis');
        isValid = false;
      }

      if (!data.id_organisateur) {
        showFieldError('id_organisateur', 'L\'organisateur est requis');
        isValid = false;
      }

      const capacite = parseInt(data.capacite_max);
      if (!capacite || capacite <= 0) {
        showFieldError('capacite_max', 'La capacité doit être supérieure à 0');
        isValid = false;
      } else if (capacite > 1000) {
        showFieldError('capacite_max', 'La capacité ne peut pas dépasser 1000');
        isValid = false;
      }

      return isValid;
    }

    function showFieldError(field, message) {
      const errorElement = document.getElementById(`error-${field}`);
      if (errorElement) {
        errorElement.textContent = message;
        errorElement.style.display = 'block';
      }
    }

    function clearFormErrors() {
      const errorElements = document.querySelectorAll('.error-message');
      errorElements.forEach(el => {
        el.textContent = '';
        el.style.display = 'none';
      });
    }

    function displayFormErrors(errors) {
      Object.keys(errors).forEach(field => {
        showFieldError(field, errors[field]);
      });
    }

    function getStatusClass(status) {
      switch (status) {
        case 'valide':
        case 'approuve':
          return 'badge-success';
        case 'rejete':
          return 'badge-danger';
        case 'en_attente':
          return 'badge-warning';
        default:
          return 'badge-secondary';
      }
    }

    function getStatusText(status) {
      switch (status) {
        case 'valide':
        case 'approuve':
          return 'Validé';
        case 'rejete':
          return 'Rejeté';
        case 'en_attente':
          return 'En attente';
        default:
          return status;
      }
    }

    function formatDate(dateString) {
      if (!dateString) return '-';
      const date = new Date(dateString);
      return date.toLocaleDateString('fr-FR') + ' ' + date.toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit'});
    }

    function showAlert(message, type = 'info') {
      const alertDiv = document.getElementById('eventsAlert');
      alertDiv.className = `alert alert-${type === 'error' ? 'danger' : type}`;
      alertDiv.textContent = message;
      alertDiv.style.display = 'block';

      setTimeout(() => {
        alertDiv.style.display = 'none';
      }, 5000);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text || '';
      return div.innerHTML;
    }

    function getAuthToken() {
      return localStorage.getItem('authToken') || '';
    }

    // ===== INITIALISATION - Exécutée après toutes les définitions =====
    if (document.readyState !== 'loading') {
      setupEventListeners();
    } else {
      document.addEventListener('DOMContentLoaded', setupEventListeners);
    }
  </script>

