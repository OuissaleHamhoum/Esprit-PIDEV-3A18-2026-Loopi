  function validateEventForm(data) {
    clearFormErrors();
    let isValid = true;

    if (!data.titre || data.titre.trim().length < 3) {
      showFieldError('titre', 'Le titre doit contenir au moins 3 caractères');
      isValid = false;
    }

    if (!data.description || data.description.trim().length < 10) {
      showFieldError('description', 'La description doit contenir au moins 10 caractères');
      isValid = false;
    }

    if (!data.date_evenement) {
      showFieldError('date_evenement', 'La date est requise');
      isValid = false;
    }

    if (!data.lieu || data.lieu.trim().length === 0) {
      showFieldError('lieu', 'Le lieu est requis');
      isValid = false;
    }

    if (!data.id_organisateur) {
      showFieldError('id_organisateur', 'L\'organisateur est requis');
      isValid = false;
    }

    const capacite = parseInt(data.capacite_max);
    if (!capacite || capacite <= 0) {
      showFieldError('capacite_max', 'La capacité doit être supérieure à 0');
      isValid = false;
    } else if (capacite > 1000) {
      showFieldError('capacite_max', 'La capacité ne peut pas dépasser 1000');
      isValid = false;
    }

    return isValid;
  }

  async function saveEvent() {
    const btnSave = document.getElementById('btnSaveEvent');
    if (btnSave && btnSave.disabled) return;

    const form = document.getElementById('eventForm');
    const formData = new FormData(form);
    const imageFile = formData.get('image_evenement');
    
    const isUpdate = currentEventId !== null && currentEventId !== '';
    
    if ((!imageFile || imageFile.size === 0) && generatedImageData) {
      let base64String = generatedImageData;
      if (base64String.includes(',')) {
        base64String = base64String.split(',')[1];
      }
      const byteCharacters = atob(base64String);
      const byteNumbers = new Array(byteCharacters.length);
      for (let i = 0; i < byteCharacters.length; i++) {
        byteNumbers[i] = byteCharacters.charCodeAt(i);
      }
      const byteArray = new Uint8Array(byteNumbers);
      const mimeType = generatedImageData.startsWith('data:image/svg+xml') ? 'image/svg+xml' : 'image/png';
      const fileName = mimeType === 'image/svg+xml' ? 'generated-event-image.svg' : 'generated-event-image.png';
      formData.set('image_evenement', new Blob([byteArray], { type: mimeType }), fileName);
    }
    
    if (currentLatitude && currentLongitude) {
      formData.set('latitude', currentLatitude);
      formData.set('longitude', currentLongitude);
    }

    const data = {};
    for (let [key, value] of formData.entries()) {
      data[key] = value;
    }
    
    if (!validateEventForm(data)) {
      return;
    }

    const url = isUpdate ? `/api/admin/events/${currentEventId}` : '/api/admin/events';
    const method = 'POST';

    const originalHtml = btnSave ? btnSave.innerHTML : '';
    if (btnSave) {
      btnSave.disabled = true;
      btnSave.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enregistrement...';
    }

    try {
      const response = await fetch(url, {
        method: method,
        credentials: 'include',
        headers: {
          'Accept': 'application/json'
        },
        body: formData
      });

      const result = await parseJsonResponse(response);

      if (result.success) {
        showAlert(result.message, 'success');
        closeEventModal();
        await loadEvents();
      } else if (result.errors) {
        displayFormErrors(result.errors);
      } else {
        showAlert(result.message || 'Erreur lors de la sauvegarde', 'error');
      }
    } catch (error) {
      console.error('Erreur saveEvent:', error);
      showAlert('Erreur de connexion: ' + error.message, 'error');
    } finally {
      if (btnSave) {
        btnSave.disabled = false;
        btnSave.innerHTML = originalHtml;
      }
    }
  }

