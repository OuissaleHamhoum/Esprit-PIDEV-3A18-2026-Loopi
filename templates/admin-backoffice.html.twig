<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — Administration</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F7F5F0;--cream:#FDFCF9;--card:#FFFFFF;--forest:#1E3A2F;--moss:#3D6B4F;--sage:#7A9E7E;--sand:#C9A96E;--rust:#B05A2F;--danger:#DC3545;--warn:#F59E0B;--success:#10B981;--info:#3B82F6;--muted:#6B7468;--border:rgba(30,58,47,0.09);--dark:#111510;--text:#1A2218}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;font-size:14px}

/* SIDEBAR - dark premium */
.sidebar{width:256px;background:var(--dark);min-height:100vh;display:flex;flex-direction:column;position:fixed;left:0;top:0;bottom:0;z-index:100}
.s-logo{padding:24px 22px 18px;border-bottom:1px solid rgba(255,255,255,.06)}
.logo-wrap{display:flex;align-items:center;gap:10px}
.logo-icon{width:32px;height:32px;background:linear-gradient(135deg,var(--moss),var(--sage));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.logo-name{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:white}
.admin-pill{background:rgba(176,90,47,.25);color:#e8926a;border-radius:50px;padding:2px 8px;font-size:.58rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-left:auto}
.s-user{padding:14px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px}
.s-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--rust),#d4783c);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:.9rem;font-weight:700;color:white;flex-shrink:0}
.s-uname{font-size:.8rem;font-weight:600;color:white}
.s-urole{font-size:.62rem;color:rgba(255,255,255,.35)}
nav.snav{padding:12px 10px;flex:1;overflow-y:auto}
.s-sec{font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.2);padding:14px 12px 5px}
.ni{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;transition:all .18s;margin-bottom:1px;text-decoration:none;color:rgba(255,255,255,.45);font-size:.8rem;font-weight:500}
.ni:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.85)}
.ni.active{background:linear-gradient(135deg,rgba(176,90,47,.2),rgba(176,90,47,.1));color:#e8926a}
.ni .ic{width:16px;text-align:center;font-size:.85rem;flex-shrink:0}
.ni .nb{margin-left:auto;background:var(--danger);color:white;border-radius:50px;padding:1px 6px;font-size:.58rem;font-weight:700;min-width:18px;text-align:center}
.s-bot{padding:12px 10px;border-top:1px solid rgba(255,255,255,.06)}

/* MAIN */
.main{margin-left:256px;flex:1;min-height:100vh;background:var(--bg)}
.header{background:white;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.h-left{display:flex;align-items:center;gap:12px}
.breadcrumb{font-size:.75rem;color:var(--muted)}
.breadcrumb span{color:var(--forest);font-weight:600}
.h-right{display:flex;align-items:center;gap:10px}
.h-notif{width:34px;height:34px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.9rem;position:relative}
.h-notif .dot{width:7px;height:7px;background:var(--danger);border-radius:50%;position:absolute;top:6px;right:6px;border:2px solid white}
.content{padding:24px 28px}

/* BUTTONS */
.btn{padding:7px 16px;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .18s;border:none;font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;gap:5px}
.btn-primary{background:var(--forest);color:white}
.btn-primary:hover{background:var(--moss)}
.btn-danger{background:rgba(220,53,69,.1);color:var(--danger);border:1px solid rgba(220,53,69,.2)}
.btn-danger:hover{background:rgba(220,53,69,.2)}
.btn-warn{background:rgba(245,158,11,.1);color:var(--warn);border:1px solid rgba(245,158,11,.2)}
.btn-warn:hover{background:rgba(245,158,11,.2)}
.btn-success{background:rgba(16,185,129,.1);color:var(--success);border:1px solid rgba(16,185,129,.2)}
.btn-success:hover{background:rgba(16,185,129,.2)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--bg);color:var(--forest)}
.btn-sm{padding:4px 10px;font-size:.7rem;border-radius:6px}

/* STAT CARDS */
.cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}
.sc{background:white;border-radius:14px;padding:18px;border:1px solid var(--border);position:relative;overflow:hidden;transition:box-shadow .2s}
.sc:hover{box-shadow:0 6px 24px rgba(30,58,47,.07)}
.sc-accent{position:absolute;top:0;left:0;width:4px;height:100%;border-radius:14px 0 0 14px}
.sc-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.sc-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.sc-delta{font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:50px}
.sc-val{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:var(--forest);line-height:1;margin-bottom:3px}
.sc-lbl{font-size:.7rem;color:var(--muted)}

/* LAYOUT */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:18px}
.g23{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-bottom:18px}
.g32{display:grid;grid-template-columns:3fr 2fr;gap:18px;margin-bottom:18px}

/* CARD BLOCK */
.blk{background:white;border-radius:14px;padding:20px;border:1px solid var(--border)}
.blk-title{font-size:.9rem;font-weight:700;color:var(--forest);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.blk-title .sub{font-family:'DM Sans',sans-serif;font-size:.7rem;font-weight:500;color:var(--muted)}

/* CHARTS (CSS bar) */
.chart-bars{display:flex;align-items:flex-end;gap:6px;height:90px}
.b-col{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
.b{width:100%;border-radius:4px 4px 0 0;min-height:3px}
.b-l{font-size:.58rem;color:var(--muted)}
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut{width:90px;height:90px;border-radius:50%;background:conic-gradient(var(--forest) 0% 45%,var(--moss) 45% 72%,var(--sage) 72% 90%,var(--sand) 90% 100%);display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0}
.donut::after{content:'';position:absolute;width:55px;height:55px;background:white;border-radius:50%}
.donut-labels{display:flex;flex-direction:column;gap:6px}
.dl{display:flex;align-items:center;gap:6px;font-size:.72rem;color:var(--muted)}
.dl-dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}

/* TABLE */
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;padding:7px 10px;font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);background:var(--bg)}
.tbl td{padding:10px;border-bottom:1px solid rgba(30,58,47,.04);font-size:.79rem;vertical-align:middle;color:var(--text)}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(30,58,47,.02)}
.user-cell{display:flex;align-items:center;gap:9px}
.uc-av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;color:white;flex-shrink:0}
.uc-name{font-weight:600;color:var(--forest);font-size:.8rem}
.uc-email{font-size:.66rem;color:var(--muted)}

/* BADGES */
.badge{padding:3px 8px;border-radius:50px;font-size:.62rem;font-weight:700;white-space:nowrap}
.b-admin{background:rgba(176,90,47,.1);color:var(--rust)}
.b-org{background:rgba(61,107,79,.1);color:var(--moss)}
.b-part{background:rgba(30,58,47,.07);color:var(--forest)}
.b-active{background:rgba(16,185,129,.1);color:var(--success)}
.b-pending{background:rgba(245,158,11,.1);color:var(--warn)}
.b-danger{background:rgba(220,53,69,.08);color:var(--danger)}

/* SEARCH BAR */
.search-bar{display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
.search-input{padding:8px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.8rem;outline:none;background:white;transition:border-color .2s;min-width:220px}
.search-input:focus{border-color:var(--moss)}
select.filter{padding:7px 10px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.78rem;color:var(--muted);outline:none;background:white;cursor:pointer}

/* ACTIVITY FEED */
.act-item{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
.act-item:last-child{border-bottom:none}
.act-icon{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0}
.act-body{flex:1}
.act-text{font-size:.79rem;color:var(--text);line-height:1.4}
.act-time{font-size:.66rem;color:var(--muted);margin-top:1px}

/* MODAL */
.moverlay{display:none;position:fixed;inset:0;background:rgba(17,21,16,.55);backdrop-filter:blur(5px);z-index:2000;align-items:center;justify-content:center}
.moverlay.open{display:flex}
.modal{background:white;border-radius:18px;width:500px;max-width:94vw;padding:26px;border:1px solid var(--border);animation:sUp .25s ease}
@keyframes sUp{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-hd{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;color:var(--forest);margin-bottom:18px;display:flex;justify-content:space-between;align-items:center}
.modal-close{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer}
.fg{margin-bottom:12px}
.fg label{display:block;font-size:.73rem;font-weight:600;color:var(--forest);margin-bottom:4px}
.fg input,.fg select,.fg textarea{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:var(--text);outline:none;transition:border-color .2s;background:var(--bg)}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--moss);background:white}
.fg textarea{resize:vertical;min-height:70px}
.frow2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* ALERT */
.alert{padding:12px 16px;border-radius:10px;font-size:.8rem;font-weight:500;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.alert-info{background:rgba(59,130,246,.08);color:#1d4ed8;border:1px solid rgba(59,130,246,.15)}
.alert-warn{background:rgba(245,158,11,.08);color:#92400e;border:1px solid rgba(245,158,11,.15)}

/* TOAST */
.toast{position:fixed;bottom:20px;right:20px;background:var(--forest);color:white;padding:11px 18px;border-radius:11px;font-size:.8rem;font-weight:600;z-index:9999;transform:translateY(60px);opacity:0;transition:all .28s}
.toast.show{transform:translateY(0);opacity:1}

@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.content>*{animation:fadeUp .35s ease both}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="s-logo">
    <div class="logo-wrap">
      <div class="logo-icon">🌿</div>
      <div class="logo-name">Loopi</div>
      <div class="admin-pill">Admin</div>
    </div>
  </div>
  <div class="s-user">
    <div class="s-av">{{ app.user.nom|default('A')[:1]|upper }}</div>
    <div><div class="s-uname">{{ app.user.nom|default('Admin System') }}</div><div class="s-urole">{{ app.user.email|default('admin@loopi.tn') }}</div></div>
  </div>
  <nav class="snav">
    <div class="s-sec">Tableau de bord</div>
    <a href="#" class="ni active" onclick="goPage('dashboard',this)"><span class="ic">📊</span> Vue d'ensemble</a>
    <a href="#" class="ni" onclick="goPage('analytics',this)"><span class="ic">📈</span> Analytique</a>
    <div class="s-sec">Gestion</div>
    <a href="#" class="ni" onclick="goPage('users',this)"><span class="ic">👥</span> Utilisateurs<span class="nb">11</span></a>
    <a href="#" class="ni" onclick="goPage('events',this)"><span class="ic">📅</span> Événements<span class="nb">2</span></a>
    <a href="#" class="ni" onclick="goPage('products',this)"><span class="ic">🎨</span> Produits</a>
    <a href="#" class="ni" onclick="goPage('collections',this)"><span class="ic">♻️</span> Collections</a>
    <div class="s-sec">Communauté</div>
    <a href="#" class="ni" onclick="goPage('donations',this)"><span class="ic">🤝</span> Donations</a>
    <a href="#" class="ni" onclick="goPage('coupons',this)"><span class="ic">🎟️</span> Coupons</a>
    <a href="#" class="ni" onclick="goPage('feedbacks',this)"><span class="ic">⭐</span> Avis & Feedbacks</a>
    <div class="s-sec">Système</div>
    <a href="#" class="ni" onclick="goPage('settings',this)"><span class="ic">⚙️</span> Paramètres</a>
    <a href="#" class="ni" onclick="goPage('notifs',this)"><span class="ic">🔔</span> Notifications</a>
  </nav>
  <div class="s-bot">
    <a href="/logout" class="ni"><span class="ic">🚪</span> Déconnexion</a>
  </div>
</aside>

<main class="main">
  <div class="header">
    <div class="h-left">
      <div class="breadcrumb">Loopi Admin / <span id="breadcrumb-text">Vue d'ensemble</span></div>
    </div>
    <div class="h-right">
      <div class="h-notif" onclick="showToast('3 nouvelles notifications')">🔔<span class="dot"></span></div>
      <button class="btn btn-primary btn-sm" onclick="openModal('userModal')">+ Ajouter utilisateur</button>
    </div>
  </div>

  <div class="content" id="content">

  <!-- ─── PAGE: DASHBOARD ─── -->
  <div id="page-dashboard">
    <div class="cards-grid">
      <div class="sc">
        <div class="sc-accent" style="background:var(--forest)"></div>
        <div class="sc-head">
          <div class="sc-icon" style="background:rgba(30,58,47,.07)">👥</div>
          <span class="sc-delta" style="background:rgba(16,185,129,.1);color:var(--success)">+22%</span>
        </div>
        <div class="sc-val">11</div>
        <div class="sc-lbl">Utilisateurs enregistrés</div>
      </div>
      <div class="sc">
        <div class="sc-accent" style="background:var(--moss)"></div>
        <div class="sc-head">
          <div class="sc-icon" style="background:rgba(61,107,79,.08)">📅</div>
          <span class="sc-delta" style="background:rgba(16,185,129,.1);color:var(--success)">Actifs</span>
        </div>
        <div class="sc-val">2</div>
        <div class="sc-lbl">Événements créés</div>
      </div>
      <div class="sc">
        <div class="sc-accent" style="background:var(--sand)"></div>
        <div class="sc-head">
          <div class="sc-icon" style="background:rgba(201,169,110,.1)">🎨</div>
          <span class="sc-delta" style="background:rgba(16,185,129,.1);color:var(--success)">+3 récents</span>
        </div>
        <div class="sc-val">11</div>
        <div class="sc-lbl">Produits en galerie</div>
      </div>
      <div class="sc">
        <div class="sc-accent" style="background:var(--rust)"></div>
        <div class="sc-head">
          <div class="sc-icon" style="background:rgba(176,90,47,.09)">♻️</div>
          <span class="sc-delta" style="background:rgba(245,158,11,.1);color:var(--warn)">2 actives</span>
        </div>
        <div class="sc-val">32.8</div>
        <div class="sc-lbl">kg collectés (total)</div>
      </div>
    </div>

    <div class="g23">
      <div>
        <div class="g2" style="margin-bottom:0">
          <div class="blk">
            <div class="blk-title">Inscriptions par rôle <span class="sub">Tous les utilisateurs</span></div>
            <div class="donut-wrap">
              <div class="donut"></div>
              <div class="donut-labels">
                <div class="dl"><div class="dl-dot" style="background:var(--forest)"></div> Admin (1 · 9%)</div>
                <div class="dl"><div class="dl-dot" style="background:var(--moss)"></div> Organisateurs (3 · 27%)</div>
                <div class="dl"><div class="dl-dot" style="background:var(--sage)"></div> Participants (7 · 64%)</div>
              </div>
            </div>
          </div>
          <div class="blk">
            <div class="blk-title">Activité hebdomadaire <span class="sub">7 derniers jours</span></div>
            <div class="chart-bars">
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--moss),var(--sage));height:35%"></div><div class="b-l">L</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--moss),var(--sage));height:60%"></div><div class="b-l">M</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--moss),var(--sage));height:48%"></div><div class="b-l">M</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--moss),var(--sage));height:82%"></div><div class="b-l">J</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--sand),#e8c48a);height:70%"></div><div class="b-l">V</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--sand),#e8c48a);height:95%"></div><div class="b-l">S</div></div>
              <div class="b-col"><div class="b" style="background:linear-gradient(to top,var(--moss),var(--sage));height:42%"></div><div class="b-l">D</div></div>
            </div>
          </div>
        </div>
        <div class="blk" style="margin-top:18px">
          <div class="blk-title">Utilisateurs récents <span class="sub" style="cursor:pointer;color:var(--moss)" onclick="goPage('users',null)">Gérer tous →</span></div>
          <table class="tbl">
            <thead><tr><th>Utilisateur</th><th>Rôle</th><th>Inscription</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
              <tr><td><div class="user-cell"><div class="uc-av" style="background:linear-gradient(135deg,#B05A2F,#d4783c)">A</div><div><div class="uc-name">Admin System</div><div class="uc-email">admin@loopi.tn</div></div></div></td><td><span class="badge b-admin">Admin</span></td><td style="color:var(--muted)">8 Fév 2026</td><td><span class="badge b-active">Actif</span></td><td><div style="display:flex;gap:5px"><button class="btn btn-ghost btn-sm" onclick="showToast('Modifier Admin')">Éditer</button></div></td></tr>
              <tr><td><div class="user-cell"><div class="uc-av" style="background:linear-gradient(135deg,var(--moss),var(--forest))">E</div><div><div class="uc-name">Eco Organisateur</div><div class="uc-email">organisateur@loopi.tn</div></div></div></td><td><span class="badge b-org">Organisateur</span></td><td style="color:var(--muted)">8 Fév 2026</td><td><span class="badge b-active">Actif</span></td><td><div style="display:flex;gap:5px"><button class="btn btn-ghost btn-sm" onclick="showToast('Modifier Eco')">Éditer</button><button class="btn btn-danger btn-sm" onclick="showToast('Suspendre: Eco?')">Susp.</button></div></td></tr>
              <tr><td><div class="user-cell"><div class="uc-av" style="background:linear-gradient(135deg,#5a8a7a,#3d6b5a)">T</div><div><div class="uc-name">Test Participant</div><div class="uc-email">participant@loopi.tn</div></div></div></td><td><span class="badge b-part">Participant</span></td><td style="color:var(--muted)">8 Fév 2026</td><td><span class="badge b-active">Actif</span></td><td><div style="display:flex;gap:5px"><button class="btn btn-ghost btn-sm" onclick="showToast('Modifier Test')">Éditer</button><button class="btn btn-danger btn-sm" onclick="showToast('Supprimer?')">Suppr.</button></div></td></tr>
              <tr><td><div class="user-cell"><div class="uc-av" style="background:linear-gradient(135deg,#8a7a5a,#6b5a3d)">B</div><div><div class="uc-name">Ali Ben</div><div class="uc-email">ben.ali@email.com</div></div></div></td><td><span class="badge b-part">Participant</span></td><td style="color:var(--muted)">8 Fév 2026</td><td><span class="badge b-active">Actif</span></td><td><div style="display:flex;gap:5px"><button class="btn btn-ghost btn-sm" onclick="showToast('Modifier Ben')">Éditer</button><button class="btn btn-danger btn-sm" onclick="showToast('Supprimer?')">Suppr.</button></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:18px">
        <div class="blk">
          <div class="blk-title">Activité en direct</div>
