<style>
/* ANIMATIONS */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes buttonPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(107, 138, 112, 0.3); } 50% { box-shadow: 0 0 0 8px rgba(107, 138, 112, 0); } }

/* MODAL VISIBILITY */
#userModal.open { display: flex !important; }

/* FORM STYLES - LOGIN MATCHING */
.form-label {
  font-weight: 600;
  font-size: 0.8rem;
  color: var(--forest);
  transition: color 0.2s ease;
}

.form-control, .form-select {
  width: 100%;
  padding: 12px 14px;
  border: 1.5px solid rgba(30,58,47,0.15);
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.88rem;
  color: var(--dark);
  transition: border-color 0.2s;
  outline: none;
  background: var(--light);
}

.form-control:hover, .form-select:hover {
  border-color: rgba(30,58,47,0.25);
}

.form-control:focus, .form-select:focus {
  border-color: var(--moss);
  background: white;
  box-shadow: 0 0 0 2px rgba(107,138,112,0.1);
}

.form-control:disabled, .form-select:disabled {
  background: rgba(0, 0, 0, 0.05);
  cursor: not-allowed;
  opacity: 0.7;
}

/* BUTTONS */
.btn-submit {
  width: 100%;
  padding: 13px;
  background: var(--forest);
  color: white;
  border: none;
  border-radius: 10px;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.92rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.02em;
}

.btn-submit:hover:not(:disabled) {
  background: var(--moss);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(30,58,47,0.2);
}

.btn-submit:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

button:focus-visible {
  outline: 2px solid var(--moss);
  outline-offset: 2px;
}

/* MODAL HEADER */
.auth-card-header {
  text-align: center;
}

.auth-card-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 900;
  color: var(--forest);
  margin: 0 0 8px 0;
  letter-spacing: -0.5px;
}

/* ERROR MESSAGES */
#userFormErrors {
  border-left: 4px solid #dc3545;
  padding: 12px 14px;
  border-radius: 10px;
  background: #fff5f5;
  color: #721c24;
  font-size: 0.85rem;
  line-height: 1.5;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .auth-modal { width: 95vw !important; }
  .form-group { margin-bottom: 12px; }
  button { font-size: 0.88rem; }
}

@media (max-width: 480px) {
  .auth-modal { width: 98vw !important; }
  .form-control, .form-select, .btn-submit { font-size: 16px; }
  .btn-submit { min-height: 44px; padding: 12px 14px; }
}

/* PRINT */
@media print {
  .modal-overlay, button, .auth-modal { display: none !important; }
}

/* DARK MODE */
@media (prefers-color-scheme: dark) {
  .form-control, .form-select { 
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
    color: white;
  }
  .form-control:focus, .form-select:focus {
    border-color: var(--moss);
    background-color: rgba(255, 255, 255, 0.08);
  }
}
</style>

