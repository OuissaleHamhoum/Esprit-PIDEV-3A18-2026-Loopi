<script>
const breadcrumbs = {
  dashboard:'Vue d\'ensemble', analytics:'Analytique', users:'Utilisateurs', events:'Événements',
  products:'Produits', collections:'Collections', donations:'Donations', coupons:'Coupons',
  feedbacks:'Avis & Feedbacks', settings:'Paramètres', notifs:'Notifications'
};
let adminUsers = [];
let adminEvents = [];
let userModalMode = 'create';

async function checkAuthentication() {
  try {
    const response = await fetch('/api/health', {
      credentials: 'include',
      headers: { 'Accept': 'application/json' }
    });
    const data = await response.json();
    return response.ok && data.success && data.user;
  } catch (error) {
    return false;
  }
}

async function parseJsonResponse(response) {
  const text = await response.text();
  try {
    const json = JSON.parse(text);
    if (typeof json === 'object' && json !== null) {
      return json;
    }
  } catch (error) {
    console.error('Invalid JSON response:', text);
  }
  return {
    success: false,
    message: response.status === 401
      ? 'Accès non autorisé. Veuillez vous reconnecter.'
      : response.status === 403
        ? 'Accès refusé.'
        : 'Réponse serveur invalide.',
    status: response.status,
    body: text,
  };
}

function goPage(name, navEl) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + name).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  document.getElementById('breadcrumb-text').textContent = breadcrumbs[name] || name;

  // Load data based on page
  switch (name) {
    case 'users':
      refreshUserTable();
      break;
    case 'events':
      checkAuthentication().then(isAuthenticated => {
        if (isAuthenticated) {
          if (typeof loadEvents === 'function') {
            loadEvents();
          }
          if (typeof loadOrganisateurs === 'function') {
            loadOrganisateurs();
          }
        } else {
          showToast('Accès refusé. Veuillez vous connecter en tant qu\'administrateur.');
          setTimeout(() => window.location.href = '/login', 3000);
        }
      });
      break;
    case 'products':
      refreshProductTable();
      break;
    case 'collections':
      refreshCollections();
      break;
    case 'donations':
      refreshDonationsTable();
      break;
    case 'coupons':
      refreshCouponsTable();
      break;
    case 'feedbacks':
      refreshFeedbacksTable();
      break;
  }
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
function closeUserModal() {
  resetUserForm();
  closeModal('userModal');
}

function openUserModal(mode, id = null) {
  userModalMode = mode;
  const title = document.getElementById('userModalTitle');
  const description = document.getElementById('userModalDescription');
  const submitButton = document.getElementById('userModalSubmit');
  const submitButtonText = document.getElementById('submitButtonText');
  const formErrors = document.getElementById('userFormErrors');
  const photoSection = document.getElementById('photoSection');
  const passwordField = document.getElementById('passwordField');

  formErrors.style.display = 'none';
  formErrors.textContent = '';

  if (mode === 'create') {
    title.textContent = '✨ Ajouter un nouvel utilisateur';
    if (description) description.textContent = 'Créez un nouveau compte utilisateur en remplissant les champs ci-dessous.';
    submitButtonText.textContent = '✅ Créer';
    submitButton.disabled = false;
    submitButton.style.display = 'inline-block';
    if (passwordField) passwordField.style.display = 'block';
    if (photoSection) photoSection.style.display = 'block';
    fillUserForm({ nom: '', prenom: '', email: '', password: '', role: 'participant', genre: '' });
    setFormDisabled(false);
    document.getElementById('userPassword').required = true;
    document.getElementById('userPassword').focus();
  } else {
    const user = adminUsers.find(u => u.id === id);
    if (!user) {
      showToast('❌ Utilisateur introuvable.');
      return;
    }
    fillUserForm(user);

    if (mode === 'edit') {
      title.textContent = '✏️ Modifier: ' + (user.nom || 'Utilisateur');
      if (description) description.textContent = 'Mettez à jour les informations du compte. Tous les changements seront sauvegardés.';
      submitButtonText.textContent = '💾 Enregistrer';
      submitButton.disabled = false;
      submitButton.style.display = 'inline-block';
      if (passwordField) passwordField.style.display = 'none';
      if (photoSection) photoSection.style.display = 'block';
      setFormDisabled(false);
      document.getElementById('userPassword').required = false;
      document.getElementById('userNom').focus();
    } else if (mode === 'show') {
      title.textContent = '👁️ Détails: ' + (user.nom || 'Utilisateur');
      if (description) description.textContent = 'Mode lecture seule - aucune modification possible. Fermez pour retourner à la liste.';
      submitButton.style.display = 'none';
      if (passwordField) passwordField.style.display = 'none';
      if (photoSection) photoSection.style.display = 'none';
      setFormDisabled(true);
    }
  }

  openModal('userModal');
}

function setFormDisabled(disabled) {
  ['userNom', 'userPrenom', 'userEmail', 'userPassword', 'userRole', 'userGenre'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = disabled;
  });
}

function fillUserForm(user) {
  document.getElementById('userId').value = user.id || '';
  document.getElementById('userNom').value = user.nom || '';
  document.getElementById('userPrenom').value = user.prenom || '';
  document.getElementById('userEmail').value = user.email || '';
  document.getElementById('userPassword').value = '';
  document.getElementById('userRole').value = user.role || 'participant';
  document.getElementById('userGenre').value = user.genre || '';
  document.getElementById('userPhoto').value = '';
  
  // Display photo if exists
  const preview = document.getElementById('photoPreview');
  if (user.photoUrl && user.photoUrl !== '/uploads/users/default.jpg') {
    preview.innerHTML = `<img src="${user.photoUrl}?t=${Date.now()}" alt="Photo" style="width:100%;height:100%;object-fit:cover">`;
    preview.classList.remove('empty');
  } else {
    preview.innerHTML = '📸';
    preview.classList.add('empty');
  }
}

function resetUserForm() {
  document.getElementById('userFormErrors').style.display = 'none';
  document.getElementById('userFormErrors').textContent = '';
  userModalMode = 'create';
