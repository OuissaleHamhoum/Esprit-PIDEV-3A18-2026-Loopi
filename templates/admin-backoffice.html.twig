function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

function handleCsvImport(event) {
  const file = event.target.files[0];
  if (!file) {
    return;
  }
  importUsersCsv(file);
  event.target.value = '';
}

async function importUsersCsv(file) {
  const formData = new FormData();
  formData.append('csv', file);
  try {
    const response = await fetch('/api/admin/users/import', {
      method: 'POST',
      body: formData
    });
    const result = await response.json();
    if (result.success) {
      showToast(result.message || 'Import terminé.');
      refreshUserTable();
    } else {
      showToast(result.message || 'Erreur lors de l\'import CSV.');
    }
  } catch (error) {
    showToast('Erreur réseau lors de l\'import.');
  }
}

async function submitUserForm(event) {
  event.preventDefault();

  // Form validation
  const form = document.getElementById('userForm');
  if (!form.checkValidity()) {
    form.classList.add('was-validated');
    return;
  }
  form.classList.remove('was-validated');

  const errorsElement = document.getElementById('userFormErrors');
  const submitButton = document.getElementById('userModalSubmit');
  const submitButtonText = document.getElementById('submitButtonText');
  const submitLoadingSpinner = document.getElementById('submitLoadingSpinner');

  errorsElement.style.display = 'none';
  errorsElement.textContent = '';

  const userId = document.getElementById('userId').value;
  const nom = document.getElementById('userNom').value.trim();
  const prenom = document.getElementById('userPrenom').value.trim();
  const email = document.getElementById('userEmail').value.trim();
  const password = document.getElementById('userPassword').value;
  const role = document.getElementById('userRole').value;
  const genre = document.getElementById('userGenre').value;
  const photo = document.getElementById('userPhoto').value;

  if (userModalMode === 'show') {
    closeUserModal();
    return;
  }

  const payload = { nom, prenom, email, role, genre };
  if (password) {
    payload.password = password;
  }
  if (photo) {
    payload.photo = photo;
  }

  const method = userModalMode === 'edit' ? 'PUT' : 'POST';
  const url = userModalMode === 'edit' ? `/api/admin/user/${userId}` : '/api/admin/user';

  console.log('[User Form] Mode:', userModalMode, 'URL:', url, 'Payload:', payload);

  if (!nom || !prenom || !email || (userModalMode === 'create' && !password)) {
    errorsElement.style.display = 'block';
    errorsElement.textContent = 'Tous les champs obligatoires doivent être remplis. Le mot de passe est requis lors de la création.';
    errorsElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    document.getElementById('userNom').focus();
    return;
  }

  // État de soumission
  submitButton.disabled = true;
  submitButtonText.style.opacity = '0.6';
  submitLoadingSpinner.style.display = 'inline-block';
  submitButtonText.textContent = userModalMode === 'edit' ? '⏳ Enregistrement...' : '⏳ Création...';

  try {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    console.log('[User Form] Response status:', response.status, response.statusText);

    if (!response.ok) {
      if (response.status === 401) {
        errorsElement.style.display = 'block';
        errorsElement.textContent = '🔒 Vous n\'êtes pas autorisé. Veuillez vous reconnecter.';
        submitButton.disabled = false;
        submitButtonText.style.opacity = '1';
        submitLoadingSpinner.style.display = 'none';
        submitButtonText.textContent = userModalMode === 'edit' ? '💾 Enregistrer' : '✅ Créer';
        return;
      } else if (response.status === 403) {
        errorsElement.style.display = 'block';
        errorsElement.textContent = '⛔ Vous n\'avez pas les permissions requises.';
        submitButton.disabled = false;
        submitButtonText.style.opacity = '1';
        submitLoadingSpinner.style.display = 'none';
        submitButtonText.textContent = userModalMode === 'edit' ? '💾 Enregistrer' : '✅ Créer';
        return;
      }
    }

    const result = await response.json();
    console.log('[User Form] API Response:', result);

    if (result.success) {
      submitButtonText.textContent = userModalMode === 'edit' ? '✅ Enregistré !' : '✅ Créé !';
      submitLoadingSpinner.style.display = 'none';
      showToast(userModalMode === 'edit' ? '✅ Utilisateur mis à jour avec succès.' : '✅ Utilisateur créé avec succès.');
      
      setTimeout(() => {
        closeUserModal();
        refreshUserTable();
      }, 400);
    } else {
      errorsElement.style.display = 'block';
      if (result.errors) {
        const errorMessages = Object.entries(result.errors)
          .map(([field, message]) => `<strong>${field}:</strong> ${message}`)
          .join('<br>');
        errorsElement.innerHTML = '❌ Erreur: <br>' + errorMessages;
      } else {
        errorsElement.textContent = '❌ ' + (result.message || 'Erreur lors du traitement du formulaire.');
      }
      errorsElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      
      // Réactivation du bouton
      submitButton.disabled = false;
      submitButtonText.style.opacity = '1';
      submitLoadingSpinner.style.display = 'none';
      submitButtonText.textContent = userModalMode === 'edit' ? '💾 Enregistrer' : '✅ Créer';
    }
  } catch (error) {
    errorsElement.style.display = 'block';
    errorsElement.textContent = '⚠️ Erreur réseau: ' + error.message;
    console.error('[User Form] Error:', error);
    
    // Réactivation du bouton
    submitButton.disabled = false;
    submitButtonText.style.opacity = '1';
    submitLoadingSpinner.style.display = 'none';
    submitButtonText.textContent = userModalMode === 'edit' ? '💾 Enregistrer' : '✅ Créer';
  }
}

async function refreshUserTable() {
  const search = document.getElementById('userSearch').value.trim();
  const role = document.getElementById('userRoleFilter').value;
  await fetchAdminUsers(search, role);
}

async function fetchAdminUsers(search = '', role = '') {
  const params = new URLSearchParams();
  if (search) params.set('q', search);
  if (role) params.set('role', role);

  const url = '/api/admin/users?' + params.toString();
  console.log('[Admin Users] Fetching:', url);

  try {
    const response = await fetch(url);
    console.log('[Admin Users] Response status:', response.status, response.statusText);

    if (!response.ok) {
      if (response.status === 401) {
        showToast('Session expirée. Veuillez vous reconnecter.');
        window.location.href = '/logout';
        return;
      } else if (response.status === 403) {
        showToast('Accès refusé. Vous devez être administrateur.');
        return;
      } else if (response.status === 404) {
        showToast('Endpoint API non trouvé. Veuillez vérifier la configuration.');
        console.error('API endpoint not found:', response.status);
        return;
      }
    }

    const result = await response.json();
    console.log('[Admin Users] API Response:', result);
    
    if (!result.success) {
      showToast('Impossible de charger les utilisateurs: ' + (result.message || 'Erreur inconnue'));
      console.error('Load users error:', result);
      return;
    }
    adminUsers = result.users || [];
    console.log('[Admin Users] Loaded:', adminUsers.length, 'users');
    renderUsersTable(adminUsers);
  } catch (error) {
    showToast('Erreur de connexion: ' + error.message);
    console.error('Fetch error:', error);
  }
}

function renderUsersTable(users) {
  const tbody = document.getElementById('usersTableBody');
  const emptyState = document.getElementById('usersEmptyState');
  const summary = document.getElementById('usersSummary');
  if (!tbody || !emptyState || !summary) return;

  if (!users.length) {
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
    summary.textContent = '0 comptes enregistrés';
    return;
  }

  emptyState.style.display = 'none';
  summary.textContent = `${users.length} comptes enregistrés`;
  tbody.innerHTML = users.map(user => {
    const displayName = user.displayName || [`${user.nom || ''}`, `${user.prenom || ''}`].filter(Boolean).join(' ').trim() || user.email || 'Utilisateur';
    const avatarHtml = user.photoUrl && user.photoUrl !== '/uploads/users/default.jpg' 
      ? `<div class="uc-av" style="background-image:url('${user.photoUrl}?t=${Date.now()}');background-size:cover;background-position:center"></div>`
      : `<div class="uc-av" style="background:linear-gradient(135deg, #6b8a70, #3d6b5a)">${user.nom ? user.nom.charAt(0).toUpperCase() : '?'}</div>`;
    
    return `
    <tr style="border-bottom:1px solid var(--border);transition:background 0.15s;cursor:default" onmouseover="this.style.background='rgba(61,107,79,0.05)'" onmouseout="this.style.background='transparent'">
      <td style="padding:14px"><div class="user-cell">${avatarHtml}<div><div class="uc-name">${displayName}</div><div class="uc-email">${user.email}</div></div></div></td>
      <td style="color:var(--muted);padding:14px;font-size:0.9rem">${user.email}</td>
      <td style="padding:14px"><span class="badge ${getRoleClass(user.role)}" style="font-size:0.75rem;padding:5px 10px">${getRoleLabel(user.role)}</span></td>
      <td style="color:var(--muted);padding:14px;font-size:0.9rem">${user.genre || '-'}</td>
      <td style="color:var(--muted);padding:14px;font-size:0.9rem">${formatDate(user.createdAt)}</td>
      <td style="color:var(--muted);padding:14px;font-size:0.9rem">${formatDate(user.updatedAt)}</td>
      <td style="padding:14px;vertical-align:middle">
        <div style="display:flex;gap:8px;flex-wrap:nowrap;align-items:center;white-space:nowrap">
          <button class="btn-action btn-action-view" onclick="openUserModal('show', ${user.id})" title="Voir les détails">Voir</button>
          <button class="btn-action btn-action-edit" onclick="openUserModal('edit', ${user.id})" title="Modifier">Éditer</button>
          <button class="btn-action btn-action-delete" onclick="deleteUser(${user.id})" title="Supprimer">Supp.</button>
        </div>
      </td>
    </tr>
  `}).join('');
}

function getRoleClass(role) {
  return role === 'admin' ? 'b-admin' : role === 'organisateur' ? 'b-org' : 'b-part';
}

function getRoleLabel(role) {
  if (role === 'admin') return 'Admin';
  if (role === 'organisateur') return 'Organisateur';
  return 'Participant';
}

async function deleteUser(id) {
  if (!confirm('Confirmer la suppression de cet utilisateur ?')) {
    return;
  }

  try {
    const response = await fetch(`/api/admin/user/${id}`, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      showToast('Utilisateur supprimé.');
      refreshUserTable();
    } else {
      showToast(result.message || 'Impossible de supprimer cet utilisateur.');
    }
  } catch (error) {
    showToast('Erreur réseau lors de la suppression.');
  }
}

function escapeCsv(value) {
  if (value == null) return '';
  const text = String(value).replace(/"/g, '""');
  return text.includes(',') || text.includes('"') || text.includes('\n') ? `"${text}"` : text;
}

function exportUsersCsv() {
  if (!adminUsers.length) {
    showToast('Aucun utilisateur à exporter');
    return;
  }

  const rows = [
    ['Nom', 'Prénom', 'Email', 'Rôle', 'Genre', 'Inscription', 'Dernière MAJ']
  ];

  adminUsers.forEach(user => {
    rows.push([
      user.nom,
      user.prenom,
      user.email,
      getRoleLabel(user.role),
      user.genre || '',
      formatDate(user.createdAt),
      formatDate(user.updatedAt)
    ]);
  });

  const csvContent = rows.map(row => row.map(escapeCsv).join(',')).join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `loopi-users-${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

