// ─── PRODUCTS MANAGEMENT ───

async function refreshProductTable() {
  const search = document.getElementById('productSearch').value.trim();
  const category = document.getElementById('productCategoryFilter').value;
  const organisateur = document.getElementById('productOrganisateurFilter').value;

  const params = new URLSearchParams();
  if (search) params.append('search', search);
  if (category) params.append('category', category);
  if (organisateur) params.append('organisateur', organisateur);

  try {
    const response = await fetch(`/api/admin/products?${params}`);
    const result = await response.json();

    if (result.success) {
      populateProductsTable(result.data);
      populateProductFilters(result.data);
      document.getElementById('productsSummary').textContent = `${result.data.length} œuvres en galerie`;
    } else {
      showToast('Erreur lors du chargement des produits');
    }
  } catch (error) {
    console.error('Error fetching products:', error);
    showToast('Erreur réseau');
  }
}

function populateProductsTable(products) {
  const tbody = document.getElementById('productsTableBody');
  const emptyState = document.getElementById('productsEmptyState');

  if (products.length === 0) {
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
    return;
  }

  emptyState.style.display = 'none';

  tbody.innerHTML = products.map(product => `
    <tr>
      <td style="font-weight:600">${product.nomProduit}</td>
      <td><span class="badge b-org">${product.category || 'N/A'}</span></td>
      <td style="color:var(--muted)">${product.organisateur || 'N/A'}</td>
      <td style="color:var(--muted)">${product.createdAt || 'N/A'}</td>
      <td style="color:var(--danger)">♥ ${product.favoris}</td>
      <td style="color:var(--sand)">★ ${product.noteMoyenne}</td>
      <td>
        <div style="display:flex;gap:5px">
          <button class="btn btn-ghost btn-sm" onclick="showToast('Voir détails')">Voir</button>
          <button class="btn btn-danger btn-sm" onclick="deleteProduct(${product.id})">Suppr.</button>
        </div>
      </td>
    </tr>
  `).join('');
}

function populateProductFilters(products) {
  const categoryFilter = document.getElementById('productCategoryFilter');
  const organisateurFilter = document.getElementById('productOrganisateurFilter');

  // Populate categories
  const categories = [...new Set(products.map(p => p.category).filter(Boolean))];
  categoryFilter.innerHTML = '<option value="">Toutes catégories</option>' +
    categories.map(cat => `<option value="${cat}">${cat}</option>`).join('');

  // Populate organisateurs
  const organisateurs = [...new Set(products.map(p => p.organisateur).filter(Boolean))];
  organisateurFilter.innerHTML = '<option value="">Tous organisateurs</option>' +
    organisateurs.map(org => `<option value="${org}">${org}</option>`).join('');
}

async function deleteProduct(id) {
