<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — Administration</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F7F5F0;--cream:#FDFCF9;--card:#FFFFFF;--forest:#1E3A2F;--moss:#3D6B4F;--sage:#7A9E7E;--sand:#C9A96E;--rust:#B05A2F;--danger:#DC3545;--warn:#F59E0B;--success:#10B981;--info:#3B82F6;--muted:#6B7468;--border:rgba(30,58,47,0.09);--dark:#111510;--text:#1A2218}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;font-size:14px}

/* SIDEBAR - dark premium */
.sidebar{width:256px;background:var(--dark);min-height:100vh;display:flex;flex-direction:column;position:fixed;left:0;top:0;bottom:0;z-index:100}
.s-logo{padding:24px 22px 18px;border-bottom:1px solid rgba(255,255,255,.06)}
.logo-wrap{display:flex;align-items:center;gap:10px}
.logo-icon{width:32px;height:32px;background:linear-gradient(135deg,var(--moss),var(--sage));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.logo-name{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:white}
.admin-pill{background:rgba(176,90,47,.25);color:#e8926a;border-radius:50px;padding:2px 8px;font-size:.58rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-left:auto}
.s-user{padding:14px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px}
.s-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--rust),#d4783c);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:.9rem;font-weight:700;color:white;flex-shrink:0}
.s-uname{font-size:.8rem;font-weight:600;color:white}
.s-urole{font-size:.62rem;color:rgba(255,255,255,.35)}
nav.snav{padding:12px 10px;flex:1;overflow-y:auto}
.s-sec{font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.2);padding:14px 12px 5px}
.ni{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;transition:all .18s;margin-bottom:1px;text-decoration:none;color:rgba(255,255,255,.45);font-size:.8rem;font-weight:500}
.ni:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.85)}
.ni.active{background:linear-gradient(135deg,rgba(176,90,47,.2),rgba(176,90,47,.1));color:#e8926a}
.ni .ic{width:16px;text-align:center;font-size:.85rem;flex-shrink:0}
.ni .nb{margin-left:auto;background:var(--danger);color:white;border-radius:50px;padding:1px 6px;font-size:.58rem;font-weight:700;min-width:18px;text-align:center}
.s-bot{padding:12px 10px;border-top:1px solid rgba(255,255,255,.06)}

/* MAIN */
.main{margin-left:256px;flex:1;min-height:100vh;background:var(--bg)}
.header{background:white;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.h-left{display:flex;align-items:center;gap:12px}
.breadcrumb{font-size:.75rem;color:var(--muted)}
.breadcrumb span{color:var(--forest);font-weight:600}
.h-right{display:flex;align-items:center;gap:10px}
.h-notif{width:34px;height:34px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.9rem;position:relative}
.h-notif .dot{width:7px;height:7px;background:var(--danger);border-radius:50%;position:absolute;top:6px;right:6px;border:2px solid white}
.content{padding:24px 28px}

/* BUTTONS */
.btn{padding:7px 16px;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .18s;border:none;font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;gap:5px}
.btn-primary{background:var(--forest);color:white}
.btn-primary:hover{background:var(--moss)}
.btn-danger{background:rgba(220,53,69,.1);color:var(--danger);border:1px solid rgba(220,53,69,.2)}
.btn-danger:hover{background:rgba(220,53,69,.2)}
.btn-warn{background:rgba(245,158,11,.1);color:var(--warn);border:1px solid rgba(245,158,11,.2)}
.btn-warn:hover{background:rgba(245,158,11,.2)}
.btn-success{background:rgba(16,185,129,.1);color:var(--success);border:1px solid rgba(16,185,129,.2)}
.btn-success:hover{background:rgba(16,185,129,.2)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--bg);color:var(--forest)}
.btn-sm{padding:4px 10px;font-size:.7rem;border-radius:6px}

/* STAT CARDS */
.cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}
.sc{background:white;border-radius:14px;padding:18px;border:1px solid var(--border);position:relative;overflow:hidden;transition:box-shadow .2s}
.sc:hover{box-shadow:0 6px 24px rgba(30,58,47,.07)}
.sc-accent{position:absolute;top:0;left:0;width:4px;height:100%;border-radius:14px 0 0 14px}
.sc-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.sc-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.sc-delta{font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:50px}
.sc-val{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:var(--forest);line-height:1;margin-bottom:3px}
.sc-lbl{font-size:.7rem;color:var(--muted)}

/* LAYOUT */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:18px}
.g23{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-bottom:18px}
.g32{display:grid;grid-template-columns:3fr 2fr;gap:18px;margin-bottom:18px}

/* CARD BLOCK */
.blk{background:white;border-radius:14px;padding:20px;border:1px solid var(--border)}
.blk-title{font-size:.9rem;font-weight:700;color:var(--forest);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.blk-title .sub{font-family:'DM Sans',sans-serif;font-size:.7rem;font-weight:500;color:var(--muted)}

/* CHARTS (CSS bar) */
.chart-bars{display:flex;align-items:flex-end;gap:6px;height:90px}
.b-col{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
.b{width:100%;border-radius:4px 4px 0 0;min-height:3px}
.b-l{font-size:.58rem;color:var(--muted)}
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut{width:90px;height:90px;border-radius:50%;background:conic-gradient(var(--forest) 0% 45%,var(--moss) 45% 72%,var(--sage) 72% 90%,var(--sand) 90% 100%);display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0}
.donut::after{content:'';position:absolute;width:55px;height:55px;background:white;border-radius:50%}
.donut-labels{display:flex;flex-direction:column;gap:6px}
.dl{display:flex;align-items:center;gap:6px;font-size:.72rem;color:var(--muted)}
.dl-dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}

/* TABLE */
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;padding:7px 10px;font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);background:var(--bg)}
.tbl td{padding:10px;border-bottom:1px solid rgba(30,58,47,.04);font-size:.79rem;vertical-align:middle;color:var(--text)}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(30,58,47,.02)}
.user-cell{display:flex;align-items:center;gap:9px}
.uc-av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;color:white;flex-shrink:0;overflow:hidden;background-size:cover;background-position:center}
.uc-name{font-weight:600;color:var(--forest);font-size:.8rem}
.uc-email{font-size:.66rem;color:var(--muted)}

/* BADGES */
.badge{padding:3px 8px;border-radius:50px;font-size:.62rem;font-weight:700;white-space:nowrap}
.b-admin{background:rgba(176,90,47,.1);color:var(--rust)}
.b-org{background:rgba(61,107,79,.1);color:var(--moss)}
.b-part{background:rgba(30,58,47,.07);color:var(--forest)}
.b-active{background:rgba(16,185,129,.1);color:var(--success)}
.b-pending{background:rgba(245,158,11,.1);color:var(--warn)}
.b-danger{background:rgba(220,53,69,.08);color:var(--danger)}

/* SEARCH BAR */
.search-bar{display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
.search-input{padding:8px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.8rem;outline:none;background:white;transition:border-color .2s;min-width:220px}
.search-input:focus{border-color:var(--moss)}
select.filter{padding:7px 10px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.78rem;color:var(--muted);outline:none;background:white;cursor:pointer}

/* ACTIVITY FEED */
.act-item{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
.act-item:last-child{border-bottom:none}
.act-icon{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0}
.act-body{flex:1}
.act-text{font-size:.79rem;color:var(--text);line-height:1.4}
.act-time{font-size:.66rem;color:var(--muted);margin-top:1px}

/* MODAL */
.moverlay{display:none;position:fixed;inset:0;background:rgba(17,21,16,.55);backdrop-filter:blur(5px);z-index:2000;align-items:center;justify-content:center}
.moverlay.open{display:flex}
.modal{background:white;border-radius:18px;width:500px;max-width:94vw;padding:26px;border:1px solid var(--border);animation:sUp .25s ease}
@keyframes sUp{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-hd{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;color:var(--forest);margin-bottom:18px;display:flex;justify-content:space-between;align-items:center}
.modal-close{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer}
.fg{margin-bottom:12px}
.fg label{display:block;font-size:.73rem;font-weight:600;color:var(--forest);margin-bottom:4px}
.fg input,.fg select,.fg textarea{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:var(--text);outline:none;transition:border-color .2s;background:var(--bg)}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--moss);background:white}
.fg textarea{resize:vertical;min-height:70px}
.frow2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* ALERT */
.alert{padding:12px 16px;border-radius:10px;font-size:.8rem;font-weight:500;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.alert-info{background:rgba(59,130,246,.08);color:#1d4ed8;border:1px solid rgba(59,130,246,.15)}
.alert-warn{background:rgba(245,158,11,.08);color:#92400e;border:1px solid rgba(245,158,11,.15)}

/* TOAST */
.toast{position:fixed;bottom:20px;right:20px;background:var(--forest);color:white;padding:11px 18px;border-radius:11px;font-size:.8rem;font-weight:600;z-index:9999;transform:translateY(60px);opacity:0;transition:all .28s}
.toast.show{transform:translateY(0);opacity:1}

@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.content>*{animation:fadeUp .35s ease both}

/* PHOTO SECTION */
.photo-section{margin-bottom:16px;padding:14px;background:var(--bg);border-radius:10px;border:1.5px solid var(--border)}
.photo-preview{width:140px;height:140px;border-radius:12px;margin:0 auto 12px;overflow:hidden;background:var(--cream);display:flex;align-items:center;justify-content:center;border:2px solid var(--border)}
.photo-preview img{width:100%;height:100%;object-fit:cover}
.photo-preview.empty{background:linear-gradient(135deg,var(--moss),var(--sage));color:white;font-size:3rem}
.photo-buttons{display:flex;gap:8px;justify-content:center}
.photo-buttons button{padding:6px 12px;font-size:.75rem;border-radius:7px;border:1.5px solid var(--border);background:white;color:var(--forest);cursor:pointer;transition:all .18s;font-weight:500}
.photo-buttons button:hover{background:var(--forest);color:white;border-color:var(--forest)}
#photoCanvas{display:none}
#cameraModal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);z-index:10000;align-items:center;justify-content:center;flex-direction:column}
#cameraModal.active{display:flex}
.camera-container{background:white;border-radius:14px;padding:14px;max-width:500px}
.camera-container video{width:100%;border-radius:10px;margin-bottom:12px;display:block}
.camera-buttons{display:flex;gap:8px;justify-content:center}
.camera-buttons button{padding:8px 16px;border-radius:8px;border:none;font-weight:600;cursor:pointer;font-size:.8rem}
.camera-buttons .capture{background:var(--forest);color:white}
.camera-buttons .capture:hover{background:var(--moss)}
.camera-buttons .cancel{background:var(--bg);color:var(--forest);border:1px solid var(--border)}
.camera-buttons .cancel:hover{background:var(--border)}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="s-logo">
    <div class="logo-wrap">
      <div class="logo-icon">🌿</div>
      <div class="logo-name">Loopi</div>
      <div class="admin-pill">Admin</div>
    </div>
  </div>
  <div class="s-user">
    <div class="s-av">{{ app.user.nom|default('A')[:1]|upper }}</div>
    <div><div class="s-uname">{{ app.user.nom|default('Admin System') }}</div><div class="s-urole">{{ app.user.email|default('admin@loopi.tn') }}</div></div>
  </div>
  <nav class="snav">
    {% include 'admin/sidebar.html.twig' %}
</aside>

<main class="main">
  <div class="header">
    <div class="h-left">
      <div class="breadcrumb">Loopi Admin / <span id="breadcrumb-text">Vue d'ensemble</span></div>
    </div>
    <div class="h-right">
      <div class="h-notif" onclick="showToast('3 nouvelles notifications')">🔔<span class="dot"></span></div>
      <button class="btn btn-primary btn-sm" onclick="openUserModal('create')">+ Ajouter utilisateur</button>
    </div>
  </div>

  <div class="content" id="content">
    {% include 'admin/dashboard.html.twig' %}
    {% include 'admin/users.html.twig' %}
    {% include 'admin/events.html.twig' %}
    {% include 'admin/products.html.twig' %}
    {% include 'admin/collections.html.twig' %}
    {% include 'admin/donations.html.twig' %}
    {% include 'admin/coupons.html.twig' %}
    {% include 'admin/feedbacks.html.twig' %}
    {% include 'admin/analytics.html.twig' %}
    {% include 'admin/settings.html.twig' %}
    {% include 'admin/notifs.html.twig' %}
  </div><!-- end content -->
</main>

<!-- MODAL AJOUTER UTILISATEUR -->
<div class="moverlay" id="userModal" onclick="if(event.target===this)closeUserModal()">
  <div class="modal">
    <div class="modal-hd" id="userModalTitle">Ajouter un utilisateur <button class="modal-close" onclick="closeUserModal()">✕</button></div>
    <div id="userFormErrors" style="color:#b91c1c;font-size:.82rem;margin-bottom:12px;display:none"></div>
    <input type="hidden" id="userId">
    <input type="hidden" id="userPhoto">
    
    <!-- Photo Section -->
    <div class="photo-section">
      <div class="photo-preview empty" id="photoPreview">📸</div>
      <div class="photo-buttons" id="photoButtons">
        <button type="button" onclick="startCamera()">📷 Caméra</button>
        <button type="button" onclick="document.getElementById('photoFile').click()">📤 Télécharger</button>
        <button type="button" onclick="clearPhoto()">✕ Effacer</button>
      </div>
      <input type="file" id="photoFile" accept="image/*" style="display:none" onchange="handlePhotoUpload(event)">
    </div>
    
    <div class="frow2">
      <div class="fg"><label>Nom</label><input id="userNom" placeholder="Dupont"></div>
      <div class="fg"><label>Prénom</label><input id="userPrenom" placeholder="Marie"></div>
    </div>
    <div class="fg"><label>Email</label><input type="email" id="userEmail" placeholder="marie@loopi.tn"></div>
    <div class="fg"><label>Mot de passe</label><input type="password" id="userPassword" placeholder="••••••••"></div>
    <div class="frow2">
      <div class="fg"><label>Rôle</label><select id="userRole"><option value="participant">Participant</option><option value="organisateur">Organisateur</option><option value="admin">Admin</option></select></div>
      <div class="fg"><label>Genre</label><select id="userGenre"><option value="">Aucun</option><option value="Masculin">Masculin</option><option value="Féminin">Féminin</option></select></div>
    </div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px">
      <button class="btn btn-ghost" type="button" onclick="closeUserModal()">Annuler</button>
      <button class="btn btn-primary" type="button" id="userModalSubmit" onclick="submitUserForm(event)">Créer le compte</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Camera Modal -->
<div id="cameraModal">
  <div class="camera-container">
    <video id="cameraVideo" playsinline></video>
    <canvas id="photoCanvas" style="display:none"></canvas>
    <div class="camera-buttons">
      <button type="button" class="capture" onclick="capturePhoto()">📸 Capturer</button>
      <button type="button" class="cancel" onclick="closeCamera()">Annuler</button>
    </div>
  </div>
</div>

<script>
const breadcrumbs = {
  dashboard:'Vue d\'ensemble', analytics:'Analytique', users:'Utilisateurs', events:'Événements',
  products:'Produits', collections:'Collections', donations:'Donations', coupons:'Coupons',
  feedbacks:'Avis & Feedbacks', settings:'Paramètres', notifs:'Notifications'
};
let adminUsers = [];
let userModalMode = 'create';

function goPage(name, navEl) {
  document.querySelectorAll('[id^=page-]').forEach(p => p.style.display = 'none');
  document.getElementById('page-' + name).style.display = 'block';
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  document.getElementById('breadcrumb-text').textContent = breadcrumbs[name] || name;
  if (name === 'users') {
    refreshUserTable();
  }
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
function closeUserModal() {
  resetUserForm();
  closeModal('userModal');
}

function openUserModal(mode, id = null) {
  userModalMode = mode;
  const title = document.getElementById('userModalTitle');
  const submitButton = document.getElementById('userModalSubmit');
  const formErrors = document.getElementById('userFormErrors');
  const photoButtons = document.getElementById('photoButtons');

  formErrors.style.display = 'none';
  formErrors.textContent = '';

  if (mode === 'create') {
    title.innerHTML = 'Ajouter un utilisateur <button class="modal-close" onclick="closeUserModal()">✕</button>';
    submitButton.textContent = 'Créer le compte';
    submitButton.style.display = 'inline-flex';
    photoButtons.style.display = 'flex';
    fillUserForm({ nom: '', prenom: '', email: '', password: '', role: 'participant', genre: '' });
    setFormDisabled(false);
  } else {
    const user = adminUsers.find(u => u.id === id);
    if (!user) {
      showToast('Utilisateur introuvable.');
      return;
    }
    fillUserForm(user);

    if (mode === 'edit') {
      title.innerHTML = 'Modifier un utilisateur <button class="modal-close" onclick="closeUserModal()">✕</button>';
      submitButton.textContent = 'Enregistrer';
      submitButton.style.display = 'inline-flex';
      photoButtons.style.display = 'flex';
      setFormDisabled(false);
      document.getElementById('userPassword').placeholder = 'Laisser vide pour conserver le mot de passe';
    } else {
      title.innerHTML = 'Détails utilisateur <button class="modal-close" onclick="closeUserModal()">✕</button>';
      submitButton.textContent = 'Fermer';
      submitButton.style.display = 'inline-flex';
      photoButtons.style.display = 'none';
      setFormDisabled(true);
    }
  }

  openModal('userModal');
}

function setFormDisabled(disabled) {
  ['userNom', 'userPrenom', 'userEmail', 'userPassword', 'userRole', 'userGenre'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = disabled;
  });
}

function fillUserForm(user) {
  document.getElementById('userId').value = user.id || '';
  document.getElementById('userNom').value = user.nom || '';
  document.getElementById('userPrenom').value = user.prenom || '';
  document.getElementById('userEmail').value = user.email || '';
  document.getElementById('userPassword').value = '';
  document.getElementById('userRole').value = user.role || 'participant';
  document.getElementById('userGenre').value = user.genre || '';
  document.getElementById('userPhoto').value = '';
  
  // Display photo if exists
  const preview = document.getElementById('photoPreview');
  if (user.photoUrl && user.photoUrl !== '/uploads/users/default.jpg') {
    preview.innerHTML = `<img src="${user.photoUrl}?t=${Date.now()}" alt="Photo" style="width:100%;height:100%;object-fit:cover">`;
    preview.classList.remove('empty');
  } else {
    preview.innerHTML = '📸';
    preview.classList.add('empty');
  }
}

function resetUserForm() {
  document.getElementById('userFormErrors').style.display = 'none';
  document.getElementById('userFormErrors').textContent = '';
  userModalMode = 'create';
  fillUserForm({ nom: '', prenom: '', email: '', password: '', role: 'participant', genre: '' });
  document.getElementById('userPassword').placeholder = '••••••••';
  document.getElementById('photoButtons').style.display = 'flex';
  setFormDisabled(false);
  clearPhoto();
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

function handleCsvImport(event) {
  const file = event.target.files[0];
  if (!file) {
    return;
  }
  importUsersCsv(file);
  event.target.value = '';
}

async function importUsersCsv(file) {
  const formData = new FormData();
  formData.append('csv', file);
  try {
    const response = await fetch('/api/admin/users/import', {
      method: 'POST',
      body: formData
    });
    const result = await response.json();
    if (result.success) {
      showToast(result.message || 'Import terminé.');
      refreshUserTable();
    } else {
      showToast(result.message || 'Erreur lors de l\'import CSV.');
    }
  } catch (error) {
    showToast('Erreur réseau lors de l\'import.');
  }
}

async function submitUserForm(event) {
  event.preventDefault();
  const errorsElement = document.getElementById('userFormErrors');
  errorsElement.style.display = 'none';
  errorsElement.textContent = '';

  const userId = document.getElementById('userId').value;
  const nom = document.getElementById('userNom').value.trim();
  const prenom = document.getElementById('userPrenom').value.trim();
  const email = document.getElementById('userEmail').value.trim();
  const password = document.getElementById('userPassword').value;
  const role = document.getElementById('userRole').value;
  const genre = document.getElementById('userGenre').value;
  const photo = document.getElementById('userPhoto').value;

  if (userModalMode === 'show') {
    closeUserModal();
    return;
  }

  const payload = { nom, prenom, email, role, genre };
  if (password) {
    payload.password = password;
  }
  if (photo) {
    payload.photo = photo;
  }

  const method = userModalMode === 'edit' ? 'PUT' : 'POST';
  const url = userModalMode === 'edit' ? `/api/admin/user/${userId}` : '/api/admin/user';

  console.log('[User Form] Mode:', userModalMode, 'URL:', url, 'Payload:', payload);

  if (!nom || !prenom || !email || (userModalMode === 'create' && !password)) {
    errorsElement.style.display = 'block';
    errorsElement.textContent = 'Tous les champs obligatoires doivent être remplis. Le mot de passe est requis lors de la création.';
    return;
  }

  try {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    console.log('[User Form] Response status:', response.status, response.statusText);

    if (!response.ok) {
      if (response.status === 401) {
        errorsElement.style.display = 'block';
        errorsElement.textContent = 'Vous n\'êtes pas autorisé. Veuillez vous reconnecter.';
        return;
      } else if (response.status === 403) {
        errorsElement.style.display = 'block';
        errorsElement.textContent = 'Vous n\'avez pas les permissions requises.';
        return;
      }
    }

    const result = await response.json();
    console.log('[User Form] API Response:', result);

    if (result.success) {
      showToast(userModalMode === 'edit' ? 'Utilisateur mis à jour.' : 'Utilisateur créé.');
      closeUserModal();
      refreshUserTable();
    } else {
      errorsElement.style.display = 'block';
      if (result.errors) {
        errorsElement.innerHTML = Object.values(result.errors).join('<br>');
      } else {
        errorsElement.textContent = result.message || 'Erreur lors du traitement du formulaire.';
      }
    }
  } catch (error) {
    errorsElement.style.display = 'block';
    errorsElement.textContent = 'Erreur réseau: ' + error.message;
    console.error('[User Form] Error:', error);
  }
}

async function refreshUserTable() {
  const search = document.getElementById('userSearch').value.trim();
  const role = document.getElementById('userRoleFilter').value;
  await fetchAdminUsers(search, role);
}

async function fetchAdminUsers(search = '', role = '') {
  const params = new URLSearchParams();
  if (search) params.set('q', search);
  if (role) params.set('role', role);

  const url = '/api/admin/users?' + params.toString();
  console.log('[Admin Users] Fetching:', url);

  try {
    const response = await fetch(url);
    console.log('[Admin Users] Response status:', response.status, response.statusText);

    if (!response.ok) {
      if (response.status === 401) {
        showToast('Session expirée. Veuillez vous reconnecter.');
        window.location.href = '/logout';
        return;
      } else if (response.status === 403) {
        showToast('Accès refusé. Vous devez être administrateur.');
        return;
      } else if (response.status === 404) {
        showToast('Endpoint API non trouvé. Veuillez vérifier la configuration.');
        console.error('API endpoint not found:', response.status);
        return;
      }
    }

    const result = await response.json();
    console.log('[Admin Users] API Response:', result);
    
    if (!result.success) {
      showToast('Impossible de charger les utilisateurs: ' + (result.message || 'Erreur inconnue'));
      console.error('Load users error:', result);
      return;
    }
    adminUsers = result.users || [];
    console.log('[Admin Users] Loaded:', adminUsers.length, 'users');
    renderUsersTable(adminUsers);
  } catch (error) {
    showToast('Erreur de connexion: ' + error.message);
    console.error('Fetch error:', error);
  }
}

function renderUsersTable(users) {
  const tbody = document.getElementById('usersTableBody');
  const emptyState = document.getElementById('usersEmptyState');
  const summary = document.getElementById('usersSummary');
  if (!tbody || !emptyState || !summary) return;

  if (!users.length) {
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
    summary.textContent = '0 comptes enregistrés';
    return;
  }

  emptyState.style.display = 'none';
  summary.textContent = `${users.length} comptes enregistrés`;
  tbody.innerHTML = users.map(user => {
    const avatarHtml = user.photoUrl && user.photoUrl !== '/uploads/users/default.jpg' 
      ? `<div class="uc-av" style="background-image:url('${user.photoUrl}?t=${Date.now()}');background-size:cover;background-position:center"></div>`
      : `<div class="uc-av" style="background:linear-gradient(135deg, #6b8a70, #3d6b5a)">${user.nom ? user.nom.charAt(0).toUpperCase() : '?'}</div>`;
    
    return `
    <tr>
      <td><div class="user-cell">${avatarHtml}<div><div class="uc-name">${user.displayName}</div><div class="uc-email">${user.email}</div></div></div></td>
      <td style="color:var(--muted)">${user.email}</td>
      <td><span class="badge ${getRoleClass(user.role)}">${getRoleLabel(user.role)}</span></td>
      <td style="color:var(--muted)">${user.genre || '-'}</td>
      <td style="color:var(--muted)">${formatDate(user.createdAt)}</td>
      <td style="color:var(--muted)">${formatDate(user.updatedAt)}</td>
      <td style="display:flex;gap:5px;flex-wrap:wrap">
        <button class="btn btn-ghost btn-sm" onclick="openUserModal('show', ${user.id})">Voir</button>
        <button class="btn btn-ghost btn-sm" onclick="openUserModal('edit', ${user.id})">Éditer</button>
        <button class="btn btn-danger btn-sm" onclick="deleteUser(${user.id})">Suppr.</button>
      </td>
    </tr>
  `}).join('');
}

function getRoleClass(role) {
  return role === 'admin' ? 'b-admin' : role === 'organisateur' ? 'b-org' : 'b-part';
}

function getRoleLabel(role) {
  if (role === 'admin') return 'Admin';
  if (role === 'organisateur') return 'Organisateur';
  return 'Participant';
}

async function deleteUser(id) {
  if (!confirm('Confirmer la suppression de cet utilisateur ?')) {
    return;
  }

  try {
    const response = await fetch(`/api/admin/user/${id}`, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      showToast('Utilisateur supprimé.');
      refreshUserTable();
    } else {
      showToast(result.message || 'Impossible de supprimer cet utilisateur.');
    }
  } catch (error) {
    showToast('Erreur réseau lors de la suppression.');
  }
}

function escapeCsv(value) {
  if (value == null) return '';
  const text = String(value).replace(/"/g, '""');
  return text.includes(',') || text.includes('"') || text.includes('\n') ? `"${text}"` : text;
}

function exportUsersCsv() {
  if (!adminUsers.length) {
    showToast('Aucun utilisateur à exporter');
    return;
  }

  const rows = [
    ['Nom', 'Prénom', 'Email', 'Rôle', 'Genre', 'Inscription', 'Dernière MAJ']
  ];

  adminUsers.forEach(user => {
    rows.push([
      user.nom,
      user.prenom,
      user.email,
      getRoleLabel(user.role),
      user.genre || '',
      formatDate(user.createdAt),
      formatDate(user.updatedAt)
    ]);
  });

  const csvContent = rows.map(row => row.map(escapeCsv).join(',')).join('\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `loopi-users-${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}

function formatDate(value) {
  if (!value) {
    return '-';
  }
  try {
    return new Date(value).toLocaleString('fr-FR', { dateStyle: 'medium', timeStyle: 'short' });
  } catch (e) {
    return value;
  }
}

window.addEventListener('DOMContentLoaded', () => {
  console.log('[Admin] DOM Content Loaded');
  const searchInput = document.getElementById('userSearch');
  const roleFilter = document.getElementById('userRoleFilter');
  const usersPage = document.getElementById('page-users');
  
  if (searchInput) {
    searchInput.addEventListener('input', refreshUserTable);
  }
  if (roleFilter) {
    roleFilter.addEventListener('change', refreshUserTable);
  }

  // Initialize users table on first page load if users page is currently visible
  if (usersPage && usersPage.style.display !== 'none') {
    console.log('[Admin] Users page visible, loading users...');
    refreshUserTable();
  }
});

document.addEventListener('keydown', e => {
  document.querySelectorAll('.moverlay.open').forEach(m => { if (e.key === 'Escape') m.classList.remove('open'); });
});

// PHOTO HANDLING FUNCTIONS
let cameraStream = null;

function startCamera() {
  const modal = document.getElementById('cameraModal');
  const video = document.getElementById('cameraVideo');
  
  modal.classList.add('active');
  
  navigator.mediaDevices.getUserMedia({ 
    video: { facingMode: 'user' },
    audio: false 
  }).then(stream => {
    cameraStream = stream;
    video.srcObject = stream;
    video.play();
  }).catch(error => {
    console.error('Camera error:', error);
    alert('Impossible d\'accéder à la caméra. Veuillez vérifier les permissions.');
    modal.classList.remove('active');
  });
}

function capturePhoto() {
  const canvas = document.getElementById('photoCanvas');
  const video = document.getElementById('cameraVideo');
  const ctx = canvas.getContext('2d');
  
  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;
  ctx.drawImage(video, 0, 0);
  
  const photoData = canvas.toDataURL('image/jpeg', 0.8);
  document.getElementById('userPhoto').value = photoData;
  
  // Display preview
  const preview = document.getElementById('photoPreview');
  preview.innerHTML = `<img src="${photoData}" alt="Photo">`;
  preview.classList.remove('empty');
  
  closeCamera();
}

function closeCamera() {
  if (cameraStream) {
    cameraStream.getTracks().forEach(track => track.stop());
    cameraStream = null;
  }
  document.getElementById('cameraModal').classList.remove('active');
  document.getElementById('cameraVideo').srcObject = null;
}

function handlePhotoUpload(event) {
  const file = event.target.files[0];
  if (!file) return;
  
  const reader = new FileReader();
  reader.onload = function(e) {
    const photoData = e.target.result;
    document.getElementById('userPhoto').value = photoData;
    
    // Display preview
    const preview = document.getElementById('photoPreview');
    preview.innerHTML = `<img src="${photoData}" alt="Photo">`;
    preview.classList.remove('empty');
  };
  reader.readAsDataURL(file);
}

function clearPhoto() {
  document.getElementById('userPhoto').value = '';
  document.getElementById('photoPreview').innerHTML = '📸';
  document.getElementById('photoPreview').classList.add('empty');
  document.getElementById('photoFile').value = '';
}
</script>
