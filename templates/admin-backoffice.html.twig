// ─── COLLECTIONS MANAGEMENT ───

async function refreshCollections() {
  const search = document.getElementById('collectionSearch').value.trim();
  const organisateur = document.getElementById('collectionOrganisateurFilter').value;

  const params = new URLSearchParams();
  if (search) params.append('search', search);
  if (organisateur) params.append('organisateur', organisateur);

  try {
    const response = await fetch(`/api/admin/collections?${params}`);
    const result = await response.json();

    if (result.success) {
      populateCollectionsCards(result.data);
      populateCollectionsDetails(result.data);
      populateCollectionFilters(result.data);
      document.getElementById('collectionsSummary').textContent = `${result.data.length} collections actives`;
    } else {
      showToast('Erreur lors du chargement des collections');
    }
  } catch (error) {
    console.error('Error fetching collections:', error);
    showToast('Erreur réseau');
  }
}

function populateCollectionsCards(collections) {
  const container = document.getElementById('collectionsCards');

  const activeCollections = collections.filter(c => c.status === 'active').length;
  const totalDonations = collections.reduce((sum, c) => sum + (c.currentAmount || 0), 0);

  container.innerHTML = `
    <div class="sc">
      <div class="sc-head">
        <div class="sc-icon" style="background:rgba(30,58,47,.07)">♻️</div>
        <span class="badge b-active">Actives</span>
      </div>
      <div class="sc-val">${activeCollections}</div>
      <div class="sc-lbl">Collections ouvertes</div>
    </div>
    <div class="sc">
      <div class="sc-head">
        <div class="sc-icon" style="background:rgba(16,185,129,.08)">✓</div>
        <span class="badge b-active">+${collections.length}</span>
      </div>
      <div class="sc-val">${collections.length}</div>
      <div class="sc-lbl">Collections totales</div>
    </div>
    <div class="sc">
      <div class="sc-head">
        <div class="sc-icon" style="background:rgba(201,169,110,.1)">⚖️</div>
      </div>
      <div class="sc-val">${totalDonations.toFixed(1)}</div>
      <div class="sc-lbl">kg collectés</div>
    </div>
  `;
}

function populateCollectionsDetails(collections) {
  const container = document.getElementById('collectionsDetails');

  if (collections.length === 0) {
    container.innerHTML = '<div class="blk" style="grid-column:1/-1"><div style="text-align:center;padding:30px;color:var(--muted)">Aucune collection trouvée.</div></div>';
    return;
  }

  container.innerHTML = collections.map(collection => {
    const progress = collection.progress || 0;
    const progressColor = progress > 50 ? 'var(--moss)' : progress > 25 ? 'var(--sand)' : '#e8c48a';

    return `
      <div class="blk">
        <div class="blk-title">
          <div style="flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${collection.title} <span style="font-size:.7rem;font-weight:normal;color:var(--muted)">— ${collection.materialType}</span></div>
          <div style="display:flex;gap:5px;flex-shrink:0">
            <button class="btn btn-primary btn-sm" onclick='openAdminEditCollModal(${JSON.stringify(collection).replace(/'/g, "&apos;")})'>Éditer</button>
            <button class="btn btn-danger btn-sm" onclick="deleteAdminCollection(${collection.id})">Suppr.</button>
          </div>
        </div>
        <div style="font-size:.75rem;color:var(--muted);margin-bottom:8px">Organisateur : ${collection.organisateur || 'Inconnu'}</div>
        <div style="height:8px;background:var(--bg);border-radius:4px;overflow:hidden;margin:12px 0">
          <div style="width:${Math.min(progress, 100)}%;height:100%;background:linear-gradient(to right,${progressColor},#${progressColor === 'var(--moss)' ? '7a9e7e' : progressColor === 'var(--sand)' ? 'e8c48a' : 'e8c48a'});border-radius:4px"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:14px">
          <span style="color:${progress > 50 ? 'var(--success)' : 'var(--warn)'};font-weight:700">${collection.currentAmount} ${collection.unit}</span>
          <span style="color:var(--muted)">/ ${collection.goalAmount} ${collection.unit} · ${progress.toFixed(0)}%</span>
        </div>
        <div style="text-align:center;padding:10px 0;color:var(--muted);font-size:.82rem">
          Statut : <span class="badge ${collection.status==='active'?'b-active':'b-pending'}">${collection.status==='active'?'Active':'Inactive'}</span>
        </div>
      </div>
    `;
  }).join('');
}

function openAdminEditCollModal(c) {
  document.getElementById('adminCollId').value = c.id;
  document.getElementById('adminCollTitle').value = c.title;
  document.getElementById('adminCollMat').value = c.materialType;
  document.getElementById('adminCollStatus').value = c.status;
  document.getElementById('adminCollGoal').value = c.goalAmount;
  document.getElementById('adminCollUnit').value = c.unit;
  document.getElementById('adminCollErrors').style.display = 'none';
  document.getElementById('adminCollModal').classList.add('open');
}

function closeAdminCollModal() {
  document.getElementById('adminCollModal').classList.remove('open');
}

async function submitAdminEditColl() {
  const id = document.getElementById('adminCollId').value;
  const errEl = document.getElementById('adminCollErrors');
  errEl.style.display = 'none';

  const fd = new FormData();
  fd.append('title', document.getElementById('adminCollTitle').value);
  fd.append('materialType', document.getElementById('adminCollMat').value);
  fd.append('status', document.getElementById('adminCollStatus').value);
  fd.append('goalAmount', document.getElementById('adminCollGoal').value);
  fd.append('unit', document.getElementById('adminCollUnit').value);

  try {
    const res = await fetch('/api/admin/collections/' + id, { method: 'POST', body: fd });
    const json = await res.json();
    if(json.success) {
      closeAdminCollModal();
      showToast('Collection mise à jour');
      refreshCollections();
    } else {
      errEl.textContent = json.message || Object.values(json.errors || {})[0] || 'Erreur.';
      errEl.style.display = 'block';
    }
  } catch {
    errEl.textContent = 'Erreur réseau.';
    errEl.style.display = 'block';
  }
}

async function deleteAdminCollection(id) {
  if(!confirm('Confirmer la suppression de cette collection ?')) return;
  try {
    const res = await fetch('/api/admin/collections/' + id, { method: 'DELETE' });
    const json = await res.json();
    if(json.success) {
      showToast('Collection supprimée');
      refreshCollections();
    } else {
      showToast(json.message || 'Erreur');
    }
  } catch {
    showToast('Erreur réseau');
  }
}

function populateCollectionFilters(collections) {
  const organisateurFilter = document.getElementById('collectionOrganisateurFilter');

  // Populate organisateurs
  const organisateurs = [...new Set(collections.map(c => c.organisateur).filter(Boolean))];
  organisateurFilter.innerHTML = '<option value="">Tous les organisateurs</option>' +
    organisateurs.map(org => `<option value="${org}">${org}</option>`).join('');
}

// ─── DONATIONS MANAGEMENT ───

async function refreshDonationsTable() {
  const search = document.getElementById('donationSearch').value.trim();
  const status = document.getElementById('donationStatusFilter').value;

  const params = new URLSearchParams();
  if (search) params.append('search', search);
  if (status) params.append('status', status);

  try {
    const response = await fetch(`/api/admin/donations?${params}`);
    const result = await response.json();

    if (result.success) {
      populateDonationsTable(result.data);
      const confirmed = result.data.filter(d => d.status === 'confirmé').length;
      const pending = result.data.filter(d => d.status === 'en_attente').length;
      document.getElementById('donationsSummary').textContent = `${confirmed} confirmées · ${pending} en attente`;
    } else {
      showToast('Erreur lors du chargement des donations');
    }
  } catch (error) {
    console.error('Error fetching donations:', error);
    showToast('Erreur réseau');
  }
}

function populateDonationsTable(donations) {
  const tbody = document.getElementById('donationsTableBody');
  const emptyState = document.getElementById('donationsEmptyState');

  if (donations.length === 0) {
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
    return;
  }

  emptyState.style.display = 'none';

  tbody.innerHTML = donations.map(donation => {
    const userInitial = donation.donateur ? donation.donateur.prenom.charAt(0).toUpperCase() : '?';
    const userName = donation.donateur ? `${donation.donateur.prenom} ${donation.donateur.nom}` : 'Anonyme';

    const statusBadge = donation.status === 'confirmé' ? '<span class="badge b-active">Confirmé</span>' : (donation.status === 'annulé' ? '<span class="badge b-danger">Annulé</span>' : '<span class="badge b-pending">En attente</span>');

    return `
      <tr>
        <td>
          <div class="user-cell">
            <div class="uc-av" style="background:linear-gradient(135deg,#5a8a7a,#3d6b5a)">${userInitial}</div>
            <div><div class="uc-name">${userName}</div></div>
          </div>
        </td>
        <td style="color:var(--muted)">${donation.collection || 'N/A'}</td>
        <td style="color:var(--success);font-weight:700">${donation.amount} ${donation.unit || ''}</td>
        <td style="color:var(--muted)">${donation.donationDate || 'N/A'}</td>
        <td>
          <select onchange="changeDonationStatus(${donation.id}, this.value)" style="padding:4px 8px;border-radius:6px;border:1px solid var(--border);font-size:.7rem;outline:none;background:var(--bg);cursor:pointer">
            <option value="confirmé" ${donation.status === 'confirmé' ? 'selected' : ''}>Confirmé</option>
            <option value="en_attente" ${donation.status === 'en_attente' ? 'selected' : ''}>En attente</option>
            <option value="annulé" ${donation.status === 'annulé' ? 'selected' : ''}>Annulé</option>
          </select>
        </td>
        <td>
          <button class="btn btn-danger btn-sm" onclick="deleteAdminDonation(${donation.id})">Suppr.</button>
        </td>
      </tr>
    `;
  }).join('');
}

async function changeDonationStatus(id, newStatus) {
  try {
    const res = await fetch('/api/admin/donations/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    });
    const json = await res.json();
    if(json.success) {
      showToast('Statut mis à jour');
      refreshDonationsTable();
    } else {
      showToast(json.message || 'Erreur lors de la mise à jour');
    }
  } catch {
    showToast('Erreur réseau');
  }
}

async function deleteAdminDonation(id) {
  if(!confirm('Confirmer la suppression de cette donation ?')) return;
  try {
    const res = await fetch('/api/admin/donations/' + id, { method: 'DELETE' });
    const json = await res.json();
    if(json.success) {
      showToast('Donation supprimée');
      refreshDonationsTable();
    } else {
      showToast(json.message || 'Erreur');
    }
  } catch {
    showToast('Erreur réseau');
  }
}

