function populateCollectionsDetails(collections) {
  const container = document.getElementById('collectionsDetails');

  if (collections.length === 0) {
    container.innerHTML = '<div class="blk"><div style="text-align:center;padding:30px;color:var(--muted)">Aucune collection trouvée.</div></div>';
    return;
  }

  // Show first 2 collections as examples
  const displayCollections = collections.slice(0, 2);

  container.innerHTML = displayCollections.map(collection => {
    const progress = collection.progress || 0;
    const progressColor = progress > 50 ? 'var(--moss)' : progress > 25 ? 'var(--sand)' : '#e8c48a';

    return `
      <div class="blk">
        <div class="blk-title">${collection.title} — ${collection.materialType}</div>
        <div style="height:8px;background:var(--bg);border-radius:4px;overflow:hidden;margin:12px 0">
          <div style="width:${Math.min(progress, 100)}%;height:100%;background:linear-gradient(to right,${progressColor},#${progressColor === 'var(--moss)' ? '7a9e7e' : progressColor === 'var(--sand)' ? 'e8c48a' : 'e8c48a'});border-radius:4px"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:14px">
          <span style="color:${progress > 50 ? 'var(--success)' : 'var(--warn)'};font-weight:700">${collection.currentAmount} ${collection.unit}</span>
          <span style="color:var(--muted)">/ ${collection.goalAmount} ${collection.unit} · ${progress.toFixed(0)}%</span>
        </div>
        <div style="text-align:center;padding:30px 0;color:var(--muted);font-size:.82rem">
          ${collection.currentAmount > 0 ? 'Donations en cours...' : 'Aucune donation pour l\'instant.'}
        </div>
      </div>
    `;
  }).join('');
}

function populateCollectionFilters(collections) {
  const organisateurFilter = document.getElementById('collectionOrganisateurFilter');

  // Populate organisateurs
  const organisateurs = [...new Set(collections.map(c => c.organisateur).filter(Boolean))];
  organisateurFilter.innerHTML = '<option value="">Tous les organisateurs</option>' +
    organisateurs.map(org => `<option value="${org}">${org}</option>`).join('');
}

// ─── DONATIONS MANAGEMENT ───

async function refreshDonationsTable() {
  const search = document.getElementById('donationSearch').value.trim();
  const status = document.getElementById('donationStatusFilter').value;

  const params = new URLSearchParams();
  if (search) params.append('search', search);
  if (status) params.append('status', status);

  try {
    const response = await fetch(`/api/admin/donations?${params}`);
    const result = await response.json();

    if (result.success) {
      populateDonationsTable(result.data);
      const confirmed = result.data.filter(d => d.status === 'confirmé').length;
      const pending = result.data.filter(d => d.status === 'en_attente').length;
      document.getElementById('donationsSummary').textContent = `${confirmed} confirmées · ${pending} en attente`;
    } else {
      showToast('Erreur lors du chargement des donations');
    }
  } catch (error) {
    console.error('Error fetching donations:', error);
    showToast('Erreur réseau');
  }
}

function populateDonationsTable(donations) {
  const tbody = document.getElementById('donationsTableBody');
  const emptyState = document.getElementById('donationsEmptyState');

  if (donations.length === 0) {
    tbody.innerHTML = '';
    emptyState.style.display = 'block';
    return;
  }

  emptyState.style.display = 'none';

  tbody.innerHTML = donations.map(donation => {
    const userInitial = donation.donateur ? donation.donateur.prenom.charAt(0).toUpperCase() : '?';
    const userName = donation.donateur ? `${donation.donateur.prenom} ${donation.donateur.nom}` : 'Anonyme';

    return `
      <tr>
        <td>
          <div class="user-cell">
            <div class="uc-av" style="background:linear-gradient(135deg,#5a8a7a,#3d6b5a)">${userInitial}</div>
            <div><div class="uc-name">${userName}</div></div>
          </div>
        </td>
        <td style="color:var(--muted)">${donation.collection || 'N/A'}</td>
        <td style="color:var(--success);font-weight:700">${donation.amount} ${donation.unit || ''}</td>
        <td style="color:var(--muted)">${donation.donationDate || 'N/A'}</td>
        <td><span class="badge ${donation.status === 'confirmé' ? 'b-active' : 'b-pending'}">${donation.status === 'confirmé' ? 'Confirmé' : 'En attente'}</span></td>
        <td><button class="btn btn-ghost btn-sm" onclick="showToast('Voir donation')">Voir</button></td>
      </tr>
    `;
  }).join('');
}

