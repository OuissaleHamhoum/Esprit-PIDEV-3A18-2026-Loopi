<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — Administration</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F7F5F0;--cream:#FDFCF9;--light:#FAFAF7;--card:#FFFFFF;--forest:#1E3A2F;--moss:#3D6B4F;--sage:#7A9E7E;--sand:#C9A96E;--rust:#B05A2F;--danger:#DC3545;--warn:#F59E0B;--success:#10B981;--info:#3B82F6;--muted:#6B7468;--border:rgba(30,58,47,0.09);--dark:#111510;--text:#1A2218;--loopi-mint:#3D6B4F}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;font-size:14px}

/* SIDEBAR - dark premium */
.sidebar{width:256px;background:var(--dark);min-height:100vh;display:flex;flex-direction:column;position:fixed;left:0;top:0;bottom:0;z-index:100}
.s-logo{padding:24px 22px 18px;border-bottom:1px solid rgba(255,255,255,.06)}
.logo-wrap{display:flex;align-items:center;gap:10px}
.logo-icon{width:32px;height:32px;background:linear-gradient(135deg,var(--moss),var(--sage));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.logo-name{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:white}
.admin-pill{background:rgba(176,90,47,.25);color:#e8926a;border-radius:50px;padding:2px 8px;font-size:.58rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-left:auto}
.s-user{padding:14px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:10px}
.s-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--rust),#d4783c);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:.9rem;font-weight:700;color:white;flex-shrink:0}
.s-uname{font-size:.8rem;font-weight:600;color:white}
.s-urole{font-size:.62rem;color:rgba(255,255,255,.35)}
nav.snav{padding:12px 10px;flex:1;overflow-y:auto}
.s-sec{font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.2);padding:14px 12px 5px}
.ni{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;transition:all .18s;margin-bottom:1px;text-decoration:none;color:rgba(255,255,255,.45);font-size:.8rem;font-weight:500}
.ni:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.85)}
.ni.active{background:linear-gradient(135deg,rgba(176,90,47,.2),rgba(176,90,47,.1));color:#e8926a}
.ni .ic{width:16px;text-align:center;font-size:.85rem;flex-shrink:0}
.ni .nb{margin-left:auto;background:var(--danger);color:white;border-radius:50px;padding:1px 6px;font-size:.58rem;font-weight:700;min-width:18px;text-align:center}
.s-bot{padding:12px 10px;border-top:1px solid rgba(255,255,255,.06)}

/* MAIN */
.main{margin-left:256px;flex:1;min-height:100vh;background:var(--bg)}
.header{background:white;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.h-left{display:flex;align-items:center;gap:12px}
.breadcrumb{font-size:.75rem;color:var(--muted)}
.breadcrumb span{color:var(--forest);font-weight:600}
.h-right{display:flex;align-items:center;gap:10px}
.h-notif{width:34px;height:34px;border-radius:50%;background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.9rem;position:relative}
.h-notif .dot{width:7px;height:7px;background:var(--danger);border-radius:50%;position:absolute;top:6px;right:6px;border:2px solid white}
.content{padding:24px 28px}

/* BUTTONS */
.btn{padding:7px 16px;border-radius:8px;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .18s;border:none;font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;gap:5px}
.btn-primary{background:var(--forest);color:white}
.btn-primary:hover{background:var(--moss)}
.btn-danger{background:rgba(220,53,69,.1);color:var(--danger);border:1px solid rgba(220,53,69,.2)}
.btn-danger:hover{background:rgba(220,53,69,.2)}
.btn-warn{background:rgba(245,158,11,.1);color:var(--warn);border:1px solid rgba(245,158,11,.2)}
.btn-warn:hover{background:rgba(245,158,11,.2)}
.btn-success{background:rgba(16,185,129,.1);color:var(--success);border:1px solid rgba(16,185,129,.2)}
.btn-success:hover{background:rgba(16,185,129,.2)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--bg);color:var(--forest)}
.btn-action{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 12px;border-radius:10px;border:1px solid transparent;background:rgba(30,58,47,.06);color:var(--forest);font-size:.82rem;font-weight:700;cursor:pointer;transition:all .18s;white-space:nowrap}
.btn-action:hover{transform:translateY(-1px);background:rgba(61,107,79,.12)}
.btn-action:focus{outline:none;box-shadow:0 0 0 3px rgba(61,107,79,.15)}
.btn-action-view{background:rgba(61,107,79,.08);border-color:rgba(61,107,79,.14);color:var(--forest)}
.btn-action-edit{background:var(--forest);color:white;border-color:transparent}
.btn-action-edit:hover{background:var(--moss)}
.btn-action-delete{background:transparent;color:var(--danger);border-color:rgba(220,53,69,.2)}
.btn-action-delete:hover{background:rgba(220,53,69,.12);color:var(--danger)}
.btn-sm{padding:4px 10px;font-size:.7rem;border-radius:6px}

/* STAT CARDS */
.cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}
.sc{background:white;border-radius:14px;padding:18px;border:1px solid var(--border);position:relative;overflow:hidden;transition:box-shadow .2s}
.sc:hover{box-shadow:0 6px 24px rgba(30,58,47,.07)}
.sc-accent{position:absolute;top:0;left:0;width:4px;height:100%;border-radius:14px 0 0 14px}
.sc-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.sc-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.sc-delta{font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:50px}
.sc-val{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:var(--forest);line-height:1;margin-bottom:3px}
.sc-lbl{font-size:.7rem;color:var(--muted)}

/* LAYOUT */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:18px}
.g23{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-bottom:18px}
.g32{display:grid;grid-template-columns:3fr 2fr;gap:18px;margin-bottom:18px}

/* CARD BLOCK */
.blk{background:white;border-radius:14px;padding:20px;border:1px solid var(--border)}
.blk-title{font-size:.9rem;font-weight:700;color:var(--forest);margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.blk-title .sub{font-family:'DM Sans',sans-serif;font-size:.7rem;font-weight:500;color:var(--muted)}

/* CHARTS (CSS bar) */
.chart-bars{display:flex;align-items:flex-end;gap:6px;height:90px}
.b-col{display:flex;flex-direction:column;align-items:center;gap:3px;flex:1}
.b{width:100%;border-radius:4px 4px 0 0;min-height:3px}
.b-l{font-size:.58rem;color:var(--muted)}
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut{width:90px;height:90px;border-radius:50%;background:conic-gradient(var(--forest) 0% 45%,var(--moss) 45% 72%,var(--sage) 72% 90%,var(--sand) 90% 100%);display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0}
.donut::after{content:'';position:absolute;width:55px;height:55px;background:white;border-radius:50%}
.donut-labels{display:flex;flex-direction:column;gap:6px}
.dl{display:flex;align-items:center;gap:6px;font-size:.72rem;color:var(--muted)}
.dl-dot{width:9px;height:9px;border-radius:3px;flex-shrink:0}

/* TABLE */
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;padding:7px 10px;font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);background:var(--bg)}
.tbl td{padding:10px;border-bottom:1px solid rgba(30,58,47,.04);font-size:.79rem;vertical-align:middle;color:var(--text)}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(30,58,47,.02)}
.user-cell{display:flex;align-items:center;gap:9px}
.uc-av{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;color:white;flex-shrink:0;overflow:hidden;background-size:cover;background-position:center}
.uc-name{font-weight:600;color:var(--forest);font-size:.8rem}
.uc-email{font-size:.66rem;color:var(--muted)}

/* BADGES */
.badge{padding:3px 8px;border-radius:50px;font-size:.62rem;font-weight:700;white-space:nowrap}
.b-admin{background:rgba(176,90,47,.1);color:var(--rust)}
.b-org{background:rgba(61,107,79,.1);color:var(--moss)}
.b-part{background:rgba(30,58,47,.07);color:var(--forest)}
.b-active{background:rgba(16,185,129,.1);color:var(--success)}
.b-pending{background:rgba(245,158,11,.1);color:var(--warn)}
.b-danger{background:rgba(220,53,69,.08);color:var(--danger)}

/* SEARCH BAR */
.search-bar{display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
.search-input{padding:8px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.8rem;outline:none;background:white;transition:border-color .2s;min-width:220px}
.search-input:focus{border-color:var(--moss)}
select.filter{padding:7px 10px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.78rem;color:var(--muted);outline:none;background:white;cursor:pointer}

/* ACTIVITY FEED */
.act-item{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
.act-item:last-child{border-bottom:none}
.act-icon{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0}
.act-body{flex:1}
.act-text{font-size:.79rem;color:var(--text);line-height:1.4}
.act-time{font-size:.66rem;color:var(--muted);margin-top:1px}

/* MODAL */
.modal-overlay{display:none !important;position:fixed;inset:0;background:rgba(17,21,16,0.7);backdrop-filter:blur(6px);z-index:2000;align-items:center;justify-content:center;animation:fadeIn .2s ease;pointer-events:none;opacity:0;visibility:hidden;transition:opacity .2s ease, visibility .2s ease}
.modal-overlay.open{display:flex !important;pointer-events:auto;opacity:1;visibility:visible}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal{background:white;border-radius:24px;width:460px;max-width:92vw;overflow:hidden;animation:slideUp .25s ease;position:relative}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-header{background:var(--cream);padding:32px 32px 24px;text-align:center;border-bottom:1px solid rgba(30,58,47,.07);position:relative}
.modal-title{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:var(--forest);margin:0}
.modal-close{position:absolute;top:20px;right:20px;background:transparent;border:none;color:var(--muted);font-size:1.3rem;cursor:pointer}
.modal-body{padding:28px 32px 32px}
.modal-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:16px}
.modal-footer .btn-ghost{min-width:120px}
.modal-footer .btn-submit{width:auto;flex:1}
.btn-submit{width:100%;padding:13px 16px;background:var(--forest);color:white;border:none;border-radius:10px;font-family:'DM Sans',sans-serif;font-size:.92rem;font-weight:700;cursor:pointer;transition:all .18s;letter-spacing:.02em}
.btn-submit:hover{background:var(--moss);transform:translateY(-1px)}
.fg{margin-bottom:12px}
.fg label{display:block;font-size:.73rem;font-weight:600;color:var(--forest);margin-bottom:4px}
.fg input,.fg select,.fg textarea{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:9px;font-family:'DM Sans',sans-serif;font-size:.82rem;color:var(--text);outline:none;transition:border-color .2s;background:var(--bg)}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--moss);background:white}
.fg textarea{resize:vertical;min-height:70px}
.frow2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* AUTH MODAL STYLES (matching login page) */
.auth-modal{background:white;border-radius:24px;width:90vw;max-width:920px;max-height:92vh;overflow:hidden;animation:slideUp .25s ease;position:relative;box-shadow:0 30px 70px rgba(17,21,16,.18)}
.auth-split{display:grid;grid-template-columns:1.05fr 1fr;min-height:520px}
.auth-split-left{position:relative;background:linear-gradient(135deg,var(--forest) 0%,var(--moss) 100%);color:white;display:flex;flex-direction:column;justify-content:center;padding:44px 38px}
.auth-split-left::before{content:'';position:absolute;inset:0;background:url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="rgba(255,255,255,0.04)"/><circle cx="75" cy="75" r="1" fill="rgba(255,255,255,0.04)"/><circle cx="50" cy="50" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');opacity:.25;pointer-events:none}
.auth-panel{position:relative;z-index:1;display:flex;flex-direction:column;gap:28px;max-width:420px}
.auth-brand{display:flex;align-items:center;gap:.9rem;}
.auth-brand-label{font-size:.95rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.78)}
.auth-title{font-size:2rem;font-weight:900;line-height:1.05;margin:0;max-width:15ch}
.auth-description{font-size:1rem;color:rgba(255,255,255,.85);line-height:1.65;max-width:32ch}
.auth-highlights{display:flex;flex-wrap:wrap;gap:.75rem}
.auth-chip{padding:.55rem 1rem;border-radius:999px;background:rgba(255,255,255,.12);font-size:.78rem;font-weight:600;color:white}
.auth-footer{margin-top:auto;display:flex;flex-direction:column;gap:.9rem}
.auth-logos{display:flex;align-items:center;gap:1rem}
.auth-note{font-size:.85rem;color:rgba(255,255,255,.75);margin:0;max-width:280px}
.auth-split-right{position:relative;background:var(--cream);padding:32px 36px;display:flex;align-items:center;justify-content:center}
.auth-card{width:100%;max-width:420px;background:white;border-radius:22px;box-shadow:0 18px 40px rgba(30,58,47,.08);padding:28px 30px;}
.auth-card-header{display:flex;align-items:center;gap:18px;margin-bottom:22px}
.auth-card-title{font-size:1.2rem;font-weight:800;color:var(--forest);margin:0}
.auth-card-subtitle{font-size:.92rem;color:var(--muted);margin:2px 0 0}
.modal-close{position:absolute;top:20px;right:22px;background:transparent;border:none;color:var(--muted);font-size:1.35rem;cursor:pointer;z-index:2}
.loopi-logo-img{height:40px;width:auto;margin-bottom:0}
.loopi-logo-img--auth{height:44px}
.user-avatar{width:72px;height:72px;border-radius:18px;background:linear-gradient(135deg,var(--rust),#d4783c);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:white;flex-shrink:0;overflow:hidden;background-size:cover;background-position:center;border:4px solid rgba(255,255,255,.14)}
.form-label{display:block;font-size:.78rem;font-weight:700;color:var(--forest);margin-bottom:.55rem}
.form-control,.form-select{padding:.92rem 1.1rem;border:1px solid #d7d3c8;border-radius:14px;font-family:'DM Sans',sans-serif;font-size:.95rem;color:var(--text);outline:none;transition:border-color .2s,box-shadow .2s;background:#faf8f3}
.form-control:focus,.form-select:focus{border-color:var(--moss);background:white;box-shadow:0 0 0 3px rgba(61,107,79,0.1)}
.form-control-lg{padding:1rem 1.25rem;font-size:1rem}
.form-select-lg{padding:1rem 1.25rem;font-size:1rem}
.btn-loopi{background:linear-gradient(135deg,var(--forest),var(--moss));color:white;border:none;padding:.95rem 1.5rem;border-radius:14px;font-family:'DM Sans',sans-serif;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;justify-content:center}
.btn-loopi:hover{background:linear-gradient(135deg,var(--moss),var(--sage));transform:translateY(-1px);box-shadow:0 8px 18px rgba(30,58,47,0.18)}
.btn-outline-secondary{background:transparent;color:#6c757d;border:1px solid #6c757d;padding:.55rem 1rem;border-radius:12px;font-size:.85rem;font-weight:600;cursor:pointer;transition:all .2s}
.btn-outline-secondary:hover{background:#6c757d;color:white}
.btn-outline-danger{background:transparent;color:#dc3545;border:1px solid #dc3545;padding:.55rem 1rem;border-radius:12px;font-size:.85rem;font-weight:600;cursor:pointer;transition:all .2s}
.btn-outline-danger:hover{background:#dc3545;color:white}

/* PHOTO SECTION */
.photo-section{text-align:center;margin-bottom:1.75rem;padding:18px;background:var(--bg);border-radius:18px;border:1px solid var(--border)}
.photo-preview{width:110px;height:110px;border-radius:18px;background:var(--cream);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:2.5rem;color:#6c757d;margin:0 auto 1rem;overflow:hidden;background-size:cover;background-position:center}
.photo-preview.empty{background:linear-gradient(135deg,var(--moss),var(--sage));color:white}
.photo-buttons{display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap}
.photo-buttons button{padding:.6rem 1rem;font-size:.82rem;border-radius:10px;border:1px solid var(--border);background:white;color:var(--forest);cursor:pointer;transition:all .18s;font-weight:600}
.photo-buttons button:hover{background:var(--forest);color:white;border-color:var(--forest)}

/* RESPONSIVE */
@media (max-width: 991.98px) {
  .auth-modal{max-width:95vw;max-height:95vh}
  .auth-split{grid-template-columns:1fr}
  .auth-split-left{display:none}
  .auth-split-right{padding:24px 20px}
  .auth-card{padding:24px 22px}
}

/* ALERT */
.alert{padding:12px 16px;border-radius:10px;font-size:.8rem;font-weight:500;margin-bottom:16px;display:flex;align-items:center;gap:8px}
.alert-info{background:rgba(59,130,246,.08);color:#1d4ed8;border:1px solid rgba(59,130,246,.15)}
.alert-warn{background:rgba(245,158,11,.08);color:#92400e;border:1px solid rgba(245,158,11,.15)}

/* TOAST */
.toast{position:fixed;bottom:20px;right:20px;background:var(--forest);color:white;padding:11px 18px;border-radius:11px;font-size:.8rem;font-weight:600;z-index:9999;transform:translateY(60px);opacity:0;transition:all .28s}
.toast.show{transform:translateY(0);opacity:1}

@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.content>*{animation:fadeUp .35s ease both}

/* PHOTO SECTION */
.photo-section{margin-bottom:16px;padding:14px;background:var(--bg);border-radius:10px;border:1.5px solid var(--border)}
.photo-preview{width:140px;height:140px;border-radius:12px;margin:0 auto 12px;overflow:hidden;background:var(--cream);display:flex;align-items:center;justify-content:center;border:2px solid var(--border)}
.photo-preview img{width:100%;height:100%;object-fit:cover}
.photo-preview.empty{background:linear-gradient(135deg,var(--moss),var(--sage));color:white;font-size:3rem}
.photo-buttons{display:flex;gap:8px;justify-content:center}
.photo-buttons button{padding:6px 12px;font-size:.75rem;border-radius:7px;border:1.5px solid var(--border);background:white;color:var(--forest);cursor:pointer;transition:all .18s;font-weight:500}
.photo-buttons button:hover{background:var(--forest);color:white;border-color:var(--forest)}
#photoCanvas{display:none}
#cameraModal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);z-index:10000;align-items:center;justify-content:center;flex-direction:column}
#cameraModal.active{display:flex}
.camera-container{background:white;border-radius:14px;padding:14px;max-width:500px}
.camera-container video{width:100%;border-radius:10px;margin-bottom:12px;display:block}
.camera-buttons{display:flex;gap:8px;justify-content:center}
.camera-buttons button{padding:8px 16px;border-radius:8px;border:none;font-weight:600;cursor:pointer;font-size:.8rem}
.camera-buttons .capture{background:var(--forest);color:white}
.camera-buttons .capture:hover{background:var(--moss)}
.camera-buttons .cancel{background:var(--bg);color:var(--forest);border:1px solid var(--border)}
.camera-buttons .cancel:hover{background:var(--border)}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="s-logo">
    <div class="logo-wrap">
      <div class="logo-icon">🌿</div>
