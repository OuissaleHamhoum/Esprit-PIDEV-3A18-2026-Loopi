document.addEventListener('keydown', e => {
  document.querySelectorAll('.moverlay.open').forEach(m => { if (e.key === 'Escape') m.classList.remove('open'); });
});

// PHOTO HANDLING FUNCTIONS
let cameraStream = null;

function startCamera() {
  const modal = document.getElementById('cameraModal');
  const video = document.getElementById('cameraVideo');
  
  modal.classList.add('active');
  
  navigator.mediaDevices.getUserMedia({ 
    video: { facingMode: 'user' },
    audio: false 
  }).then(stream => {
    cameraStream = stream;
    video.srcObject = stream;
    video.play();
  }).catch(error => {
    console.error('Camera error:', error);
    alert('Impossible d\'accéder à la caméra. Veuillez vérifier les permissions.');
    modal.classList.remove('active');
  });
}

function capturePhoto() {
  const canvas = document.getElementById('photoCanvas');
  const video = document.getElementById('cameraVideo');
  const ctx = canvas.getContext('2d');
  
  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;
  ctx.drawImage(video, 0, 0);
  
  const photoData = canvas.toDataURL('image/jpeg', 0.8);
  document.getElementById('userPhoto').value = photoData;
  
  // Display preview
  const preview = document.getElementById('photoPreview');
  preview.innerHTML = `<img src="${photoData}" alt="Photo">`;
  preview.classList.remove('empty');
  
  closeCamera();
}

function closeCamera() {
  if (cameraStream) {
    cameraStream.getTracks().forEach(track => track.stop());
    cameraStream = null;
  }
  document.getElementById('cameraModal').classList.remove('active');
  document.getElementById('cameraVideo').srcObject = null;
}

function handlePhotoUpload(event) {
  const file = event.target.files[0];
  if (!file) return;
  
  const reader = new FileReader();
  reader.onload = function(e) {
    const photoData = e.target.result;
    document.getElementById('userPhoto').value = photoData;
    
    // Display preview
    const preview = document.getElementById('photoPreview');
    preview.innerHTML = `<img src="${photoData}" alt="Photo">`;
    preview.classList.remove('empty');
  };
  reader.readAsDataURL(file);
}

function clearPhoto() {
  document.getElementById('userPhoto').value = '';
  document.getElementById('photoPreview').innerHTML = '📸';
  document.getElementById('photoPreview').classList.add('empty');
  document.getElementById('photoFile').value = '';
}

// Form validation for user modal
(function () {
  var f = document.getElementById('userForm');
  if (!f) return;
  f.addEventListener('submit', function (e) {
    if (!f.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
    }
    f.classList.add('was-validated');
  });
})();

// Keyboard accessibility
document.addEventListener('keydown', function(e) {
  const modal = document.getElementById('userModal');
  if (!modal || modal.classList && !modal.classList.contains('open')) return;
  
  // Close on Escape
  if (e.key === 'Escape') {
    closeUserModal();
  }
  
  // Submit on Ctrl+Enter or Cmd+Enter
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    const submitBtn = document.getElementById('userModalSubmit');
    if (submitBtn && userModalMode !== 'show') {
      e.preventDefault();
      submitUserForm(e);
    }
  }
});

// Focus management in modal
document.getElementById('userModal').addEventListener('keydown', function(e) {
  if (e.key === 'Tab') {
    const focusable = this.querySelectorAll('button, input, select, textarea, [tabindex]:not([tabindex=\"-1\"])');
    const firstFocus = focusable[0];
    const lastFocus = focusable[focusable.length - 1];
    
    if (e.shiftKey && document.activeElement === firstFocus) {
      e.preventDefault();
      lastFocus.focus();
    } else if (!e.shiftKey && document.activeElement === lastFocus) {
      e.preventDefault();
      firstFocus.focus();
    }
  }
});

// Input validation visual feedback
['userNom', 'userPrenom', 'userEmail', 'userPassword', 'userRole', 'userGenre'].forEach(id => {
  const input = document.getElementById(id);
  if (!input) return;
  
  input.addEventListener('blur', function() {
    if (this.hasAttribute('required') && !this.value.trim()) {
      this.style.borderColor = '#dc3545';
      this.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.1)';
    } else if (this.type === 'email' && this.value && !this.checkValidity()) {
      this.style.borderColor = '#dc3545';
      this.style.boxShadow = '0 0 0 3px rgba(220,53,69,0.1)';
    } else if (this.value) {
      this.style.borderColor = 'var(--moss)';
      this.style.boxShadow = '0 0 0 3px rgba(107,138,112,0.1)';
    }
  });
});

// ─── KEYBOARD EVENTS & ACCESSIBILITY ───

document.addEventListener('keydown', function(e) {
  // Fermer le modal avec Échap
  if (e.key === 'Escape' && document.getElementById('userModal').classList.contains('open')) {
    closeUserModal();
    return;
  }
  
  // Soumettre le formulaire avec Ctrl+Entrée ou Cmd+Entrée
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && document.getElementById('userModal').classList.contains('open')) {
    const submitBtn = document.getElementById('userModalSubmit');
    if (submitBtn && submitBtn.style.display !== 'none' && !submitBtn.disabled) {
      e.preventDefault();
      submitUserForm(e);
    }
  }
});

// Focus management dans le modal
document.getElementById('userModal').addEventListener('keydown', function(e) {
  if (e.key === 'Tab' && this.classList.contains('open')) {
    const focusable = this.querySelectorAll(
      'button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex="-1"])'
    );
    
    if (focusable.length === 0) return;
    
    const firstFocusable = focusable[0];
    const lastFocusable = focusable[focusable.length - 1];
    const activeElement = document.activeElement;
    
    if (e.shiftKey) {
      // Shift+Tab: go backwards
      if (activeElement === firstFocusable) {
        e.preventDefault();
        lastFocusable.focus();
      }
    } else {
      // Tab: go forward
      if (activeElement === lastFocusable) {
        e.preventDefault();
        firstFocusable.focus();
      }
    }
  }
});

// Amélioration des boutons au hover & focus
document.querySelectorAll('button').forEach(button => {
  // Feedback visuel au click
  button.addEventListener('mousedown', function(e) {
    if (!this.disabled) {
      this.style.transform = (this.style.transform || 'translateY(0)').replace('translateY', 'translateY') + ' scale(0.97)';
    }
  });
  
  button.addEventListener('mouseup', function() {
    this.style.transform = (this.style.transform || 'translateY(0)').replace('scale(0.97)', '');
  });
  
  button.addEventListener('mouseleave', function() {
    this.style.transform = (this.style.transform || 'translateY(0)').replace('scale(0.97)', '');
  });
  
  // Support du focus-visible
  button.addEventListener('focus', function(e) {
    if (e.isTrusted) {
      this.setAttribute('data-focused', 'true');
    }
  });
  
  button.addEventListener('blur', function() {
    this.removeAttribute('data-focused');
  });
});

window.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.modal-overlay.open, .events-modal.open, #cameraModal.active').forEach(el => {
    el.classList.remove('open');
    el.classList.remove('active');
  });
});

// Auto-focus du premier input au modal open
const userModal = document.getElementById('userModal');
const observer = new MutationObserver(function(mutations) {
  mutations.forEach(function(mutation) {
    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
      if (userModal.classList.contains('open')) {
        setTimeout(() => {
          const firstFocusable = userModal.querySelector('input:not([type="hidden"]):not(:disabled), button:not(:disabled)');
          if (firstFocusable) {
            firstFocusable.focus();
          }
        }, 100);
      }
    }
  });
});

observer.observe(userModal, { attributes: true });

// Validation feedback on field change
document.getElementById('userForm').addEventListener('input', function(e) {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') {
    const field = e.target;
    if (field.value.trim()) {
      field.style.borderColor = 'var(--moss)';
      field.style.boxShadow = '0 0 0 2px rgba(107,138,112,0.08)';
    } else {
      field.style.borderColor = 'var(--border)';
      field.style.boxShadow = 'none';
    }
  }
});

function formatDate(dateString) {
  if (!dateString) return '-';
  const date = new Date(dateString);
  return date.toLocaleDateString('fr-FR') + ' ' + date.toLocaleTimeString('fr-FR', {hour: '2-digit', minute: '2-digit'});
}
