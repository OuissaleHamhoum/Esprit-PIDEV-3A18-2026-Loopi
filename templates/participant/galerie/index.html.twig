{% extends 'participant/layout.html.twig' %}

{% block title %}Galerie — Participant{% endblock %}

{% block par_body %}
<h1 class="h4 fw-bold mb-2">Découvrez nos trésors</h1>
<p class="text-muted mb-4">Œuvres et créations publiées par les organisateurs.</p>
<div class="row g-3">
    {% for p in produits %}
        <div class="col-md-6 col-lg-4">
            <div class="card loopi-panel h-100">
                {% set img = p.image %}
                <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                    {% if img and 'uploads/' in img %}
                        <img src="{{ asset(img) }}" alt="" class="object-fit-cover">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center text-muted small">Aperçu</div>
                    {% endif %}
                </div>
                <div class="card-body">
                    <span class="badge rounded-pill" style="background:#e8f5e9;color:#1b5e20;">{{ p.category ? p.category.nom : 'Catégorie' }}</span>
                    <h2 class="h6 fw-bold mt-2">{{ p.nom }}</h2>
                    <p class="small text-muted mb-0">{{ p.description|default('')|slice(0, 100) }}{% if p.description|length > 100 %}…{% endif %}</p>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun produit.</p>
    {% endfor %}
</div>
{% endblock %}
