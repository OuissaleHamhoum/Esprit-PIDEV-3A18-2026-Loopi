{% extends 'participant/layout.html.twig' %}

{% block title %}Mes favoris — Participant{% endblock %}

{% block par_body %}
<h1 class="h4 fw-bold mb-2"><i class="bi bi-heart-fill text-danger me-2"></i>Mes favoris</h1>
<p class="text-muted mb-4">Produits que vous avez ajoutés en favori.</p>
<div class="row g-3">
    {% for f in favoris %}
        {% set p = f.produit %}
        {% if p %}
            <div class="col-md-6 col-lg-4">
                <div class="card loopi-panel h-100">
                    {% set img = p.image %}
                    <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                        {% if img and 'uploads/' in img %}
                            <img src="{{ asset(img) }}" alt="" class="object-fit-cover">
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center text-muted small">Aperçu</div>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <h2 class="h6 fw-bold">{{ p.nom }}</h2>
                        <p class="small text-muted mb-0">Ajouté le {{ f.dateAjout ? f.dateAjout|date('d/m/Y') : '—' }}</p>
                    </div>
                </div>
            </div>
        {% endif %}
    {% else %}
        <p class="text-muted">Aucun favori pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}
