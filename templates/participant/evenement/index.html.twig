{% extends 'participant/layout.html.twig' %}

{% block title %}Événements — Participant{% endblock %}

{% block par_body %}
<h1 class="h4 fw-bold mb-2">Événements écologiques</h1>
<p class="text-muted mb-4">Parcourez les événements publiés sur la plateforme.</p>
<div class="row g-3">
    {% for e in events %}
        <div class="col-md-6 col-xl-4">
            <div class="card loopi-panel h-100">
                {% set img = e.imageEvenement %}
                <div class="ratio ratio-16x9 bg-light rounded-top overflow-hidden">
                    {% if img and 'uploads/' in img %}
                        <img src="{{ asset(img) }}" alt="" class="object-fit-cover">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center text-muted"><i class="bi bi-image fs-1"></i></div>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if e.statutValidation %}
                        <span class="badge bg-success bg-opacity-10 text-success">{{ e.statutValidation }}</span>
                    {% endif %}
                    <h2 class="h6 fw-bold mt-2">{{ e.titre }}</h2>
                    <p class="small text-muted mb-2">{{ e.dateEvenement|date('d/m/Y H:i') }} · {{ e.lieu ?? '—' }}</p>
                    <p class="small mb-0">{{ e.description|default('')|slice(0, 120) }}{% if e.description|length > 120 %}…{% endif %}</p>
                    {% if e.organisateur %}
                        <p class="small text-muted mt-2 mb-0"><i class="bi bi-person me-1"></i>{{ e.organisateur.prenom }} {{ e.organisateur.nom }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun événement.</p>
    {% endfor %}
</div>
{% endblock %}
