{% extends 'organisateur/layout.html.twig' %}

{% block title %}Mes produits — Organisateur{% endblock %}

{% block org_body %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h4 fw-bold mb-0">Ma galerie</h1>
    <a class="btn btn-primary rounded-3" href="{{ path('org_produits_new') }}"><i class="bi bi-plus-lg me-1"></i>Nouveau</a>
</div>
<div class="row g-3">
    {% for p in produits %}
        <div class="col-md-6 col-xl-4">
            <div class="card loopi-panel h-100">
                {% set img = p.image %}
                <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                    {% if img and 'uploads/' in img %}
                        <img src="{{ asset(img) }}" alt="" class="object-fit-cover">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center text-muted small">Aperçu</div>
                    {% endif %}
                </div>
                <div class="card-body">
                    <div class="small text-success">{{ p.category ? p.category.nom : '' }}</div>
                    <h2 class="h6 fw-bold">{{ p.nom }}</h2>
                    <p class="small text-muted text-truncate-3" style="max-height:4.5rem;overflow:hidden;">{{ p.description|default('') }}</p>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary btn-sm flex-grow-1" href="{{ path('org_produits_edit', {id: p.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('org_produits_delete', {id: p.id}) }}" onsubmit="return confirm('Supprimer ce produit ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucun produit pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}
