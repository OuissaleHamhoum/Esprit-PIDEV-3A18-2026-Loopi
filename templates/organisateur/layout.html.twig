{% extends 'base.html.twig' %}

{% block body %}
{% set _route = app.request.attributes.get('_route') %}
<div class="loopi-dash-shell">
    <aside class="loopi-dash-sidebar loopi-dash-sidebar--org">
        <div class="loopi-dash-sidebar-head">
            <a href="{{ path('app_organisateur_dashboard') }}" class="d-block mb-3">
                <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img loopi-logo-img--sidebar">
            </a>
            <div class="small text-white-50 text-uppercase fw-semibold mb-2" style="letter-spacing:.1em;">Organisateur</div>
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-25 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;font-weight:700;">
                    {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                </div>
                <div class="small lh-sm text-truncate">
                    <div class="fw-semibold text-white">{{ app.user.prenom }} {{ app.user.nom }}</div>
                    <div class="text-white-50 text-truncate" style="max-width:160px;">{{ app.user.email }}</div>
                </div>
            </div>
        </div>
        <nav class="nav flex-column gap-0">
            <span class="loopi-dash-nav-label">Produits</span>
            <a class="nav-link {{ 'org_produits' in _route ? 'is-active' : '' }}" href="{{ path('org_produits') }}"><i class="bi bi-palette me-2"></i>Mes produits</a>
            <span class="loopi-dash-nav-label">Événements</span>
            <a class="nav-link {{ 'org_evenements' in _route ? 'is-active' : '' }}" href="{{ path('org_evenements') }}"><i class="bi bi-calendar-event me-2"></i>Mes événements</a>
            <span class="loopi-dash-nav-label">Participants</span>
            <a class="nav-link {{ 'org_participants' in _route ? 'is-active' : '' }}" href="{{ path('org_participants') }}"><i class="bi bi-people me-2"></i>Gestion participants</a>
            <span class="loopi-dash-nav-label">Collectes</span>
            <a class="nav-link {{ 'org_collections' in _route ? 'is-active' : '' }}" href="{{ path('org_collections') }}"><i class="bi bi-recycle me-2"></i>Campagnes</a>
            <span class="loopi-dash-nav-label">Statistiques</span>
            <a class="nav-link {{ _route == 'app_organisateur_dashboard' ? 'is-active' : '' }}" href="{{ path('app_organisateur_dashboard') }}"><i class="bi bi-graph-up-arrow me-2"></i>Tableau de bord</a>
        </nav>
        <div class="loopi-dash-sidebar-foot">
            <a class="btn btn-danger w-100 rounded-3" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-1"></i>Déconnexion</a>
            <div class="d-flex align-items-center justify-content-center gap-2 mt-3">
                <img src="{{ asset('images/branding/esprit.png') }}" alt="" class="loopi-logo-img" style="height:22px;opacity:.65;">
            </div>
        </div>
    </aside>
    <div class="loopi-dash-main">
        <header class="loopi-dash-topbar loopi-dash-topbar--org">
            <span class="loopi-dash-topbar-title">LOOPI ORGANISATEUR</span>
            <div class="small text-end">
                <div class="fw-semibold">{{ app.user.prenom }} {{ app.user.nom }}</div>
                <div class="text-white-50 text-uppercase" style="font-size:.7rem;">Organisateur</div>
            </div>
        </header>
        <div class="loopi-dash-body">
            {% block org_body %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
