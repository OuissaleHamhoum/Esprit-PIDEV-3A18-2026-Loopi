{% extends 'base.html.twig' %}

{% block title %}Accueil — Loopi{% endblock %}

{% block extra_styles %}
.hero-loopi {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(125deg, var(--loopi-deep) 0%, var(--loopi-forest) 40%, #1e6b6b 100%);
    color: #fff;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    box-shadow: var(--shadow);
}
.hero-loopi::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 1;
    pointer-events: none;
}
.hero-loopi .inner { position: relative; z-index: 1; max-width: 640px; }
.hero-loopi h1 { font-size: clamp(1.85rem, 4vw, 2.75rem); font-weight: 700; line-height: 1.15; }
.hero-loopi .lead { opacity: 0.92; font-size: 1.05rem; }
.feature-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
}
{% endblock %}

{% block body %}
<div class="container">
    <section class="hero-loopi mb-5">
        <div class="inner">
            <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                <img src="{{ asset('images/branding/logo.png') }}" alt="Loopi" class="loopi-logo-img" style="height:52px;width:auto;opacity:.96;filter:drop-shadow(0 2px 8px rgba(0,0,0,.25));">
                <img src="{{ asset('images/branding/esprit.png') }}" alt="Esprit" class="loopi-logo-img" style="height:40px;width:auto;opacity:.92;filter:drop-shadow(0 2px 6px rgba(0,0,0,.2));">
            </div>
            <p class="text-uppercase small fw-semibold mb-2 opacity-75" style="letter-spacing:.12em;">Art · recyclage · communauté</p>
            <h1 class="mb-3">Donnez une seconde vie aux matériaux, <span style="color:var(--loopi-mint);">exposez votre création</span></h1>
            <p class="lead mb-4">Loopi connecte participants et organisateurs autour d’une galerie d’œuvres et d’événements éco-responsables — avec un back-office dédié aux administrateurs.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light btn-lg text-dark fw-semibold px-4" href="{{ path('app_catalog') }}"><i class="bi bi-grid-3x3-gap me-2"></i>Explorer la galerie</a>
                <a class="btn btn-loopi-outline btn-lg" href="{{ path('app_events') }}"><i class="bi bi-calendar2-week me-2"></i>Événements</a>
                {% if not app.user %}
                    <a class="btn btn-loopi btn-lg" href="{{ path('app_register') }}"><i class="bi bi-person-plus me-2"></i>Créer un compte</a>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card card-loopi h-100 border-0">
                <div class="card-body p-4">
                    <div class="feature-icon" style="background: linear-gradient(135deg,#e8f4f2,var(--loopi-mint)); color: var(--loopi-deep);"><i class="bi bi-people"></i></div>
                    <h2 class="h5 fw-bold" style="color:var(--loopi-deep);">Participant</h2>
                    <p class="text-muted small mb-3">Parcourez la galerie, inscrivez-vous aux événements et suivez votre activité depuis un espace clair et moderne.</p>
                    <span class="badge rounded-pill" style="background:#e8f4f2;color:var(--loopi-forest);">Front-office</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-loopi h-100 border-0">
                <div class="card-body p-4">
                    <div class="feature-icon" style="background: linear-gradient(135deg,#fff3e8,#ffd8c2); color: #a85a32;"><i class="bi bi-megaphone"></i></div>
                    <h2 class="h5 fw-bold" style="color:var(--loopi-deep);">Organisateur</h2>
                    <p class="text-muted small mb-3">Même interface que le participant pour la navigation : votre tableau de bord met en avant vos œuvres, collections et événements publiés.</p>
                    <span class="badge rounded-pill" style="background:#fff3e8;color:#a85a32;">Front-office</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-loopi h-100 border-0">
                <div class="card-body p-4">
                    <div class="feature-icon" style="background: linear-gradient(135deg,#f0e8ff,#d4c4f5); color: #5b3d8a;"><i class="bi bi-shield-lock"></i></div>
                    <h2 class="h5 fw-bold" style="color:var(--loopi-deep);">Administrateur</h2>
                    <p class="text-muted small mb-3">Vue consolidée : utilisateurs, produits et événements — réservée au rôle <strong>admin</strong>.</p>
                    <span class="badge rounded-pill" style="background:#f0e8ff;color:#5b3d8a;">Back-office</span>
                </div>
            </div>
        </div>
    </div>

    <section class="text-center py-4 px-3 rounded-4 mb-5" style="background: rgba(255,255,255,0.65); border: 1px solid rgba(10,61,62,0.08);">
        <h2 class="h4 fw-bold mb-2" style="color:var(--loopi-deep);">Déjà un compte de test ?</h2>
        <p class="text-muted small mb-0">
            Admin : <code>admin@loopi.tn</code> · Organisateur : <code>organisateur@loopi.tn</code> · Participant : <code>participant@loopi.tn</code>
            <span class="d-block mt-1">(mots de passe du jeu de données importé dans <code>loopi_db</code>)</span>
        </p>
    </section>
</div>
{% endblock %}
