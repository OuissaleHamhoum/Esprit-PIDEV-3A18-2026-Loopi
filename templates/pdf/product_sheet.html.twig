<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Fiche Produit - {{ product.nomProduit }}</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #333; margin: 40px; }
        .header { display: table; width: 100%; border-bottom: 2px solid #28a745; padding-bottom: 20px; margin-bottom: 30px; }
        .header-left { display: table-cell; vertical-align: middle; }
        .header-right { display: table-cell; text-align: right; vertical-align: middle; }
        .logo { color: #28a745; font-size: 32px; font-weight: bold; }
        .product-name { font-size: 28px; font-weight: bold; margin: 20px 0; color: #222; }
        .main-content { display: table; width: 100%; }
        .product-image { display: table-cell; width: 40%; vertical-align: top; }
        .product-details { display: table-cell; width: 60%; vertical-align: top; padding-left: 30px; }
        .img-placeholder { width: 100%; height: 250px; background: #f0f0f0; border: 1px solid #ddd; text-align: center; line-height: 250px; color: #999; }
        .badge { display: inline-block; padding: 5px 12px; border-radius: 15px; font-size: 14px; background: #e8f5e9; color: #2e7d32; font-weight: bold; margin-bottom: 15px; }
        .price { font-size: 24px; color: #28a745; font-weight: bold; margin-bottom: 20px; }
        .description { margin-bottom: 30px; text-align: justify; }
        .section-title { font-size: 18px; font-weight: bold; border-bottom: 1px solid #eee; padding-bottom: 5px; margin-bottom: 15px; color: #555; }
        .stats-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .stats-table td { padding: 10px; border-bottom: 1px solid #f5f5f5; }
        .stats-label { font-weight: bold; color: #666; width: 40%; }
        .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #aaa; padding: 20px 0; }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-left">
            <div class="logo">Loopi</div>
        </div>
        <div class="header-right">
            <div>Fiche Technique Produit</div>
            <div style="font-size: 12px; color: #888;">Réf: #PROD-{{ product.id }}</div>
        </div>
    </div>

    <div class="product-name">{{ product.nomProduit }}</div>
    <div class="badge">{{ product.category.nomCat }}</div>

    <div class="main-content">
        <div class="product-image">
            {% if base64Image %}
                <img src="{{ base64Image }}" style="width: 100%; border-radius: 8px;">
            {% else %}
                <div class="img-placeholder">Aucune image disponible</div>
            {% endif %}
        </div>
        <div class="product-details">
            <div class="section-title">Description</div>
            <div class="description">
                {{ product.description|nl2br }}
            </div>

            <div class="section-title">Informations Vendeur</div>
            <table class="stats-table">
                <tr>
                    <td class="stats-label">Organisateur :</td>
                    <td>{{ product.user.prenom }} {{ product.user.nom }}</td>
                </tr>
                <tr>
                    <td class="stats-label">Date de création :</td>
                    <td>{{ product.createdAt|date('d/m/Y') }}</td>
                </tr>
                <tr>
                    <td class="stats-label">Popularité :</td>
                    <td>{{ favCount }} favoris</td>
                </tr>
                <tr>
                    <td class="stats-label">Note Moyenne :</td>
                    <td>{{ avgRating }}/5</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="footer">
        © {{ "now"|date('Y') }} Loopi Marketplace - Document confidentiel destiné à l'administration.
    </div>
</body>
</html>
