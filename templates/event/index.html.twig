{% extends 'base.html.twig' %}

{% block title %}Événements — Loopi{% endblock %}

{% block extra_styles %}
.events-hero {
    border-radius: 1.25rem;
    background: linear-gradient(125deg, var(--forest-green, #2d5a3d) 0%, var(--leaf-green, #4a7c59) 55%, var(--water-blue, #5ba4a4) 100%);
    color: #fff;
    padding: 2rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-lg);
}
{% endblock %}

{% block body %}
<div class="container pb-5">
    <div class="events-hero">
        <p class="small text-white-50 text-uppercase mb-2" style="letter-spacing:.12em;">Agenda</p>
        <h1 class="h2 fw-bold mb-2">Événements écologiques</h1>
        <p class="mb-0 opacity-90">Uniquement les événements validés par l’administration.</p>
    </div>
    <div class="vstack gap-3">
        {% for e in events %}
            <a href="{{ path('app_event_show', {id: e.id}) }}" class="text-decoration-none">
                <div class="card loopi-card-elevated border-0">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h2 class="h5 mb-0 text-dark fw-bold">{{ e.titre }}</h2>
                                <span class="badge rounded-pill bg-white bg-opacity-25 text-white">Validé</span>
                            </div>
                            <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i>{{ e.lieu ?? 'Lieu à préciser' }}</p>
                        </div>
                        <div class="text-md-end flex-shrink-0">
                            <div class="fw-semibold text-loopi"><i class="bi bi-calendar3 me-1"></i>{{ e.dateEvenement|date('d/m/Y') }}</div>
                            <div class="small text-muted">{{ e.dateEvenement|date('H:i') }}</div>
                        </div>
                    </div>
                </div>
            </a>
        {% else %}
            <p class="text-muted">Aucun événement.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
