{% extends 'base.html.twig' %}

{% block title %}{{ event.titre }} — Loopi{% endblock %}

{% block body %}
<div class="container pb-5">
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_events') }}">Événements</a></li>
        <li class="breadcrumb-item active">{{ event.titre }}</li>
    </ol>
</nav>
<div class="card card-loopi">
    <div class="card-body">
        <h1 class="h3">{{ event.titre }}</h1>
        <p class="text-muted">{{ event.dateEvenement|date('d/m/Y à H:i') }} — {{ event.lieu ?? 'Lieu non renseigné' }}</p>
        {% if event.organisateur %}
            <p class="small">Organisateur : {{ event.organisateur.prenom }} {{ event.organisateur.nom }}</p>
        {% endif %}
        {% if event.description %}
            <p class="mt-3">{{ event.description|nl2br }}</p>
        {% endif %}
        {% if event.capaciteMax %}
            <p class="small text-muted">Capacité max : {{ event.capaciteMax }}</p>
        {% endif %}
    </div>
</div>
</div>
{% endblock %}
