<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Login — Loopi</title>
  <style>
    :root{--bg:#F7F5F0;--card:#fff;--forest:#1E3A2F;--moss:#3D6B4F;--muted:#6B7468;--border:rgba(30,58,47,0.12);--info:#1d4ed8;--danger:#b91c1c}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#111}
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .card{width:min(560px,92vw);background:var(--card);border:1px solid var(--border);border-radius:18px;box-shadow:0 16px 40px rgba(17,21,16,.08);padding:18px}
    h1{margin:0 0 6px;font-size:1.1rem;color:var(--forest)}
    p{margin:0 0 14px;color:var(--muted);font-size:.92rem;line-height:1.45}
    .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
    .btn{padding:12px 14px;border-radius:12px;border:none;background:linear-gradient(135deg,var(--forest),var(--moss));color:#fff;font-weight:900;cursor:pointer;flex:1}
    .btn.secondary{background:rgba(59,130,246,0.12);color:var(--info);border:1px solid rgba(29,78,216,.25)}
    .box{margin-top:14px;border:1px solid var(--border);border-radius:16px;padding:14px;background:#faf8f3}
    .qr{width:220px;height:220px;border-radius:14px;border:1px solid rgba(30,58,47,0.12);background:#fff;display:block;margin:10px auto}
    .warn{display:none;margin-top:10px;padding:10px 12px;border-radius:14px;border:1px solid rgba(185,28,28,.25);background:rgba(185,28,28,.08);color:var(--danger);font-weight:800}
    .link{word-break:break-all;font-weight:800;color:var(--moss);text-decoration:none}
    code{background:#fff;border:1px solid rgba(30,58,47,.12);padding:2px 6px;border-radius:8px}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Connexion par QR Code (téléphone)</h1>
      <p>Scannez le QR avec votre téléphone. Une page web s’ouvre sur le téléphone pour entrer email + mot de passe. Ensuite, ce PC se connectera automatiquement.</p>

      <div class="warn" id="warn"></div>

      <div class="row">
        <button class="btn" id="btn" type="button" onclick="start()">Générer QR</button>
        <button class="btn secondary" type="button" onclick="window.close()">Fermer</button>
      </div>

      <div class="box" id="box" style="display:none">
        <div style="text-align:center;color:var(--muted);font-size:.85rem">
          QR valide <span id="mins">5</span> min · serveur embarqué: <code>http://PC:8081</code>
        </div>
        <img id="img" class="qr" alt="QR Login">
        <div style="text-align:center;font-size:.85rem;color:var(--muted)">
          Lien: <a id="a" class="link" href="#" target="_blank" rel="noopener">ouvrir</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function start() {
      const btn = document.getElementById('btn');
      const warn = document.getElementById('warn');
      warn.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Génération...';
      try {
        const r = await fetch('/api/qr-login/start', { method:'POST', headers:{'Accept':'application/json'}});
        const data = await r.json();
        if (!r.ok || !data.success) throw new Error(data.message || 'Erreur QR');

        const host = window.location.hostname;
        const phoneHost = host === 'localhost' ? null : host;
        if (!phoneHost) {
          warn.textContent = 'Vous êtes sur localhost. Ouvrez le site via l’IP du PC (ex: http://192.168.x.x:8080) pour que le téléphone puisse accéder au PC.';
          warn.style.display = 'block';
        }

        const url8081 = `http://${phoneHost || 'VOTRE_IP_PC'}:8081${data.phoneUrl}`;
        document.getElementById('img').src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(url8081)}`;
        const a = document.getElementById('a');
        a.href = url8081;
        a.textContent = url8081;
        document.getElementById('mins').textContent = String(Math.round((data.expiresIn || 300)/60));
        document.getElementById('box').style.display = 'block';

        const token = data.token;
        const startedAt = Date.now();
        const poll = async () => {
          try {
            const rr = await fetch(`/api/qr-login/status/${encodeURIComponent(token)}`, { headers:{'Accept':'application/json'}});
            const s = await rr.json();
            if (s.status === 'approved') {
              window.location.href = `/qr-login/${encodeURIComponent(token)}`;
              return;
            }
            if (s.status === 'expired') {
              warn.textContent = 'QR expiré. Régénérez.';
              warn.style.display = 'block';
              return;
            }
          } catch(e) {}
          if (Date.now() - startedAt < (data.expiresIn || 300)*1000) setTimeout(poll, 1500);
        };
        setTimeout(poll, 1200);
      } catch (e) {
        warn.textContent = e.message || 'Erreur serveur.';
        warn.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Générer QR';
      }
    }
  </script>
</body>
</html>

