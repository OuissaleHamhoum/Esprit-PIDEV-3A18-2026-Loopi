<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loopi — L'Art du Recyclage</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #F5F0E8;
    --forest: #1E3A2F;
    --moss: #3D6B4F;
    --sage: #7A9E7E;
    --sand: #C9A96E;
    --rust: #B05A2F;
    --light: #FAFAF7;
    --dark: #111510;
    --muted: #6B7468;
    --card: #FFFFFF;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--light);
    color: var(--dark);
    overflow-x: hidden;
  }

  /* ── NOISE TEXTURE ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.4;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 18px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(245,240,232,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(30,58,47,0.08);
    transition: all 0.3s ease;
  }

  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.7rem;
    font-weight: 900;
    color: var(--forest);
    letter-spacing: -0.5px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-leaf {
    width: 30px; height: 30px;
    background: var(--moss);
    border-radius: 60% 10% 60% 10%;
    display: inline-block;
    position: relative;
    transform: rotate(-20deg);
    flex-shrink: 0;
  }
  .logo-leaf::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 60%; height: 1.5px;
    background: rgba(255,255,255,0.6);
    transform: translate(-50%, -50%) rotate(0deg);
    border-radius: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--forest); }

  .nav-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .btn-ghost {
    padding: 8px 20px;
    border: 1.5px solid var(--forest);
    border-radius: 50px;
    background: transparent;
    color: var(--forest);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-ghost:hover { background: var(--forest); color: white; }

  .btn-solid {
    padding: 9px 22px;
    border: none;
    border-radius: 50px;
    background: var(--forest);
    color: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-solid:hover { background: var(--moss); transform: translateY(-1px); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    padding: 120px 5% 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    right: -100px; top: -100px;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(61,107,79,0.12) 0%, transparent 70%);
    border-radius: 50%;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(61,107,79,0.1);
    border: 1px solid rgba(61,107,79,0.25);
    border-radius: 50px;
    padding: 5px 14px 5px 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--moss);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 22px;
    animation: fadeUp 0.6s ease both;
  }

  .hero-badge-dot {
    width: 6px; height: 6px;
    background: var(--moss);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.08;
    color: var(--forest);
    margin-bottom: 20px;
    animation: fadeUp 0.6s ease 0.1s both;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--rust);
  }

  .hero p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 480px;
    margin-bottom: 36px;
    animation: fadeUp 0.6s ease 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    animation: fadeUp 0.6s ease 0.3s both;
  }

  .btn-large {
    padding: 14px 32px;
    font-size: 0.95rem;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-primary {
    background: var(--forest);
    color: white;
    border: none;
  }
  .btn-primary:hover { background: var(--moss); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(30,58,47,0.25); }
  .btn-outline {
    background: transparent;
    color: var(--forest);
    border: 2px solid var(--forest);
  }
  .btn-outline:hover { background: var(--forest); color: white; }

  .hero-stats {
    display: flex;
    gap: 30px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(30,58,47,0.1);
    animation: fadeUp 0.6s ease 0.4s both;
  }

  .stat-item {}
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--forest);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 500;
    margin-top: 3px;
    letter-spacing: 0.02em;
  }

  /* ── HERO VISUAL ── */
  .hero-visual {
    position: relative;
    animation: fadeRight 0.8s ease 0.2s both;
  }

  @keyframes fadeRight {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .hero-card-main {
    background: white;
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(30,58,47,0.12);
    position: relative;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .product-card {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    height: 150px;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .product-card:hover { transform: scale(1.02); }

  .product-card:nth-child(1) { background: linear-gradient(135deg, #e8f0e4 0%, #c5dac4 100%); }
  .product-card:nth-child(2) { background: linear-gradient(135deg, #f5e8dc 0%, #dfc4a6 100%); }
  .product-card:nth-child(3) { background: linear-gradient(135deg, #e0e8f0 0%, #a6c4dc 100%); }
  .product-card:nth-child(4) { background: linear-gradient(135deg, #f0e8e0 0%, #dcbfa6 100%); }

  .product-tag {
    position: absolute;
    bottom: 8px; left: 8px;
    background: rgba(255,255,255,0.9);
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--forest);
  }

  .hero-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-label {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .card-label strong {
    display: block;
    font-size: 0.95rem;
    color: var(--forest);
    font-weight: 700;
  }

  .eco-badge-card {
    background: rgba(61,107,79,0.1);
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--moss);
  }

  /* Floating cards */
  .float-card {
    position: absolute;
    background: white;
    border-radius: 16px;
    padding: 14px 18px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    font-size: 0.8rem;
    white-space: nowrap;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .float-card.top-right {
    top: -20px; right: -30px;
    animation-delay: 0.5s;
  }
  .float-card.bottom-left {
    bottom: -20px; left: -30px;
    animation-delay: 1s;
  }

  .float-icon { font-size: 1.2rem; margin-bottom: 2px; }
  .float-val { font-weight: 700; color: var(--forest); font-size: 0.95rem; }
  .float-sub { color: var(--muted); font-size: 0.7rem; }

  /* ── SECTION STYLES ── */
  section { padding: 90px 5%; }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moss);
    margin-bottom: 12px;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: var(--forest);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 550px;
  }

  /* ── STATS STRIP ── */
  .stats-strip {
    background: var(--forest);
    padding: 50px 5%;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .stat-block {
    text-align: center;
    padding: 10px 20px;
    border-right: 1px solid rgba(255,255,255,0.1);
  }
  .stat-block:last-child { border-right: none; }

  .stat-big {
    font-family: 'Playfair Display', serif;
    font-size: 2.8rem;
    font-weight: 900;
    color: white;
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-big span {
    color: var(--sand);
    font-size: 1.8rem;
  }

  .stat-desc {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.55);
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  /* ── HOW IT WORKS ── */
  .how-section {
    background: var(--cream);
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 56px;
  }

  .how-card {
    background: white;
    border-radius: 20px;
    padding: 36px 30px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: default;
  }
  .how-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(30,58,47,0.1); }

  .how-num {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    font-weight: 900;
    color: rgba(30,58,47,0.06);
    position: absolute;
    top: -10px; right: 16px;
    line-height: 1;
  }

  .how-icon {
    width: 52px; height: 52px;
    background: linear-gradient(135deg, var(--moss), var(--forest));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 20px;
  }

  .how-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--forest);
    margin-bottom: 10px;
  }

  .how-card p {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ── PRODUCTS / GALLERY ── */
  .products-section {}

  .products-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
  }

  .products-scroll {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .art-card {
    border-radius: 20px;
    overflow: hidden;
    background: var(--cream);
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
  }
  .art-card:hover { transform: translateY(-8px); box-shadow: 0 24px 60px rgba(30,58,47,0.12); }

  .art-img {
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    position: relative;
    overflow: hidden;
  }

  .art-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30,58,47,0.3) 0%, transparent 60%);
  }

  .art-cat {
    position: absolute;
    top: 12px; left: 12px;
    background: rgba(255,255,255,0.92);
    border-radius: 8px;
    padding: 3px 10px;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--moss);
    letter-spacing: 0.04em;
    z-index: 1;
  }

  .art-body {
    padding: 18px 20px;
  }

  .art-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--forest);
    margin-bottom: 6px;
  }

  .art-desc {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .art-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(30,58,47,0.07);
  }

  .art-material {
    font-size: 0.72rem;
    color: var(--sage);
    font-weight: 600;
  }

  .art-heart {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    transition: transform 0.2s;
  }
  .art-heart:hover { transform: scale(1.3); }

  /* ── EVENTS ── */
  .events-section {
    background: var(--cream);
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 48px;
  }

  .event-card {
    background: white;
    border-radius: 20px;
    padding: 28px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .event-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(30,58,47,0.1); }

  .event-date-block {
    background: var(--forest);
    border-radius: 14px;
    width: 56px; height: 60px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .event-day {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-month {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.7;
    margin-top: 2px;
  }

  .event-info {}
  .event-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--forest);
    margin-bottom: 6px;
  }
  .event-meta {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 10px;
    line-height: 1.6;
  }
  .event-location {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    color: var(--moss);
    font-weight: 500;
  }

  .event-spots {
    margin-top: 10px;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .spots-bar {
    height: 4px;
    background: rgba(30,58,47,0.1);
    border-radius: 2px;
    margin-top: 4px;
    overflow: hidden;
  }
  .spots-fill {
    height: 100%;
    background: var(--moss);
    border-radius: 2px;
    transition: width 1s ease;
  }

  /* ── TEAM ── */
  .team-section {}

  .team-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .team-card {
    background: white;
    border-radius: 20px;
    padding: 24px 16px;
    text-align: center;
    border: 1px solid rgba(30,58,47,0.07);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .team-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(30,58,47,0.08); }

  .team-avatar {
    width: 64px; height: 64px;
    border-radius: 50%;
    margin: 0 auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    color: white;
  }

  .team-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--forest);
    margin-bottom: 4px;
  }

  .team-role {
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .team-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-admin { background: rgba(176,90,47,0.1); color: var(--rust); }
  .badge-org { background: rgba(61,107,79,0.12); color: var(--moss); }
  .badge-part { background: rgba(30,58,47,0.07); color: var(--forest); }

  /* ── COLLECTIONS / DONATIONS ── */
  .collections-section {
    background: var(--forest);
    color: white;
  }

  .collections-section .section-label { color: var(--sand); }
  .collections-section .section-title { color: white; }
  .collections-section .section-sub { color: rgba(255,255,255,0.6); }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .collection-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    padding: 24px;
    transition: background 0.2s;
    cursor: pointer;
  }
  .collection-card:hover { background: rgba(255,255,255,0.1); }

  .col-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }

  .col-mat {
    background: rgba(201,169,110,0.2);
    color: var(--sand);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .col-status {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #4CAF50;
    margin-top: 4px;
  }

  .col-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 18px;
  }

  .col-progress {
    margin-bottom: 10px;
  }

  .col-bar {
    height: 6px;
    background: rgba(255,255,255,0.12);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .col-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(to right, var(--sand), #e8c48a);
  }

  .col-numbers {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .col-current { color: var(--sand); font-weight: 600; }
  .col-goal { color: rgba(255,255,255,0.4); }

  /* ── TESTIMONIALS ── */
  .testimonials-section {
    background: var(--cream);
    overflow: hidden;
  }

  .testimonials-track {
    display: flex;
    gap: 24px;
    margin-top: 48px;
    animation: scroll-left 20s linear infinite;
    width: max-content;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .testimonials-track:hover { animation-play-state: paused; }

